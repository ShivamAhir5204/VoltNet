@model IEnumerable<VoltNet.Controllers.admin.AdminStationRankDto>

@{
    ViewData["Title"] = "Platform Reports & Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var platformRevenue = ViewBag.PlatformRevenue != null ? (decimal)ViewBag.PlatformRevenue : 0m;
    var platformKwh = ViewBag.PlatformKwh != null ? (decimal)ViewBag.PlatformKwh : 0m;
    var totalSessions = ViewBag.TotalSessions != null ? (int)ViewBag.TotalSessions : 0;
    var totalUsers = ViewBag.TotalUsers != null ? (int)ViewBag.TotalUsers : 0;
    var totalCustomers = ViewBag.TotalCustomers != null ? (int)ViewBag.TotalCustomers : 0;
    var totalOwners = ViewBag.TotalOwners != null ? (int)ViewBag.TotalOwners : 0;
    var totalStations = ViewBag.TotalStations != null ? (int)ViewBag.TotalStations : 0;
    var verifiedStations = ViewBag.VerifiedStations != null ? (int)ViewBag.VerifiedStations : 0;

    var monthLabels = ViewBag.MonthLabels as List<string> ?? new List<string>();
    var monthRevenue = ViewBag.MonthRevenue as List<decimal> ?? new List<decimal>();
    var monthSessions = ViewBag.MonthSessions as List<int> ?? new List<int>();
    var connectorLabels = ViewBag.ConnectorLabels as List<string> ?? new List<string>();
    var connectorCounts = ViewBag.ConnectorCounts as List<int> ?? new List<int>();
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-1"><i class="fas fa-chart-pie text-primary mr-2"></i> Platform-Wide EV Charging &amp; Revenue Analytics</h4>
                    <p class="text-muted mb-0 small">Comprehensive network KPIs, energy dispensing volumes, and station partner performance metrics.</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <div class="btn-group" role="group">
                        <a href="/admin/reports" class="btn btn-sm @(ViewBag.SelectedDays == null ? "btn-primary" : "btn-outline-primary")">All Time</a>
                        <a href="/admin/reports?days=30" class="btn btn-sm @(ViewBag.SelectedDays == 30 ? "btn-primary" : "btn-outline-primary")">Last 30 Days</a>
                        <a href="/admin/reports?days=90" class="btn btn-sm @(ViewBag.SelectedDays == 90 ? "btn-primary" : "btn-outline-primary")">Last 90 Days</a>
                        <a href="/admin/reports?days=365" class="btn btn-sm @(ViewBag.SelectedDays == 365 ? "btn-primary" : "btn-outline-primary")">1 Year</a>
                    </div>
                </div>
            </div>
            <div class="card-body">

                <!-- Platform KPI Metric Cards -->
                <div class="row mb-4">
                    <div class="col-6 col-lg-3 mb-3 mb-lg-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-success text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-rupee-sign fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Gross Revenue</h4></div>
                                <div class="card-body font-weight-bold text-success">₹@platformRevenue.ToString("F2")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 mb-3 mb-lg-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-primary text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-bolt fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Clean Energy</h4></div>
                                <div class="card-body font-weight-bold text-primary">@platformKwh.ToString("F2") kWh</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 mb-3 mb-lg-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-info text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-charging-station fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Network Stations</h4></div>
                                <div class="card-body font-weight-bold text-dark">
                                    @verifiedStations <span class="small text-muted font-weight-normal">/ @totalStations active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-warning text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-users fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Total Users</h4></div>
                                <div class="card-body font-weight-bold text-warning">
                                    @totalUsers <span class="small text-muted font-weight-normal">(@totalCustomers EV drivers)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interactive Charts Row -->
                <div class="row mb-4">
                    <div class="col-12 col-lg-8 mb-4 mb-lg-0">
                        <div class="card border mb-0 h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="font-weight-bold text-dark mb-0"><i class="fas fa-chart-line text-primary mr-2"></i> Monthly Platform Charging Revenue</h6>
                            </div>
                            <div class="card-body">
                                <canvas id="platformRevenueChart" style="height: 270px; max-height: 270px;"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card border mb-0 h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="font-weight-bold text-dark mb-0"><i class="fas fa-chart-pie text-info mr-2"></i> Connector Type Share</h6>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center">
                                <canvas id="platformConnectorChart" style="height: 270px; max-height: 270px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Station Network Leaderboard Table -->
                <h5 class="font-weight-bold text-dark mb-3">
                    <i class="fas fa-trophy text-warning mr-2"></i> Station Network Performance Leaderboard
                </h5>

                @if (!Model.Any())
                {
                    <div class="text-center py-4 bg-light rounded">
                        <p class="text-muted mb-0">No charging session records found for the selected period.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle" id="table-1">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 50px;">Rank</th>
                                    <th>Station Name</th>
                                    <th>Location</th>
                                    <th>Partner / Owner</th>
                                    <th class="text-center">Chargers</th>
                                    <th class="text-center">Sessions</th>
                                    <th class="text-center">Energy Delivered</th>
                                    <th class="text-right">Revenue (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rank = 1; }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (rank == 1)
                                            {
                                                <span class="badge badge-warning text-dark font-weight-bold">#1 🥇</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="badge badge-secondary text-dark font-weight-bold">#2 🥈</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="badge badge-light border text-dark font-weight-bold">#3 🥉</span>
                                            }
                                            else
                                            {
                                                <span class="font-weight-bold text-muted ml-2">#@rank</span>
                                            }
                                        </td>
                                        <td>
                                            <strong class="text-dark">@item.StationName</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted"><i class="fas fa-map-marker-alt text-danger mr-1"></i> @item.City, @item.State</span>
                                        </td>
                                        <td>
                                            <span class="text-dark font-weight-bold">@item.OwnerName</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-light border font-weight-bold">@item.ChargersCount</span>
                                        </td>
                                        <td class="text-center font-weight-bold">
                                            @item.SessionsCount
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-light border text-primary font-weight-bold">@item.TotalKwh.ToString("F2") kWh</span>
                                        </td>
                                        <td class="text-right">
                                            <strong class="text-success font-weight-bold">₹@item.TotalRevenue.ToString("F2")</strong>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/otika/assets/bundles/chartjs/chart.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Platform Revenue Bar Chart
            var revCtx = document.getElementById('platformRevenueChart');
            if (revCtx) {
                var monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels));
                var monthRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthRevenue));

                new Chart(revCtx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [{
                            label: 'Platform Revenue (₹)',
                            data: monthRevenue,
                            backgroundColor: 'rgba(58, 186, 244, 0.7)',
                            borderColor: '#3abaf4',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            yAxes: [{
                                ticks: {
                                    beginAtZero: true,
                                    callback: function(value) { return '₹' + value; }
                                }
                            }]
                        }
                    }
                });
            }

            // Platform Connector Doughnut Chart
            var connCtx = document.getElementById('platformConnectorChart');
            if (connCtx) {
                var connLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(connectorLabels));
                var connCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(connectorCounts));

                if (connLabels.length === 0) {
                    connLabels = ["No Data"];
                    connCounts = [1];
                }

                new Chart(connCtx, {
                    type: 'doughnut',
                    data: {
                        labels: connLabels,
                        datasets: [{
                            data: connCounts,
                            backgroundColor: ['#6777ef', '#63ed7a', '#ffa426', '#fc544b', '#3abaf4', '#e83e8c']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'bottom' }
                    }
                });
            }
        });
    </script>
}
