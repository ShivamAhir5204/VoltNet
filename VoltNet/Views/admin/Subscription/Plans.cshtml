@model IEnumerable<VoltNet.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Subscription Plans";
    Layout = "_AdminLayout";
    var activeSubs = ViewBag.ActiveSubs as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
}

<meta name="viewport" content="width=device-width, initial-scale=1" />

<style>
    .plans-list {
        --c-primary: #6777EF;
        --c-deep: #353C48;
        --c-dark: #34395E;
        --c-muted: #96A2B4;
        --c-teal: #3DC9B3;
        --c-white: #FFFFFF;
        --c-soft: #F9F9F9;
        --c-light: #F2F2F2;
        --c-border: #E3EAEF;
        --c-success: #28C76F;
        --c-warning: #FFA117;
        --c-error: #EA5455;
        --c-info: #3ABAF4;
        color: var(--c-deep);
        font-size: 15px;
    }
    .plans-list *,
    .plans-list *::before,
    .plans-list *::after { box-sizing: border-box; }

    /* ---------- Alerts ---------- */
    .plans-list .alert {
        border: 1px solid var(--c-border);
        border-radius: 10px;
        color: var(--c-deep);
        margin-bottom: 16px;
        padding: 0;
    }
    .plans-list .alert .alert-body { color: var(--c-deep); padding: 14px 48px 14px 16px; }
    .plans-list .alert .close { color: var(--c-deep) !important; opacity: .6; text-shadow: none; }
    .plans-list .alert .close:hover,
    .plans-list .alert .close:focus { background-color: transparent !important; color: var(--c-deep) !important; opacity: 1; }
    .plans-list .alert i { color: inherit; }
    .plans-list .alert-success { background-color: rgba(40, 199, 111, 0.12); border-color: var(--c-success); }
    .plans-list .alert-danger  { background-color: rgba(234, 84, 85, 0.10);  border-color: var(--c-error); }

    /* ---------- Card ---------- */
    .plans-list .card {
        background-color: var(--c-white);
        border: 1px solid var(--c-border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(53, 60, 72, 0.06);
        overflow: hidden;
    }
    .plans-list .card-header {
        background-color: var(--c-white);
        border-bottom: 1px solid var(--c-border);
        gap: 12px;
        min-height: 0;
        padding: 20px 24px;
    }
    .plans-list .card-header h4 {
        color: var(--c-deep) !important;
        font-size: 20px !important;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        padding: 0;
    }
    .plans-list .card-header-action { gap: 12px; flex-wrap: wrap; }
    .plans-list .card-header-action .btn { margin-right: 0 !important; }
    .plans-list .card-body { padding: 0 !important; }

    /* ---------- Badges ---------- */
    .plans-list .badge {
        align-items: center;
        border: 1px solid transparent;
        border-radius: 999px;
        color: var(--c-deep) !important;
        display: inline-flex;
        font-size: 13px;
        font-weight: 600;
        gap: 6px;
        letter-spacing: 0;
        padding: 6px 12px !important;
    }
    .plans-list .badge i { display: none; }
    .plans-list .badge-primary { background-color: #E8EBFD !important; border-color: #6777EF; }
    .plans-list .badge-success { background-color: #E4F9ED !important; border-color: #28C76F; }
    .plans-list .badge-danger  { background-color: #FCE6E6 !important; border-color: #EA5455; }
    .plans-list .badge-info    { background-color: #E3F5FD !important; border-color: #3ABAF4; }
    .plans-list .badge-light   { background-color: #F2F2F2 !important; border-color: #E3EAEF; }
    .plans-list a.badge-info,
    .plans-list a.badge-info:hover,
    .plans-list a.badge-info:focus,
    .plans-list a.badge-info:active {
        color: #353C48 !important;
        min-height: 32px;
        min-width: 44px;
        justify-content: center;
        text-decoration: none;
    }
    .plans-list a.badge-info:hover,
    .plans-list a.badge-info:focus,
    .plans-list a.badge-info:active {
        background-color: #F9F9F9 !important;
        box-shadow: 0 0 0 3px rgba(58, 186, 244, 0.25);
        outline: 0;
    }
    .plans-list .table .badge-success::before,
    .plans-list .table .badge-danger::before {
        border-radius: 50%;
        content: "";
        height: 8px;
        width: 8px;
    }
    .plans-list .table .badge-success::before { background-color: #28C76F; }
    .plans-list .table .badge-danger::before  { background-color: #EA5455; }

    /* ---------- Buttons (header) ---------- */
    .plans-list .btn {
        align-items: center;
        border-radius: 8px;
        box-shadow: none;
        display: inline-flex;
        font-size: 14px;
        font-weight: 600;
        gap: 8px;
        justify-content: center;
        letter-spacing: 0;
        min-height: 44px;
        padding: 10px 18px;
        text-transform: none;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
    }
    .plans-list .btn i,
    .plans-list .btn .fas { color: inherit !important; margin: 0 !important; }

    /* Primary: Create New Plan */
    .plans-list .btn-primary,
    .plans-list .btn-primary:not(:disabled):not(.disabled) {
        background-color: #6777EF !important;
        border-color: #6777EF !important;
        color: #FFFFFF !important;
    }
    .plans-list .btn-primary:hover,
    .plans-list .btn-primary:focus,
    .plans-list .btn-primary:active,
    .plans-list .btn-primary:not(:disabled):not(.disabled):hover,
    .plans-list .btn-primary:not(:disabled):not(.disabled):focus,
    .plans-list .btn-primary:not(:disabled):not(.disabled):active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.25) !important;
    }

    /* Secondary: Owner Subscriptions */
    .plans-list .btn-outline-info,
    .plans-list .btn-outline-info:not(:disabled):not(.disabled) {
        background-color: #FFFFFF !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
    }
    .plans-list .btn-outline-info:hover,
    .plans-list .btn-outline-info:focus,
    .plans-list .btn-outline-info:active,
    .plans-list .btn-outline-info:not(:disabled):not(.disabled):hover,
    .plans-list .btn-outline-info:not(:disabled):not(.disabled):focus,
    .plans-list .btn-outline-info:not(:disabled):not(.disabled):active {
        background-color: #F9F9F9 !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18) !important;
    }

    /* Destructive: Cancellation Requests */
    .plans-list .btn-outline-danger,
    .plans-list .btn-outline-danger:not(:disabled):not(.disabled) {
        background-color: #FFFFFF !important;
        border-color: #EA5455 !important;
        color: #EA5455 !important;
    }
    .plans-list .btn-outline-danger:hover,
    .plans-list .btn-outline-danger:focus,
    .plans-list .btn-outline-danger:active,
    .plans-list .btn-outline-danger:not(:disabled):not(.disabled):hover,
    .plans-list .btn-outline-danger:not(:disabled):not(.disabled):focus,
    .plans-list .btn-outline-danger:not(:disabled):not(.disabled):active {
        background-color: #F9F9F9 !important;
        border-color: #EA5455 !important;
        color: #EA5455 !important;
        box-shadow: 0 0 0 3px rgba(234, 84, 85, 0.18) !important;
    }

    /* ---------- Row action icon buttons (white tile, coloured icon) ---------- */
    .plans-list .col-action > div { flex-wrap: wrap; gap: 8px; }
    .plans-list .col-action form { margin: 0 !important; }
    .plans-list .col-action .btn {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        border-radius: 10px;
        box-shadow: 0 1px 3px rgba(53, 60, 72, 0.06) !important;
        font-size: 15px;
        height: 44px;
        margin: 0 !important;
        min-height: 44px;
        min-width: 44px;
        padding: 0;
        width: 44px;
    }
    .plans-list .col-action .btn i { color: inherit !important; font-size: 15px; }

    /* Details = Info */
    .plans-list .col-action .btn-info,
    .plans-list .col-action .btn-info:not(:disabled):not(.disabled) { color: #3ABAF4 !important; }
    /* Edit = Indigo */
    .plans-list .col-action .btn-warning,
    .plans-list .col-action .btn-warning:not(:disabled):not(.disabled) { color: #6777EF !important; }
    /* Deactivate = Warning */
    .plans-list .col-action .btn-secondary,
    .plans-list .col-action .btn-secondary:not(:disabled):not(.disabled) { color: #FFA117 !important; }
    /* Activate = Success */
    .plans-list .col-action .btn-success,
    .plans-list .col-action .btn-success:not(:disabled):not(.disabled) { color: #28C76F !important; }
    /* Delete = Error */
    .plans-list .col-action .btn-danger,
    .plans-list .col-action .btn-danger:not(:disabled):not(.disabled) { color: #EA5455 !important; }

    /* Hover / focus / active: soft grey tile, icon colour stays */
    .plans-list .col-action .btn:hover,
    .plans-list .col-action .btn:focus,
    .plans-list .col-action .btn:active,
    .plans-list .col-action .btn:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn:not(:disabled):not(.disabled):active {
        background-color: #F9F9F9 !important;
        border-color: #E3EAEF !important;
        outline: 0;
    }
    .plans-list .col-action .btn-info:hover,
    .plans-list .col-action .btn-info:focus,
    .plans-list .col-action .btn-info:active,
    .plans-list .col-action .btn-info:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn-info:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn-info:not(:disabled):not(.disabled):active { color: #3ABAF4 !important; box-shadow: 0 0 0 3px rgba(58, 186, 244, 0.25) !important; }

    .plans-list .col-action .btn-warning:hover,
    .plans-list .col-action .btn-warning:focus,
    .plans-list .col-action .btn-warning:active,
    .plans-list .col-action .btn-warning:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn-warning:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn-warning:not(:disabled):not(.disabled):active { color: #6777EF !important; box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.25) !important; }

    .plans-list .col-action .btn-secondary:hover,
    .plans-list .col-action .btn-secondary:focus,
    .plans-list .col-action .btn-secondary:active,
    .plans-list .col-action .btn-secondary:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn-secondary:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn-secondary:not(:disabled):not(.disabled):active { color: #FFA117 !important; box-shadow: 0 0 0 3px rgba(255, 161, 23, 0.25) !important; }

    .plans-list .col-action .btn-success:hover,
    .plans-list .col-action .btn-success:focus,
    .plans-list .col-action .btn-success:active,
    .plans-list .col-action .btn-success:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn-success:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn-success:not(:disabled):not(.disabled):active { color: #28C76F !important; box-shadow: 0 0 0 3px rgba(40, 199, 111, 0.25) !important; }

    .plans-list .col-action .btn-danger:hover,
    .plans-list .col-action .btn-danger:focus,
    .plans-list .col-action .btn-danger:active,
    .plans-list .col-action .btn-danger:not(:disabled):not(.disabled):hover,
    .plans-list .col-action .btn-danger:not(:disabled):not(.disabled):focus,
    .plans-list .col-action .btn-danger:not(:disabled):not(.disabled):active { color: #EA5455 !important; box-shadow: 0 0 0 3px rgba(234, 84, 85, 0.25) !important; }

    .plans-list thead th.text-center { min-width: 210px; }

    /* Mobile expand toggle (display is left to the template) */
    .plans-list .mobile-expand-btn,
    .plans-list .mobile-expand-btn:hover,
    .plans-list .mobile-expand-btn:focus,
    .plans-list .mobile-expand-btn:active {
        border: 1px solid #E3EAEF !important;
        border-radius: 8px;
        color: #353C48 !important;
        height: 44px;
        min-width: 44px;
        outline: 0;
    }
    .plans-list .mobile-expand-btn { background-color: #FFFFFF !important; }
    .plans-list .mobile-expand-btn:hover,
    .plans-list .mobile-expand-btn:focus,
    .plans-list .mobile-expand-btn:active { background-color: #F9F9F9 !important; }
    .plans-list .mobile-expand-btn i,
    .plans-list .mobile-expand-btn svg { color: inherit !important; stroke: currentColor; }

    /* ---------- Table ---------- */
    .plans-list .table { color: var(--c-deep); margin-bottom: 0; }
    .plans-list .table thead th {
        background-color: #F9F9F9 !important;
        border-bottom: 1px solid #E3EAEF !important;
        border-top: 0 !important;
        color: #96A2B4 !important;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .plans-list .table th,
    .plans-list .table td {
        padding-top: 14px !important;
        padding-bottom: 14px !important;
        vertical-align: middle;
    }
    .plans-list .table tbody td {
        background-color: transparent !important;
        border-top: 1px solid #E3EAEF !important;
        color: #353C48;
    }
    .plans-list .table tbody tr,
    .plans-list .table-striped tbody tr:nth-of-type(odd) { background-color: #FFFFFF !important; }
    .plans-list .table tbody tr:hover,
    .plans-list .table-striped tbody tr:nth-of-type(odd):hover { background-color: rgba(103, 119, 239, 0.06) !important; }
    .plans-list .table .text-dark { color: #353C48 !important; }
    .plans-list .table th:first-child, .plans-list .table td:first-child { padding-left: 24px !important; }
    .plans-list .table th:last-child,  .plans-list .table td:last-child  { padding-right: 24px !important; }

    /* ---------- DataTables controls ---------- */
    .plans-list .dataTables_wrapper > .row { margin: 0; }
    .plans-list .dataTables_wrapper > .row > [class*="col-"] { padding-left: 0; padding-right: 0; }
    .plans-list .dataTables_wrapper > .row:first-child,
    .plans-list .dataTables_wrapper > .row:last-child { padding: 16px 24px; }
    .plans-list .dataTables_wrapper label { color: #353C48; font-size: 14px; font-weight: 600; margin-bottom: 0; }
    .plans-list .dataTables_wrapper .form-control,
    .plans-list .dataTables_wrapper select,
    .plans-list .dataTables_wrapper input[type="search"] {
        background-color: #F2F2F2;
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        box-shadow: none;
        color: #353C48;
        min-height: 44px;
    }
    .plans-list .dataTables_wrapper .form-control:focus,
    .plans-list .dataTables_wrapper select:focus,
    .plans-list .dataTables_wrapper input[type="search"]:focus {
        background-color: #FFFFFF;
        border-color: #6777EF;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18);
        outline: 0;
    }
    .plans-list .dataTables_info { color: #353C48; font-size: 14px; }
    .plans-list .page-link {
        align-items: center;
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        border-radius: 8px;
        color: #353C48 !important;
        display: inline-flex;
        justify-content: center;
        margin: 0 2px;
        min-height: 44px;
        min-width: 44px;
    }
    .plans-list .page-link:hover,
    .plans-list .page-link:focus {
        background-color: #F9F9F9 !important;
        border-color: #E3EAEF !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18);
        color: #353C48 !important;
    }
    .plans-list .page-item.active .page-link,
    .plans-list .page-item.active .page-link:hover,
    .plans-list .page-item.active .page-link:focus {
        background-color: #6777EF !important;
        border-color: #6777EF !important;
        color: #FFFFFF !important;
    }
    .plans-list .page-item.disabled .page-link { background-color: #F9F9F9 !important; color: #96A2B4 !important; }

    /* ---------- Mobile ---------- */
    @@media (max-width: 767.98px) {
        .plans-list .card-header { padding: 16px; }
        .plans-list .card-header-action { width: 100%; }
        .plans-list .card-header-action .btn { flex: 1 1 100%; }
        .plans-list .table th:first-child, .plans-list .table td:first-child { padding-left: 16px !important; }
        .plans-list .table th:last-child,  .plans-list .table td:last-child  { padding-right: 16px !important; }
        .plans-list .dataTables_wrapper > .row:first-child,
        .plans-list .dataTables_wrapper > .row:last-child { padding: 12px 16px; }
    }
</style>

<div class="row plans-list">
    <div class="col-12">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 mr-3 font-weight-bold">Subscription Plans</h4>
                    <span class="badge badge-primary font-weight-700 mr-2">@Model.Count() Plans</span>
                    <span class="badge badge-success font-weight-700 mr-2">@Model.Count(p => p.IsActive) Active</span>
                    @if (activeSubs.Values.Sum() > 0)
                    {
                        <span class="badge badge-info font-weight-600">
                            <i class="fas fa-users mr-1"></i>@activeSubs.Values.Sum() Subscribers
                        </span>
                    }
                </div>
                <div class="card-header-action mt-2 mt-sm-0 d-flex align-items-center">
                    <a href="/admin/subscription/subscribers" class="btn btn-outline-info mr-2" title="View all owners bought subscriptions">
                        <i class="fas fa-users mr-1"></i> Owner Subscriptions
                    </a>
                    <a href="/admin/subscription/cancellation-requests" class="btn btn-outline-danger mr-2" title="Manage Owner Cancellation Requests">
                        <i class="fas fa-undo-alt mr-1"></i> Cancellation Requests
                    </a>
                    <a href="/admin/subscription/create" class="btn btn-primary">
                        <i class="fas fa-plus mr-1"></i> Create New Plan
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                        <thead>
                            <tr>
                                <th>Plan Name</th>
                                <th>Price</th>
                                <th>Max Stations</th>
                                <th>Managers / Station</th>
                                <th>Active Subscribers</th>
                                <th>Status</th>
                                <th class="text-center" data-orderable="false" style="width: 170px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in Model)
                            {
                                var activeCount = activeSubs.ContainsKey(plan.Id) ? activeSubs[plan.Id] : 0;
                                <tr>
                                    <td class="col-primary" data-label="Plan Name">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="font-weight-600 text-dark font-15">@plan.Name</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Price">
                                        <div>
                                            <span class="font-weight-600 text-dark font-15">₹@plan.PricePerMonth.ToString("N0")</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Max Stations">
                                        <div>
                                            <span class="font-weight-600 text-dark">@plan.MaxStations</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Managers / Station">
                                        <div>
                                            <span class="font-weight-600 text-dark">@plan.MaxManagersPerStation</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Active Subscribers">
                                        <div>
                                            @if (activeCount > 0)
                                            {
                                                <a href="/admin/subscription/subscribers?planId=@plan.Id" class="badge badge-info font-weight-600" title="Click to view subscribers">
                                                    @activeCount
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light text-dark font-weight-700">
                                                    0
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Status">
                                        <div>
                                            @if (plan.IsActive)
                                            {
                                                <span class="badge badge-success font-weight-600">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger font-weight-600">Inactive</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center col-action" data-label="Actions">
                                        <div class="d-flex justify-content-center align-items-center">
                                            <a href="/admin/subscription/plan-details/@plan.Id" class="btn btn-info mr-1" title="View Plan Details">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a href="/admin/subscription/edit/@plan.Id" class="btn btn-warning mr-1" title="Edit Plan">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="/admin/subscription/toggle-status" class="d-inline-block mr-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@plan.Id" />
                                                @if (plan.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-secondary" title="Deactivate Plan" onclick="return confirm('Deactivate this plan? New owners will not be able to purchase it.');">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-success" title="Activate Plan">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                }
                                            </form>
                                            <form method="post" action="/admin/subscription/delete/@plan.Id" class="d-inline-block">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger" title="Delete Plan" onclick="return confirm('Are you sure you want to permanently delete this plan?');">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
            if ($.fn.DataTable) {
                $('#table-1').on('draw.dt', function() {
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                });
            }
        });
    </script>
}