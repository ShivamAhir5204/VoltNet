@model IEnumerable<VoltNet.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Manage Subscription Plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var activeSubs = ViewBag.ActiveSubs as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
}

<div class="section-header">
    <h1>Subscription Plans</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/admin/Dashboard">Dashboard</a></div>
        <div class="breadcrumb-item">Subscription Plans</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>All Plans</h4>
                <a href="/admin/subscription/create" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Plan</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Price (Monthly)</th>
                                <th>Max Stations</th>
                                <th>Max Managers/Station</th>
                                <th>Active Subscribers</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in Model)
                            {
                                var activeCount = activeSubs.ContainsKey(plan.Id) ? activeSubs[plan.Id] : 0;
                                <tr>
                                    <td><strong>@plan.Name</strong></td>
                                    <td>₹@plan.PricePerMonth.ToString("N0")</td>
                                    <td>@plan.MaxStations</td>
                                    <td>@plan.MaxManagersPerStation</td>
                                    <td><span class="badge badge-info">@activeCount</span></td>
                                    <td>
                                        @if (plan.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex" style="gap: 5px;">
                                            <a href="/admin/subscription/edit/@plan.Id" class="btn btn-sm btn-outline-primary" title="Edit Plan"><i class="fas fa-edit"></i></a>
                                            
                                            <form method="post" action="/admin/subscription/toggle-status" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@plan.Id" />
                                                @if (plan.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Deactivate" onclick="return confirm('Deactivate this plan? No new owners can buy this.');"><i class="fas fa-pause"></i></button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate"><i class="fas fa-play"></i></button>
                                                }
                                            </form>

                                            <form method="post" action="/admin/subscription/delete/@plan.Id" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to permanently delete this plan?');"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No subscription plans found. Create one to get started.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
