@model VoltNet.Models.SubscriptionPlan
@{
    ViewData["Title"] = "Edit Subscription Plan";
    Layout = "_AdminLayout";
}

<meta name="viewport" content="width=device-width, initial-scale=1" />
<div class="row plan-edit">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Edit Subscription Plan</h4>
                <a href="/admin/subscription" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                </a>
            </div>
            <div class="card-body">
                <form method="post" action="/admin/subscription/edit/@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="form-group">
                        <label class="font-weight-600">Plan Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" value="@Model.Name" required />
                        <span class="text-danger">@Html.ValidationMessageFor(m => m.Name)</span>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-600">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Description" required rows="3">@Model.Description</textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" name="PricePerMonth" value="@Model.PricePerMonth" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Duration (Days) <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="DurationDays" value="@Model.DurationDays" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Max Stations Allowed <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="MaxStations" value="@Model.MaxStations" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Max Managers per Station <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="MaxManagersPerStation" value="@Model.MaxManagersPerStation" required />
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="custom-control-label" for="IsActive">Plan is active for purchase</label>
                        </div>
                    </div>

                    <div class="form-actions mt-4 pt-3 border-top d-flex align-items-center">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check mr-1"></i> Update Plan</button>
                        <a href="/admin/subscription" class="btn btn-outline-secondary ml-2"><i class="fas fa-times mr-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>