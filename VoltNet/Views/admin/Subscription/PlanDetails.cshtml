@model VoltNet.Models.SubscriptionPlan
@{
    ViewData["Title"] = $"{Model.Name} Plan Details";
    Layout = "_AdminLayout";
    var subscribers = ViewBag.Subscribers as List<VoltNet.Models.OwnerSubscription> ?? new List<VoltNet.Models.OwnerSubscription>();
    var activeCount = ViewBag.ActiveCount as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
}

<meta name="viewport" content="width=device-width, initial-scale=1" />

<style>
    .plan-detail {
        --c-primary: #6777EF;
        --c-deep: #353C48;
        --c-dark: #34395E;
        --c-muted: #96A2B4;
        --c-teal: #3DC9B3;
        --c-white: #FFFFFF;
        --c-soft: #F9F9F9;
        --c-light: #F2F2F2;
        --c-border: #E3EAEF;
        --c-success: #28C76F;
        --c-warning: #FFA117;
        --c-error: #EA5455;
        --c-info: #3ABAF4;
        color: var(--c-deep);
        font-size: 15px;
    }
    .plan-detail *,
    .plan-detail *::before,
    .plan-detail *::after { box-sizing: border-box; }

    /* ---------- Card ---------- */
    .plan-detail > .col-12 > .card {
        background-color: var(--c-white);
        border: 1px solid var(--c-border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(53, 60, 72, 0.06);
        overflow: hidden;
    }
    .plan-detail .card-header {
        background-color: var(--c-white);
        border-bottom: 1px solid var(--c-border);
        gap: 12px;
        min-height: 0;
        padding: 20px 24px;
    }
    .plan-detail .card-header h4 {
        color: var(--c-deep) !important;
        font-size: 20px !important;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        padding: 0;
    }
    .plan-detail .card-body { padding: 24px; }
    .plan-detail .card-footer {
        background-color: var(--c-white) !important;
        border-top: 1px solid var(--c-border) !important;
        gap: 12px;
        padding: 20px 24px;
    }

    /* ---------- Detail cards ---------- */
    .plan-detail .detail-card {
        background-color: var(--c-soft);
        border: 1px solid var(--c-border);
        border-radius: 12px;
        box-shadow: none;
        height: 100%;
        margin-bottom: 0;
        padding: 24px;
    }
    .plan-detail .detail-card-title {
        align-items: center;
        border-bottom: 1px solid var(--c-border);
        color: var(--c-deep) !important;
        display: flex;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0;
        margin-bottom: 18px;
        padding-bottom: 12px;
    }
    .plan-detail .detail-card-title.justify-content-between { gap: 12px; }
    .plan-detail .detail-card-title i { color: inherit; }
    .plan-detail .detail-row { display: flex; flex-direction: column; margin-bottom: 16px; }
    .plan-detail .detail-row:last-child { margin-bottom: 0; }
    .plan-detail .detail-label {
        color: var(--c-muted);
        display: inline-block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }
    .plan-detail .detail-value {
        color: var(--c-deep) !important;
        font-size: 15px;
        font-weight: 600;
        word-break: break-word;
    }
    .plan-detail .detail-value.font-22 { font-size: 22px; font-weight: 700; }
    .plan-detail .detail-value.font-18 { font-size: 18px; }
    .plan-detail .detail-value i { display: none; }

    /* Status text keeps its meaning through a dot */
    .plan-detail .detail-value.text-success,
    .plan-detail .detail-value.text-danger { align-items: center; display: inline-flex; gap: 8px; }
    .plan-detail .detail-value.text-success::before,
    .plan-detail .detail-value.text-danger::before {
        border-radius: 50%;
        content: "";
        height: 10px;
        width: 10px;
    }
    .plan-detail .detail-value.text-success::before { background-color: var(--c-success); }
    .plan-detail .detail-value.text-danger::before  { background-color: var(--c-error); }
    .plan-detail .detail-value.font-22.text-success::before { display: none; }

    .plan-detail .detail-card p { color: var(--c-deep) !important; font-size: 15px; line-height: 1.7; }
    .plan-detail .detail-card .border-top { border-top: 1px solid var(--c-border) !important; gap: 8px; }
    .plan-detail .detail-card .border-top > div { color: var(--c-muted) !important; font-size: 14px; font-weight: 600; }
    .plan-detail .detail-card .border-top .text-dark { color: var(--c-deep) !important; font-weight: 600; }

    /* ---------- Badges ---------- */
    .plan-detail .badge {
        align-items: center;
        border: 1px solid transparent;
        border-radius: 999px;
        color: var(--c-deep) !important;
        display: inline-flex;
        font-size: 13px;
        font-weight: 600;
        gap: 6px;
        letter-spacing: 0;
        padding: 6px 14px !important;
    }
    .plan-detail .badge-success { background-color: #E4F9ED !important; border-color: #28C76F; }
    .plan-detail .badge-danger  { background-color: #FCE6E6 !important; border-color: #EA5455; }
    .plan-detail .badge i { display: none; }
    .plan-detail .badge::before { border-radius: 50%; content: ""; height: 8px; width: 8px; }
    .plan-detail .badge-success::before { background-color: #28C76F; }
    .plan-detail .badge-danger::before  { background-color: #EA5455; }

    /* ---------- Buttons ---------- */
    .plan-detail .btn {
        align-items: center;
        border-radius: 8px;
        box-shadow: none;
        display: inline-flex;
        font-size: 14px;
        font-weight: 600;
        gap: 8px;
        justify-content: center;
        letter-spacing: 0;
        min-height: 44px;
        padding: 10px 20px;
        text-transform: none;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }
    .plan-detail .btn i,
    .plan-detail .btn .fas { color: inherit !important; margin: 0 !important; }

    /* Primary: View All Subscribers, Edit Plan */
    .plan-detail .btn-primary,
    .plan-detail .btn-primary:not(:disabled):not(.disabled),
    .plan-detail .btn-warning,
    .plan-detail .btn-warning:not(:disabled):not(.disabled) {
        background-color: #6777EF !important;
        border-color: #6777EF !important;
        color: #FFFFFF !important;
    }
    .plan-detail .btn-primary:hover,
    .plan-detail .btn-primary:focus,
    .plan-detail .btn-primary:active,
    .plan-detail .btn-primary:not(:disabled):not(.disabled):hover,
    .plan-detail .btn-primary:not(:disabled):not(.disabled):focus,
    .plan-detail .btn-primary:not(:disabled):not(.disabled):active,
    .plan-detail .btn-warning:hover,
    .plan-detail .btn-warning:focus,
    .plan-detail .btn-warning:active,
    .plan-detail .btn-warning:not(:disabled):not(.disabled):hover,
    .plan-detail .btn-warning:not(:disabled):not(.disabled):focus,
    .plan-detail .btn-warning:not(:disabled):not(.disabled):active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.25) !important;
    }

    /* Secondary: Back, Deactivate */
    .plan-detail .btn-outline-secondary,
    .plan-detail .btn-outline-secondary:not(:disabled):not(.disabled),
    .plan-detail .btn-secondary,
    .plan-detail .btn-secondary:not(:disabled):not(.disabled) {
        background-color: #FFFFFF !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
    }
    .plan-detail .btn-outline-secondary:hover,
    .plan-detail .btn-outline-secondary:focus,
    .plan-detail .btn-outline-secondary:active,
    .plan-detail .btn-outline-secondary:not(:disabled):not(.disabled):hover,
    .plan-detail .btn-outline-secondary:not(:disabled):not(.disabled):focus,
    .plan-detail .btn-outline-secondary:not(:disabled):not(.disabled):active,
    .plan-detail .btn-secondary:hover,
    .plan-detail .btn-secondary:focus,
    .plan-detail .btn-secondary:active,
    .plan-detail .btn-secondary:not(:disabled):not(.disabled):hover,
    .plan-detail .btn-secondary:not(:disabled):not(.disabled):focus,
    .plan-detail .btn-secondary:not(:disabled):not(.disabled):active {
        background-color: #F9F9F9 !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18) !important;
    }

    /* Positive action: Activate */
    .plan-detail .btn-success,
    .plan-detail .btn-success:not(:disabled):not(.disabled) {
        background-color: #28C76F !important;
        border-color: #28C76F !important;
        color: #353C48 !important;
    }
    .plan-detail .btn-success:hover,
    .plan-detail .btn-success:focus,
    .plan-detail .btn-success:active,
    .plan-detail .btn-success:not(:disabled):not(.disabled):hover,
    .plan-detail .btn-success:not(:disabled):not(.disabled):focus,
    .plan-detail .btn-success:not(:disabled):not(.disabled):active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
        box-shadow: 0 0 0 3px rgba(40, 199, 111, 0.25) !important;
    }

    .plan-detail .card-footer form.d-inline { display: inline-flex !important; }

    /* ---------- Desktop rows ---------- */
    @@media (min-width: 576px) {
        .plan-detail .detail-row-inline {
            align-items: center;
            border-bottom: 1px solid var(--c-border);
            flex-direction: row;
            justify-content: space-between;
            padding-bottom: 12px;
        }
        .plan-detail .detail-row-inline:last-child { border-bottom: none; padding-bottom: 0; }
        .plan-detail .detail-row-inline .detail-label { flex-shrink: 0; margin-bottom: 0; margin-right: 18px; }
        .plan-detail .detail-row-inline .detail-value { text-align: right; }
    }

    /* ---------- Mobile ---------- */
    @@media (max-width: 767.98px) {
        .plan-detail .card-header,
        .plan-detail .card-footer { padding: 16px; }
        .plan-detail .card-body { padding: 16px; }
        .plan-detail .detail-card { padding: 18px; }
        .plan-detail .card-header-action,
        .plan-detail .card-header-action .btn { width: 100%; }
        .plan-detail .card-footer > a.btn { width: 100%; }
        .plan-detail .card-footer > div { display: flex; flex-direction: column; gap: 12px; width: 100%; }
        .plan-detail .card-footer > div .btn,
        .plan-detail .card-footer > div form { width: 100%; margin: 0 !important; }
        .plan-detail .detail-card-title .btn { width: 100%; }
    }
</style>

<div class="row plan-detail">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 mr-3 font-weight-bold">@Model.Name Plan Details</h4>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-check-circle mr-1"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-danger font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-ban mr-1"></i> Inactive
                        </span>
                    }
                </div>
                <div class="card-header-action mt-2 mt-sm-0">
                    <a href="/admin/subscription" class="btn btn-outline-secondary font-weight-600">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Pricing & Duration Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary">
                                Pricing & Duration
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Monthly Price</span>
                                <span class="detail-value font-weight-bold text-dark font-22">
                                    ₹@Model.PricePerMonth.ToString("N0")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Duration</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @Model.DurationDays Days
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Billing Cycle</span>
                                <span class="detail-value font-weight-600 text-dark font-15">
                                    @(Model.DurationDays == 30 ? "Monthly Recurring" : $"{Model.DurationDays} Days Fixed")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Quota Limits Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-info">
                                Station Quotas
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Max Stations</span>
                                <span class="detail-value font-weight-bold text-dark font-18">
                                    @Model.MaxStations @(Model.MaxStations == 1 ? "Station" : "Stations")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Managers / Station</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @Model.MaxManagersPerStation Max
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Status</span>
                                <span class="detail-value font-weight-700 @(Model.IsActive ? "text-success" : "text-danger")">
                                    @(Model.IsActive ? "Available for Purchase" : "Disabled")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Performance & Subscribers Summary Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-success">
                                Performance
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Total Revenue</span>
                                <span class="detail-value font-weight-bold text-success font-22">
                                    ₹@totalRevenue.ToString("N0")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Active Subscribers</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @activeCount
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Total Purchases</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @subscribers.Count
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description & Quick Action Card -->
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary justify-content-between flex-wrap">
                                <span>Description</span>
                                @if (subscribers.Any())
                                {
                                    <a href="/admin/subscription/subscribers?planId=@Model.Id" class="btn btn-primary font-weight-600 btn-sm mt-2 mt-sm-0">
                                        <i class="fas fa-users mr-1"></i> View All @subscribers.Count Subscribers
                                    </a>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="text-dark font-15 font-weight-500 mb-3">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-dark font-14 mb-3">No description</p>
                            }

                            <div class="pt-3 border-top d-flex align-items-center justify-content-between flex-wrap">
                                <div class="font-14 font-weight-600">
                                    Plan ID: <span class="text-monospace text-dark font-weight-700">@Model.Id</span>
                                </div>
                                <div class="font-14 font-weight-600">
                                    Created on: <span class="text-dark font-weight-700">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center flex-wrap">
                <a href="/admin/subscription" class="btn btn-outline-secondary font-weight-600">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                </a>
                <div class="mt-2 mt-sm-0">
                    <a href="/admin/subscription/edit/@Model.Id" class="btn btn-warning mr-2 font-weight-600">
                        <i class="fas fa-edit mr-1"></i> Edit Plan
                    </a>
                    <form method="post" action="/admin/subscription/toggle-status" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn btn-secondary font-weight-600" onclick="return confirm('Deactivate this plan?');">
                                <i class="fas fa-pause mr-1"></i> Deactivate Plan
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success font-weight-600">
                                <i class="fas fa-play mr-1"></i> Activate Plan
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>