@model VoltNet.Models.SubscriptionPlan
@{
    ViewData["Title"] = $"{Model.Name} Plan Details";
    Layout = "_AdminLayout";
    var subscribers = ViewBag.Subscribers as List<VoltNet.Models.OwnerSubscription> ?? new List<VoltNet.Models.OwnerSubscription>();
    var activeCount = ViewBag.ActiveCount as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
}

<meta name="viewport" content="width=device-width, initial-scale=1" />
<div class="row plan-detail">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 mr-3 font-weight-bold">@Model.Name Plan Details</h4>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-check-circle mr-1"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-danger font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-ban mr-1"></i> Inactive
                        </span>
                    }
                </div>
                <div class="card-header-action mt-2 mt-sm-0">
                    <a href="/admin/subscription" class="btn btn-outline-secondary font-weight-600">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Pricing & Duration Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary">
                                Pricing & Duration
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Monthly Price</span>
                                <span class="detail-value font-weight-bold text-dark font-22">
                                    ₹@Model.PricePerMonth.ToString("N0")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Duration</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @Model.DurationDays Days
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Billing Cycle</span>
                                <span class="detail-value font-weight-600 text-dark font-15">
                                    @(Model.DurationDays == 30 ? "Monthly Recurring" : $"{Model.DurationDays} Days Fixed")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Quota Limits Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-info">
                                Station Quotas
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Max Stations</span>
                                <span class="detail-value font-weight-bold text-dark font-18">
                                    @Model.MaxStations @(Model.MaxStations == 1 ? "Station" : "Stations")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Managers / Station</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @Model.MaxManagersPerStation Max
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Status</span>
                                <span class="detail-value font-weight-700 @(Model.IsActive ? "text-success" : "text-danger")">
                                    @(Model.IsActive ? "Available for Purchase" : "Disabled")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Performance & Subscribers Summary Card -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-success">
                                Performance
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Total Revenue</span>
                                <span class="detail-value font-weight-bold text-success font-22">
                                    ₹@totalRevenue.ToString("N0")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Active Subscribers</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @activeCount
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Total Purchases</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @subscribers.Count
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description & Quick Action Card -->
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary justify-content-between flex-wrap">
                                <span>Description</span>
                                @if (subscribers.Any())
                                {
                                    <a href="/admin/subscription/subscribers?planId=@Model.Id" class="btn btn-primary font-weight-600 btn-sm mt-2 mt-sm-0">
                                        <i class="fas fa-users mr-1"></i> View All @subscribers.Count Subscribers
                                    </a>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="text-dark font-15 font-weight-500 mb-3">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-dark font-14 mb-3">No description</p>
                            }

                            <div class="pt-3 border-top d-flex align-items-center justify-content-between flex-wrap">
                                <div class="font-14 font-weight-600">
                                    Plan ID: <span class="text-monospace text-dark font-weight-700">@Model.Id</span>
                                </div>
                                <div class="font-14 font-weight-600">
                                    Created on: <span class="text-dark font-weight-700">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center flex-wrap">
                <a href="/admin/subscription" class="btn btn-outline-secondary font-weight-600">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                </a>
                <div class="mt-2 mt-sm-0">
                    <a href="/admin/subscription/edit/@Model.Id" class="btn btn-warning mr-2 font-weight-600">
                        <i class="fas fa-edit mr-1"></i> Edit Plan
                    </a>
                    <form method="post" action="/admin/subscription/toggle-status" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn btn-secondary font-weight-600" onclick="return confirm('Deactivate this plan?');">
                                <i class="fas fa-pause mr-1"></i> Deactivate Plan
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success font-weight-600">
                                <i class="fas fa-play mr-1"></i> Activate Plan
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>