@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Cancellation Request Details";
    Layout = "_AdminLayout";
    var isPending = Model.Status == "CancellationPending";
    var isCancelled = Model.Status == "Cancelled";
    var hoursSincePurchase = Math.Floor((Model.CancellationRequestedAt.HasValue ? Model.CancellationRequestedAt.Value - Model.CreatedAt : DateTime.UtcNow - Model.CreatedAt).TotalHours);
}

<style>
    .cr-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --success: #28C76F;
        --warning: #FFA117;
        --error: #EA5455;
        --info: #3ABAF4;
        color: var(--text);
        font-size: 15px;
    }

    .cr-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }
    .cr-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
        gap: 12px;
        flex-wrap: wrap;
    }
    .cr-page .card-header h4 { margin: 0; font-size: 20px; font-weight: 600; color: var(--text); }
    .cr-page .card-body { padding: 24px; }
    .cr-page .card-footer {
        background: var(--white);
        border-top: 1px solid var(--border);
        border-radius: 0 0 12px 12px;
        padding: 18px 24px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    /* Section cards */
    .cr-page .detail-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }
    .cr-page .detail-card.accent-error   { border-top: 3px solid var(--error); }
    .cr-page .detail-card.accent-success { border-top: 3px solid var(--success); }
    .cr-page .detail-card-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
    }
    .cr-page .detail-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 14px;
    }
    .cr-page .detail-row:last-child { margin-bottom: 0; }
    .cr-page .detail-label { font-size: 13px; font-weight: 500; color: var(--muted); margin-bottom: 2px; }
    .cr-page .detail-value { font-size: 15px; font-weight: 600; color: var(--text); word-break: break-word; }
    .cr-page .detail-value.money { color: #1B8F50; font-size: 20px; }
    .cr-page .detail-box {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 14px;
        color: var(--text);
        font-size: 15px;
        line-height: 1.6;
    }
    .cr-page .note { color: var(--muted); font-size: 13px; margin-top: 2px; }

    /* Pills */
    .cr-page .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .cr-page .status-pending  { background: rgba(255, 161, 23, .14); color: #B86F00; }
    .cr-page .status-cancel   { background: rgba(234, 84, 85, .12);  color: var(--error); }
    .cr-page .status-active   { background: rgba(40, 199, 111, .12); color: #1B8F50; }
    .cr-page .status-plan     { background: rgba(103, 119, 239, .12); color: var(--primary); }

    /* Form fields */
    .cr-page .form-label { color: var(--text); font-size: 14px; font-weight: 500; margin-bottom: 6px; }
    .cr-page .form-control {
        background: var(--field);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        padding: 10px 14px;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .cr-page .form-control:hover { border-color: var(--muted); }
    .cr-page .form-control:focus {
        background: var(--white);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
        outline: 0;
    }

    /* Buttons */
    .cr-page .btn-approve,
    .cr-page .btn-reject,
    .cr-page .btn-back,
    .cr-page .btn-view {
        min-height: 44px;
        padding: 0 22px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .cr-page .btn-approve {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .cr-page .btn-approve:hover,
    .cr-page .btn-approve:focus,
    .cr-page .btn-approve:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }
    .cr-page .btn-reject {
        background-color: #FFFFFF !important;
        border: 1px solid #EA5455 !important;
        color: #EA5455 !important;
    }
    .cr-page .btn-reject:hover,
    .cr-page .btn-reject:focus,
    .cr-page .btn-reject:active {
        background-color: #EA5455 !important;
        border-color: #EA5455 !important;
        color: #FFFFFF !important;
    }
    .cr-page .btn-back,
    .cr-page .btn-view {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .cr-page .btn-back:hover,
    .cr-page .btn-back:focus,
    .cr-page .btn-back:active,
    .cr-page .btn-view:hover,
    .cr-page .btn-view:focus,
    .cr-page .btn-view:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }
    .cr-page .btn-approve i,
    .cr-page .btn-reject i,
    .cr-page .btn-back i,
    .cr-page .btn-view i { color: inherit !important; }
    .cr-page .btn-approve:focus,
    .cr-page .btn-reject:focus,
    .cr-page .btn-back:focus,
    .cr-page .btn-view:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    @@media (min-width: 576px) {
        .cr-page .detail-row-inline {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px dashed var(--border);
            padding-bottom: 12px;
        }
        .cr-page .detail-row-inline:last-child { border-bottom: none; padding-bottom: 0; }
        .cr-page .detail-row-inline .detail-label { margin-bottom: 0; margin-right: 18px; flex-shrink: 0; }
        .cr-page .detail-row-inline .detail-value { text-align: right; }
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .cr-page .card-header { padding: 16px; }
        .cr-page .card-body { padding: 16px; }
        .cr-page .card-footer { padding: 16px; flex-direction: column-reverse; }
        .cr-page .btn-approve,
        .cr-page .btn-reject,
        .cr-page .btn-back,
        .cr-page .btn-view { width: 100%; }
    }
</style>

<div class="cr-page">
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap" style="gap: 12px;">
                    <h4 class="mb-0">Cancellation Request</h4>
                    @if (isPending)
                    {
                        <span class="status status-pending">Pending Review</span>
                    }
                    else if (isCancelled)
                    {
                        <span class="status status-cancel">Cancelled</span>
                    }
                    else
                    {
                        <span class="status status-active">Active (Rejected)</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Owner Details -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title">Owner</div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Name</span>
                                <span class="detail-value">@(Model.Owner?.FullName ?? Model.Owner?.User?.Fullname ?? "N/A")</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Business</span>
                                <span class="detail-value">@(Model.Owner?.BusinessName ?? "Individual Owner")</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Email</span>
                                <span class="detail-value">@(Model.Owner?.User?.Email ?? "N/A")</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Phone</span>
                                <span class="detail-value">@(Model.Owner?.Phone ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Subscription Info -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title">Subscription</div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Plan</span>
                                <span class="detail-value"><span class="status status-plan">@(Model.Plan?.Name ?? "Plan")</span></span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Amount Paid</span>
                                <span class="detail-value money">₹@Model.AmountPaid.ToString("N2")</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Payment ID</span>
                                <span class="detail-value text-monospace">@Model.PaymentId</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Purchased On</span>
                                <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Stations</span>
                                <span class="detail-value">@Model.Stations.Count</span>
                            </div>
                        </div>
                    </div>

                    <!-- Cancellation Request Info -->
                    <div class="col-12 mb-4">
                        <div class="detail-card accent-error">
                            <div class="detail-card-title">Request</div>
                            <div class="row">
                                <div class="col-12 col-md-4 mb-3">
                                    <span class="detail-label">Requested On</span>
                                    <div class="detail-value">
                                        @(Model.CancellationRequestedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? Model.CreatedAt.ToString("dd MMM yyyy"))
                                    </div>
                                    <div class="note">@hoursSincePurchase hours after purchase</div>
                                </div>
                                <div class="col-12 col-md-8 mb-3">
                                    <span class="detail-label">Reason</span>
                                    <div class="detail-box">
                                        @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason specified" : Model.CancellationReason)
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks) || Model.RefundAmount.HasValue || Model.CancellationProcessedAt.HasValue)
                            {
                                <div class="row" style="border-top: 1px solid #E3EAEF; padding-top: 16px; margin-top: 8px;">
                                    @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks))
                                    {
                                        <div class="col-12 col-md-6 mb-2">
                                            <span class="detail-label">Admin Remarks</span>
                                            <div class="detail-box">@Model.CancellationAdminRemarks</div>
                                        </div>
                                    }
                                    @if (Model.RefundAmount.HasValue)
                                    {
                                        <div class="col-12 col-md-3 mb-2">
                                            <span class="detail-label">Refund</span>
                                            <div class="detail-value money">₹@Model.RefundAmount.Value.ToString("N2")</div>
                                        </div>
                                    }
                                    @if (Model.CancellationProcessedAt.HasValue)
                                    {
                                        <div class="col-12 col-md-3 mb-2">
                                            <span class="detail-label">Processed On</span>
                                            <div class="detail-value">@Model.CancellationProcessedAt.Value.ToString("dd MMM yyyy, hh:mm tt") UTC</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Actions (if pending review) -->
                    @if (isPending)
                    {
                        <div class="col-12 col-lg-6 mb-4">
                            <div class="detail-card accent-success">
                                <div class="detail-card-title">Approve & Refund</div>
                                <form method="post" action="/admin/subscription/approve-cancellation/@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group mb-3">
                                        <label class="form-label">Remarks (Optional)</label>
                                        <textarea name="adminRemarks" class="form-control" rows="2"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-approve btn-block" onclick="return confirm('Confirm approval of this cancellation request?');">
                                        <i class="fas fa-check"></i> Approve & Refund
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 mb-4">
                            <div class="detail-card accent-error">
                                <div class="detail-card-title">Reject</div>
                                <form method="post" action="/admin/subscription/reject-cancellation/@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group mb-3">
                                        <label class="form-label">Remarks *</label>
                                        <textarea name="adminRemarks" class="form-control" rows="2" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-reject btn-block" onclick="return confirm('Confirm rejection of this cancellation request?');">
                                        <i class="fas fa-ban"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer">
                <a href="/admin/subscription/cancellation-requests" class="btn btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Requests
                </a>
                <a href="/admin/subscription/subscription-details/@Model.Id" class="btn btn-view">
                    <i class="fas fa-receipt"></i> Subscription Record
                </a>
            </div>
        </div>
    </div>
</div>
</div>