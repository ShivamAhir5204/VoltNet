@model VoltNet.Models.SubscriptionPlan
@{
    ViewData["Title"] = "Create Subscription Plan";
    Layout = "_AdminLayout";
}

<meta name="viewport" content="width=device-width, initial-scale=1" />

<style>
    .plan-create {
        --c-primary: #6777EF;
        --c-deep: #353C48;
        --c-dark: #34395E;
        --c-muted: #96A2B4;
        --c-teal: #3DC9B3;
        --c-white: #FFFFFF;
        --c-soft: #F9F9F9;
        --c-light: #F2F2F2;
        --c-border: #E3EAEF;
        --c-error: #EA5455;
        color: var(--c-deep);
        font-size: 15px;
    }

    .plan-create *,
    .plan-create *::before,
    .plan-create *::after { box-sizing: border-box; }

    /* Card */
    .plan-create .card {
        background-color: var(--c-white);
        border: 1px solid var(--c-border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(53, 60, 72, 0.06);
        overflow: hidden;
    }
    .plan-create .card-header {
        background-color: var(--c-white);
        border-bottom: 1px solid var(--c-border);
        padding: 20px 24px;
        min-height: 0;
        gap: 12px;
        flex-wrap: wrap;
    }
    .plan-create .card-header h4 {
        color: var(--c-deep);
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        padding: 0;
    }
    .plan-create .card-body { padding: 24px; }

    /* Labels */
    .plan-create .form-group { margin-bottom: 20px; }
    .plan-create label,
    .plan-create .form-group label {
        color: var(--c-deep);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 8px;
    }
    .plan-create .text-danger { color: var(--c-error) !important; }

    /* Inputs */
    .plan-create .form-control {
        background-color: var(--c-light);
        border: 1px solid var(--c-border);
        border-radius: 8px;
        color: var(--c-deep);
        font-size: 15px;
        min-height: 44px;
        height: auto;
        padding: 10px 14px;
        box-shadow: none;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
    }
    .plan-create textarea.form-control { min-height: 110px; resize: vertical; }
    .plan-create .form-control:hover { border-color: var(--c-muted); }
    .plan-create .form-control:focus {
        background-color: var(--c-white);
        border-color: var(--c-primary);
        color: var(--c-deep);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18);
        outline: 0;
    }
    .plan-create .form-control:invalid:focus { border-color: var(--c-primary); }
    .plan-create .field-validation-error,
    .plan-create .text-danger.field-validation-error {
        display: block;
        font-size: 13px;
        margin-top: 6px;
    }
    .plan-create .form-group > span.text-danger:empty,
    .plan-create .field-validation-valid { display: none; }

    /* Checkbox */
    .plan-create .custom-control { min-height: 44px; display: flex; align-items: center; padding-left: 1.9rem; }
    .plan-create .custom-control-label { cursor: pointer; margin-bottom: 0; font-weight: 500; }
    .plan-create .custom-control-label::before {
        background-color: var(--c-white);
        border: 1px solid var(--c-muted);
        border-radius: 5px;
        width: 20px;
        height: 20px;
        top: 50%;
        left: -1.9rem;
        transform: translateY(-50%);
    }
    .plan-create .custom-control-label::after {
        width: 20px;
        height: 20px;
        top: 50%;
        left: -1.9rem;
        transform: translateY(-50%);
    }
    .plan-create .custom-control-input:checked ~ .custom-control-label::before {
        background-color: var(--c-primary);
        border-color: var(--c-primary);
    }
    .plan-create .custom-control-input:focus ~ .custom-control-label::before {
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18);
        border-color: var(--c-primary);
    }

    /* Actions */
    .plan-create .form-actions {
        border-top: 1px solid var(--c-border);
        margin-top: 24px;
        padding-top: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .plan-create .form-actions .btn.ml-2 { margin-left: 0 !important; }

    /* Buttons */
    .plan-create .btn {
        align-items: center;
        border-radius: 8px;
        display: inline-flex;
        font-size: 14px;
        font-weight: 600;
        gap: 8px;
        justify-content: center;
        letter-spacing: 0;
        min-height: 44px;
        padding: 10px 20px;
        text-transform: none;
        box-shadow: none;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    }
    .plan-create .btn i,
    .plan-create .btn .fas { color: inherit !important; margin: 0 !important; }

    .plan-create .btn-primary,
    .plan-create .btn-primary:not(:disabled):not(.disabled) {
        background-color: #6777EF !important;
        border-color: #6777EF !important;
        color: #FFFFFF !important;
    }
    .plan-create .btn-primary:hover,
    .plan-create .btn-primary:focus,
    .plan-create .btn-primary:active,
    .plan-create .btn-primary:not(:disabled):not(.disabled):hover,
    .plan-create .btn-primary:not(:disabled):not(.disabled):focus,
    .plan-create .btn-primary:not(:disabled):not(.disabled):active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.25) !important;
    }

    .plan-create .btn-outline-secondary,
    .plan-create .btn-outline-secondary:not(:disabled):not(.disabled) {
        background-color: #FFFFFF !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
    }
    .plan-create .btn-outline-secondary:hover,
    .plan-create .btn-outline-secondary:focus,
    .plan-create .btn-outline-secondary:active,
    .plan-create .btn-outline-secondary:not(:disabled):not(.disabled):hover,
    .plan-create .btn-outline-secondary:not(:disabled):not(.disabled):focus,
    .plan-create .btn-outline-secondary:not(:disabled):not(.disabled):active {
        background-color: #F9F9F9 !important;
        border-color: #E3EAEF !important;
        color: #353C48 !important;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, 0.18) !important;
    }

    /* Mobile */
    @@media (max-width: 575.98px) {
        .plan-create .card-header,
        .plan-create .card-body { padding: 16px; }
        .plan-create .card-header .btn { width: 100%; }
        .plan-create .form-actions { flex-direction: column-reverse; align-items: stretch; }
        .plan-create .form-actions .btn { width: 100%; }
    }
</style>

<div class="row plan-create">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Create Subscription Plan</h4>
                <a href="/admin/subscription" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                </a>
            </div>
            <div class="card-body">
                <form method="post" action="/admin/subscription/create">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="font-weight-600">Plan Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" value="@Model?.Name" required />
                        <span class="text-danger">@Html.ValidationMessageFor(m => m.Name)</span>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-600">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Description" required rows="3">@Model?.Description</textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" name="PricePerMonth" value="@(Model?.PricePerMonth ?? 0)" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Duration (Days) <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="DurationDays" value="@(Model?.DurationDays ?? 30)" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Max Stations Allowed <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="MaxStations" value="@(Model?.MaxStations ?? 1)" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="font-weight-600">Max Managers per Station <span class="text-danger">*</span></label>
                            <input type="number" min="1" class="form-control" name="MaxManagersPerStation" value="@(Model?.MaxManagersPerStation ?? 1)" required />
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive" value="true" @(Model == null || Model.IsActive ? "checked" : "")>
                            <label class="custom-control-label" for="IsActive">Plan is immediately active for purchase</label>
                        </div>
                    </div>

                    <div class="form-actions mt-4 pt-3 border-top d-flex align-items-center">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check mr-1"></i> Create Plan</button>
                        <a href="/admin/subscription" class="btn btn-outline-secondary ml-2"><i class="fas fa-times mr-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>