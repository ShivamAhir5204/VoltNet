@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscription Cancellation Requests";
    Layout = "_AdminLayout";
    var pendingCount = Model.Count(r => r.Status == "CancellationPending");
}

<div class="cq-page">
<div class="row">
    <div class="col-12">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    @TempData["Error"]
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap" style="gap: 10px;">
                    <h4 class="mb-0">Cancellation Requests</h4>
                    <span class="status status-pending">@pendingCount Pending</span>
                </div>
                <div class="header-actions">
                    <a href="/admin/subscription/subscribers" class="btn btn-ghost">
                        <i class="fas fa-users"></i> Owner Subscriptions
                    </a>
                    <a href="/admin/subscription" class="btn btn-back">
                        <i class="fas fa-arrow-left"></i> Back to Plans
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                        <thead>
                            <tr>
                                <th>Owner</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Requested</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-center" data-orderable="false">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model)
                            {
                                var isPending = req.Status == "CancellationPending";
                                var isCancelled = req.Status == "Cancelled";
                                var hoursSincePurchase = Math.Floor((req.CancellationRequestedAt.HasValue ? req.CancellationRequestedAt.Value - req.CreatedAt : DateTime.UtcNow - req.CreatedAt).TotalHours);
                                
                                <tr>
                                    <td class="col-primary" data-label="Owner">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="cell-strong">@(req.Owner?.FullName ?? req.Owner?.User?.Fullname ?? "N/A")</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Plan Details">
                                        <div>
                                            <span class="status status-plan">@(req.Plan?.Name ?? "Plan")</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Amount & Payment">
                                        <div>
                                            <span class="cell-money">₹@req.AmountPaid.ToString("N2")</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Requested At">
                                        <div>
                                            @(req.CancellationRequestedAt?.ToString("dd MMM yyyy") ?? req.CreatedAt.ToString("dd MMM yyyy"))
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Reason" style="max-width: 250px;">
                                        <div>
                                            <span title="@req.CancellationReason">
                                                @(string.IsNullOrWhiteSpace(req.CancellationReason) ? "No reason specified" : (req.CancellationReason.Length > 35 ? req.CancellationReason.Substring(0, 32) + "..." : req.CancellationReason))
                                            </span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Status">
                                        <div>
                                            @if (isPending)
                                            {
                                                <span class="status status-pending">Pending</span>
                                            }
                                            else if (isCancelled)
                                            {
                                                <span class="status status-cancel">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="status status-active">Rejected</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center col-action" data-label="Actions">
                                        <div class="d-flex justify-content-center align-items-center flex-wrap" style="gap: 8px;">
                                            <a href="/admin/subscription/cancellation-details/@req.Id" class="icon-btn icon-btn-info" title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            @if (isPending)
                                            {
                                                <button type="button" class="icon-btn icon-btn-approve" title="Approve" onclick="openApproveModal('@req.Id', '@req.Plan?.Name', '@req.Owner?.FullName', @req.AmountPaid)">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="icon-btn icon-btn-reject" title="Reject" onclick="openRejectModal('@req.Id', '@req.Plan?.Name', '@req.Owner?.FullName')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="cell-empty">No cancellation requests.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!-- ─── Approve Cancellation Modal ─── -->
<div class="modal fade cq-modal" id="approveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="approveForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Approve & Refund</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="impact">
                        Stations go offline and the owner is refunded <strong id="modalApproveAmount"></strong>.
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Remarks (Optional)</label>
                        <textarea name="adminRemarks" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-approve"><i class="fas fa-check"></i> Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ─── Reject Cancellation Modal ─── -->
<div class="modal fade cq-modal" id="rejectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="rejectForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Reject Request</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p><strong id="modalRejectPlan"></strong> by <strong id="modalRejectOwner"></strong></p>
                    <div class="form-group mb-0">
                        <label class="form-label">Remarks *</label>
                        <textarea name="adminRemarks" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-reject"><i class="fas fa-ban"></i> Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Move modals to body to prevent stacking context/dull backdrop lock issue
            $('#approveModal').appendTo("body");
            $('#rejectModal').appendTo("body");

            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            if ($.fn.DataTable) {
                $('#table-1').on('draw.dt', function() {
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                });
            }
        });

        function openApproveModal(id, planName, ownerName, amount) {
            $('#approveForm').attr('action', '/admin/subscription/approve-cancellation/' + id);
            $('#modalApproveAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#approveModal').modal('show');
        }

        function openRejectModal(id, planName, ownerName) {
            $('#rejectForm').attr('action', '/admin/subscription/reject-cancellation/' + id);
            $('#modalRejectPlan').text(planName);
            $('#modalRejectOwner').text(ownerName);
            $('#rejectModal').modal('show');
        }
    </script>
}