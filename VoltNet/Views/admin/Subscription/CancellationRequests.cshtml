@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscription Cancellation Requests";
    Layout = "_AdminLayout";
    var pendingCount = Model.Count(r => r.Status == "CancellationPending");
}

<style>
    /* Modal Stacking & Backdrop Fix for Admin Theme */
    .modal {
        z-index: 1050 !important;
    }
    .modal-backdrop {
        z-index: 1040 !important;
    }
    .modal-dialog {
        z-index: 1051 !important;
    }
</style>

<div class="row">
    <div class="col-12">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible show fade">
                <div class="alert-body">
                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 mr-3">Cancellation Requests</h4>
                    <span class="badge badge-warning font-weight-600 mr-2">@pendingCount Pending</span>
                    <span class="badge badge-secondary font-weight-600 mr-2">@Model.Count(r => r.Status == "Cancelled") Approved</span>
                    <span class="badge badge-light font-weight-600">@Model.Count() Total</span>
                </div>
                <div class="card-header-action mt-2 mt-sm-0 d-flex align-items-center">
                    <a href="/admin/subscription/subscribers" class="btn btn-outline-info btn-sm mr-2" title="View all owner subscriptions">
                        <i class="fas fa-users mr-1"></i> Owner Subscriptions
                    </a>
                    <a href="/admin/subscription" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Plans
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                        <thead>
                            <tr>
                                <th>Owner / Business</th>
                                <th>Plan Details</th>
                                <th>Amount & Payment</th>
                                <th>Requested At</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-center" data-orderable="false" style="width: 170px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model)
                            {
                                var isPending = req.Status == "CancellationPending";
                                var isCancelled = req.Status == "Cancelled";
                                var hoursSincePurchase = Math.Floor((req.CancellationRequestedAt.HasValue ? req.CancellationRequestedAt.Value - req.CreatedAt : DateTime.UtcNow - req.CreatedAt).TotalHours);
                                
                                <tr>
                                    <td class="col-primary" data-label="Owner">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="font-weight-600 text-dark font-15">@(req.Owner?.FullName ?? req.Owner?.User?.Fullname ?? "N/A")</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Plan Details">
                                        <div>
                                            <span class="badge badge-light text-dark font-weight-600">@(req.Plan?.Name ?? "Plan")</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Amount & Payment">
                                        <div>
                                            <span class="font-weight-bold text-success font-15">₹@req.AmountPaid.ToString("N2")</span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Requested At">
                                        <div>
                                            <span class="text-dark font-weight-600">
                                                @(req.CancellationRequestedAt?.ToString("dd MMM yyyy") ?? req.CreatedAt.ToString("dd MMM yyyy"))
                                            </span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Reason" style="max-width: 250px;">
                                        <div>
                                            <span class="text-dark" title="@req.CancellationReason">
                                                @(string.IsNullOrWhiteSpace(req.CancellationReason) ? "No reason specified" : (req.CancellationReason.Length > 35 ? req.CancellationReason.Substring(0, 32) + "..." : req.CancellationReason))
                                            </span>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Status">
                                        <div>
                                            @if (isPending)
                                            {
                                                <span class="badge badge-warning font-weight-600">
                                                    <i class="fas fa-clock mr-1"></i> Pending Review
                                                </span>
                                            }
                                            else if (isCancelled)
                                            {
                                                <span class="badge badge-danger font-weight-600">
                                                    <i class="fas fa-check-circle mr-1"></i> Approved & Cancelled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success font-weight-600">
                                                    <i class="fas fa-shield-alt mr-1"></i> Active (Rejected)
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center col-action" data-label="Actions">
                                        <div class="d-flex justify-content-center align-items-center flex-wrap">
                                            <a href="/admin/subscription/cancellation-details/@req.Id" class="btn btn-info btn-sm mr-1 mb-1" title="View Full Details">
                                                <i class="fas fa-info-circle mr-1"></i> Details
                                            </a>
                                            @if (isPending)
                                            {
                                                <button type="button" class="btn btn-success btn-sm mr-1 mb-1" title="Approve Cancellation & Refund" onclick="openApproveModal('@req.Id', '@req.Plan?.Name', '@req.Owner?.FullName', @req.AmountPaid)">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-danger btn-sm mb-1" title="Reject Cancellation" onclick="openRejectModal('@req.Id', '@req.Plan?.Name', '@req.Owner?.FullName')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fas fa-inbox fa-3x mb-3 text-secondary d-block"></i>
                                        <h5>No Cancellation Requests</h5>
                                        <p class="mb-0">There are currently no pending or processed subscription cancellation requests.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Approve Cancellation Modal ─── -->
<div class="modal fade" id="approveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="approveForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title text-white"><i class="fas fa-check-circle mr-2"></i>Approve Cancellation & Issue Refund</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to approve this subscription cancellation?</p>
                    <div class="alert alert-warning">
                        <strong>Impact:</strong>
                        <ul class="mb-0 pl-3">
                            <li>All assigned stations will be taken offline immediately.</li>
                            <li>The owner will receive a full refund of <strong id="modalApproveAmount"></strong>.</li>
                            <li>An official confirmation email will be dispatched to the owner.</li>
                        </ul>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Admin Remarks / Notes to Owner</label>
                        <textarea name="adminRemarks" class="form-control" rows="3" placeholder="e.g., Cancellation approved as request was placed within the 24h window. Refund processed."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check mr-1"></i>Confirm & Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ─── Reject Cancellation Modal ─── -->
<div class="modal fade" id="rejectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="rejectForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title text-white"><i class="fas fa-times-circle mr-2"></i>Reject Cancellation Request</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p>You are rejecting the cancellation request for <strong id="modalRejectPlan"></strong> by <strong id="modalRejectOwner"></strong>.</p>
                    <div class="form-group">
                        <label class="font-weight-bold text-danger">Reason for Rejection (Mandatory) *</label>
                        <textarea name="adminRemarks" class="form-control" rows="3" required placeholder="e.g., Request rejected because station was actively utilized or reason does not meet policy criteria."></textarea>
                    </div>
                    <p class="text-muted small">An email explaining the rejection decision will be dispatched to the owner.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Back</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-ban mr-1"></i>Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Move modals to body to prevent stacking context/dull backdrop lock issue
            $('#approveModal').appendTo("body");
            $('#rejectModal').appendTo("body");

            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            if ($.fn.DataTable) {
                $('#table-1').on('draw.dt', function() {
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                });
            }
        });

        function openApproveModal(id, planName, ownerName, amount) {
            $('#approveForm').attr('action', '/admin/subscription/approve-cancellation/' + id);
            $('#modalApproveAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#approveModal').modal('show');
        }

        function openRejectModal(id, planName, ownerName) {
            $('#rejectForm').attr('action', '/admin/subscription/reject-cancellation/' + id);
            $('#modalRejectPlan').text(planName);
            $('#modalRejectOwner').text(ownerName);
            $('#rejectModal').modal('show');
        }
    </script>
}
