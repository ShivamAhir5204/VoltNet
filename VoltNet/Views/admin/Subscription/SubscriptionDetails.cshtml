@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "_AdminLayout";
    var isNowExpired = Model.EndDate < DateTime.UtcNow && Model.Status != "Cancelled";
    var isPending = Model.Status == "CancellationPending";
    var isCancelled = Model.Status == "Cancelled";
    var isActive = Model.Status == "Active" && !isNowExpired;
}

<meta name="viewport" content="width=device-width, initial-scale=1" />
<div class="row sub-detail">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 mr-3 font-weight-bold">Subscription Details</h4>
                    @if (isActive)
                    {
                        <span class="badge badge-success font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-check-circle mr-1"></i> Active
                        </span>
                    }
                    else if (isPending)
                    {
                        <span class="badge badge-warning font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-clock mr-1"></i> Cancellation Pending
                        </span>
                    }
                    else if (isCancelled)
                    {
                        <span class="badge badge-danger font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-ban mr-1"></i> Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-secondary font-weight-700 font-14 px-3 py-2">
                            <i class="fas fa-hourglass-end mr-1"></i> Expired
                        </span>
                    }
                </div>
                <div class="card-header-action mt-2 mt-sm-0">
                    <a href="/admin/subscription/subscribers" class="btn btn-outline-secondary font-weight-600">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Subscriptions
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Owner Information -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary">
                                <i class="fas fa-user-circle"></i> Owner Information
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Full Name</span>
                                <span class="detail-value font-weight-bold text-dark font-16">
                                    @(Model.Owner?.FullName ?? Model.Owner?.User?.Fullname ?? "N/A")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Business Name</span>
                                <span class="detail-value font-weight-600 text-dark">
                                    @(Model.Owner?.BusinessName ?? "Individual Owner")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Email Address</span>
                                <span class="detail-value font-weight-600 text-primary">
                                    @(Model.Owner?.User?.Email ?? "N/A")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Phone</span>
                                <span class="detail-value font-weight-600 text-dark">
                                    @(Model.Owner?.Phone ?? Model.Owner?.User?.Mobile ?? "N/A")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Location</span>
                                <span class="detail-value font-weight-600 text-dark">
                                    @(Model.Owner?.City ?? "—"), @(Model.Owner?.State ?? "—")
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Owner?.GSTNumber))
                            {
                                <div class="detail-row detail-row-inline">
                                    <span class="detail-label">GST Number</span>
                                    <span class="detail-value font-weight-700 text-monospace text-dark">
                                        @Model.Owner.GSTNumber
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Plan Details -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-info">
                                <i class="fas fa-layer-group"></i> Plan Details
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Plan Tier</span>
                                <span class="detail-value">
                                    <span class="badge badge-primary font-weight-700 font-14 px-3 py-1">@(Model.Plan?.Name ?? "Plan")</span>
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Plan Price</span>
                                <span class="detail-value font-weight-bold text-dark font-18">
                                    ₹@(Model.Plan?.PricePerMonth.ToString("N0") ?? "0")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Plan Duration</span>
                                <span class="detail-value font-weight-bold text-dark font-15">
                                    @(Model.Plan?.DurationDays ?? 30) Days
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Max Stations Allowed</span>
                                <span class="detail-value font-weight-bold text-dark font-15">
                                    <i class="fas fa-charging-station text-primary mr-1"></i> @(Model.Plan?.MaxStations ?? 0) Stations
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Max Managers / Station</span>
                                <span class="detail-value font-weight-bold text-dark font-15">
                                    <i class="fas fa-user-shield text-info mr-1"></i> @(Model.Plan?.MaxManagersPerStation ?? 0) Managers
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Plan?.Description))
                            {
                                <div class="detail-row mt-2">
                                    <span class="detail-label">Description</span>
                                    <span class="detail-value font-weight-500 font-14" style="line-height: 1.6;">
                                        @Model.Plan.Description
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Billing & Validity -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-success">
                                <i class="fas fa-credit-card"></i> Billing & Validity
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Amount Paid</span>
                                <span class="detail-value font-weight-bold text-success font-22">
                                    ₹@Model.AmountPaid.ToString("N2")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Payment ID</span>
                                <span class="detail-value text-monospace font-weight-700 text-dark font-14">
                                    @(Model.PaymentId ?? "N/A")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Purchased On</span>
                                <span class="detail-value font-weight-600 text-dark font-15">
                                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Start Date</span>
                                <span class="detail-value font-weight-600 text-dark font-15">
                                    @Model.StartDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">End Date</span>
                                <span class="detail-value font-weight-600 text-dark font-15">
                                    @Model.EndDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <div class="detail-row detail-row-inline">
                                <span class="detail-label">Remaining Duration</span>
                                <span class="detail-value">
                                    @if (isActive)
                                    {
                                        var daysLeft = Math.Ceiling((Model.EndDate - DateTime.UtcNow).TotalDays);
                                        <span class="badge badge-success font-weight-700 font-14 px-3 py-1">
                                            @(daysLeft <= 0 ? "Expires today" : $"{daysLeft} days remaining")
                                        </span>
                                    }
                                    else if (isNowExpired)
                                    {
                                        <span class="badge badge-secondary font-weight-700 font-14 px-3 py-1">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger font-weight-700 font-14 px-3 py-1">@Model.Status</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Assigned Stations (Clean Badge Chips - No Sub-Tables!) -->
                    <div class="col-12 col-lg-6 mb-4">
                        <div class="detail-card">
                            <div class="detail-card-title text-primary justify-content-between">
                                <span><i class="fas fa-charging-station"></i> Assigned Stations</span>
                                <span class="badge badge-info font-weight-700 font-13 px-3 py-1">
                                    @Model.Stations.Count / @(Model.Plan?.MaxStations ?? 0) Allowed
                                </span>
                            </div>
                            @if (Model.Stations.Any())
                            {
                                <div>
                                    @foreach (var station in Model.Stations)
                                    {
                                        <div class="station-chip">
                                            <div>
                                                <i class="fas fa-charging-station text-primary mr-2"></i>
                                                <strong class="text-dark font-15 font-weight-700">@station.Name</strong>
                                                <span class="font-weight-600 ml-2">(@station.City, @station.State)</span>
                                            </div>
                                            <div>
                                                @if (station.Status == "Active")
                                                {
                                                    <span class="badge badge-success font-weight-700">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary font-weight-700">@station.Status</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-note py-4 text-center font-weight-600 font-15">
                                    No stations assigned
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Cancellation & Refund Information (Conditional) -->
                    @if (isPending || isCancelled || !string.IsNullOrWhiteSpace(Model.CancellationReason))
                    {
                        <div class="col-12 mb-4">
                            <div class="detail-card cancel-card">
                                <div class="detail-card-title text-danger">
                                    <i class="fas fa-undo-alt"></i> Cancellation & Refund Information
                                </div>
                                <div class="detail-row detail-row-inline">
                                    <span class="detail-label">Reason Stated</span>
                                    <span class="detail-value text-dark font-weight-600">
                                        @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason specified" : Model.CancellationReason)
                                    </span>
                                </div>
                                @if (Model.CancellationRequestedAt.HasValue)
                                {
                                    <div class="detail-row detail-row-inline">
                                        <span class="detail-label">Requested At</span>
                                        <span class="detail-value text-dark font-weight-600">
                                            @Model.CancellationRequestedAt.Value.ToString("dd MMM yyyy, hh:mm tt") UTC
                                        </span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks))
                                {
                                    <div class="detail-row detail-row-inline">
                                        <span class="detail-label">Admin Remarks</span>
                                        <span class="detail-value text-dark font-weight-700">
                                            @Model.CancellationAdminRemarks
                                        </span>
                                    </div>
                                }
                                @if (Model.RefundAmount.HasValue)
                                {
                                    <div class="detail-row detail-row-inline">
                                        <span class="detail-label">Refund Amount</span>
                                        <span class="detail-value font-weight-bold text-success font-22">
                                            ₹@Model.RefundAmount.Value.ToString("N2")
                                        </span>
                                    </div>
                                }
                                @if (Model.CancellationProcessedAt.HasValue)
                                {
                                    <div class="detail-row detail-row-inline">
                                        <span class="detail-label">Processed At</span>
                                        <span class="detail-value text-dark font-weight-600">
                                            @Model.CancellationProcessedAt.Value.ToString("dd MMM yyyy, hh:mm tt") UTC
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center flex-wrap">
                <a href="/admin/subscription/subscribers" class="btn btn-outline-secondary font-weight-600">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Subscriptions List
                </a>
                @if (isPending)
                {
                    <a href="/admin/subscription/cancellation-details/@Model.Id" class="btn btn-warning font-weight-600">
                        <i class="fas fa-undo-alt mr-1"></i> Review Cancellation Request
                    </a>
                }
            </div>
        </div>
    </div>
</div>