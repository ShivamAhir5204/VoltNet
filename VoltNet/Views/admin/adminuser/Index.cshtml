@model IEnumerable<VoltNet.Models.AdminUser>

@{
    ViewData["Title"] = "Admin Management";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible show fade">
            <div class="alert-body">
                <button class="close" data-dismiss="alert"><span>&times;</span></button>
                @TempData["Success"]
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible show fade">
            <div class="alert-body">
                <button class="close" data-dismiss="alert"><span>&times;</span></button>
                @TempData["Error"]
            </div>
        </div>
    }
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Admin Users</h4>
        <a asp-action="Create" class="btn btn-primary">
            <i data-feather="user-plus" style="width: 16px; height: 16px; margin-right: 4px;"></i> Create New Admin
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped align-middle table-responsive-cards" id="table-1">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th class="text-center" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="col-primary" data-label="Name">
                            <div class="d-flex align-items-center">
                                <span class="font-weight-bold">@Html.DisplayFor(modelItem => item.Name)</span>
                                <button class="mobile-expand-btn ml-2" title="Show details">
                                    <i data-feather="chevron-down"></i>
                                </button>
                            </div>
                        </td>
                        <td class="" data-label="Username"><div>@Html.DisplayFor(modelItem => item.Username)</div></td>
                        <td class="col-secondary" data-label="Role">
                            <div>
                                @if (item.Role == "SuperAdmin")
                                {
                                    <span class="badge badge-primary"><i class="fas fa-crown mr-1"></i> SuperAdmin</span>
                                }
                                else
                                {
                                    <span class="badge badge-info"><i class="fas fa-user-shield mr-1"></i> Admin</span>
                                }
                            </div>
                        </td>
                        <td class="col-secondary" data-label="Active">
                            <div>
                            @if (item.Isactive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                            </div>
                        </td>
                        <td class="text-center col-action" data-label="Actions">
                            <div class="d-flex justify-content-end">
                                <form asp-action="LoadEdit" method="post" class="d-inline-block mr-1">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                                </form>
                                <form asp-action="LoadDetails" method="post" class="d-inline-block mr-1">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-info">Details</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline-block">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this admin?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
