@model VoltNet.Models.AdminUser

@{
    ViewData["Title"] = "Admin Details";
    Layout = "_AdminLayout";
}
<div class="ud-page">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card">
        <div class="card-header">
          <h4>Admin Details</h4>
        </div>
        <div class="card-body">
          <div class="detail-item">
              <span class="detail-label">Name</span>
              <span class="detail-value">@Model.Name</span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Username</span>
              <span class="detail-value">@Model.Username</span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Role</span>
              <span class="detail-value">
                  @if (Model.Role == "SuperAdmin")
                  {
                      <span class="status status-superadmin"><i class="fas fa-crown"></i> SuperAdmin</span>
                  }
                  else
                  {
                      <span class="status status-admin"><i class="fas fa-user-shield"></i> Admin</span>
                  }
              </span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Status</span>
              <span class="detail-value">
                  @if (Model.Isactive)
                  {
                      <span class="status status-active">Active</span>
                  }
                  else
                  {
                      <span class="status status-inactive">Inactive</span>
                  }
              </span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Created At</span>
              <span class="detail-value">@Model.CreatedAt.ToString("g")</span>
          </div>

          <div class="form-actions">
              <form asp-action="LoadEdit" method="post" class="d-inline-block">
                  <input type="hidden" name="id" value="@Model.Id" />
                  <button type="submit" class="btn btn-edit">Edit</button>
              </form>
              <a asp-action="Index" class="btn btn-back">Back to List</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>