@model VoltNet.Models.AdminUser

@{
    ViewData["Title"] = "Admin Details";
    Layout = "_AdminLayout";
}

<style>
    .ud-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --success: #28C76F;
        --error: #EA5455;
        color: var(--text);
        font-size: 15px;
    }

    .ud-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .ud-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
    }

    .ud-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .ud-page .card-body { padding: 24px; }

    /* Detail items */
    .ud-page .detail-item {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 12px;
    }
    .ud-page .detail-label {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
    }
    .ud-page .detail-value {
        display: block;
        color: var(--text);
        font-size: 16px;
        font-weight: 600;
        word-break: break-word;
    }

    /* Pills */
    .ud-page .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .ud-page .status-active     { background: rgba(40, 199, 111, .12); color: var(--success); }
    .ud-page .status-inactive   { background: rgba(234, 84, 85, .12);  color: var(--error); }
    .ud-page .status-superadmin { background: rgba(103, 119, 239, .12); color: var(--primary); }
    .ud-page .status-admin      { background: rgba(58, 186, 244, .14); color: #1C8FC4; }

    /* Actions */
    .ud-page .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        border-top: 1px solid var(--border);
        padding-top: 20px;
        margin-top: 8px;
    }

    .ud-page .btn-edit,
    .ud-page .btn-back {
        min-height: 44px;
        padding: 0 22px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        margin: 0 !important;
        transition: background-color .2s, color .2s, border-color .2s;
    }

    .ud-page .btn-edit {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .ud-page .btn-edit:hover,
    .ud-page .btn-edit:focus,
    .ud-page .btn-edit:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }

    .ud-page .btn-back {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .ud-page .btn-back:hover,
    .ud-page .btn-back:focus,
    .ud-page .btn-back:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    .ud-page .btn-edit:focus,
    .ud-page .btn-back:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .ud-page .card-header { padding: 16px; }
        .ud-page .card-body { padding: 16px; }
        .ud-page .form-actions { flex-direction: column-reverse; }
        .ud-page .form-actions form { width: 100%; }
        .ud-page .btn-edit,
        .ud-page .btn-back { width: 100%; }
    }
</style>

<div class="ud-page">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card">
        <div class="card-header">
          <h4>Admin Details</h4>
        </div>
        <div class="card-body">
          <div class="detail-item">
              <span class="detail-label">Name</span>
              <span class="detail-value">@Model.Name</span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Username</span>
              <span class="detail-value">@Model.Username</span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Role</span>
              <span class="detail-value">
                  @if (Model.Role == "SuperAdmin")
                  {
                      <span class="status status-superadmin"><i class="fas fa-crown"></i> SuperAdmin</span>
                  }
                  else
                  {
                      <span class="status status-admin"><i class="fas fa-user-shield"></i> Admin</span>
                  }
              </span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Status</span>
              <span class="detail-value">
                  @if (Model.Isactive)
                  {
                      <span class="status status-active">Active</span>
                  }
                  else
                  {
                      <span class="status status-inactive">Inactive</span>
                  }
              </span>
          </div>
          <div class="detail-item">
              <span class="detail-label">Created At</span>
              <span class="detail-value">@Model.CreatedAt.ToString("g")</span>
          </div>

          <div class="form-actions">
              <form asp-action="LoadEdit" method="post" class="d-inline-block">
                  <input type="hidden" name="id" value="@Model.Id" />
                  <button type="submit" class="btn btn-edit">Edit</button>
              </form>
              <a asp-action="Index" class="btn btn-back">Back to List</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>