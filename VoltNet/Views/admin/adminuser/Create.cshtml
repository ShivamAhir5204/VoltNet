@model VoltNet.Models.AdminUser

@{
    ViewData["Title"] = "Create Admin";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card">
      <div class="card-header">
        <h4>Create Admin User</h4>
      </div>
      <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. John Doe" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Username" class="form-label font-weight-bold">Username Address</label>
                    <input asp-for="Username" type="Username" class="form-control" placeholder="admin_username" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter secure password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Role" class="form-label font-weight-bold">Admin Role</label>
                    <select asp-for="Role" class="form-control" required>
                        <option value="Admin">Admin</option>
                        <option value="SuperAdmin">SuperAdmin</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" asp-for="Isactive" checked id="isActiveCheck" />
                        <label class="form-check-label font-weight-bold" for="isActiveCheck">
                            Active Account
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-4 border-top pt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i> Save Admin
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
