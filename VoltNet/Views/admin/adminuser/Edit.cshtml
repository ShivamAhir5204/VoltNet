@model VoltNet.Models.AdminUser

@{
    ViewData["Title"] = "Edit Admin";
    Layout = "_AdminLayout";
}

<style>
    .uf-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --error: #EA5455;
        color: var(--text);
        font-size: 15px;
    }

    .uf-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .uf-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
    }

    .uf-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .uf-page .card-body { padding: 24px; }

    /* Labels */
    .uf-page .form-label,
    .uf-page .form-check-label {
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
    }

    /* Fields */
    .uf-page .form-control {
        background: var(--field);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        min-height: 44px;
        padding: 0 14px;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .uf-page .form-control:hover { border-color: var(--muted); }
    .uf-page .form-control:focus {
        background: var(--white);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
        outline: 0;
    }

    /* Checkbox */
    .uf-page .form-check-input {
        width: 20px;
        height: 20px;
        accent-color: var(--primary);
        cursor: pointer;
    }
    .uf-page .form-check-label { cursor: pointer; margin-left: 6px; }

    /* Validation */
    .uf-page .text-danger {
        color: var(--error) !important;
        font-size: 13px;
    }
    .uf-page .input-validation-error { border-color: var(--error); }

    /* Buttons */
    .uf-page .btn-save,
    .uf-page .btn-back {
        min-height: 44px;
        padding: 0 22px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        margin: 0 !important;
        transition: background-color .2s, color .2s, border-color .2s;
    }

    .uf-page .btn-save {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .uf-page .btn-save:hover,
    .uf-page .btn-save:focus,
    .uf-page .btn-save:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }

    .uf-page .btn-back {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .uf-page .btn-back:hover,
    .uf-page .btn-back:focus,
    .uf-page .btn-back:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    .uf-page .btn-save i,
    .uf-page .btn-back i { color: inherit !important; }

    .uf-page .btn-save:focus,
    .uf-page .btn-back:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }
    .uf-page .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        border-top: 1px solid var(--border);
        padding-top: 20px;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .uf-page .card-header { padding: 16px; }
        .uf-page .card-body { padding: 16px; }
        .uf-page .form-actions { flex-direction: column-reverse; }
        .uf-page .btn-save,
        .uf-page .btn-back { width: 100%; }
        .uf-page .form-check-wrap { margin-top: 0 !important; }
    }
</style>

<div class="uf-page">
  <div class="row">
    <div class="col-12 col-md-10 col-lg-8">
      <div class="card">
        <div class="card-header">
          <h4>Edit Admin</h4>
        </div>
        <div class="card-body">
          <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

              <input type="hidden" asp-for="Id" />
              <input type="hidden" asp-for="CreatedAt" />

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Name" class="form-label">Name</label>
                      <input asp-for="Name" class="form-control" required />
                      <span asp-validation-for="Name" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="Username" class="form-label">Username</label>
                      <input asp-for="Username" type="Username" class="form-control" required />
                      <span asp-validation-for="Username" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Password" class="form-label">Password</label>
                      <input asp-for="Password" type="password" class="form-control" value="" />
                      <span asp-validation-for="Password" class="text-danger"></span>
                  </div>
              </div>
              <input type="hidden" asp-for="Role" value="Admin" />

              <div class="row">
                  <div class="col-md-6 mb-3 d-flex align-items-center">
                      <div class="form-check form-check-wrap mt-2 d-flex align-items-center">
                          <input class="form-check-input" type="checkbox" asp-for="Isactive" id="isActiveCheck" />
                          <label class="form-check-label" for="isActiveCheck">Active</label>
                      </div>
                  </div>
              </div>

              <div class="form-actions mt-4">
                  <button type="submit" class="btn btn-save">
                      <i class="fas fa-save"></i> Update
                  </button>
                  <a asp-action="Index" class="btn btn-back">Back to List</a>
              </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}