@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Edit Station";
    Layout = "_AdminLayout";
}

<style>
    .uf-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --error: #EA5455;
        color: var(--text);
        font-size: 15px;
    }

    .uf-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .uf-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
    }

    .uf-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .uf-page .card-body { padding: 24px; }

    /* Labels */
    .uf-page .form-label {
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
    }

    /* Fields */
    .uf-page .form-control {
        background: var(--field);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        min-height: 44px;
        padding: 0 14px;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .uf-page .form-control:hover { border-color: var(--muted); }
    .uf-page .form-control:focus {
        background: var(--white);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
        outline: 0;
    }

    /* Validation */
    .uf-page .text-danger {
        color: var(--error) !important;
        font-size: 13px;
    }
    .uf-page .input-validation-error { border-color: var(--error); }

    /* Buttons */
    .uf-page .btn-save,
    .uf-page .btn-back,
    .uf-page .btn-map {
        min-height: 44px;
        padding: 0 22px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }

    .uf-page .btn-save {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .uf-page .btn-save:hover,
    .uf-page .btn-save:focus,
    .uf-page .btn-save:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }

    .uf-page .btn-back {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .uf-page .btn-back:hover,
    .uf-page .btn-back:focus,
    .uf-page .btn-back:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    .uf-page .btn-map {
        width: 100%;
        padding: 0 14px;
        background-color: #FFFFFF !important;
        border: 1px solid #3DC9B3 !important;
        color: #353C48 !important;
    }
    .uf-page .btn-map:hover,
    .uf-page .btn-map:focus,
    .uf-page .btn-map:active {
        background-color: #3DC9B3 !important;
        border-color: #3DC9B3 !important;
        color: #FFFFFF !important;
    }

    .uf-page .btn-save i,
    .uf-page .btn-back i,
    .uf-page .btn-map i { color: inherit !important; }

    .uf-page .btn-save:focus,
    .uf-page .btn-back:focus,
    .uf-page .btn-map:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }
    .uf-page .form-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    /* Select2 */
    .select2-container--default .select2-selection--single {
        background: #F2F2F2;
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        height: 44px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #353C48;
        line-height: 42px;
        padding-left: 14px;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 42px; right: 8px; }
    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        background: #FFFFFF;
        border-color: #6777EF;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
    }
    .select2-dropdown {
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        box-shadow: 0 6px 20px rgba(52, 57, 94, .12);
        overflow: hidden;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected],
    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background: #6777EF;
        color: #FFFFFF;
    }
    .select2-container--default .select2-results__option[aria-selected=true] { background: #F2F2F2; color: #353C48; }
    .select2-container--default .select2-search--dropdown .select2-search__field {
        border: 1px solid #E3EAEF;
        border-radius: 6px;
        min-height: 38px;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .uf-page .card-header { padding: 16px; }
        .uf-page .card-body { padding: 16px; }
        .uf-page .form-actions { flex-direction: column-reverse; }
        .uf-page .btn-save,
        .uf-page .btn-back { width: 100%; }
    }
</style>

<div class="uf-page">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h4>Edit Station</h4>
        </div>
        <div class="card-body">
          <form asp-action="Edit" id="stationForm">
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

              <input type="hidden" asp-for="Id" />
              <input type="hidden" asp-for="CreatedAt" />

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Name" class="form-label">Station Name</label>
                      <input asp-for="Name" class="form-control" />
                      <span asp-validation-for="Name" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="OwnerUserId" class="form-label">Owner</label>
                      <select asp-for="OwnerUserId" class="form-control" asp-items="@ViewBag.OwnerList">
                          <option value="">-- Select Owner --</option>
                      </select>
                      <span asp-validation-for="OwnerUserId" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-12 mb-3">
                      <label asp-for="Address" class="form-label">Address</label>
                      <input asp-for="Address" class="form-control" />
                      <span asp-validation-for="Address" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="City" class="form-label">City</label>
                      <input asp-for="City" class="form-control" />
                      <span asp-validation-for="City" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="State" class="form-label">State</label>
                      <select asp-for="State" class="form-control" id="State" required>
                          <option value="">-- Select State --</option>
                      </select>
                      <span asp-validation-for="State" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-5 mb-3">
                      <label asp-for="Latitude" class="form-label">Latitude</label>
                      <input asp-for="Latitude" id="Latitude" class="form-control" step="0.000001" />
                      <span asp-validation-for="Latitude" class="text-danger"></span>
                  </div>

                  <div class="col-md-5 mb-3">
                      <label asp-for="Longitude" class="form-label">Longitude</label>
                      <input asp-for="Longitude" id="Longitude" class="form-control" step="0.000001" />
                      <span asp-validation-for="Longitude" class="text-danger"></span>
                  </div>

                  <div class="col-md-2 mb-3 d-flex align-items-end">
                      <button type="button" id="btnPickLocation" class="btn btn-map">
                          <i class="bi bi-geo-alt"></i> Map
                      </button>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="OpeningTime" class="form-label">Opening Time</label>
                      <input asp-for="OpeningTime" type="time" class="form-control" />
                      <span asp-validation-for="OpeningTime" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="ClosingTime" class="form-label">Closing Time</label>
                      <input asp-for="ClosingTime" type="time" class="form-control" />
                      <span asp-validation-for="ClosingTime" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Status" class="form-label">Status</label>
                      <select asp-for="Status" class="form-control">
                          <option value="Active">Active</option>
                          <option value="Inactive">Inactive</option>
                          <option value="Maintenance">Maintenance</option>
                      </select>
                      <span asp-validation-for="Status" class="text-danger"></span>
                  </div>
              </div>

              <div class="form-actions mt-4">
                  <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Save</button>
                  <a asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
              </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        var stationId = '@Model.Id';

        // Restore picked location from sessionStorage
        var picked = sessionStorage.getItem('pickedLocation');
        if (picked) {
            var loc = JSON.parse(picked);
            document.getElementById('Latitude').value = loc.lat;
            document.getElementById('Longitude').value = loc.lng;
            sessionStorage.removeItem('pickedLocation');
        }

        // Navigate to PickLocation page
        document.getElementById('btnPickLocation').addEventListener('click', function () {
            var lat = document.getElementById('Latitude').value || '0';
            var lng = document.getElementById('Longitude').value || '0';
            sessionStorage.setItem('pickLocationInitial', JSON.stringify({ lat: lat, lng: lng }));
            window.location.href = '/admin/Station/PickLocation?returnTo=Edit&id=' + stationId;
        });

        $(document).ready(function() {
            var stateSelect = $('#State');
            var selectedState = '@Model.State';

            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    var option = new Option(state, state);
                    if (state === selectedState) {
                        option.selected = true;
                    }
                    stateSelect.append(option);
                });
            }
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    })();
    </script>
}