@{
    ViewData["Title"] = "Station Map";
    Layout = "_AdminLayout";
    var highlightId = ViewBag.HighlightId as int?;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    .sm-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --success: #28C76F;
        --warning: #FFA117;
        --error: #EA5455;
        color: var(--text);
        font-size: 15px;
    }

    .sm-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .sm-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
        gap: 12px;
    }

    .sm-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .sm-page .card-body { padding: 16px; }
    .sm-page .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* Map */
    .sm-page #stationMap {
        height: calc(100vh - 240px);
        min-height: 500px;
        border-radius: 10px;
        border: 1px solid var(--border);
        z-index: 1;
    }

    /* Header buttons */
    .sm-page .btn-loc,
    .sm-page .btn-clear,
    .sm-page .btn-back {
        min-height: 44px;
        padding: 0 18px;
        border-radius: 8px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .sm-page .btn-loc,
    .sm-page .btn-back { display: inline-flex; }
    .sm-page .btn-clear { display: inline-flex; }

    .sm-page .btn-loc {
        background-color: #FFFFFF !important;
        border: 1px solid #3DC9B3 !important;
        color: #353C48 !important;
    }
    .sm-page .btn-loc:hover,
    .sm-page .btn-loc:focus,
    .sm-page .btn-loc:active {
        background-color: #3DC9B3 !important;
        border-color: #3DC9B3 !important;
        color: #FFFFFF !important;
    }

    .sm-page .btn-clear {
        background-color: #FFFFFF !important;
        border: 1px solid #EA5455 !important;
        color: #EA5455 !important;
    }
    .sm-page .btn-clear:hover,
    .sm-page .btn-clear:focus,
    .sm-page .btn-clear:active {
        background-color: #EA5455 !important;
        border-color: #EA5455 !important;
        color: #FFFFFF !important;
    }

    .sm-page .btn-back {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .sm-page .btn-back:hover,
    .sm-page .btn-back:focus,
    .sm-page .btn-back:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    .sm-page .btn-loc i,
    .sm-page .btn-clear i,
    .sm-page .btn-back i { color: inherit !important; }

    .sm-page .btn-loc:focus,
    .sm-page .btn-clear:focus,
    .sm-page .btn-back:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    /* Route info bar */
    .sm-page .route-info {
        background: var(--text);
        color: var(--white);
        border-radius: 10px;
        padding: 14px 20px;
        display: none;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }
    .sm-page .route-info.active { display: flex; }
    .sm-page .route-info .route-stat { text-align: left; min-width: 0; }
    .sm-page .route-info .route-stat strong {
        display: block;
        font-size: 1.1rem;
        color: var(--teal);
        word-break: break-word;
    }
    .sm-page .route-info .route-stat small {
        color: var(--muted);
        font-size: 0.75rem;
    }

    /* Popups */
    .sm-page .leaflet-popup-content-wrapper {
        border-radius: 10px;
        color: var(--text);
        box-shadow: 0 6px 20px rgba(52, 57, 94, .18);
    }
    .sm-page .leaflet-popup-content { min-width: 200px; margin: 14px 16px; }
    .sm-page .popup-station-name { font-weight: 700; font-size: 1rem; margin-bottom: 6px; color: var(--text); }
    .sm-page .popup-meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 4px; }
    .sm-page .popup-status { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin-top: 4px; }
    .sm-page .popup-status.active { background: rgba(40, 199, 111, .12); color: #28C76F; }
    .sm-page .popup-status.inactive { background: rgba(234, 84, 85, .12); color: #EA5455; }
    .sm-page .popup-status.maintenance { background: rgba(255, 161, 23, .14); color: #B86F00; }

    .sm-page .popup-actions { margin-top: 12px; display: flex; gap: 8px; }
    .sm-page .popup-actions a,
    .sm-page .popup-actions button {
        font-size: 0.85rem;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .sm-page .popup-actions .popup-btn-directions {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .sm-page .popup-actions .popup-btn-directions:hover,
    .sm-page .popup-actions .popup-btn-directions:focus,
    .sm-page .popup-actions .popup-btn-directions:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }
    .sm-page .popup-actions .popup-btn-details {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .sm-page .popup-actions .popup-btn-details:hover,
    .sm-page .popup-actions .popup-btn-details:focus,
    .sm-page .popup-actions .popup-btn-details:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .sm-page .card-header { padding: 16px; }
        .sm-page .card-body { padding: 12px; }
        .sm-page .header-actions { width: 100%; flex-direction: column; }
        .sm-page .btn-loc,
        .sm-page .btn-clear,
        .sm-page .btn-back { width: 100%; }
        .sm-page #stationMap { height: calc(100vh - 200px); min-height: 420px; }
        .sm-page .route-info { gap: 16px; padding: 12px 16px; }
        .sm-page .leaflet-popup-content { min-width: 170px; }
    }
</style>

<div class="sm-page">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
          <h4 class="mb-0">Station Map</h4>
          <div class="header-actions">
              <button id="btnMyLocation" class="btn btn-loc">
                  <i class="bi bi-crosshair"></i> My Location
              </button>
              <button id="btnClearRoute" class="btn btn-clear" style="display: none;">
                  <i class="bi bi-x-lg"></i> Clear Route
              </button>
              <a href="/admin/Station" class="btn btn-back">
                  <i class="bi bi-list-ul"></i> Back to List
              </a>
          </div>
        </div>
        <div class="card-body">
          <!-- Route Info Bar -->
          <div id="routeInfo" class="route-info mb-2">
              <div class="route-stat">
                  <strong id="routeDistance">—</strong>
                  <small>Distance</small>
              </div>
              <div class="route-stat">
                  <strong id="routeDuration">—</strong>
                  <small>Est. Time</small>
              </div>
              <div class="route-stat">
                  <strong id="routeTo">—</strong>
                  <small>Destination</small>
              </div>
          </div>

          <div id="stationMap"></div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
    // ── Config ───────────────────────────────────────────────
    var highlightId = @(highlightId.HasValue ? highlightId.Value.ToString() : "null");
    var defaultCenter = [20.5937, 78.9629];
    var defaultZoom = 5;

    var map = L.map('stationMap').setView(defaultCenter, defaultZoom);

    var streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
    });

    var satelliteMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri',
        maxZoom: 19
    });

    streetMap.addTo(map);

    var baseMaps = {
        "Street Map": streetMap,
        "Satellite Map": satelliteMap
    };

    L.control.layers(baseMaps).addTo(map);

    // Custom icons
    var stationIcon = L.divIcon({
        className: 'custom-div-icon',
        html: '<div style="background:#3DC9B3;width:14px;height:14px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(53,60,72,0.3);"></div>',
        iconSize: [20, 20],
        iconAnchor: [10, 10]
    });

    var highlightIcon = L.divIcon({
        className: 'custom-div-icon',
        html: '<div style="background:#6777EF;width:18px;height:18px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 8px rgba(103,119,239,0.5);animation:pulse 1.5s infinite;"></div>',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
    });

    var userIcon = L.divIcon({
        className: 'custom-div-icon',
        html: '<div style="background:#34395E;width:16px;height:16px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 8px rgba(52,57,94,0.5);"></div>',
        iconSize: [22, 22],
        iconAnchor: [11, 11]
    });

    var markers = {};
    var routeLine = null;
    var userMarker = null;
    var userLatLng = null;

    // ── Load Stations ────────────────────────────────────────
    fetch('/admin/Station/MapData')
        .then(function (res) { return res.json(); })
        .then(function (stations) {
            if (stations.length === 0) return;

            var bounds = L.latLngBounds();

            stations.forEach(function (s) {
                var isHighlight = (s.id === highlightId);
                var icon = isHighlight ? highlightIcon : stationIcon;
                var statusClass = s.status.toLowerCase();

                var popupHtml =
                    '<div class="popup-station-name">' + s.name + '</div>' +
                    '<div class="popup-meta"><i class="bi bi-person"></i> ' + s.owner + '</div>' +
                    '<div class="popup-meta"><i class="bi bi-geo-alt"></i> ' + s.address + ', ' + s.city + '</div>' +
                    '<div class="popup-meta"><i class="bi bi-clock"></i> ' + s.opening + ' – ' + s.closing + '</div>' +
                    '<span class="popup-status ' + statusClass + '">' + s.status + '</span>' +
                    '<div class="popup-actions">' +
                        '<button class="popup-btn-directions" onclick="getDirections(' + s.latitude + ',' + s.longitude + ',\'' + s.name.replace(/'/g, "\\'") + '\')">Directions</button>' +
                        '<a href="/admin/Station/Map?highlight=' + s.id + '" class="popup-btn-details">Focus</a>' +
                    '</div>';

                var marker = L.marker([s.latitude, s.longitude], { icon: icon })
                    .addTo(map)
                    .bindPopup(popupHtml);

                markers[s.id] = marker;
                bounds.extend([s.latitude, s.longitude]);

                if (isHighlight) {
                    map.setView([s.latitude, s.longitude], 16);
                    setTimeout(function () { marker.openPopup(); }, 500);
                }
            });

            if (!highlightId) {
                map.fitBounds(bounds, { padding: [40, 40] });
            }
        });

    // ── My Location ──────────────────────────────────────────
    document.getElementById('btnMyLocation').addEventListener('click', function () {
        if (!navigator.geolocation) {
            alert('Geolocation is not supported by your browser.');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (pos) {
            userLatLng = L.latLng(pos.coords.latitude, pos.coords.longitude);
            if (userMarker) {
                userMarker.setLatLng(userLatLng);
            } else {
                userMarker = L.marker(userLatLng, { icon: userIcon })
                    .addTo(map)
                    .bindPopup('<strong>Your Location</strong>');
            }
            map.setView(userLatLng, 14);
            userMarker.openPopup();
        }, function () {
            alert('Unable to get your location. Please allow location access.');
        });
    });

    // ── Directions (OSRM) ────────────────────────────────────
    window.getDirections = function (destLat, destLng, stationName) {
        if (!navigator.geolocation) {
            alert('Geolocation is not supported by your browser.');
            return;
        }

        // Get current position first
        navigator.geolocation.getCurrentPosition(function (pos) {
            userLatLng = L.latLng(pos.coords.latitude, pos.coords.longitude);

            // Show user marker
            if (userMarker) {
                userMarker.setLatLng(userLatLng);
            } else {
                userMarker = L.marker(userLatLng, { icon: userIcon })
                    .addTo(map)
                    .bindPopup('<strong>Your Location</strong>');
            }

            // Call OSRM for route
            var osrmUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                pos.coords.longitude + ',' + pos.coords.latitude + ';' +
                destLng + ',' + destLat +
                '?overview=full&geometries=geojson';

            fetch(osrmUrl)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.routes || data.routes.length === 0) {
                        alert('No route found.');
                        return;
                    }

                    // Clear previous route
                    if (routeLine) map.removeLayer(routeLine);

                    var route = data.routes[0];
                    var coords = route.geometry.coordinates.map(function (c) {
                        return [c[1], c[0]];
                    });

                    routeLine = L.polyline(coords, {
                        color: '#6777EF',
                        weight: 5,
                        opacity: 0.8,
                        dashArray: '10, 8'
                    }).addTo(map);

                    map.fitBounds(routeLine.getBounds(), { padding: [60, 60] });

                    // Update route info bar
                    var distKm = (route.distance / 1000).toFixed(1);
                    var durationMin = Math.round(route.duration / 60);
                    var hours = Math.floor(durationMin / 60);
                    var mins = durationMin % 60;
                    var timeStr = hours > 0 ? hours + 'h ' + mins + 'm' : mins + ' min';

                    document.getElementById('routeDistance').textContent = distKm + ' km';
                    document.getElementById('routeDuration').textContent = timeStr;
                    document.getElementById('routeTo').textContent = stationName;
                    document.getElementById('routeInfo').classList.add('active');
                    document.getElementById('btnClearRoute').style.display = 'inline-block';
                })
                .catch(function () {
                    alert('Failed to fetch route. Please try again.');
                });
        }, function () {
            alert('Unable to get your location. Please allow location access.');
        });
    };

    // ── Clear Route ──────────────────────────────────────────
    document.getElementById('btnClearRoute').addEventListener('click', function () {
        if (routeLine) {
            map.removeLayer(routeLine);
            routeLine = null;
        }
        document.getElementById('routeInfo').classList.remove('active');
        this.style.display = 'none';
    });
})();
</script>

<style>
@@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
}
</style>
}