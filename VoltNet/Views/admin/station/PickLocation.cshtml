@{
    ViewData["Title"] = "Select Location";
    Layout = "_AdminLayout";
    var returnTo = ViewBag.ReturnTo as string ?? "Create";
    var stationId = ViewBag.StationId as int?;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    .pl-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        color: var(--text);
        font-size: 15px;
    }

    .pl-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .pl-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
        gap: 12px;
    }

    .pl-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .pl-page .card-body { padding: 16px; }
    .pl-page .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* Map */
    .pl-page #pickMap {
        height: calc(100vh - 280px);
        min-height: 450px;
        border-radius: 10px;
        border: 1px solid var(--border);
        z-index: 1;
    }

    /* Coordinates bar */
    .pl-page .pick-info-bar {
        background: var(--text);
        color: var(--white);
        border-radius: 10px;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }
    .pl-page .pick-info-bar small { color: var(--muted); font-size: 0.75rem; }
    .pl-page .pick-info-bar .coord-display {
        font-family: monospace;
        font-size: 1rem;
        color: var(--teal);
        font-weight: 600;
    }

    /* Buttons */
    .pl-page .btn-loc,
    .pl-page .btn-confirm,
    .pl-page .btn-cancel {
        min-height: 44px;
        padding: 0 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }

    .pl-page .btn-loc {
        background-color: #FFFFFF !important;
        border: 1px solid #3DC9B3 !important;
        color: #353C48 !important;
    }
    .pl-page .btn-loc:hover,
    .pl-page .btn-loc:focus,
    .pl-page .btn-loc:active {
        background-color: #3DC9B3 !important;
        border-color: #3DC9B3 !important;
        color: #FFFFFF !important;
    }

    .pl-page .btn-confirm {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .pl-page .btn-confirm:hover,
    .pl-page .btn-confirm:focus,
    .pl-page .btn-confirm:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }
    .pl-page .btn-confirm:disabled {
        background-color: #F2F2F2 !important;
        border-color: #E3EAEF !important;
        color: #96A2B4 !important;
        cursor: not-allowed;
        opacity: 1;
    }

    .pl-page .btn-cancel {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .pl-page .btn-cancel:hover,
    .pl-page .btn-cancel:focus,
    .pl-page .btn-cancel:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }

    .pl-page .btn-loc i,
    .pl-page .btn-confirm i,
    .pl-page .btn-cancel i { color: inherit !important; }

    .pl-page .btn-loc:focus,
    .pl-page .btn-confirm:focus,
    .pl-page .btn-cancel:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    /* Popup */
    .pl-page .leaflet-popup-content-wrapper {
        border-radius: 10px;
        color: var(--text);
        box-shadow: 0 6px 20px rgba(52, 57, 94, .18);
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .pl-page .card-header { padding: 16px; }
        .pl-page .card-body { padding: 12px; }
        .pl-page .header-actions { width: 100%; flex-direction: column; }
        .pl-page .btn-loc,
        .pl-page .btn-confirm,
        .pl-page .btn-cancel { width: 100%; }
        .pl-page #pickMap { height: calc(100vh - 220px); min-height: 400px; }
        .pl-page .pick-info-bar { gap: 20px; padding: 12px 16px; }
    }
</style>

<div class="pl-page">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
          <h4 class="mb-0">Select Location</h4>
          <div class="header-actions">
              <button id="btnMyLocation" class="btn btn-loc">
                  <i class="bi bi-crosshair"></i> My Location
              </button>
              <button id="btnConfirm" class="btn btn-confirm" disabled>
                  <i class="bi bi-check-lg"></i> Confirm
              </button>
              <button id="btnCancel" class="btn btn-cancel">
                  <i class="bi bi-x-lg"></i> Cancel
              </button>
          </div>
        </div>
        <div class="card-body">
          <div class="pick-info-bar mb-2">
              <div>
                  <small>Latitude</small>
                  <div class="coord-display" id="displayLat">—</div>
              </div>
              <div>
                  <small>Longitude</small>
                  <div class="coord-display" id="displayLng">—</div>
              </div>
          </div>

          <div id="pickMap"></div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
    var returnTo = '@Html.Raw(returnTo)';
    var stationId = @(stationId.HasValue ? stationId.Value.ToString() : "null");

    // Check if we have initial coordinates from the form
    var initialData = sessionStorage.getItem('pickLocationInitial');
    var initLat = 20.5937, initLng = 78.9629, initZoom = 5;
    if (initialData) {
        var init = JSON.parse(initialData);
        var parsedLat = parseFloat(init.lat);
        var parsedLng = parseFloat(init.lng);
        if (!isNaN(parsedLat) && !isNaN(parsedLng) && parsedLat !== 0 && parsedLng !== 0) {
            initLat = parsedLat;
            initLng = parsedLng;
            initZoom = 15;
        }
        sessionStorage.removeItem('pickLocationInitial');
    }

    var map = L.map('pickMap').setView([initLat, initLng], initZoom);

    var streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
    });

    var satelliteMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri',
        maxZoom: 19
    });

    streetMap.addTo(map);

    var baseMaps = {
        "Street Map": streetMap,
        "Satellite Map": satelliteMap
    };

    L.control.layers(baseMaps).addTo(map);

    var marker = null;
    var selectedLat = null;
    var selectedLng = null;

    // If we have initial coords, place a marker
    if (initZoom === 15) {
        marker = L.marker([initLat, initLng]).addTo(map);
        selectedLat = initLat;
        selectedLng = initLng;
        document.getElementById('displayLat').textContent = initLat.toFixed(6);
        document.getElementById('displayLng').textContent = initLng.toFixed(6);
        document.getElementById('btnConfirm').disabled = false;
    }

    // Click to pick location
    map.on('click', function (e) {
        selectedLat = parseFloat(e.latlng.lat.toFixed(6));
        selectedLng = parseFloat(e.latlng.lng.toFixed(6));

        if (marker) {
            marker.setLatLng(e.latlng);
        } else {
            marker = L.marker(e.latlng).addTo(map);
        }

        document.getElementById('displayLat').textContent = selectedLat.toFixed(6);
        document.getElementById('displayLng').textContent = selectedLng.toFixed(6);
        document.getElementById('btnConfirm').disabled = false;

        marker.bindPopup('Lat: ' + selectedLat + '<br>Lng: ' + selectedLng).openPopup();
    });

    // My Location
    document.getElementById('btnMyLocation').addEventListener('click', function () {
        if (!navigator.geolocation) {
            alert('Geolocation is not supported by your browser.');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (pos) {
            var lat = pos.coords.latitude;
            var lng = pos.coords.longitude;
            map.setView([lat, lng], 15);
        }, function () {
            alert('Unable to get your location.');
        });
    });

    // Confirm & go back
    document.getElementById('btnConfirm').addEventListener('click', function () {
        if (selectedLat === null || selectedLng === null) return;

        sessionStorage.setItem('pickedLocation', JSON.stringify({
            lat: selectedLat.toFixed(6),
            lng: selectedLng.toFixed(6)
        }));

        if (returnTo === 'Edit' && stationId) {
            window.location.href = '/admin/Station/Edit/' + stationId;
        } else {
            window.location.href = '/admin/Station/Create';
        }
    });

    // Cancel
    document.getElementById('btnCancel').addEventListener('click', function () {
        if (returnTo === 'Edit' && stationId) {
            window.location.href = '/admin/Station/Edit/' + stationId;
        } else {
            window.location.href = '/admin/Station/Create';
        }
    });
})();
</script>
}