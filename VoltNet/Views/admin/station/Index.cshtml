@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "Stations";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Stations</h4>
        <div class="d-flex gap-2">
            <a asp-action="Map" class="btn btn-info text-white">
                <i class="bi bi-map"></i> View Map
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        </div>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped align-middle table-responsive-cards" id="table-1">
    <thead>
        <tr>
            <th>Name</th>
            <th>Owner</th>
            <th>City</th>
            <th>State</th>
            <th>Status</th>
            <th class="text-center" style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="col-primary" data-label="Name">
                    <div class="d-flex align-items-center">
                        <span>@Html.DisplayFor(modelItem => item.Name)</span>
                        <button class="mobile-expand-btn ml-2" title="Show details">
                            <i data-feather="chevron-down"></i>
                        </button>
                    </div>
                </td>
                <td class="" data-label="Owner"><div>@(item.OwnerUser?.Fullname ?? "—")</div></td>
                <td class="col-secondary" data-label="City"><div>@Html.DisplayFor(modelItem => item.City)</div></td>
                <td class="col-secondary" data-label="State"><div>@Html.DisplayFor(modelItem => item.State)</div></td>
                <td class="col-secondary" data-label="Status">
                    <div>
                    @if (item.Status == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else if (item.Status == "Maintenance")
                    {
                        <span class="badge bg-warning text-dark">Maintenance</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                    </div>
                </td>
                <td class="text-center col-action" data-label="Actions">
                    <div class="d-flex justify-content-center">
                        <form asp-action="LoadEdit" method="post" class="d-inline-block mr-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-warning" title="Edit"><i class="fas fa-edit"></i></button>
                        </form>
                        <form asp-action="LoadDetails" method="post" class="d-inline-block mr-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-info" title="Details"><i class="fas fa-info-circle"></i></button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline-block">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this station?');" title="Delete"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
      </div>
    </div>
  </div>
</div>
