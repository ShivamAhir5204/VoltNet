@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "Stations";
    Layout = "_AdminLayout";
}

<style>
    .um-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --success: #28C76F;
        --warning: #FFA117;
        --error: #EA5455;
        --info: #3ABAF4;
        color: var(--text);
        font-size: 15px;
    }

    .um-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .um-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .um-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .um-page .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    .um-page .card-body { padding: 8px 24px 24px; }

    /* Header buttons */
    .um-page .btn-create,
    .um-page .btn-map {
        min-height: 44px;
        padding: 0 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }

    .um-page .btn-create {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .um-page .btn-create:hover,
    .um-page .btn-create:focus,
    .um-page .btn-create:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }

    .um-page .btn-map {
        background-color: #FFFFFF !important;
        border: 1px solid #3DC9B3 !important;
        color: #353C48 !important;
    }
    .um-page .btn-map:hover,
    .um-page .btn-map:focus,
    .um-page .btn-map:active {
        background-color: #3DC9B3 !important;
        border-color: #3DC9B3 !important;
        color: #FFFFFF !important;
    }

    .um-page .btn-create i,
    .um-page .btn-map i { color: inherit !important; }

    .um-page .btn-create:focus,
    .um-page .btn-map:focus,
    .um-page .icon-btn:focus,
    .um-page .mobile-expand-btn:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    /* Table */
    .um-page .table { margin: 0; color: var(--text); }
    .um-page .table thead th {
        background: var(--bg);
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-top: 0;
        border-bottom: 1px solid var(--border);
        padding: 14px 12px;
        white-space: nowrap;
    }
    .um-page .table td {
        padding: 14px 12px;
        vertical-align: middle;
        border-top: 1px solid var(--border);
    }
    .um-page .table-striped tbody tr:nth-of-type(odd) { background: var(--bg); }
    .um-page .table tbody tr:hover { background: rgba(103, 119, 239, .06); }

    /* Status pills */
    .um-page .status {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .um-page .status-active      { background: rgba(40, 199, 111, .12); color: var(--success); }
    .um-page .status-maintenance { background: rgba(255, 161, 23, .14); color: #B86F00; }
    .um-page .status-inactive    { background: rgba(234, 84, 85, .12);  color: var(--error); }

    /* Action icon buttons */
    .um-page .icon-btn {
        width: 40px;
        height: 40px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        border-radius: 8px;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .um-page .icon-btn-edit   { color: #6777EF !important; }
    .um-page .icon-btn-info   { color: #3ABAF4 !important; }
    .um-page .icon-btn-delete { color: #EA5455 !important; }
    .um-page .icon-btn-edit:hover,
    .um-page .icon-btn-edit:focus,
    .um-page .icon-btn-edit:active   { background-color: #6777EF !important; border-color: #6777EF !important; color: #FFFFFF !important; }
    .um-page .icon-btn-info:hover,
    .um-page .icon-btn-info:focus,
    .um-page .icon-btn-info:active   { background-color: #3ABAF4 !important; border-color: #3ABAF4 !important; color: #FFFFFF !important; }
    .um-page .icon-btn-delete:hover,
    .um-page .icon-btn-delete:focus,
    .um-page .icon-btn-delete:active { background-color: #EA5455 !important; border-color: #EA5455 !important; color: #FFFFFF !important; }
    .um-page .icon-btn i { color: inherit !important; }

    .um-page .mobile-expand-btn {
        background: transparent;
        border: 0;
        color: var(--primary);
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .um-page .card-header { padding: 16px; }
        .um-page .card-body { padding: 8px 16px 16px; }
        .um-page .header-actions { width: 100%; flex-direction: column; }
        .um-page .btn-create,
        .um-page .btn-map { width: 100%; }
        .um-page .icon-btn { width: 44px; height: 44px; }
    }
</style>

<div class="um-page">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4>Stations</h4>
          <div class="header-actions">
              <a asp-action="Map" class="btn btn-map">
                  <i class="bi bi-map"></i> View Map
              </a>
              <a asp-action="Create" class="btn btn-create">
                  <i class="bi bi-plus-lg"></i> Create New
              </a>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped align-middle table-responsive-cards" id="table-1">
              <thead>
                <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="col-primary" data-label="Name">
                            <div class="d-flex align-items-center">
                                <span>@Html.DisplayFor(modelItem => item.Name)</span>
                                <button class="mobile-expand-btn ml-2" title="Show details">
                                    <i data-feather="chevron-down"></i>
                                </button>
                            </div>
                        </td>
                        <td data-label="Owner"><div>@(item.OwnerUser?.Fullname ?? "—")</div></td>
                        <td class="col-secondary" data-label="City"><div>@Html.DisplayFor(modelItem => item.City)</div></td>
                        <td class="col-secondary" data-label="State"><div>@Html.DisplayFor(modelItem => item.State)</div></td>
                        <td class="col-secondary" data-label="Status">
                            <div>
                                @if (item.Status == "Active")
                                {
                                    <span class="status status-active">Active</span>
                                }
                                else if (item.Status == "Maintenance")
                                {
                                    <span class="status status-maintenance">Maintenance</span>
                                }
                                else
                                {
                                    <span class="status status-inactive">Inactive</span>
                                }
                            </div>
                        </td>
                        <td class="text-center col-action" data-label="Actions">
                            <div class="d-flex justify-content-center" style="gap: 8px;">
                                <form asp-action="LoadEdit" method="post" class="d-inline-block">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="icon-btn icon-btn-edit" title="Edit"><i class="fas fa-edit"></i></button>
                                </form>
                                <form asp-action="LoadDetails" method="post" class="d-inline-block">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="icon-btn icon-btn-info" title="Details"><i class="fas fa-info-circle"></i></button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline-block">
                                    <button type="submit" class="icon-btn icon-btn-delete" onclick="return confirm('Are you sure you want to delete this station?');" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>