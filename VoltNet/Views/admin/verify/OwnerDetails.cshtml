@model VoltNet.Models.StationOwner
@{
    ViewData["Title"] = "Partner Application Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="oa-page">
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Partner Application — @Model.FullName</h4>
                <a href="/admin/VerifyOwners" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Full Name</span>
                            <span class="detail-value">@Model.FullName</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Email</span>
                            <span class="detail-value">@(Model.User?.Email ?? "N/A")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Phone</span>
                            <span class="detail-value">@Model.Phone</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Business Name</span>
                            <span class="detail-value">@(Model.BusinessName ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Business Registration Number</span>
                            <span class="detail-value">@(Model.BusinessRegistrationNumber ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">GST Number</span>
                            <span class="detail-value">@(Model.GSTNumber ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Address</span>
                            <span class="detail-value">@(Model.Address ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">City</span>
                            <span class="detail-value">@(Model.City ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">State</span>
                            <span class="detail-value">@(Model.State ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Status</span>
                            <span class="detail-value">
                                @if (Model.Status == "Pending")
                                {
                                    <span class="status status-warn">Pending</span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="status status-success">Approved</span>
                                }
                                else
                                {
                                    <span class="status status-error">Rejected</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="detail-item">
                            <span class="detail-label">Applied On</span>
                            <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>
                </div>

                <!-- KYC & Verification Documents -->
                <hr class="divider" />
                <div>
                    <div class="docs-head">
                        <h5>KYC Documents</h5>
                        <span class="status status-plan">@(Model.Documents?.Count ?? 0) Document(s)</span>
                    </div>

                    @if (Model.Documents == null || !Model.Documents.Any())
                    {
                        <div class="alert alert-warning">No documents uploaded</div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <div class="table-responsive">
                                <table class="table align-middle no-datatable table-responsive-cards">
                                    <thead>
                                        <tr>
                                            <th>Document</th>
                                            <th>Ref / ID</th>
                                            <th>File</th>
                                            <th>Status</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in Model.Documents)
                                        {
                                            <tr>
                                                <td class="col-primary" data-label="Document">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <span class="cell-strong">@doc.DocumentType</span>
                                                        <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                            <i data-feather="chevron-down"></i>
                                                        </button>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(doc.RejectionReason))
                                                    {
                                                        <div class="cell-error">@doc.RejectionReason</div>
                                                    }
                                                </td>
                                                <td class="col-secondary" data-label="Ref / ID"><div>@(doc.DocumentNumber ?? "—")</div></td>
                                                <td class="col-secondary" data-label="File">
                                                    <div>
                                                        <div class="cell-sub">@doc.OriginalFileName</div>
                                                        <span class="status status-plain mt-1">@(doc.FileSizeBytes / 1024) KB</span>
                                                    </div>
                                                </td>
                                                <td data-label="Status">
                                                    <div>
                                                        @if (doc.Status == "Verified")
                                                        {
                                                            <span class="status status-success">Verified</span>
                                                        }
                                                        else if (doc.Status == "Rejected")
                                                        {
                                                            <span class="status status-error">Rejected</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="status status-warn">Pending</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center col-action" data-label="Actions">
                                                    <div class="doc-actions">
                                                        <button type="button" class="btn btn-preview-doc" data-filepath="@doc.FilePath" data-title="@doc.DocumentType" data-ext="@doc.FileExtension">
                                                            Preview
                                                        </button>
                                                        <a href="@doc.FilePath" target="_blank" class="icon-btn icon-btn-open" title="Open in new tab">
                                                            <i class="fas fa-external-link-alt"></i>
                                                        </a>
                                                        @if (doc.Status != "Verified")
                                                        {
                                                            <form method="post" action="/admin/VerifyDocuments/VerifyOwnerDocument">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="documentId" value="@doc.Id" />
                                                                <input type="hidden" name="ownerId" value="@Model.Id" />
                                                                <button type="submit" class="icon-btn icon-btn-approve" title="Mark Verified">
                                                                    <i class="fas fa-check"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                        @if (doc.Status != "Rejected")
                                                        {
                                                            <button type="button" class="icon-btn icon-btn-reject" data-toggle="modal" data-target="#rejectDocModal"
                                                                    onclick="openRejectDocModal('@doc.Id', '@doc.DocumentType');" title="Mark Rejected">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.Status == "Pending")
                {
                    <hr class="divider" />
                    <div class="final-actions">
                        <form method="post" action="/admin/VerifyOwners/Approve">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-main" onclick="return confirm('Approve this partner application and elevate user role to StationOwner?');">
                                <i class="fas fa-check-circle"></i> Approve Application
                            </button>
                        </form>
                        <button type="button" class="btn btn-reject" data-toggle="modal" data-target="#rejectOwnerModal">
                            <i class="fas fa-times-circle"></i> Reject Application
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>

@section Modals {
<!-- In-Browser Document Preview Modal -->
<div class="modal fade oa-modal" id="docPreviewModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docPreviewModalTitle">Document Preview</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body text-center" id="docPreviewModalBody">
                <!-- Dynamically loaded preview -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-dismiss="modal">Close</button>
                <a href="#" id="docPreviewDownloadBtn" target="_blank" class="btn btn-main">
                    <i class="fas fa-external-link-alt"></i> Open Full View
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Centralized Reject Single KYC Document Modal -->
<div class="modal fade oa-modal" id="rejectDocModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content text-left">
            <form method="post" action="/admin/VerifyDocuments/RejectOwnerDocument">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentId" id="rejectSingleDocId" />
                <input type="hidden" name="ownerId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Reject Document: <span id="rejectSingleDocTitle"></span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-0">
                        <label class="form-label">Reason *</label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-reject"><i class="fas fa-ban"></i> Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Status == "Pending")
{
    <!-- Reject Partner Application Modal -->
    <div class="modal fade oa-modal" id="rejectOwnerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form method="post" action="/admin/VerifyOwners/Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">Reject Application</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>@Model.FullName</strong></p>
                        <div class="form-group mb-0">
                            <label class="form-label">Reason *</label>
                            <textarea name="rejectionReason" class="form-control" rows="3" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-reject"><i class="fas fa-ban"></i> Reject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
}

@section Scripts {
<script>
    function openRejectDocModal(docId, docTitle) {
        document.getElementById('rejectSingleDocId').value = docId;
        document.getElementById('rejectSingleDocTitle').textContent = docTitle;
    }

    document.querySelectorAll('.btn-preview-doc').forEach(btn => {
        btn.addEventListener('click', function() {
            const filepath = this.getAttribute('data-filepath');
            const title = this.getAttribute('data-title');
            const ext = (this.getAttribute('data-ext') || '').toLowerCase();
            const modalBody = document.getElementById('docPreviewModalBody');
            const modalTitle = document.getElementById('docPreviewModalTitle');
            const downloadBtn = document.getElementById('docPreviewDownloadBtn');

            modalTitle.textContent = title;
            downloadBtn.href = filepath;

            if (ext === '.pdf') {
                modalBody.innerHTML = `<iframe src="${filepath}" style="width: 100%; height: 600px; border: none;"></iframe>`;
            } else {
                modalBody.innerHTML = `<div class="p-3 d-flex align-items-center justify-content-center" style="min-height: 500px;"><img src="${filepath}" class="img-fluid rounded shadow" style="max-height: 580px;" alt="${title}" /></div>`;
            }

            $('#docPreviewModal').modal('show');
        });
    });
</script>
}