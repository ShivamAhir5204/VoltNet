@model VoltNet.Models.StationOwner
@{
    ViewData["Title"] = "Partner Application Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Partner Application — @Model.FullName</h4>
                <a href="/admin/VerifyOwners" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Full Name</strong>
                        <p>@Model.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Email</strong>
                        <p>@(Model.User?.Email ?? "N/A")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Phone</strong>
                        <p>@Model.Phone</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Business Name</strong>
                        <p>@(Model.BusinessName ?? "—")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Business Registration Number</strong>
                        <p>@(Model.BusinessRegistrationNumber ?? "—")</p>
                    </div>
                    <div class="col-md-6">
                        <strong>GST Number</strong>
                        <p>@(Model.GSTNumber ?? "—")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Address</strong>
                        <p>@(Model.Address ?? "—")</p>
                    </div>
                    <div class="col-md-3">
                        <strong>City</strong>
                        <p>@(Model.City ?? "—")</p>
                    </div>
                    <div class="col-md-3">
                        <strong>State</strong>
                        <p>@(Model.State ?? "—")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Status</strong>
                        <p>
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                            else if (Model.Status == "Approved")
                            {
                                <span class="badge badge-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Rejected</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <strong>Applied On</strong>
                        <p>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                    </div>
                </div>

                @if (Model.Status == "Pending")
                {
                    <hr />
                    <div class="d-flex gap-2">
                        <form method="post" action="/admin/VerifyOwners/Approve" class="d-inline-block mr-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success" onclick="return confirm('Approve this partner application?');">
                                <i class="fas fa-check"></i> Approve
                            </button>
                        </form>
                        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#rejectOwnerModal">
                            <i class="fas fa-times"></i> Reject
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Status == "Pending")
{
    <!-- Reject Modal -->
    <div class="modal fade" id="rejectOwnerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form method="post" action="/admin/VerifyOwners/Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">Reject Partner Application</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <p>Rejecting application from: <strong>@Model.FullName</strong></p>
                        <div class="form-group">
                            <label>Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Enter reason..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Reject Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
