@model VoltNet.Models.Station
@{
    ViewData["Title"] = "Station Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    #stationMap {
        height: 300px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        z-index: 1;
    }
</style>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Station Details — @Model.Name</h4>
                <a href="/admin/VerifyStations" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Station Name</strong>
                        <p>@Model.Name</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Owner</strong>
                        <p>@(Model.OwnerUser?.Fullname ?? "N/A")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <strong>Address</strong>
                        <p>@Model.Address</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>City</strong>
                        <p>@Model.City</p>
                    </div>
                    <div class="col-md-6">
                        <strong>State</strong>
                        <p>@Model.State</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Opening Time</strong>
                        <p>@Model.OpeningTime.ToString(@"hh\:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Closing Time</strong>
                        <p>@Model.ClosingTime.ToString(@"hh\:mm")</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Latitude</strong>
                        <p>@Model.Latitude</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Longitude</strong>
                        <p>@Model.Longitude</p>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-12">
                        <strong>Location Map</strong>
                        <div class="mt-2" id="stationMap"></div>
                    </div>
                </div>

                <!-- Compliance & Statutory Documents -->
                <hr />
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-file-contract text-primary mr-2"></i> Statutory & Compliance Documents
                        </h5>
                        <span class="badge badge-primary font-12 font-weight-bold">@(Model.Documents?.Count ?? 0) Document(s)</span>
                    </div>

                    @if (Model.Documents == null || !Model.Documents.Any())
                    {
                        <div class="alert alert-warning py-3">
                            <i class="fas fa-exclamation-triangle mr-1"></i> No statutory compliance documents (DISCOM sanction letter, land lease, fire NOC) have been uploaded for this station yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Document Type</th>
                                        <th>Ref / Sanction No.</th>
                                        <th>File</th>
                                        <th>Status</th>
                                        <th class="text-center" style="width: 220px;">Review Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.Documents)
                                    {
                                        <tr>
                                            <td>
                                                <div class="font-weight-bold text-dark">
                                                    @if (doc.DocumentType.Contains("DISCOM"))
                                                    {
                                                        <i class="fas fa-bolt text-warning mr-1"></i>
                                                    }
                                                    else if (doc.DocumentType.Contains("Fire"))
                                                    {
                                                        <i class="fas fa-fire-extinguisher text-danger mr-1"></i>
                                                    }
                                                    else if (doc.DocumentType.Contains("Photo"))
                                                    {
                                                        <i class="fas fa-camera text-success mr-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-file-alt text-primary mr-1"></i>
                                                    }
                                                    @doc.DocumentType
                                                </div>
                                                @if (!string.IsNullOrEmpty(doc.RejectionReason))
                                                {
                                                    <div class="small text-danger font-weight-bold mt-1">
                                                        <i class="fas fa-times-circle mr-1"></i> @doc.RejectionReason
                                                    </div>
                                                }
                                            </td>
                                            <td>@(doc.DocumentNumber ?? "—")</td>
                                            <td>
                                                <div class="small text-muted font-weight-600">@doc.OriginalFileName</div>
                                                <small class="badge badge-light border">@(doc.FileSizeBytes / 1024) KB</small>
                                            </td>
                                            <td>
                                                @if (doc.Status == "Verified")
                                                {
                                                    <span class="badge badge-success font-11 font-weight-bold"><i class="fas fa-check-circle"></i> Verified</span>
                                                }
                                                else if (doc.Status == "Rejected")
                                                {
                                                    <span class="badge badge-danger font-11 font-weight-bold"><i class="fas fa-ban"></i> Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning font-11 font-weight-bold"><i class="fas fa-clock"></i> Pending</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-outline-primary btn-sm btn-preview-doc" data-filepath="@doc.FilePath" data-title="@doc.DocumentType" data-ext="@doc.FileExtension">
                                                        <i class="fas fa-eye"></i> Preview
                                                    </button>
                                                    <a href="@doc.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm" title="Open in new tab">
                                                        <i class="fas fa-external-link-alt"></i>
                                                    </a>
                                                    @if (doc.Status != "Verified")
                                                    {
                                                        <form method="post" action="/admin/VerifyDocuments/VerifyStationDocument" class="d-inline-block ml-1">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="documentId" value="@doc.Id" />
                                                            <input type="hidden" name="stationId" value="@Model.Id" />
                                                            <button type="submit" class="btn btn-success btn-sm" title="Mark Verified">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (doc.Status != "Rejected")
                                                    {
                                                        <button type="button" class="btn btn-danger btn-sm ml-1" data-toggle="modal" data-target="#rejectDocModal"
                                                                onclick="openRejectDocModal('@doc.Id', '@doc.DocumentType');" title="Mark Rejected">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                @if (Model.Status == "PendingVerification")
                {
                    <hr />
                    <div class="d-flex gap-2">
                        <form method="post" action="/admin/VerifyStations/Approve" class="d-inline-block mr-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success font-weight-600" onclick="return confirm('Approve this station and publish it to the active network?');">
                                <i class="fas fa-check-circle mr-1"></i> Approve Station
                            </button>
                        </form>
                        <button type="button" class="btn btn-danger font-weight-600" data-toggle="modal" data-target="#rejectModal">
                            <i class="fas fa-times-circle mr-1"></i> Reject Station
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Modals {
<!-- In-Browser Document Preview Modal -->
<div class="modal fade" id="docPreviewModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title font-weight-bold text-white" id="docPreviewModalTitle">Document Preview</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0 text-center" id="docPreviewModalBody" style="min-height: 550px; background: #0f172a;">
                <!-- Dynamically loaded preview -->
            </div>
            <div class="modal-footer bg-light">
                <a href="#" id="docPreviewDownloadBtn" target="_blank" class="btn btn-primary btn-sm font-weight-600">
                    <i class="fas fa-external-link-alt mr-1"></i> Open Full View
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Centralized Reject Single Document Modal -->
<div class="modal fade" id="rejectDocModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content text-left">
            <form method="post" action="/admin/VerifyDocuments/RejectStationDocument">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentId" id="rejectSingleDocId" />
                <input type="hidden" name="stationId" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title font-weight-bold text-white">
                        <i class="fas fa-file-excel mr-1"></i> Reject Document: <span id="rejectSingleDocTitle"></span>
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body p-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-600">Rejection Reason / Feedback to Owner <span class="text-danger">*</span></label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="e.g. Sanction letter is illegible, expired, or power load does not match station specs..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary font-weight-600" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger font-weight-600">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Status == "PendingVerification")
{
    <!-- Reject Station Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form method="post" action="/admin/VerifyStations/Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title font-weight-bold text-white"><i class="fas fa-ban mr-1"></i> Reject Station</h5>
                        <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body p-4">
                        <p>Rejecting station: <strong>@Model.Name</strong></p>
                        <div class="form-group mb-0">
                            <label class="font-weight-600">Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Specify why the entire station registration is rejected..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger font-weight-600">Confirm Station Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function openRejectDocModal(docId, docTitle) {
            document.getElementById('rejectSingleDocId').value = docId;
            document.getElementById('rejectSingleDocTitle').textContent = docTitle;
        }

        (function() {
            var lat = @Model.Latitude;
            var lng = @Model.Longitude;
            
            var map = L.map('stationMap').setView([lat, lng], 15);
            
            var streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap',
                maxZoom: 19
            });
            var satelliteMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri',
                maxZoom: 19
            });

            streetMap.addTo(map);
            L.control.layers({ "Street Map": streetMap, "Satellite Map": satelliteMap }).addTo(map);
            
            L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>@Model.Name</b><br>@Model.Address")
                .openPopup();
        })();

        // Document preview script
        document.querySelectorAll('.btn-preview-doc').forEach(btn => {
            btn.addEventListener('click', function() {
                const filepath = this.getAttribute('data-filepath');
                const title = this.getAttribute('data-title');
                const ext = (this.getAttribute('data-ext') || '').toLowerCase();
                const modalBody = document.getElementById('docPreviewModalBody');
                const modalTitle = document.getElementById('docPreviewModalTitle');
                const downloadBtn = document.getElementById('docPreviewDownloadBtn');

                modalTitle.textContent = title;
                downloadBtn.href = filepath;

                if (ext === '.pdf') {
                    modalBody.innerHTML = `<iframe src="${filepath}" style="width: 100%; height: 600px; border: none;"></iframe>`;
                } else {
                    modalBody.innerHTML = `<div class="p-3 d-flex align-items-center justify-content-center" style="min-height: 500px;"><img src="${filepath}" class="img-fluid rounded shadow" style="max-height: 580px;" alt="${title}" /></div>`;
                }

                $('#docPreviewModal').modal('show');
            });
        });
    </script>
}
