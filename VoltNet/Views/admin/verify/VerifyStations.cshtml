@model IEnumerable<VoltNet.Models.Station>
@{
    ViewData["Title"] = "Verify Stations";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4>Pending Station Verifications</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-check-circle"></i> No pending station verifications.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Station Name</th>
                                    <th>Owner</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Submitted</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var station in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@station.Name</strong>
                                            <div class="mt-1">
                                                @if (station.Status == "PendingVerification")
                                                {
                                                    <span class="badge badge-warning font-11 mr-1"><i class="fas fa-clock mr-1"></i> New Station</span>
                                                }
                                                else if (station.Documents != null && station.Documents.Any(d => d.Status == "Pending"))
                                                {
                                                    <span class="badge badge-info font-11 mr-1"><i class="fas fa-file-upload mr-1"></i> New Docs Pending</span>
                                                }

                                                @if (station.Documents != null && station.Documents.Any())
                                                {
                                                    var pendingCount = station.Documents.Count(d => d.Status == "Pending");
                                                    <span class="badge badge-light border text-dark font-11">
                                                        <i class="fas fa-file-contract mr-1"></i> @station.Documents.Count doc(s)
                                                        @if (pendingCount > 0)
                                                        {
                                                            <strong class="text-danger ml-1">(@pendingCount pending)</strong>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light border text-muted font-11">No docs</span>
                                                }
                                            </div>
                                        </td>
                                        <td>@(station.OwnerUser?.Fullname ?? "N/A")</td>
                                        <td>@station.City</td>
                                        <td>@station.State</td>
                                        <td>@station.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="/admin/VerifyStations/Details/@station.Id" class="btn btn-info mr-1" title="View Details">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                @if (station.Status == "PendingVerification")
                                                {
                                                    <form method="post" action="/admin/VerifyStations/Approve" class="d-inline-block mr-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@station.Id" />
                                                        <button type="submit" class="btn btn-success" title="Approve Station" onclick="return confirm('Approve this station?');">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-danger" title="Reject Station"
                                                            data-toggle="modal" data-target="#rejectModal"
                                                            onclick="document.getElementById('rejectStationId').value='@station.Id'; document.getElementById('rejectStationName').textContent='@station.Name';">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Modals {
<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form method="post" action="/admin/VerifyStations/Reject">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectStationId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title font-weight-bold text-white"><i class="fas fa-ban mr-1"></i> Reject Station</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body p-4">
                    <p>Rejecting station: <strong id="rejectStationName"></strong></p>
                    <div class="form-group mb-0">
                        <label class="font-weight-600">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Specify why the station was rejected so the owner can correct issues..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger font-weight-600">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>
}
