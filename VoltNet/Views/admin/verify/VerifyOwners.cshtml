@model IEnumerable<VoltNet.Models.StationOwner>
@{
    ViewData["Title"] = "Verify Partner Applications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="ow-page">
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4>Partner Applications</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }
                @if (!Model.Any())
                {
                    <div class="alert alert-info">No pending applications.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle table-responsive-cards">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Business</th>
                                    <th>Phone</th>
                                    <th>City</th>
                                    <th>Applied</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var owner in Model)
                                {
                                    <tr>
                                        <td class="col-primary" data-label="Full Name">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="cell-strong">@owner.FullName</span>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td data-label="Business"><div>@(owner.BusinessName ?? "—")</div></td>
                                        <td class="col-secondary" data-label="Phone"><div>@owner.Phone</div></td>
                                        <td class="col-secondary" data-label="City"><div>@(owner.City ?? "—")</div></td>
                                        <td class="col-secondary" data-label="Applied"><div>@owner.CreatedAt.ToString("dd MMM yyyy")</div></td>
                                        <td class="text-center col-action" data-label="Actions">
                                            <div class="d-flex justify-content-center" style="gap: 8px;">
                                                <a href="/admin/VerifyOwners/Details/@owner.Id" class="icon-btn icon-btn-info" title="Details">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <form method="post" action="/admin/VerifyOwners/Approve" class="d-inline-block">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@owner.Id" />
                                                    <button type="submit" class="icon-btn icon-btn-approve" title="Approve" onclick="return confirm('Approve this partner application?');">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <button type="button" class="icon-btn icon-btn-reject" title="Reject"
                                                        data-toggle="modal" data-target="#rejectOwnerModal"
                                                        onclick="document.getElementById('rejectOwnerId').value='@owner.Id'; document.getElementById('rejectOwnerName').textContent='@owner.FullName';">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>

@section Modals {
<!-- Reject Modal -->
<div class="modal fade ow-modal" id="rejectOwnerModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form method="post" action="/admin/VerifyOwners/Reject">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectOwnerId" />
                <div class="modal-header">
                    <h5 class="modal-title">Reject Application</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p><strong id="rejectOwnerName"></strong></p>
                    <div class="form-group mb-0">
                        <label class="form-label">Reason *</label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-reject"><i class="fas fa-ban"></i> Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
}