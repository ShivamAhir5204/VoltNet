@model VoltNet.Models.UserMaster

@{
    ViewData["Title"] = "Edit User";
    Layout = "_AdminLayout";
}

<style>
    .uf-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --error: #EA5455;
        color: var(--text);
        font-size: 15px;
    }

    .uf-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
    }

    .uf-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 18px 24px;
    }

    .uf-page .card-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
    }

    .uf-page .card-body { padding: 24px; }

    /* Labels */
    .uf-page .form-label,
    .uf-page .form-check-label {
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
    }

    /* Fields */
    .uf-page .form-control {
        background: var(--field);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        min-height: 44px;
        padding: 0 14px;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .uf-page .form-control:hover { border-color: var(--muted); }
    .uf-page .form-control:focus {
        background: var(--white);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
        outline: 0;
    }

    /* Checkbox */
    .uf-page .form-check-input {
        width: 20px;
        height: 20px;
        accent-color: var(--primary);
        cursor: pointer;
    }
    .uf-page .form-check-label { cursor: pointer; margin-left: 6px; }

    /* Validation */
    .uf-page .text-danger {
        color: var(--error) !important;
        font-size: 13px;
    }
    .uf-page .input-validation-error { border-color: var(--error); }

    /* Buttons */
    .uf-page .btn-save {
    background-color: #6777EF !important;
    border: 1px solid #6777EF !important;
    color: #FFFFFF !important;
}
.uf-page .btn-save:hover,
.uf-page .btn-save:focus,
.uf-page .btn-save:active {
    background-color: #34395E !important;
    border-color: #34395E !important;
    color: #FFFFFF !important;
}
.uf-page .btn-back {
    background-color: #FFFFFF !important;
    border: 1px solid #E3EAEF !important;
    color: #353C48 !important;
}
.uf-page .btn-back:hover,
.uf-page .btn-back:focus,
.uf-page .btn-back:active {
    background-color: #F9F9F9 !important;
    border-color: #96A2B4 !important;
    color: #353C48 !important;
}
.uf-page .btn-save i,
.uf-page .btn-back i { color: inherit !important; }

    /* Select2 */
    .select2-container--default .select2-selection--single {
        background: #F2F2F2;
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        height: 44px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #353C48;
        line-height: 42px;
        padding-left: 14px;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 42px; right: 8px; }
    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        background: #FFFFFF;
        border-color: #6777EF;
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
    }
    .select2-dropdown {
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        box-shadow: 0 6px 20px rgba(52, 57, 94, .12);
        overflow: hidden;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected],
    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background: #6777EF;
        color: #FFFFFF;
    }
    .select2-container--default .select2-results__option[aria-selected=true] { background: #F2F2F2; color: #353C48; }
    .select2-container--default .select2-search--dropdown .select2-search__field {
        border: 1px solid #E3EAEF;
        border-radius: 6px;
        min-height: 38px;
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .uf-page .card-header { padding: 16px; }
        .uf-page .card-body { padding: 16px; }
        .uf-page .form-actions { flex-direction: column-reverse; }
        .uf-page .btn-save,
        .uf-page .btn-back { width: 100%; }
        .uf-page .form-check-wrap { margin-top: 0 !important; }
    }
</style>

<div class="uf-page">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h4>Edit User</h4>
        </div>
        <div class="card-body">
          <form asp-action="Edit">
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

              <input type="hidden" asp-for="Id" />
              <input type="hidden" asp-for="CreatedAt" />

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Fullname" class="form-label">Full Name</label>
                      <input asp-for="Fullname" class="form-control" />
                      <span asp-validation-for="Fullname" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="Email" class="form-label">Email</label>
                      <input asp-for="Email" type="email" class="form-control" />
                      <span asp-validation-for="Email" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Password" class="form-label">Password</label>
                      <input asp-for="Password" type="password" class="form-control" />
                      <span asp-validation-for="Password" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="Mobile" class="form-label">Mobile</label>
                      <input asp-for="Mobile" type="tel" inputmode="numeric" class="form-control" maxlength="10" />
                      <span asp-validation-for="Mobile" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="City" class="form-label">City</label>
                      <input asp-for="City" class="form-control" />
                      <span asp-validation-for="City" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                      <label asp-for="State" class="form-label">State</label>
                      <select asp-for="State" class="form-control select2" data-selected="@Model.State">
                          <option value="">-- Select State --</option>
                      </select>
                      <span asp-validation-for="State" class="text-danger"></span>
                  </div>
              </div>

              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label asp-for="Role" class="form-label">Role</label>
                      <select asp-for="Role" class="form-control">
                          <option value="Customer">-- Select Role --</option>
                          <option value="StationManager">StationManager</option>
                          <option value="Technician">Technician</option>
                          <option value="StationOwner">StationOwner</option>
                          <option value="Customer">Customer</option>
                      </select>
                      <span asp-validation-for="Role" class="text-danger"></span>
                  </div>

                  <div class="col-md-6 mb-3 d-flex align-items-center">
                      <div class="form-check form-check-wrap mt-4 d-flex align-items-center">
                          <input asp-for="Isactive" class="form-check-input" />
                          <label asp-for="Isactive" class="form-check-label">Is Active</label>
                      </div>
                  </div>
              </div>

              <div class="form-actions mt-4">
                  <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Save</button>
                  <a asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
              </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var stateSelect = $('#State');
            
            // Populate states
            indianStates.forEach(function(state) {
                var option = new Option(state, state);
                stateSelect.append(option);
            });
            
            // Set selected value
            var selectedState = stateSelect.data('selected');
            if (selectedState) {
                stateSelect.val(selectedState);
            }
            
            // Initialize Select2
            stateSelect.select2({
                placeholder: "-- Select State --",
                width: '100%'
            });
        });
    </script>
}