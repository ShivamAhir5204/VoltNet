@model VoltNet.Models.Charger

@{
    ViewData["Title"] = "Charger Details";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Charger Details</h4>
      </div>
      <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Charger Code</span>
                <strong>@Html.DisplayFor(model => model.ChargerCode)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Station</span>
                <strong>@(Model.Station?.Name ?? "N/A")</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Charger Type</span>
                <strong>@Html.DisplayFor(model => model.Type)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Connector Type</span>
                <strong>@Html.DisplayFor(model => model.ConnectorType)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Power Rating</span>
                <strong>@Model.PowerRatingKw kW</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Rate per kWh</span>
                <strong>₹@Model.RatePerKwh.ToString("F2")</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Status</span>
                <div>
                    @if (Model.Status == "Available")
                    {
                        <span class="badge bg-success">Available</span>
                    }
                    else if (Model.Status == "Occupied")
                    {
                        <span class="badge bg-primary">Occupied</span>
                    }
                    else if (Model.Status == "Faulty")
                    {
                        <span class="badge bg-danger">Faulty</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Offline</span>
                    }
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Last Serviced</span>
                <strong>@(Model.LastServicedAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</strong>
            </div>
        </div>
      </div>
      <div class="card-footer bg-whitesmoke d-flex gap-2">
        <form asp-action="LoadEdit" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</button>
        </form>
        <a asp-action="Index" class="btn btn-light text-dark ml-2"><i class="fas fa-arrow-left"></i> Back to List</a>
      </div>
    </div>
  </div>
</div>
