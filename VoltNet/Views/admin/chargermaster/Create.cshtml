@model VoltNet.Models.Charger

@{
    ViewData["Title"] = "Create Charger";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Create Charger</h4>
      </div>
      <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StationId" class="form-label">Station</label>
                    <select asp-for="StationId" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Stations)">
                        <option value="">-- Select Station --</option>
                    </select>
                    <span asp-validation-for="StationId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ChargerCode" class="form-label">Charger Code</label>
                    <input asp-for="ChargerCode" class="form-control" placeholder="e.g. STN01-CH01" />
                    <span asp-validation-for="ChargerCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="form-label">Charger Type</label>
                    <select asp-for="Type" class="form-control">
                        <option value="">-- Select Type --</option>
                        <option value="AC_Slow">AC Slow</option>
                        <option value="AC_Fast">AC Fast</option>
                        <option value="DC_Fast">DC Fast</option>
                        <option value="DC_UltraFast">DC Ultra Fast</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ConnectorType" class="form-label">Connector Type</label>
                    <select asp-for="ConnectorType" class="form-control">
                        <option value="">-- Select Connector --</option>
                        <option value="CCS2">CCS2</option>
                        <option value="Type2">Type2</option>
                        <option value="CHAdeMO">CHAdeMO</option>
                        <option value="GBT">GBT</option>
                    </select>
                    <span asp-validation-for="ConnectorType" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PowerRatingKw" class="form-label">Power Rating (kW)</label>
                    <input asp-for="PowerRatingKw" class="form-control" step="0.01" />
                    <span asp-validation-for="PowerRatingKw" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="RatePerKwh" class="form-label">Rate per kWh (₹)</label>
                    <input asp-for="RatePerKwh" class="form-control" step="0.01" />
                    <span asp-validation-for="RatePerKwh" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-control">
                        <option value="Available">Available</option>
                        <option value="Occupied">Occupied</option>
                        <option value="Faulty">Faulty</option>
                        <option value="Offline">Offline</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Create</button>
                <a asp-action="Index" class="btn btn-light text-dark"><i class="fas fa-arrow-left"></i> Back to List</a>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
