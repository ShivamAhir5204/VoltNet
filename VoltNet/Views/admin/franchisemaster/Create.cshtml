@model VoltNet.Models.FranchiseMaster

@{
    ViewData["Title"] = "Create Franchise";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Create Franchise</h4>
      </div>
      <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FranchiseName" class="form-label">Franchise Name</label>
                    <input asp-for="FranchiseName" class="form-control" />
                    <span asp-validation-for="FranchiseName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="OwnerUserId" class="form-label">Owner (FranchiseOwner)</label>
                    <select asp-for="OwnerUserId" class="form-control" asp-items="@(ViewBag.FranchiseOwners as IEnumerable<SelectListItem>)">
                        <option value="">-- Select Franchise Owner --</option>
                    </select>
                    <span asp-validation-for="OwnerUserId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RevenueSharePercent" class="form-label">Revenue Share %</label>
                    <input asp-for="RevenueSharePercent" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <span asp-validation-for="RevenueSharePercent" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ContactEmail" class="form-label">Contact Email</label>
                    <input asp-for="ContactEmail" type="email" class="form-control" />
                    <span asp-validation-for="ContactEmail" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Create</button>
                <a asp-action="Index" class="btn btn-light text-dark"><i class="fas fa-arrow-left"></i> Back to List</a>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
