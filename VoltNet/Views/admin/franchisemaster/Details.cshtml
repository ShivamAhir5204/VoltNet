@model VoltNet.Models.FranchiseMaster

@{
    ViewData["Title"] = "Franchise Details";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Franchise Details</h4>
      </div>
      <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Franchise Name</span>
                <strong>@Html.DisplayFor(model => model.FranchiseName)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Owner</span>
                <strong>@(Model.OwnerUser?.Fullname ?? "N/A") (@(Model.OwnerUser?.Email ?? ""))</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Revenue Share %</span>
                <strong>@Model.RevenueSharePercent.ToString("F2")%</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Contact Email</span>
                <strong>@Html.DisplayFor(model => model.ContactEmail)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Address</span>
                <strong>@Html.DisplayFor(model => model.Address)</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Created At</span>
                <strong>@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</strong>
            </div>
        </div>
      </div>
      <div class="card-footer bg-whitesmoke d-flex gap-2">
        <form asp-action="LoadEdit" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</button>
        </form>
        <a asp-action="Index" class="btn btn-light text-dark ml-2"><i class="fas fa-arrow-left"></i> Back to List</a>
      </div>
    </div>
  </div>
</div>
