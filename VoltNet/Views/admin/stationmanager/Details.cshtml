@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Station Manager Details";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Station Manager Details</h4>
      </div>
      <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Station</span>
                <strong>@(Model.Station?.Name ?? "N/A")</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Manager</span>
                <strong>@(Model.User?.Fullname ?? "N/A") (@(Model.User?.Email ?? "N/A"))</strong>
            </div>

            <div class="col-md-6 mb-3">
                <span class="text-muted d-block mb-1">Assigned At</span>
                <strong>@Model.AssignedAt.ToString("dd MMM yyyy HH:mm")</strong>
            </div>
        </div>
      </div>
      <div class="card-footer bg-whitesmoke d-flex gap-2">
        <form asp-action="LoadEdit" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</button>
        </form>
        <a asp-action="Index" class="btn btn-light text-dark ml-2"><i class="fas fa-arrow-left"></i> Back to List</a>
      </div>
    </div>
  </div>
</div>
