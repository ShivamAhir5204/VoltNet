@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Edit Station Manager";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 mt-4">
            <div class="card-header border-bottom pt-4 pb-3">
                <h3 class="mb-0">Edit Station Assignment</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="AssignedAt" />

                    <div class="mb-3">
                        <label asp-for="StationId" class="form-label">Station</label>
                        <select asp-for="StationId" class="form-select" asp-items="ViewBag.StationList">
                            <option value="">-- Select Station --</option>
                        </select>
                        <span asp-validation-for="StationId" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="UserId" class="form-label">Manager</label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserList">
                            <option value="">-- Select Manager --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
