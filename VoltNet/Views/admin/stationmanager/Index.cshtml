@model IEnumerable<VoltNet.Models.StationManager>

@{
    ViewData["Title"] = "Station Manager Assignments";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Station Manager Assignments</h4>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Assign New
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped align-middle table-responsive-cards" id="table-1">
    <thead>
        <tr>
            <th>Manager Name</th>
            <th>Email</th>
            <th>Station</th>
            <th>Assigned At</th>
            <th class="text-center" style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="col-primary" data-label="Manager Name">
                    <div class="d-flex align-items-center">
                        <span>@(item.User?.Fullname ?? "N/A")</span>
                        <button class="mobile-expand-btn ml-2" title="Show details">
                            <i data-feather="chevron-down"></i>
                        </button>
                    </div>
                </td>
                <td class="" data-label="Email"><div>@(item.User?.Email ?? "N/A")</div></td>
                <td class="col-secondary" data-label="Station"><div>@(item.Station?.Name ?? "N/A")</div></td>
                <td class="col-secondary" data-label="Assigned At"><div>@item.AssignedAt.ToString("dd MMM yyyy")</div></td>
                <td class="text-center col-action" data-label="Actions">
                    <div class="d-flex justify-content-end">
                        <form asp-action="LoadEdit" method="post" class="d-inline-block mr-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                        </form>
                        <form asp-action="LoadDetails" method="post" class="d-inline-block mr-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-info">Details</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline-block">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to remove this assignment?');">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
      </div>
    </div>
  </div>
</div>
