@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Assign Station Manager";
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Assign Station Manager</h4>
      </div>
      <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StationId" class="form-label">Station</label>
                    <select asp-for="StationId" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Stations)">
                        <option value="">-- Select Station --</option>
                    </select>
                    <span asp-validation-for="StationId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="UserId" class="form-label">Station Manager</label>
                    <select asp-for="UserId" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Managers)">
                        <option value="">-- Select Manager --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Assign</button>
                <a asp-action="Index" class="btn btn-light text-dark"><i class="fas fa-arrow-left"></i> Back to List</a>
            </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
