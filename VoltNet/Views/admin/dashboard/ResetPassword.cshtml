@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>VoltNet - Reset Password</title>
  <link rel="stylesheet" href="~/otika/assets/css/app.min.css">
  <link rel="stylesheet" href="~/otika/assets/css/style.css">
  <link rel="stylesheet" href="~/otika/assets/css/components.css">
  <link rel="stylesheet" href="~/otika/assets/css/custom.css">
  <link rel='shortcut icon' type='image/x-icon' href='~/otika/assets/img/voltnet.ico' />
</head>

<body>
  <div class="loader"></div>
  <div id="app">
    <section class="section">
      <div class="container mt-5">
        <div class="row">
          <div class="col-12 col-sm-8 offset-sm-2 col-md-6 offset-md-3 col-lg-6 offset-lg-3 col-xl-4 offset-xl-4">
            <div class="card card-primary">
              <div class="card-header">
                <h4>Reset Password</h4>
              </div>
              <div class="card-body">
                <p class="text-muted">Enter Your New Password</p>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-has-icon d-flex align-items-center">
                        <div class="alert-icon"><i class="fas fa-exclamation-circle"></i></div>
                        <div class="alert-body">
                            @ViewBag.Error
                        </div>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-has-icon d-flex align-items-center">
                        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
                        <div class="alert-body">
                            @TempData["Success"]
                        </div>
                    </div>
                }
                <form method="POST" action="/admin/Dashboard/ResetPassword">
                  @Html.AntiForgeryToken()
                  <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <input id="currentPassword" type="password" class="form-control" name="currentPassword" tabindex="1" required autofocus>
                  </div>
                  <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input id="newPassword" type="password" class="form-control pwstrength" data-indicator="pwindicator" name="newPassword" tabindex="2" required>
                    <div id="pwindicator" class="pwindicator">
                      <div class="bar"></div>
                      <div class="label"></div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input id="confirmPassword" type="password" class="form-control" name="confirmPassword" tabindex="3" required>
                  </div>
                  <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-lg btn-block" tabindex="4">
                      Reset Password
                    </button>
                  </div>
                  <div class="form-group text-center mb-0">
                    <a href="/admin/Dashboard" class="text-small">Back to Dashboard</a>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <script src="~/otika/assets/js/app.min.js"></script>
  <script src="~/otika/assets/js/scripts.js"></script>
  <script src="~/otika/assets/js/custom.js"></script>
</body>
</html>
