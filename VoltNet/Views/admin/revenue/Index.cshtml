@model VoltNet.Controllers.admin.AdminRevenueViewModel
@{
    ViewData["Title"] = "Platform Revenue Intelligence";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="rv-page">

    <div class="rv-head">
        <h4>Platform Revenue</h4>
        <div class="rv-actions">
            <a href="/admin/revenue/analytics" class="btn btn-main">
                <i class="fas fa-sliders-h"></i> Analyst Studio
            </a>
            <a href="/admin/revenue/export" class="btn btn-ghost">
                <i class="fas fa-file-csv"></i> Export
            </a>
        </div>
    </div>

    <!-- KPI cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-wallet"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Total GMV</div>
                    <div class="kpi-value">₹@Model.TotalPlatformGMV.ToString("N0")</div>
                    <div class="kpi-note">₹@Model.ThisMonthGMV.ToString("N0") this month</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-charging-station"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Charging Revenue</div>
                    <div class="kpi-value">₹@Model.TotalBookingRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.TotalBookingCount bookings | @Model.TotalEnergyKwh.ToString("N0") kWh</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-info">
                <div class="kpi-icon"><i class="fas fa-crown"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Subscriptions</div>
                    <div class="kpi-value">₹@Model.TotalSubscriptionRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.ActiveSubscriptionsCount Active | @Model.ExpiredSubscriptionsCount Expired</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-warn">
                <div class="kpi-icon"><i class="fas fa-network-wired"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Stations</div>
                    <div class="kpi-value">@Model.TotalStationsCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 12-month chart -->
    <div class="card gap-b">
        <div class="card-header">
            <h5>12-Month Revenue</h5>
        </div>
        <div class="card-body">
            <div class="chart-box">
                <canvas id="platformTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Top 10 stations -->
        <div class="col-lg-7 col-12 gap-b">
            <div class="card h-100">
                <div class="card-header">
                    <h5>Top 10 Stations</h5>
                </div>
                <div class="card-body flush">
                    <div class="table-responsive">
                        <table class="table no-datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 60px;">#</th>
                                    <th>Station</th>
                                    <th class="text-center">Bookings</th>
                                    <th class="text-center">kWh</th>
                                    <th class="text-right">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopStations.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="cell-empty">No completed sessions yet.</td>
                                    </tr>
                                }
                                else
                                {
                                    int rank = 1;
                                    @foreach (var st in Model.TopStations)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @if (rank == 1) { <span class="pill pill-gold">1</span> }
                                                else if (rank == 2) { <span class="pill pill-silver">2</span> }
                                                else if (rank == 3) { <span class="pill pill-bronze">3</span> }
                                                else { <span class="pill pill-plain">@rank</span> }
                                            </td>
                                            <td>
                                                <div class="cell-strong">@st.StationName</div>
                                                <div class="cell-sub">@st.City</div>
                                            </td>
                                            <td class="text-center cell-strong">@st.TotalBookings</td>
                                            <td class="text-center cell-kwh">@st.TotalEnergyKwh.ToString("N1")</td>
                                            <td class="text-right cell-money">₹@st.TotalRevenue.ToString("N2")</td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 col-12">
            <!-- Top 5 cities -->
            <div class="card gap-b">
                <div class="card-header">
                    <h5>Top 5 Cities</h5>
                </div>
                <div class="card-body flush">
                    <div class="table-responsive">
                        <table class="table no-datatable">
                            <thead>
                                <tr>
                                    <th>City</th>
                                    <th class="text-center">Stations</th>
                                    <th class="text-center">Bookings</th>
                                    <th class="text-right">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopCities.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="cell-empty">No city revenue yet.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var city in Model.TopCities)
                                    {
                                        <tr>
                                            <td class="cell-strong">@city.City</td>
                                            <td class="text-center"><span class="pill pill-count">@city.StationCount</span></td>
                                            <td class="text-center cell-strong">@city.TotalBookings</td>
                                            <td class="text-right cell-money">₹@city.TotalRevenue.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Subscription health -->
            <div class="card">
                <div class="card-header">
                    <h5>Subscription Health</h5>
                </div>
                <div class="card-body">
                    @{
                        var totalSubs = Math.Max(1, Model.ActiveSubscriptionsCount + Model.ExpiredSubscriptionsCount + Model.CancelledSubscriptionsCount);
                        var activePct = Math.Round(((double)Model.ActiveSubscriptionsCount / totalSubs) * 100);
                        var expiredPct = Math.Round(((double)Model.ExpiredSubscriptionsCount / totalSubs) * 100);
                        var cancelledPct = Math.Round(((double)Model.CancelledSubscriptionsCount / totalSubs) * 100);
                    }
                    <div class="health-top">
                        <span>Active Owners</span>
                        <span class="pill pill-success">@Model.ActiveSubscriptionsCount</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bar-active" role="progressbar" style="width: @activePct%;" title="Active"></div>
                        <div class="progress-bar bar-expired" role="progressbar" style="width: @expiredPct%;" title="Expired"></div>
                        <div class="progress-bar bar-cancelled" role="progressbar" style="width: @cancelledPct%;" title="Cancelled"></div>
                    </div>

                    <div class="health-stats">
                        <div>
                            <div class="lbl">Active</div>
                            <div class="num num-active">@Model.ActiveSubscriptionsCount</div>
                        </div>
                        <div>
                            <div class="lbl">Expired</div>
                            <div class="num num-expired">@Model.ExpiredSubscriptionsCount</div>
                        </div>
                        <div>
                            <div class="lbl">Cancelled</div>
                            <div class="num num-cancelled">@Model.CancelledSubscriptionsCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const labels = @Html.Raw(Model.MonthLabelsJson);
            const chargingData = @Html.Raw(Model.ChargingRevenueJson);
            const subscriptionData = @Html.Raw(Model.SubscriptionRevenueJson);
            const totalData = @Html.Raw(Model.TotalRevenueJson);

            const ctx = document.getElementById('platformTrendChart');
            if (ctx) {
                new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Total GMV (₹)',
                                data: totalData,
                                borderColor: '#34395E',
                                backgroundColor: 'transparent',
                                borderWidth: 3,
                                tension: 0.3,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                pointBackgroundColor: '#34395E',
                                order: 1
                            },
                            {
                                type: 'bar',
                                label: 'Charging Revenue (₹)',
                                data: chargingData,
                                backgroundColor: 'rgba(61, 201, 179, 0.8)',
                                borderColor: '#3DC9B3',
                                borderWidth: 1,
                                borderRadius: 4,
                                order: 2
                            },
                            {
                                type: 'bar',
                                label: 'Subscriptions (₹)',
                                data: subscriptionData,
                                backgroundColor: 'rgba(103, 119, 239, 0.8)',
                                borderColor: '#6777EF',
                                borderWidth: 1,
                                borderRadius: 4,
                                order: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 15,
                                    color: '#353C48'
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ctx.dataset.label + ': ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: '#96A2B4' }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: '#E3EAEF' },
                                ticks: {
                                    color: '#96A2B4',
                                    callback: function (val) {
                                        return '₹' + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val);
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}