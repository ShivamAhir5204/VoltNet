@model VoltNet.Controllers.admin.RevenueAnalystStudioViewModel
@{
    ViewData["Title"] = "Financial Analyst Studio & Custom Date Review";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .an-page {
        --primary: #6777EF;
        --text: #353C48;
        --hover: #34395E;
        --muted: #96A2B4;
        --teal: #3DC9B3;
        --white: #FFFFFF;
        --bg: #F9F9F9;
        --field: #F2F2F2;
        --border: #E3EAEF;
        --success: #28C76F;
        --warning: #FFA117;
        --error: #EA5455;
        --info: #3ABAF4;
        color: var(--text);
        font-size: 15px;
    }

    /* Header */
    .an-page .an-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    .an-page .an-head h4 { margin: 0; font-size: 22px; font-weight: 600; color: var(--text); }
    .an-page .an-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* Buttons */
    .an-page .btn-main,
    .an-page .btn-ghost,
    .an-page .btn-back {
        min-height: 44px;
        padding: 0 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 500;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .an-page .btn-main {
        background-color: #6777EF !important;
        border: 1px solid #6777EF !important;
        color: #FFFFFF !important;
    }
    .an-page .btn-main:hover,
    .an-page .btn-main:focus,
    .an-page .btn-main:active {
        background-color: #34395E !important;
        border-color: #34395E !important;
        color: #FFFFFF !important;
    }
    .an-page .btn-ghost {
        background-color: #FFFFFF !important;
        border: 1px solid #3DC9B3 !important;
        color: #353C48 !important;
    }
    .an-page .btn-ghost:hover,
    .an-page .btn-ghost:focus,
    .an-page .btn-ghost:active {
        background-color: #3DC9B3 !important;
        border-color: #3DC9B3 !important;
        color: #FFFFFF !important;
    }
    .an-page .btn-back {
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
    }
    .an-page .btn-back:hover,
    .an-page .btn-back:focus,
    .an-page .btn-back:active {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }
    .an-page .btn-main i,
    .an-page .btn-ghost i,
    .an-page .btn-back i { color: inherit !important; }

    /* Preset and metric chips */
    .an-page .chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .an-page .chip {
        min-height: 40px;
        padding: 0 16px;
        margin: 0 !important;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        background-color: #FFFFFF !important;
        border: 1px solid #E3EAEF !important;
        color: #353C48 !important;
        transition: background-color .2s, color .2s, border-color .2s;
    }
    .an-page .chip:hover,
    .an-page .chip:focus {
        background-color: #F9F9F9 !important;
        border-color: #96A2B4 !important;
        color: #353C48 !important;
    }
    .an-page .chip.active,
    .an-page .chip.active:hover,
    .an-page .chip.active:focus,
    .an-page .chip:active {
        background-color: #6777EF !important;
        border-color: #6777EF !important;
        color: #FFFFFF !important;
        box-shadow: none !important;
    }
    .an-page .chip input { position: absolute; opacity: 0; pointer-events: none; }

    .an-page .btn-main:focus,
    .an-page .btn-ghost:focus,
    .an-page .btn-back:focus,
    .an-page .chip:focus {
        outline: 3px solid rgba(103, 119, 239, .35);
        outline-offset: 2px;
        box-shadow: none;
    }

    /* Cards */
    .an-page .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(52, 57, 94, .06);
        margin-bottom: 0;
    }
    .an-page .card-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        border-radius: 12px 12px 0 0;
        padding: 16px 20px;
        min-height: 0;
        gap: 12px;
    }
    .an-page .card-header h5 { margin: 0; font-size: 17px; font-weight: 600; color: var(--text); }
    .an-page .card-body { padding: 20px; }
    .an-page .card-body.flush { padding: 0; }
    .an-page .gap-b { margin-bottom: 24px; }

    /* Filter form */
    .an-page .form-label {
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
    }
    .an-page .form-control {
        background: var(--field);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        min-height: 44px;
        height: auto;
        padding: 0 14px;
        font-size: 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .an-page .form-control:hover { border-color: var(--muted); }
    .an-page .form-control:focus {
        background: var(--white);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(103, 119, 239, .2);
        outline: 0;
    }

    /* KPI cards */
    .an-page .kpi { display: flex; align-items: center; gap: 16px; padding: 20px; height: 100%; }
    .an-page .kpi-icon {
        flex: 0 0 52px;
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }
    .an-page .kpi-teal   .kpi-icon { background: rgba(61, 201, 179, .15);  color: var(--teal); }
    .an-page .kpi-info   .kpi-icon { background: rgba(58, 186, 244, .14);  color: var(--info); }
    .an-page .kpi-indigo .kpi-icon { background: rgba(103, 119, 239, .12); color: var(--primary); }
    .an-page .kpi-warn   .kpi-icon { background: rgba(255, 161, 23, .14);  color: var(--warning); }
    .an-page .kpi-text { min-width: 0; }
    .an-page .kpi-label {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .an-page .kpi-value { font-size: 24px; font-weight: 700; color: var(--text); line-height: 1.3; word-break: break-word; }
    .an-page .kpi-value small { font-size: 14px; font-weight: 500; color: var(--muted); }
    .an-page .kpi-note { color: var(--muted); font-size: 13px; }

    /* Chart */
    .an-page .chart-box { position: relative; height: 350px; }

    /* Tables */
    .an-page .table { margin: 0; color: var(--text); }
    .an-page .table thead th {
        background: var(--bg);
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-top: 0;
        border-bottom: 1px solid var(--border);
        padding: 14px 12px;
        white-space: nowrap;
    }
    .an-page .table td {
        padding: 14px 12px;
        vertical-align: middle;
        border-top: 1px solid var(--border);
    }
    .an-page .table tbody tr:hover { background: rgba(103, 119, 239, .06); }
    .an-page .table-scroll { max-height: 400px; overflow-y: auto; }
    .an-page .table-scroll thead th { position: sticky; top: 0; z-index: 1; }

    /* Side spacing (!important beats the template) */
    .an-page .table th:first-child,
    .an-page .table td:first-child { padding-left: 24px !important; }
    .an-page .table th:last-child,
    .an-page .table td:last-child  { padding-right: 24px !important; }

    .an-page .cell-strong { font-weight: 600; color: var(--text); }
    .an-page .cell-money  { font-weight: 600; color: #1B8F50; white-space: nowrap; }
    .an-page .cell-kwh    { font-weight: 600; color: var(--info); }
    .an-page .cell-muted  { color: var(--muted); white-space: nowrap; }
    .an-page .cell-empty  { text-align: center; color: var(--muted); padding: 24px 12px !important; }

    /* Share bars */
    .an-page .share { display: flex; align-items: center; gap: 8px; min-width: 100px; }
    .an-page .share .progress { flex: 1; height: 6px; border-radius: 3px; background: var(--field); overflow: hidden; }
    .an-page .share .bar-teal   { background-color: #3DC9B3; }
    .an-page .share .bar-indigo { background-color: #6777EF; }
    .an-page .share span { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; }

    /* Payment icons */
    .an-page .pay-icon { margin-right: 8px; }
    .an-page .pay-upi  { color: var(--primary); }
    .an-page .pay-cash { color: var(--success); }
    .an-page .pay-card { color: var(--warning); }

    /* Mobile */
    @@media (max-width: 767px) {
        .an-page .an-head h4 { font-size: 20px; }
        .an-page .an-actions { width: 100%; flex-direction: column; }
        .an-page .btn-main,
        .an-page .btn-ghost,
        .an-page .btn-back { width: 100%; }
        .an-page .card-header { padding: 14px 16px; }
        .an-page .card-body { padding: 16px; }
        .an-page .card-body.flush { padding: 0; }
        .an-page .kpi { padding: 16px; }
        .an-page .kpi-value { font-size: 22px; }
        .an-page .chart-box { height: 280px; }
        .an-page .chips { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
        .an-page .chip { width: 100%; padding: 0 8px; }
        .an-page .table th:first-child,
        .an-page .table td:first-child { padding-left: 16px !important; }
        .an-page .table th:last-child,
        .an-page .table td:last-child  { padding-right: 16px !important; }
    }
</style>

<div class="an-page">

    <div class="an-head">
        <h4>Analyst Studio</h4>
        <div class="an-actions">
            <a href="/admin/revenue/analytics/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))&stationId=@Model.SelectedStationId&city=@Model.SelectedCity&paymentMethod=@Model.SelectedPaymentMethod" class="btn btn-ghost">
                <i class="fas fa-file-excel"></i> Export CSV
            </a>
            <a href="/admin/revenue" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card gap-b">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
            <h5>Filters</h5>
            <div class="chips">
                <button type="button" class="btn chip" onclick="applyPreset(7, 'day')">Last 7 Days</button>
                <button type="button" class="btn chip" onclick="applyPreset(30, 'day')">Last 30 Days</button>
                <button type="button" class="btn chip" onclick="applyPreset(90, 'week')">Last 90 Days</button>
                <button type="button" class="btn chip" onclick="applyPreset(365, 'month')">Past 1 Year</button>
            </div>
        </div>
        <div class="card-body">
            <form method="get" action="/admin/revenue/analytics" id="analystFilterForm" class="row">
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
                    <label class="form-label">From</label>
                    <input type="date" name="startDate" id="filterStartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
                    <label class="form-label">To</label>
                    <input type="date" name="endDate" id="filterEndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
                    <label class="form-label">Granularity</label>
                    <select name="groupBy" id="filterGroupBy" class="form-control">
                        <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                        <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                        <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
                    <label class="form-label">Station</label>
                    <select name="stationId" class="form-control">
                        <option value="">All Stations (@Model.AvailableStations.Count)</option>
                        @foreach (var s in Model.AvailableStations)
                        {
                            <!option value="@s.Id" @(Model.SelectedStationId.HasValue && Model.SelectedStationId.Value == s.Id ? "selected" : "")>@s.Name (@s.City)</!option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
                    <label class="form-label">City</label>
                    <select name="city" class="form-control">
                        <option value="">All Cities</option>
                        @foreach (var c in Model.AvailableCities)
                        {
                            <!option value="@c" @(string.Equals(Model.SelectedCity, c, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@c</!option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-main btn-block"><i class="fas fa-search"></i> Run Analysis</button>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-rupee-sign"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Gross Revenue</div>
                    <div class="kpi-value">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.TotalBookings sessions</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-info">
                <div class="kpi-icon"><i class="fas fa-bolt"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Energy</div>
                    <div class="kpi-value">@Model.TotalEnergyKwh.ToString("N1") <small>kWh</small></div>
                    <div class="kpi-note">₹@Model.EffectiveRatePerKwh.ToString("N2") avg rate/kWh</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-calculator"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Avg Order Value</div>
                    <div class="kpi-value">₹@Model.AverageOrderValue.ToString("N0")</div>
                    <div class="kpi-note">₹@Model.AveragePeriodRevenue.ToString("N0") avg per @Model.GroupBy</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-warn">
                <div class="kpi-icon"><i class="fas fa-trophy"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Peak @Model.GroupBy.ToUpper()</div>
                    <div class="kpi-value">₹@Model.PeakPeriodRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.PeakPeriodLabel</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="card gap-b">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
            <h5>Trend</h5>
            <div class="chips btn-group-toggle" data-toggle="buttons">
                <label class="btn chip active" onclick="switchMetric('revenue')">
                    <input type="radio" name="options" checked> Revenue
                </label>
                <label class="btn chip" onclick="switchMetric('energy')">
                    <input type="radio" name="options"> Energy
                </label>
                <label class="btn chip" onclick="switchMetric('count')">
                    <input type="radio" name="options"> Sessions
                </label>
                <label class="btn chip" onclick="switchMetric('aov')">
                    <input type="radio" name="options"> AOV
                </label>
            </div>
        </div>
        <div class="card-body">
            <div class="chart-box">
                <canvas id="analystMatrixChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- City breakdown -->
        <div class="col-lg-6 col-12 gap-b">
            <div class="card h-100">
                <div class="card-header">
                    <h5>Cities</h5>
                </div>
                <div class="card-body flush">
                    <div class="table-responsive">
                        <table class="table no-datatable">
                            <thead>
                                <tr>
                                    <th>City</th>
                                    <th class="text-center">Bookings</th>
                                    <th class="text-center">kWh</th>
                                    <th class="text-right">Revenue</th>
                                    <th style="width: 140px;">Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CityBreakdown.Any())
                                {
                                    <tr><td colspan="5" class="cell-empty">No transactions in this period.</td></tr>
                                }
                                else
                                {
                                    @foreach (var c in Model.CityBreakdown)
                                    {
                                        <tr>
                                            <td class="cell-strong">@c.City</td>
                                            <td class="text-center">@c.Count</td>
                                            <td class="text-center cell-kwh">@c.EnergyKwh.ToString("N1")</td>
                                            <td class="text-right cell-money">₹@c.Revenue.ToString("N0")</td>
                                            <td>
                                                <div class="share">
                                                    <div class="progress"><div class="progress-bar bar-teal" style="width: @c.SharePercentage%;"></div></div>
                                                    <span>@c.SharePercentage%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment breakdown -->
        <div class="col-lg-6 col-12 gap-b">
            <div class="card h-100">
                <div class="card-header">
                    <h5>Payment Methods</h5>
                </div>
                <div class="card-body flush">
                    <div class="table-responsive">
                        <table class="table no-datatable">
                            <thead>
                                <tr>
                                    <th>Method</th>
                                    <th class="text-center">Transactions</th>
                                    <th class="text-right">Collection</th>
                                    <th style="width: 140px;">Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.PaymentBreakdown.Any())
                                {
                                    <tr><td colspan="4" class="cell-empty">No transactions in this period.</td></tr>
                                }
                                else
                                {
                                    @foreach (var p in Model.PaymentBreakdown)
                                    {
                                        <tr>
                                            <td class="cell-strong">
                                                @if (p.Method.Contains("UPI")) { <i class="fas fa-qrcode pay-icon pay-upi"></i> }
                                                else if (p.Method.Contains("Cash")) { <i class="fas fa-money-bill-wave pay-icon pay-cash"></i> }
                                                else { <i class="fas fa-credit-card pay-icon pay-card"></i> }
                                                @p.Method
                                            </td>
                                            <td class="text-center">@p.Count</td>
                                            <td class="text-right cell-money">₹@p.Revenue.ToString("N2")</td>
                                            <td>
                                                <div class="share">
                                                    <div class="progress"><div class="progress-bar bar-indigo" style="width: @p.SharePercentage%;"></div></div>
                                                    <span>@p.SharePercentage%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ledger -->
    <div class="card gap-b">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Ledger</h5>
        </div>
        <div class="card-body flush">
            <div class="table-responsive table-scroll">
                <table class="table no-datatable">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th class="text-center">Sessions</th>
                            <th class="text-center">kWh</th>
                            <th class="text-right">Revenue</th>
                            <th class="text-right">AOV</th>
                            <th class="text-right">Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TimeSeries.Any())
                        {
                            <tr><td colspan="6" class="cell-empty">No data in selected date range.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Model.TimeSeries)
                            {
                                <tr>
                                    <td class="cell-strong">@row.Label</td>
                                    <td class="text-center">@row.Count</td>
                                    <td class="text-center cell-kwh">@row.EnergyKwh.ToString("N1")</td>
                                    <td class="text-right cell-money">₹@row.Revenue.ToString("N2")</td>
                                    <td class="text-right">₹@row.AverageOrderValue.ToString("N0")</td>
                                    <td class="text-right cell-muted">₹@row.EffectiveRatePerKwh.ToString("N2")/kWh</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Preset Date Quick Selector
        function applyPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('filterStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('filterEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('filterGroupBy').value = group;
            document.getElementById('analystFilterForm').submit();
        }

        // Multi-Metric Chart Engine
        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRevenue = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let currentChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Gross Revenue (₹)',
                data: dataRevenue,
                borderColor: '#3DC9B3',
                backgroundColor: 'rgba(61, 201, 179, 0.15)',
                prefix: '₹',
                suffix: ''
            },
            energy: {
                label: 'Energy Dispensed (kWh)',
                data: dataEnergy,
                borderColor: '#3ABAF4',
                backgroundColor: 'rgba(58, 186, 244, 0.15)',
                prefix: '',
                suffix: ' kWh'
            },
            count: {
                label: 'Completed Sessions',
                data: dataCount,
                borderColor: '#6777EF',
                backgroundColor: 'rgba(103, 119, 239, 0.15)',
                prefix: '',
                suffix: ' sessions'
            },
            aov: {
                label: 'Average Order Value (₹)',
                data: dataAov,
                borderColor: '#34395E',
                backgroundColor: 'rgba(52, 57, 94, 0.12)',
                prefix: '₹',
                suffix: ''
            }
        };

        function initChart(metric) {
            const ctx = document.getElementById('analystMatrixChart');
            if (!ctx) return;

            const config = metricConfigs[metric];
            if (currentChart) {
                currentChart.destroy();
            }

            currentChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: config.label,
                        data: config.data,
                        borderColor: config.borderColor,
                        backgroundColor: config.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: labels.length > 40 ? 1 : 3.5,
                        pointHoverRadius: 6,
                        pointBackgroundColor: config.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + config.label + ': ' + config.prefix + Number(ctx.raw).toLocaleString('en-IN') + config.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#96A2B4' }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#E3EAEF' },
                            ticks: {
                                color: '#96A2B4',
                                callback: function (val) {
                                    return config.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + config.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchMetric(metric) {
            initChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            initChart('revenue');
        });
    </script>
}