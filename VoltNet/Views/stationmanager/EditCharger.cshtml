@model VoltNet.Models.Charger
@{
    ViewData["Title"] = "Edit Charger";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card card-primary shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h4 class="text-dark font-weight-bold mb-0">
                    <i class="fas fa-edit text-primary mr-2"></i> Edit Charger Point — @Model.Name
                </h4>
                <a href="/manager/chargers" class="btn btn-outline-secondary btn-sm font-weight-600">
                    <i class="fas fa-arrow-left mr-1"></i> Back
                </a>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="StationId" />

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label class="font-weight-600 font-13 mb-1 text-dark">Charger Point / Bay Name <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Name" class="form-control" required placeholder="e.g. Fast DC Bay 1">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label class="font-weight-600 font-13 mb-1 text-dark">Connector Type <span class="text-danger">*</span></label>
                            <select asp-for="ConnectorType" class="form-control" required>
                                <option value="CCS2">CCS2 (DC Fast)</option>
                                <option value="Type 2">Type 2 (AC)</option>
                                <option value="CHAdeMO">CHAdeMO</option>
                                <option value="GB/T">GB/T</option>
                                <option value="15A Domestic">15A Domestic</option>
                            </select>
                            <span asp-validation-for="ConnectorType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label class="font-weight-600 font-13 mb-1 text-dark">Power Rating (kW) <span class="text-danger">*</span></label>
                            <input type="number" asp-for="CapacityKw" class="form-control font-mono" step="0.1" min="1" max="500" required>
                            <span asp-validation-for="CapacityKw" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label class="font-weight-600 font-13 mb-1 text-dark">Operational Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-control" required>
                                <option value="Active">Active (Available for booking)</option>
                                <option value="Maintenance">Under Maintenance</option>
                                <option value="Offline">Offline</option>
                                <option value="Inactive">Inactive / Decommissioned</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3 pt-3 border-top d-flex align-items-center">
                        <button type="submit" class="btn btn-primary font-weight-700 px-4 py-2 mr-2">
                            <i class="fas fa-save mr-1"></i> Update Charger Point
                        </button>
                        <a href="/manager/chargers" class="btn btn-outline-secondary font-weight-600 px-3 py-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
