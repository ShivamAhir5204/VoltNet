@model VoltNet.Controllers.stationowner.OwnerIndividualStationRevenueViewModel
@{
    ViewData["Title"] = $"{Model.Station.Name} — Revenue Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    var paymentBreakdown = ViewBag.PaymentBreakdown as dynamic;
}

<meta name="viewport" content="width=device-width, initial-scale=1" />
<div class="mgr-revenue">

<!-- Page Header -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box page-head d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between mb-3 bg-white p-3 rounded shadow-sm">
            <div>
                <div class="d-flex align-items-center flex-wrap" style="gap: 12px;">
                    <h4 class="mb-0 font-weight-bold mr-3">
                        <i class="fas fa-chart-line mr-2"></i>@Model.Station.Name — Revenue Dashboard
                    </h4>
                    @if (Model.Station.Status == "Active")
                    {
                        <span class="badge status-pill status-active px-2 py-1 font-weight-bold">
                            <i class="fas fa-bolt mr-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="badge status-pill status-neutral px-2 py-1 font-weight-bold">
                            @Model.Station.Status
                        </span>
                    }
                </div>
                <div class="head-meta font-weight-500 mt-1">
                    <i class="fas fa-map-marker-alt mr-1"></i>@Model.Station.Address, @Model.Station.City &bull; @Model.Station.OpeningTime.ToString(@"hh\:mm") - @Model.Station.ClosingTime.ToString(@"hh\:mm")
                </div>
            </div>
            <div class="action-btns mt-2 mt-lg-0 d-flex flex-wrap align-items-center">
                <a href="/manager/revenue/export-pdf?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))"
                   class="btn btn-act-primary font-weight-bold px-3 py-1 mr-2">
                    <i class="fas fa-file-pdf mr-1"></i>Download PDF
                </a>
                <a href="/manager/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))"
                   class="btn btn-act-secondary font-weight-bold px-3 py-1 mr-2">
                    <i class="fas fa-file-csv mr-1"></i>Export CSV
                </a>
                <a href="/manager/station"
                   class="btn btn-act-secondary font-weight-bold px-3 py-1">
                    <i class="fas fa-charging-station mr-1"></i>My Station
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Macro Lifetime Cards -->
<div class="row">
    <!-- Today -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold">TODAY</div>
                <div class="stat-icon-box tile-primary">
                    <i class="fas fa-coins"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between flex-wrap" style="gap: 8px;">
                <div class="stat-value font-weight-bold">₹@Model.TodayRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0">
                    <i class="fas fa-bolt mr-1"></i>@Model.TodayBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- This Week -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold">THIS WEEK</div>
                <div class="stat-icon-box tile-teal">
                    <i class="fas fa-calendar-week"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between flex-wrap" style="gap: 8px;">
                <div class="stat-value font-weight-bold">₹@Model.WeekRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0">
                    <i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- This Month -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold">THIS MONTH</div>
                <div class="stat-icon-box tile-info">
                    <i class="fas fa-calendar-alt"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between flex-wrap" style="gap: 8px;">
                <div class="stat-value font-weight-bold">₹@Model.MonthRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0">
                    <i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- All-Time -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold">ALL-TIME</div>
                <div class="stat-icon-box tile-dark">
                    <i class="fas fa-trophy"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between flex-wrap" style="gap: 8px;">
                <div class="stat-value font-weight-bold">₹@Model.AllTimeRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0">
                    <i class="fas fa-bolt mr-1"></i>@Model.TotalEnergyKwh.ToString("N0") kWh
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Operational Highlights -->
<div class="row mb-3">
    <!-- Top Charger -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="card hl-card hl-primary shadow-sm p-3 mb-0 h-100">
            <div class="d-flex align-items-center">
                <div class="hl-icon tile-primary">
                    <i class="fas fa-plug"></i>
                </div>
                <div style="min-width: 0;">
                    <div class="hl-title font-weight-bold text-uppercase">Top Earning Charger</div>
                    <div class="d-flex align-items-center flex-wrap mt-1" style="gap: 8px;">
                        <span class="hl-main font-weight-bold text-truncate" title="@Model.TopChargerName">@Model.TopChargerName</span>
                        <span class="badge chip">@Model.TopChargerConnector</span>
                    </div>
                    <div class="mt-1">
                        <span class="hl-sub font-weight-bold">₹@Model.TopChargerRevenue.ToString("N0")</span>
                        <span class="hl-sub font-weight-600 ml-1">(@Model.TopChargerSharePct%)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Demand Hour -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="card hl-card hl-dark shadow-sm p-3 mb-0 h-100">
            <div class="d-flex align-items-center">
                <div class="hl-icon tile-dark">
                    <i class="fas fa-fire"></i>
                </div>
                <div>
                    <div class="hl-title font-weight-bold text-uppercase">Peak Demand Hour</div>
                    <div class="hl-main font-weight-bold mt-1">@Model.PeakHourRange</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bay Utilization -->
    <div class="col-lg-4 col-md-12 col-12">
        <div class="card hl-card hl-teal shadow-sm p-3 mb-0 d-flex flex-column justify-content-between h-100">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="hl-title font-weight-bold text-uppercase">30-Day Bay Utilization</span>
                    <span class="badge chip font-weight-bold px-2 py-0">
                        @Model.UtilizationPct%
                    </span>
                </div>
                <div class="progress mb-1">
                    <div class="progress-bar bar-teal" role="progressbar" style="width: @Model.UtilizationPct%;" aria-valuenow="@Model.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="hl-sub font-weight-600 mt-2">
                @Model.Station.Chargers?.Count chargers
            </div>
        </div>
    </div>
</div>

<!-- Date Filter Panel -->
<div class="card section-card shadow-sm mb-3">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
        <h6 class="mb-0 font-weight-bold">
            <i class="fas fa-sliders-h mr-2"></i>Date Range
        </h6>
        <div class="preset-group d-flex flex-wrap mt-2 mt-md-0" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary btn-act-secondary py-1 px-2 mr-1 mb-1 font-weight-600" onclick="applyManagerPreset(7, 'day')">7 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-act-secondary py-1 px-2 mr-1 mb-1 font-weight-600" onclick="applyManagerPreset(30, 'day')">30 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-act-secondary py-1 px-2 mr-1 mb-1 font-weight-600" onclick="applyManagerPreset(90, 'week')">90 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-act-secondary py-1 px-2 mb-1 font-weight-600" onclick="applyManagerPreset(365, 'month')">1 Year</button>
        </div>
    </div>
    <div class="card-body p-3">
        <form method="get" action="/manager/revenue" id="managerFilterForm" class="row align-items-end">
            <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                <label class="filter-label font-weight-bold mb-1">From</label>
                <input type="date" name="startDate" id="mgrStartDate" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                <label class="filter-label font-weight-bold mb-1">To</label>
                <input type="date" name="endDate" id="mgrEndDate" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 mb-3 mb-lg-0">
                <label class="filter-label font-weight-bold mb-1">Interval</label>
                <select name="groupBy" id="mgrGroupBy" class="form-control form-control-sm">
                    <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                    <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                    <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex filter-actions">
                <button type="submit" class="btn btn-sm btn-block btn-act-primary font-weight-bold">
                    <i class="fas fa-filter mr-1"></i>Apply
                </button>
                <a href="/manager/revenue" class="btn btn-sm btn-act-secondary ml-2 d-flex align-items-center justify-content-center" title="Reset Filters">
                    <i class="fas fa-redo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Filtered Period Summary Cards -->
<div class="row mb-3">
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="card period-card text-center shadow-sm mb-0">
            <div class="period-label font-weight-bold text-uppercase">Period Revenue</div>
            <div class="period-value font-weight-bold">₹@Model.PeriodRevenue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="card period-card text-center shadow-sm mb-0">
            <div class="period-label font-weight-bold text-uppercase">Sessions</div>
            <div class="period-value font-weight-bold">@Model.PeriodBookings</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="card period-card text-center shadow-sm mb-0">
            <div class="period-label font-weight-bold text-uppercase">Energy</div>
            <div class="period-value font-weight-bold">@Model.PeriodEnergyKwh.ToString("N1") <span>kWh</span></div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card period-card text-center shadow-sm mb-0">
            <div class="period-label font-weight-bold text-uppercase">Avg Order Value</div>
            <div class="period-value font-weight-bold">₹@Model.PeriodAvgTicket.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Interactive Time-Series Telemetry Chart -->
<div class="card section-card shadow-sm mb-3">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
        <h6 class="mb-0 font-weight-bold">
            <i class="fas fa-chart-area mr-2"></i>Revenue & Charging Telemetry
        </h6>
        <!-- Metric Switcher -->
        <div class="d-flex flex-wrap mt-2 mt-md-0" id="mgrMetricSwitcher">
            <button type="button" class="btn btn-sm btn-outline-success font-weight-600 mr-1 active" id="btn-metric-revenue" onclick="switchManagerMetric('revenue')">
                <i class="fas fa-rupee-sign mr-1"></i>Revenue
            </button>
            <button type="button" class="btn btn-sm btn-outline-info font-weight-600 mr-1" id="btn-metric-energy" onclick="switchManagerMetric('energy')">
                <i class="fas fa-bolt mr-1"></i>Energy
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary font-weight-600 mr-1" id="btn-metric-count" onclick="switchManagerMetric('count')">
                <i class="fas fa-charging-station mr-1"></i>Sessions
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning font-weight-600" id="btn-metric-aov" onclick="switchManagerMetric('aov')">
                <i class="fas fa-tag mr-1"></i>AOV
            </button>
        </div>
    </div>
    <div class="card-body p-3">
        @if (Model.PeriodRevenue == 0)
        {
            <div class="empty-chart text-center py-4">
                <i class="fas fa-chart-line fa-2x mb-2"></i>
                <div class="font-weight-600">No sessions in this period</div>
            </div>
        }
        else
        {
            <div class="chart-wrap" style="position: relative; height: 260px;">
                <canvas id="managerTelemetryChart"></canvas>
            </div>
        }
    </div>
</div>

<!-- Charger Breakdown & Payment Mode Split -->
<div class="row">
    <!-- Charger Breakdown Table -->
    <div class="col-lg-8 col-12 mb-3">
        <div class="card section-card shadow-sm h-100">
            <div class="card-header border-0 py-2 px-3 d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0 font-weight-bold">
                    <i class="fas fa-plug mr-2"></i>Charger Utilization & Earnings
                </h6>
                <span class="badge chip px-2 py-1 font-weight-bold">
                    @Model.ChargerBreakdowns.Count Chargers
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 no-datatable">
                        <thead>
                            <tr>
                                <th>Charger</th>
                                <th>Connector</th>
                                <th class="text-center">Sessions</th>
                                <th class="text-center">Energy (kWh)</th>
                                <th class="text-right">Revenue</th>
                                <th class="share-cell">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChargerBreakdowns.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3">
                                        No chargers configured
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ch in Model.ChargerBreakdowns)
                                {
                                    <tr>
                                        <td class="font-weight-bold">
                                            <i class="fas fa-bolt mr-2"></i>@ch.ChargerName
                                        </td>
                                        <td>
                                            <span class="badge chip font-weight-600 px-2 py-0">
                                                @ch.ConnectorType
                                            </span>
                                            @if (ch.CapacityKw > 0)
                                            {
                                                <small class="font-weight-600 ml-1">(@ch.CapacityKw kW)</small>
                                            }
                                        </td>
                                        <td class="text-center font-weight-bold">@ch.TotalBookings</td>
                                        <td class="text-center font-weight-bold">@ch.TotalEnergyKwh.ToString("N1")</td>
                                        <td class="text-right font-weight-bold">₹@ch.TotalRevenue.ToString("N0")</td>
                                        <td class="share-cell">
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 mr-2">
                                                    <div class="progress-bar bar-teal" style="width: @ch.RevenueSharePercentage%;"></div>
                                                </div>
                                                <small class="font-weight-bold" style="min-width: 40px; text-align: right;">@ch.RevenueSharePercentage%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Channels -->
    <div class="col-lg-4 col-12 mb-3">
        <div class="card section-card shadow-sm h-100">
            <div class="card-header border-0 py-2 px-3">
                <h6 class="card-title mb-0 font-weight-bold">
                    <i class="fas fa-wallet mr-2"></i>Collection Channels
                </h6>
            </div>
            <div class="card-body p-3">
                @if (paymentBreakdown != null)
                {
                    @foreach (var p in paymentBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="pay-method font-weight-bold">
                                    @if (p.Method.ToString().Contains("UPI")) { <i class="fas fa-qrcode mr-1"></i> }
                                    else if (p.Method.ToString().Contains("Cash")) { <i class="fas fa-money-bill-wave mr-1"></i> }
                                    else { <i class="fas fa-credit-card mr-1"></i> }
                                    @p.Method
                                </span>
                                <span class="pay-amount font-weight-bold">₹@p.Amount.ToString("N0") <small>(@p.Count)</small></span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bar-primary" style="width: @p.Share%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-chart text-center py-4">No transactions</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Itemized Sessions Table -->
<div class="card section-card shadow-sm mb-3">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center">
        <h6 class="card-title mb-0 font-weight-bold">
            <i class="fas fa-receipt mr-2"></i>Recent Charging Sessions
        </h6>
        <a href="/manager/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))"
           class="btn btn-act-secondary font-weight-bold px-3 py-1 mt-2 mt-sm-0">
            <i class="fas fa-download mr-1"></i>Export CSV
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 no-datatable">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Charger</th>
                        <th>Date & Time</th>
                        <th>Customer & Vehicle</th>
                        <th class="text-center">Energy</th>
                        <th class="text-right">Amount</th>
                        <th class="text-center">Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentSessions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                No transactions in this period
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.RecentSessions)
                        {
                            var refCode = $"VN-{b.Id.ToString()[..8].ToUpper()}";
                            var cost = b.ActualCost ?? b.EstimatedCost;
                            <tr>
                                <td class="font-weight-bold">@refCode</td>
                                <td>
                                    <span class="badge chip font-weight-600 px-2 py-0">
                                        @(b.Charger?.Name ?? "Charger")
                                    </span>
                                </td>
                                <td>
                                    <div class="font-weight-600">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <small>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold">@(b.CustomerName ?? b.Customer?.Fullname ?? "Walk-In")</div>
                                    <small>@(b.VehicleModel ?? b.VehicleNumberPlate ?? "EV")</small>
                                </td>
                                <td class="text-center font-weight-bold">@(b.UnitsConsumedKwh?.ToString("N1") ?? "—") <small>kWh</small></td>
                                <td class="text-right font-weight-bold">₹@cost.ToString("N0")</td>
                                <td class="text-center">
                                    <span class="badge chip font-weight-600 px-2 py-0">
                                        @(b.PaymentMethod ?? "UPI")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function applyManagerPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('mgrStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('mgrEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('mgrGroupBy').value = group;
            document.getElementById('managerFilterForm').submit();
        }

        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRev = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let mgrChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Revenue (₹)',
                data: dataRev,
                borderColor: '#6777EF',
                backgroundColor: 'rgba(103, 119, 239, 0.12)',
                prefix: '₹',
                suffix: ''
            },
            energy: {
                label: 'Energy (kWh)',
                data: dataEnergy,
                borderColor: '#3DC9B3',
                backgroundColor: 'rgba(61, 201, 179, 0.12)',
                prefix: '',
                suffix: ' kWh'
            },
            count: {
                label: 'Sessions',
                data: dataCount,
                borderColor: '#34395E',
                backgroundColor: 'rgba(52, 57, 94, 0.10)',
                prefix: '',
                suffix: ' sessions'
            },
            aov: {
                label: 'AOV (₹)',
                data: dataAov,
                borderColor: '#3ABAF4',
                backgroundColor: 'rgba(58, 186, 244, 0.12)',
                prefix: '₹',
                suffix: ''
            }
        };

        function initManagerChart(metric) {
            const ctx = document.getElementById('managerTelemetryChart');
            if (!ctx) return;

            const cfg = metricConfigs[metric];
            if (mgrChart) {
                mgrChart.destroy();
            }

            mgrChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.borderColor,
                        backgroundColor: cfg.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2,
                        pointRadius: labels.length > 40 ? 1 : 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: cfg.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#34395E',
                            titleColor: '#FFFFFF',
                            bodyColor: '#FFFFFF',
                            borderColor: '#E3EAEF',
                            borderWidth: 1,
                            padding: 8,
                            displayColors: false,
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + cfg.label + ': ' + cfg.prefix + Number(ctx.raw).toLocaleString('en-IN') + cfg.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#E3EAEF' },
                            ticks: { color: '#96A2B4', font: { family: 'inherit', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#E3EAEF' },
                            ticks: {
                                color: '#96A2B4',
                                font: { family: 'inherit', size: 11 },
                                callback: function (val) {
                                    return cfg.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + cfg.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchManagerMetric(metric) {
            const switcher = document.getElementById('mgrMetricSwitcher');
            if (switcher) {
                const buttons = switcher.querySelectorAll('.btn');
                buttons.forEach(btn => {
                    btn.classList.remove('active');
                });
                const activeBtn = document.getElementById('btn-metric-' + metric);
                if (activeBtn) {
                    activeBtn.classList.add('active');
                }
            }
            initManagerChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (labels.length > 0) {
                initManagerChart('revenue');
            }
        });
    </script>
}