@{
    ViewData["Title"] = "Station Revenue Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    var station = ViewBag.Station as VoltNet.Models.Station;
    var recentTransactions = ViewBag.RecentTransactions as List<VoltNet.Models.Booking> ?? new List<VoltNet.Models.Booking>();
    var paymentBreakdown = ViewBag.PaymentBreakdown as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div>
                <h2 class="section-title text-dark font-weight-bold mb-1">
                    <i class="fas fa-chart-line text-success mr-2"></i> Station Revenue Dashboard
                </h2>
                <p class="section-lead text-muted mb-0">
                    @(station != null ? station.Name : "My Station") &bull; Real-time billing aggregations & financial performance.
                </p>
            </div>
            <div class="mt-2 mt-md-0">
                <span class="badge badge-success px-3 py-2 font-13 font-weight-bold shadow-sm">
                    <i class="fas fa-bolt mr-1"></i> Live Active Metering
                </span>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ErrorMessage
    </div>
}
else
{
    <!-- ── 1. Top Stat Cards ────────────────────────────────────────── -->
    <div class="row">
        <!-- Today -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-statistic-1 shadow-sm" style="border-radius: 12px; border-top: 4px solid #10b981;">
                <div class="card-icon bg-success">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div class="card-wrap">
                    <div class="card-header pb-0">
                        <h4 class="text-uppercase font-weight-600 font-12 text-muted">Today's Revenue</h4>
                    </div>
                    <div class="card-body">
                        <span class="font-weight-bold text-dark font-22">₹@(((decimal)ViewBag.TodayRevenue).ToString("N2"))</span>
                        <div class="text-muted font-12 font-weight-600 mt-1">
                            <i class="fas fa-charging-station text-success mr-1"></i> @ViewBag.TodayCount session(s)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Week -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-statistic-1 shadow-sm" style="border-radius: 12px; border-top: 4px solid #3b82f6;">
                <div class="card-icon bg-primary">
                    <i class="fas fa-calendar-week"></i>
                </div>
                <div class="card-wrap">
                    <div class="card-header pb-0">
                        <h4 class="text-uppercase font-weight-600 font-12 text-muted">This Week</h4>
                    </div>
                    <div class="card-body">
                        <span class="font-weight-bold text-dark font-22">₹@(((decimal)ViewBag.WeekRevenue).ToString("N2"))</span>
                        <div class="text-muted font-12 font-weight-600 mt-1">
                            <i class="fas fa-charging-station text-primary mr-1"></i> @ViewBag.WeekCount session(s)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Month -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-statistic-1 shadow-sm" style="border-radius: 12px; border-top: 4px solid #8b5cf6;">
                <div class="card-icon" style="background-color: #8b5cf6; color: #fff;">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="card-wrap">
                    <div class="card-header pb-0">
                        <h4 class="text-uppercase font-weight-600 font-12 text-muted">This Month</h4>
                    </div>
                    <div class="card-body">
                        <span class="font-weight-bold text-dark font-22">₹@(((decimal)ViewBag.MonthRevenue).ToString("N2"))</span>
                        <div class="text-muted font-12 font-weight-600 mt-1">
                            <i class="fas fa-charging-station mr-1" style="color: #8b5cf6;"></i> @ViewBag.MonthCount session(s)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- All-Time Gross & Energy -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-statistic-1 shadow-sm" style="border-radius: 12px; border-top: 4px solid #f59e0b;">
                <div class="card-icon bg-warning">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="card-wrap">
                    <div class="card-header pb-0">
                        <h4 class="text-uppercase font-weight-600 font-12 text-muted">All-Time Revenue</h4>
                    </div>
                    <div class="card-body">
                        <span class="font-weight-bold text-dark font-22">₹@(((decimal)ViewBag.AllTimeRevenue).ToString("N2"))</span>
                        <div class="text-muted font-12 font-weight-600 mt-1">
                            <i class="fas fa-bolt text-warning mr-1"></i> @(((decimal)ViewBag.TotalEnergyDispensed).ToString("N1")) kWh pumped
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 2. Performance Highlights (Top Charger, Peak Hour, Utilization) ── -->
    <div class="row">
        <!-- Top Charger -->
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100" style="border-radius: 10px;">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; background: #e0f2fe; color: #0284c7; font-size: 22px; flex-shrink: 0;">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="w-100">
                        <small class="text-muted text-uppercase font-weight-bold font-11 d-block">Top Earning Charger</small>
                        <h6 class="mb-0 font-weight-bold text-dark">@ViewBag.TopChargerName</h6>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="badge badge-light border text-muted font-11">@ViewBag.TopChargerConnector</span>
                            <span class="badge badge-primary font-11 font-weight-bold">@ViewBag.TopChargerSharePct% of total rev</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Peak Hour -->
        <div class="col-12 col-md-4 mt-3 mt-md-0">
            <div class="card shadow-sm h-100" style="border-radius: 10px;">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; background: #fef3c7; color: #d97706; font-size: 22px; flex-shrink: 0;">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="w-100">
                        <small class="text-muted text-uppercase font-weight-bold font-11 d-block">Peak Demand Hour</small>
                        <h6 class="mb-0 font-weight-bold text-dark">@ViewBag.PeakHourRange</h6>
                        <small class="text-muted d-block mt-1">Highest charging session frequency</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Utilization Rate -->
        <div class="col-12 col-md-4 mt-3 mt-md-0">
            <div class="card shadow-sm h-100" style="border-radius: 10px;">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 50px; height: 50px; background: #dcfce7; color: #16a34a; font-size: 22px; flex-shrink: 0;">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div class="w-100">
                        <small class="text-muted text-uppercase font-weight-bold font-11 d-block">30-Day Bay Utilization</small>
                        <h6 class="mb-0 font-weight-bold text-dark">@ViewBag.UtilizationPct% Capacity</h6>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @ViewBag.UtilizationPct%;" aria-valuenow="@ViewBag.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 3. Revenue Chart (Last 30 Days) ────────────────────────── -->
    <div class="row mt-3">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap">
                    <h5 class="mb-0 font-weight-bold text-dark font-16">
                        <i class="fas fa-chart-area text-primary mr-1"></i> Daily Revenue Trend (Last 30 Days)
                    </h5>
                    <span class="badge badge-light border text-muted font-12">Currency: INR (₹)</span>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if ((decimal)ViewBag.AllTimeRevenue == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-line text-muted mb-3" style="font-size: 48px; opacity: 0.4;"></i>
                            <h6 class="font-weight-bold text-dark">No revenue data yet</h6>
                            <p class="text-muted small mb-0">Completed customer and walk-in charging sessions will plot daily analytics here.</p>
                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 320px; width: 100%;">
                            <canvas id="dailyRevenueChart"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Mode Breakdown -->
        <div class="col-12 col-lg-4 mt-3 mt-lg-0">
            <div class="card shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 font-weight-bold text-dark font-16">
                        <i class="fas fa-money-check-alt text-info mr-1"></i> Collection Channels
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if (!paymentBreakdown.Any() || (decimal)ViewBag.AllTimeRevenue == 0)
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="fas fa-wallet mb-2" style="font-size: 32px; opacity: 0.3;"></i>
                            <p class="mb-0">No payment records logged.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in paymentBreakdown)
                        {
                            decimal itemAmt = (decimal)item.Amount;
                            decimal totalRev = (decimal)ViewBag.AllTimeRevenue;
                            int pct = totalRev > 0 ? (int)Math.Round((itemAmt / totalRev) * 100) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="font-14 text-dark">@item.Method</strong>
                                    <span class="font-weight-bold text-success font-14">₹@itemAmt.ToString("N2") <small class="text-muted">(@pct%)</small></span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" style="width: @pct%;"></div>
                                </div>
                                <small class="text-muted">@item.Count session(s)</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── 4. Recent Completed Charging Transactions ───────────────── -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-weight-bold text-dark font-16">
                        <i class="fas fa-receipt text-warning mr-1"></i> Recent Completed Charging Transactions
                    </h5>
                    <a href="/manager/bookings" class="btn btn-sm btn-outline-primary font-weight-600">
                        View All Bookings &rarr;
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!recentTransactions.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-receipt text-muted mb-2" style="font-size: 40px; opacity: 0.4;"></i>
                            <h6 class="font-weight-bold text-dark">No Completed Sessions</h6>
                            <p class="text-muted small mb-0">Completed charging transactions will appear here for reconciliation.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0 no-datatable font-14">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date & Slot</th>
                                        <th>Vehicle</th>
                                        <th>Charger / Gun</th>
                                        <th>Energy Units</th>
                                        <th>Rate</th>
                                        <th>Payment Mode</th>
                                        <th class="text-right">Billed Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in recentTransactions)
                                    {
                                        <tr>
                                            <td>
                                                <div class="font-weight-bold text-dark">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                                <small class="text-muted">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge badge-light border font-weight-bold text-dark">
                                                    @(string.IsNullOrWhiteSpace(b.VehicleNumberPlate) ? "—" : b.VehicleNumberPlate)
                                                </span>
                                                @if (b.IsWalkIn)
                                                {
                                                    <span class="badge badge-info font-10 ml-1">Spot</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="font-weight-600">@(b.Charger?.Name ?? "Bay")</div>
                                                <small class="text-muted">@(b.Charger?.ConnectorType ?? "CCS2")</small>
                                            </td>
                                            <td>
                                                <strong class="text-primary font-weight-bold">@(b.UnitsConsumedKwh?.ToString("F2") ?? "0.00")</strong>
                                                <span class="text-muted small">kWh</span>
                                            </td>
                                            <td>
                                                ₹@(b.AppliedRatePerKwh?.ToString("F2") ?? "15.00")/kWh
                                            </td>
                                            <td>
                                                <span class="badge badge-success font-11">
                                                    <i class="fas fa-check-circle mr-1"></i> @(string.IsNullOrWhiteSpace(b.PaymentMethod) ? "UPI" : b.PaymentMethod)
                                                </span>
                                            </td>
                                            <td class="text-right">
                                                <strong class="text-dark font-15">₹@((b.ActualCost ?? b.EstimatedCost).ToString("N2"))</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            var ctx = document.getElementById('dailyRevenueChart');
            if (ctx) {
                var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels ?? new List<string>()));
                var revData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartRevenue ?? new List<decimal>()));

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Daily Revenue (₹)',
                            data: revData,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.12)',
                            borderWidth: 2.5,
                            pointBackgroundColor: '#10b981',
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            fill: true,
                            tension: 0.35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' Revenue: ₹' + Number(context.parsed.y).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return '₹' + value;
                                    }
                                },
                                grid: {
                                    borderDash: [4, 4]
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
