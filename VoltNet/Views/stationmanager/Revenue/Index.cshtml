@model VoltNet.Controllers.stationowner.OwnerIndividualStationRevenueViewModel
@{
    ViewData["Title"] = $"{Model.Station.Name} — Revenue Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    var paymentBreakdown = ViewBag.PaymentBreakdown as dynamic;
}

<!-- Page Header (Compact Otika Style) -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between mb-3 bg-white p-3 rounded shadow-sm" style="border: 1px solid #E3EAEF;">
            <div>
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 font-weight-bold mr-3" style="color: #353C48; font-size: 20px;">
                        <i class="fas fa-chart-line mr-2" style="color: #6777EF;"></i>@Model.Station.Name — Revenue Dashboard
                    </h4>
                    @if (Model.Station.Status == "Active")
                    {
                        <span class="badge px-2 py-1 font-weight-bold" style="background: rgba(40, 199, 111, 0.12); color: #28C76F; border-radius: 6px; font-size: 11px;">
                            <i class="fas fa-bolt mr-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="badge px-2 py-1 font-weight-bold" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 6px; font-size: 11px;">
                            @Model.Station.Status
                        </span>
                    }
                </div>
                <div class="font-weight-500 mt-1" style="color: #96A2B4; font-size: 12px;">
                    <i class="fas fa-map-marker-alt mr-1" style="color: #EA5455;"></i>@Model.Station.Address, @Model.Station.City &bull; Operating Hours: @Model.Station.OpeningTime.ToString(@"hh\:mm") - @Model.Station.ClosingTime.ToString(@"hh\:mm")
                </div>
            </div>
            <div class="action-btns mt-2 mt-lg-0 d-flex flex-wrap align-items-center">
                <a href="/manager/revenue/export-pdf?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
                   class="btn font-weight-bold px-3 py-1 mr-2 shadow-sm" 
                   style="background: #E8F4FD; border: 1.5px solid #2B6CB0; color: #2B6CB0; border-radius: 6px; font-size: 12px;">
                    <i class="fas fa-file-pdf mr-1 text-danger"></i>Download PDF
                </a>
                <a href="/manager/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
                   class="btn font-weight-bold px-3 py-1 mr-2 shadow-sm" 
                   style="background: #FFFFFF; border: 1.5px solid #28C76F; color: #28C76F; border-radius: 6px; font-size: 12px;">
                    <i class="fas fa-file-csv mr-1"></i>Export CSV
                </a>
                <a href="/manager/station" 
                   class="btn font-weight-bold px-3 py-1 shadow-sm" 
                   style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; font-size: 12px;">
                    <i class="fas fa-charging-station mr-1 text-primary"></i>My Station
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Macro Lifetime Cards -->
<div class="row">
    <!-- Today -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0" style="min-height: 105px;">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold" style="font-size: 12px; color: #96A2B4;">TODAY</div>
                <div class="stat-icon-box" style="width: 36px; height: 36px; font-size: 15px; background: rgba(40, 199, 111, 0.12); color: #28C76F; border-radius: 8px;">
                    <i class="fas fa-coins"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="stat-value font-weight-bold" style="font-size: 22px; color: #353C48;">₹@Model.TodayRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0" style="background: rgba(40, 199, 111, 0.12); color: #28C76F; font-size: 11px;">
                    <i class="fas fa-bolt mr-1"></i>@Model.TodayBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- This Week -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0" style="min-height: 105px;">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold" style="font-size: 12px; color: #96A2B4;">THIS WEEK</div>
                <div class="stat-icon-box" style="width: 36px; height: 36px; font-size: 15px; background: rgba(103, 119, 239, 0.12); color: #6777EF; border-radius: 8px;">
                    <i class="fas fa-calendar-week"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="stat-value font-weight-bold" style="font-size: 22px; color: #353C48;">₹@Model.WeekRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0" style="background: rgba(103, 119, 239, 0.12); color: #6777EF; font-size: 11px;">
                    <i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- This Month -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0" style="min-height: 105px;">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold" style="font-size: 12px; color: #96A2B4;">THIS MONTH</div>
                <div class="stat-icon-box" style="width: 36px; height: 36px; font-size: 15px; background: rgba(61, 201, 179, 0.12); color: #3DC9B3; border-radius: 8px;">
                    <i class="fas fa-calendar-alt"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="stat-value font-weight-bold" style="font-size: 22px; color: #353C48;">₹@Model.MonthRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0" style="background: rgba(61, 201, 179, 0.12); color: #3DC9B3; font-size: 11px;">
                    <i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions
                </span>
            </div>
        </div>
    </div>

    <!-- All-Time -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
        <div class="revenue-stat-card p-3 mb-0" style="min-height: 105px;">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="stat-label font-weight-bold" style="font-size: 12px; color: #96A2B4;">ALL-TIME</div>
                <div class="stat-icon-box" style="width: 36px; height: 36px; font-size: 15px; background: rgba(255, 161, 23, 0.12); color: #FFA117; border-radius: 8px;">
                    <i class="fas fa-trophy"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="stat-value font-weight-bold" style="font-size: 22px; color: #353C48;">₹@Model.AllTimeRevenue.ToString("N0")</div>
                <span class="stat-badge px-2 py-0" style="background: rgba(255, 161, 23, 0.12); color: #FFA117; font-size: 11px;">
                    <i class="fas fa-bolt mr-1"></i>@Model.TotalEnergyKwh.ToString("N0") kWh
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Operational Highlights (Compact) -->
<div class="row mb-3">
    <!-- Top Charger -->
    <div class="col-lg-4 col-md-6 col-12 mb-2 mb-lg-0">
        <div class="card shadow-sm p-3 mb-0" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-left: 4px solid #6777EF !important; border-radius: 8px;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle mr-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(103, 119, 239, 0.12); color: #6777EF; font-size: 16px; flex-shrink: 0;">
                    <i class="fas fa-plug"></i>
                </div>
                <div style="min-width: 0;">
                    <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">Top Earning Charger</div>
                    <div class="d-flex align-items-center flex-wrap mt-1">
                        <span class="font-weight-bold mr-2 text-truncate" style="color: #353C48; font-size: 14px;" title="@Model.TopChargerName">@Model.TopChargerName</span>
                        <span class="badge" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; font-size: 10px;">@Model.TopChargerConnector</span>
                    </div>
                    <div class="mt-1">
                        <span class="font-weight-bold" style="color: #28C76F; font-size: 12px;">₹@Model.TopChargerRevenue.ToString("N0")</span>
                        <span class="font-weight-600 ml-1" style="color: #96A2B4; font-size: 11px;">(@Model.TopChargerSharePct% of total rev)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Demand Hour -->
    <div class="col-lg-4 col-md-6 col-12 mb-2 mb-lg-0">
        <div class="card shadow-sm p-3 mb-0" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-left: 4px solid #EA5455 !important; border-radius: 8px;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle mr-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: rgba(234, 84, 85, 0.12); color: #EA5455; font-size: 16px; flex-shrink: 0;">
                    <i class="fas fa-fire"></i>
                </div>
                <div>
                    <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">Peak Demand Hour</div>
                    <div class="font-weight-bold mt-1" style="color: #353C48; font-size: 14px;">@Model.PeakHourRange</div>
                    <div class="mt-1">
                        <span class="badge" style="background: rgba(234, 84, 85, 0.12); color: #EA5455; font-size: 10px;">
                            <i class="fas fa-clock mr-1"></i>Highest charging session frequency
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bay Utilization -->
    <div class="col-lg-4 col-md-12 col-12">
        <div class="card shadow-sm p-3 mb-0 d-flex flex-column justify-content-between" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-left: 4px solid #3DC9B3 !important; border-radius: 8px;">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">30-Day Bay Utilization</span>
                    <span class="badge font-weight-bold px-2 py-0" style="background: rgba(61, 201, 179, 0.15); color: #3DC9B3; border-radius: 6px; font-size: 11px;">
                        @Model.UtilizationPct% Capacity
                    </span>
                </div>
                <div class="progress mb-1" style="height: 6px; background: #F2F2F2; border-radius: 3px;">
                    <div class="progress-bar" role="progressbar" style="width: @Model.UtilizationPct%; background: #3DC9B3; border-radius: 3px;" aria-valuenow="@Model.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="font-weight-600 mt-1" style="color: #96A2B4; font-size: 11px;">
                @Model.Station.Chargers?.Count charger bays configured
            </div>
        </div>
    </div>
</div>

<!-- Compact Date Filter Panel -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="mb-0 font-weight-bold" style="color: #353C48; font-size: 14px;">
            <i class="fas fa-sliders-h mr-2" style="color: #6777EF;"></i>Date Range & Intervals
        </h6>
        <div class="d-flex flex-wrap mt-2 mt-md-0" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 mr-1 mb-1 font-weight-600" style="font-size: 11px; border-radius: 4px;" onclick="applyManagerPreset(7, 'day')">7 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 mr-1 mb-1 font-weight-600" style="font-size: 11px; border-radius: 4px;" onclick="applyManagerPreset(30, 'day')">30 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 mr-1 mb-1 font-weight-600" style="font-size: 11px; border-radius: 4px;" onclick="applyManagerPreset(90, 'week')">90 Days</button>
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 mb-1 font-weight-600" style="font-size: 11px; border-radius: 4px;" onclick="applyManagerPreset(365, 'month')">1 Year</button>
        </div>
    </div>
    <div class="card-body p-3">
        <form method="get" action="/manager/revenue" id="managerFilterForm" class="row align-items-end">
            <div class="col-12 col-sm-6 col-lg-4 mb-2 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 11px; text-transform: uppercase;">From</label>
                <input type="date" name="startDate" id="mgrStartDate" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;" />
            </div>
            <div class="col-12 col-sm-6 col-lg-4 mb-2 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 11px; text-transform: uppercase;">To</label>
                <input type="date" name="endDate" id="mgrEndDate" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 mb-2 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 11px; text-transform: uppercase;">Interval</label>
                <select name="groupBy" id="mgrGroupBy" class="form-control form-control-sm" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;">
                    <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                    <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                    <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex">
                <button type="submit" class="btn btn-sm btn-block font-weight-bold" style="background: #6777EF; color: #FFFFFF; border-radius: 6px; height: 31px;">
                    <i class="fas fa-filter mr-1"></i>Apply
                </button>
                <a href="/manager/revenue" class="btn btn-sm ml-2 d-flex align-items-center justify-content-center" title="Reset Filters" style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; width: 34px; height: 31px;">
                    <i class="fas fa-redo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Filtered Period Summary Cards (Compact) -->
<div class="row mb-3">
    <div class="col-xl-3 col-sm-6 col-12 mb-2 mb-xl-0">
        <div class="card p-2 text-center shadow-sm" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px;">Period Revenue</div>
            <div class="font-weight-bold" style="color: #28C76F; font-size: 18px;">₹@Model.PeriodRevenue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-2 mb-xl-0">
        <div class="card p-2 text-center shadow-sm" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px;">Sessions</div>
            <div class="font-weight-bold" style="color: #6777EF; font-size: 18px;">@Model.PeriodBookings</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-2 mb-xl-0">
        <div class="card p-2 text-center shadow-sm" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px;">Energy</div>
            <div class="font-weight-bold" style="color: #3DC9B3; font-size: 18px;">@Model.PeriodEnergyKwh.ToString("N1") <span style="font-size: 12px; font-weight: 600;">kWh</span></div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="card p-2 text-center shadow-sm" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px;">Avg Order Value</div>
            <div class="font-weight-bold" style="color: #FFA117; font-size: 18px;">₹@Model.PeriodAvgTicket.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Interactive Time-Series Telemetry Chart -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="mb-0 font-weight-bold" style="color: #353C48; font-size: 14px;">
            <i class="fas fa-chart-area mr-2" style="color: #28C76F;"></i>Revenue & Charging Telemetry
        </h6>
        <!-- Metric Switcher -->
        <div class="d-flex flex-wrap mt-2 mt-md-0" id="mgrMetricSwitcher">
            <button type="button" class="btn btn-sm btn-outline-success font-weight-600 mr-1 active" id="btn-metric-revenue" onclick="switchManagerMetric('revenue')">
                <i class="fas fa-rupee-sign mr-1"></i>Revenue
            </button>
            <button type="button" class="btn btn-sm btn-outline-info font-weight-600 mr-1" id="btn-metric-energy" onclick="switchManagerMetric('energy')">
                <i class="fas fa-bolt mr-1"></i>Energy
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary font-weight-600 mr-1" id="btn-metric-count" onclick="switchManagerMetric('count')">
                <i class="fas fa-charging-station mr-1"></i>Sessions
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning font-weight-600" id="btn-metric-aov" onclick="switchManagerMetric('aov')">
                <i class="fas fa-tag mr-1"></i>AOV
            </button>
        </div>
    </div>
    <div class="card-body p-3">
        @if (Model.PeriodRevenue == 0)
        {
            <div class="text-center py-4">
                <i class="fas fa-chart-line fa-2x mb-2" style="color: #96A2B4; opacity: 0.4;"></i>
                <div class="font-weight-600" style="color: #96A2B4; font-size: 13px;">No session telemetry in this selected period.</div>
            </div>
        }
        else
        {
            <div style="position: relative; height: 260px;">
                <canvas id="managerTelemetryChart"></canvas>
            </div>
        }
    </div>
</div>

<!-- Charger Breakdown & Payment Mode Split -->
<div class="row">
    <!-- Charger Breakdown Table -->
    <div class="col-lg-8 col-12 mb-3">
        <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="card-header border-0 py-2 px-3 d-flex justify-content-between align-items-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
                <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 14px;">
                    <i class="fas fa-plug mr-2" style="color: #6777EF;"></i>Charger Utilization & Earnings
                </h6>
                <span class="badge px-2 py-1 font-weight-bold" style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; font-size: 10px;">
                    @Model.ChargerBreakdowns.Count Chargers
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color: #353C48; font-size: 13px;">
                        <thead style="background: #F9F9F9; border-bottom: 1.5px solid #E3EAEF; color: #34395E; font-size: 11px; font-weight: 700; text-transform: uppercase;">
                            <tr>
                                <th class="pl-3 py-2 border-0">Charger</th>
                                <th class="py-2 border-0">Connector</th>
                                <th class="py-2 border-0 text-center">Sessions</th>
                                <th class="py-2 border-0 text-center">Energy (kWh)</th>
                                <th class="py-2 border-0 text-right">Revenue</th>
                                <th class="pr-3 py-2 border-0" style="width: 130px;">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChargerBreakdowns.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3" style="color: #96A2B4; font-weight: 500;">
                                        No chargers configured for this station.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ch in Model.ChargerBreakdowns)
                                {
                                    <tr style="border-top: 1px solid #E3EAEF;">
                                        <td class="pl-3 font-weight-bold" style="color: #353C48; vertical-align: middle;">
                                            <i class="fas fa-bolt mr-2" style="color: #FFA117;"></i>@ch.ChargerName
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <span class="badge font-weight-600 px-2 py-0" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px; font-size: 11px;">
                                                @ch.ConnectorType
                                            </span>
                                            @if (ch.CapacityKw > 0)
                                            {
                                                <small class="font-weight-600 ml-1" style="color: #96A2B4;">(@ch.CapacityKw kW)</small>
                                            }
                                        </td>
                                        <td class="text-center font-weight-bold" style="color: #353C48; vertical-align: middle;">@ch.TotalBookings</td>
                                        <td class="text-center font-weight-bold" style="color: #3DC9B3; vertical-align: middle;">@ch.TotalEnergyKwh.ToString("N1")</td>
                                        <td class="text-right font-weight-bold" style="color: #28C76F; vertical-align: middle; font-size: 14px;">₹@ch.TotalRevenue.ToString("N0")</td>
                                        <td class="pr-3" style="vertical-align: middle;">
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 mr-2" style="height: 5px; background: #F2F2F2; border-radius: 3px;">
                                                    <div class="progress-bar" style="width: @ch.RevenueSharePercentage%; background: #28C76F; border-radius: 3px;"></div>
                                                </div>
                                                <small class="font-weight-bold" style="color: #34395E; min-width: 32px; text-align: right; font-size: 11px;">@ch.RevenueSharePercentage%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Channels -->
    <div class="col-lg-4 col-12 mb-3">
        <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
            <div class="card-header border-0 py-2 px-3" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
                <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 14px;">
                    <i class="fas fa-wallet mr-2" style="color: #28C76F;"></i>Collection Channels
                </h6>
            </div>
            <div class="card-body p-3">
                @if (paymentBreakdown != null)
                {
                    @foreach (var p in paymentBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="font-weight-bold" style="color: #34395E; font-size: 12px;">
                                    @if (p.Method.ToString().Contains("UPI")) { <i class="fas fa-qrcode mr-1" style="color: #6777EF;"></i> }
                                    else if (p.Method.ToString().Contains("Cash")) { <i class="fas fa-money-bill-wave mr-1" style="color: #28C76F;"></i> }
                                    else { <i class="fas fa-credit-card mr-1" style="color: #FFA117;"></i> }
                                    @p.Method
                                </span>
                                <span class="font-weight-bold" style="color: #28C76F; font-size: 12px;">₹@p.Amount.ToString("N0") <small style="color: #96A2B4; font-weight: 500;">(@p.Count)</small></span>
                            </div>
                            <div class="progress" style="height: 5px; background: #F2F2F2; border-radius: 3px;">
                                <div class="progress-bar" style="width: @p.Share%; background: #6777EF; border-radius: 3px;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4" style="color: #96A2B4; font-weight: 500; font-size: 13px;">No transactions recorded.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Itemized Sessions Table -->
<div class="card shadow-sm mb-3" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 8px;">
    <div class="card-header border-0 py-2 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 14px;">
            <i class="fas fa-receipt mr-2" style="color: #6777EF;"></i>Recent Charging Sessions
        </h6>
        <a href="/manager/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
           class="btn font-weight-bold px-3 py-1 mt-1 mt-sm-0" 
           style="background: #FFFFFF; border: 1.5px solid #28C76F; color: #28C76F; border-radius: 6px; font-size: 11px;">
            <i class="fas fa-download mr-1"></i>Export CSV
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="color: #353C48; font-size: 13px;">
                <thead style="background: #F9F9F9; border-bottom: 1.5px solid #E3EAEF; color: #34395E; font-size: 11px; font-weight: 700; text-transform: uppercase;">
                    <tr>
                        <th class="pl-3 py-2 border-0">Ref</th>
                        <th class="py-2 border-0">Charger</th>
                        <th class="py-2 border-0">Date & Time</th>
                        <th class="py-2 border-0">Customer & Vehicle</th>
                        <th class="py-2 border-0 text-center">Energy</th>
                        <th class="py-2 border-0 text-right">Amount</th>
                        <th class="pr-3 py-2 border-0 text-center">Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentSessions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4" style="color: #96A2B4; font-weight: 500;">
                                No transactions found in this period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.RecentSessions)
                        {
                            var refCode = $"VN-{b.Id.ToString()[..8].ToUpper()}";
                            var cost = b.ActualCost ?? b.EstimatedCost;
                            <tr style="border-top: 1px solid #E3EAEF;">
                                <td class="pl-3 font-weight-bold" style="color: #6777EF; vertical-align: middle;">@refCode</td>
                                <td style="vertical-align: middle;">
                                    <span class="badge font-weight-600 px-2 py-0" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px; font-size: 11px;">
                                        @(b.Charger?.Name ?? "Charger")
                                    </span>
                                </td>
                                <td style="vertical-align: middle;">
                                    <div class="font-weight-600" style="color: #353C48;">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <small style="color: #96A2B4; font-weight: 500;">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td style="vertical-align: middle;">
                                    <div class="font-weight-bold" style="color: #353C48;">@(b.CustomerName ?? b.Customer?.Fullname ?? "Walk-In")</div>
                                    <small style="color: #96A2B4; font-weight: 500;">@(b.VehicleModel ?? b.VehicleNumberPlate ?? "EV")</small>
                                </td>
                                <td class="text-center font-weight-bold" style="color: #3DC9B3; vertical-align: middle;">@(b.UnitsConsumedKwh?.ToString("N1") ?? "—") <small style="color: #96A2B4;">kWh</small></td>
                                <td class="text-right font-weight-bold" style="color: #28C76F; vertical-align: middle; font-size: 14px;">₹@cost.ToString("N0")</td>
                                <td class="pr-3 text-center" style="vertical-align: middle;">
                                    <span class="badge font-weight-600 px-2 py-0" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px; font-size: 11px;">
                                        @(b.PaymentMethod ?? "UPI")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function applyManagerPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('mgrStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('mgrEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('mgrGroupBy').value = group;
            document.getElementById('managerFilterForm').submit();
        }

        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRev = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let mgrChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Revenue (₹)',
                data: dataRev,
                borderColor: '#28C76F',
                backgroundColor: 'rgba(40, 199, 111, 0.12)',
                prefix: '₹',
                suffix: ''
            },
            energy: {
                label: 'Energy (kWh)',
                data: dataEnergy,
                borderColor: '#3DC9B3',
                backgroundColor: 'rgba(61, 201, 179, 0.12)',
                prefix: '',
                suffix: ' kWh'
            },
            count: {
                label: 'Sessions',
                data: dataCount,
                borderColor: '#6777EF',
                backgroundColor: 'rgba(103, 119, 239, 0.12)',
                prefix: '',
                suffix: ' sessions'
            },
            aov: {
                label: 'AOV (₹)',
                data: dataAov,
                borderColor: '#FFA117',
                backgroundColor: 'rgba(255, 161, 23, 0.12)',
                prefix: '₹',
                suffix: ''
            }
        };

        function initManagerChart(metric) {
            const ctx = document.getElementById('managerTelemetryChart');
            if (!ctx) return;

            const cfg = metricConfigs[metric];
            if (mgrChart) {
                mgrChart.destroy();
            }

            mgrChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.borderColor,
                        backgroundColor: cfg.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2,
                        pointRadius: labels.length > 40 ? 1 : 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: cfg.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#34395E',
                            titleColor: '#FFFFFF',
                            bodyColor: '#FFFFFF',
                            borderColor: '#E3EAEF',
                            borderWidth: 1,
                            padding: 8,
                            displayColors: false,
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + cfg.label + ': ' + cfg.prefix + Number(ctx.raw).toLocaleString('en-IN') + cfg.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#F2F2F2' },
                            ticks: { color: '#96A2B4', font: { family: 'inherit', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#F2F2F2' },
                            ticks: {
                                color: '#96A2B4',
                                font: { family: 'inherit', size: 11 },
                                callback: function (val) {
                                    return cfg.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + cfg.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchManagerMetric(metric) {
            const switcher = document.getElementById('mgrMetricSwitcher');
            if (switcher) {
                const buttons = switcher.querySelectorAll('.btn');
                buttons.forEach(btn => {
                    btn.classList.remove('active');
                });
                const activeBtn = document.getElementById('btn-metric-' + metric);
                if (activeBtn) {
                    activeBtn.classList.add('active');
                }
            }
            initManagerChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (labels.length > 0) {
                initManagerChart('revenue');
            }
        });
    </script>
}
