@model VoltNet.Models.Charger
@{
    ViewData["Title"] = "Add New Charger";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}
<div class="ac">
<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Add Charger</h4>
                <a href="/manager/chargers" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Charger / Bay Name <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Name" class="form-control" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group col-md-6">
                            <label>Connector Type <span class="text-danger">*</span></label>
                            <select asp-for="ConnectorType" class="form-control" required>
                                <option value="">-- Select Connector --</option>
                                <option value="CCS2">CCS2 (DC Fast)</option>
                                <option value="Type 2">Type 2 (AC)</option>
                                <option value="CHAdeMO">CHAdeMO</option>
                                <option value="GB/T">GB/T</option>
                                <option value="15A Domestic">15A Domestic</option>
                            </select>
                            <span asp-validation-for="ConnectorType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Power Rating (kW) <span class="text-danger">*</span></label>
                            <input type="number" asp-for="CapacityKw" class="form-control" step="0.1" min="1" max="500" required>
                            <span asp-validation-for="CapacityKw" class="text-danger"></span>
                        </div>

                        <div class="form-group col-md-6">
                            <label>Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-control" required>
                                <option value="Active">Active (Available for booking)</option>
                                <option value="Maintenance">Under Maintenance</option>
                                <option value="Offline">Offline</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Save</button>
                        <a href="/manager/chargers" class="btn btn-back">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}