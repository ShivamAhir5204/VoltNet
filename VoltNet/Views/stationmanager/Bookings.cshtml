@model IEnumerable<VoltNet.Models.Booking>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var activeChargers = ViewBag.ActiveChargers as List<VoltNet.Models.Charger> ?? new List<VoltNet.Models.Charger>();
    ViewData["Title"] = $"Station Bookings - {station?.Name}";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card card-otika">
            <div class="card-header card-otika-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-0 text-dark-slate font-weight-700">
                        <i class="fas fa-charging-station text-otika-primary mr-2"></i> Bookings — @(station?.Name)
                    </h4>
                </div>
                <div class="d-flex gap-2 flex-wrap mt-2 mt-md-0" style="gap: 8px;">
                    <span class="badge badge-light border text-muted-slate font-weight-600 px-3 py-2 mr-1" id="liveMgrCountBadge">
                        Showing @Model.Count() bookings
                    </span>
                    <button type="button" class="btn btn-warning font-weight-bold text-dark btn-sm" data-toggle="modal" data-target="#walkInModal">
                        <i class="fas fa-bolt mr-1"></i> + Walk-In Driver
                    </button>
                    <a href="/manager/station-blocks" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-tools mr-1"></i> Maintenance
                    </a>
                </div>
            </div>
            <div class="card-body">
                <!-- Otika Instant Real-Time Filter Bar (Compact) -->
                <div class="otika-filter-bar">
                    <div class="row align-items-end">
                        <div class="col-12 col-md-4 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Quick Search</label>
                            <div class="input-group input-group-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0 text-muted-slate"><i class="fas fa-search"></i></span>
                                </div>
                                <input type="text" id="liveMgrSearchInput" class="form-control form-control-sm otika-search-input border-left-0" placeholder="Driver, plate, phone, charger..." />
                            </div>
                        </div>
                        <div class="col-12 col-md-3 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Status</label>
                            <select id="liveMgrStatusFilter" class="form-control form-control-sm otika-search-input">
                                <option value="">All Statuses</option>
                                <option value="confirmed">Confirmed</option>
                                <option value="charging">Charging</option>
                                <option value="completed">Completed</option>
                                <option value="cancelled">Cancelled</option>
                                <option value="noshow">No-Show</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Date</label>
                            <input type="date" id="liveMgrDateFilter" class="form-control form-control-sm otika-search-input" />
                        </div>
                        <div class="col-12 col-md-2">
                            <button type="button" id="btnMgrResetFilters" class="btn btn-outline-secondary btn-sm btn-block" title="Reset Filters" style="height: 31px;">
                                <i class="fas fa-redo-alt mr-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-soft-grey rounded border-otika">
                        <i class="fas fa-calendar-times text-muted-slate mb-3" style="font-size: 38px;"></i>
                        <h6 class="text-dark-slate font-weight-bold mb-1">No Bookings Recorded</h6>
                        <small class="text-muted-slate">Reservations and walk-in sessions for this station will appear here.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped otika-table align-middle table-responsive-cards" id="table-1">
                            <thead>
                                <tr>
                                    <th>Driver / Customer</th>
                                    <th>Vehicle & Charger</th>
                                    <th>Date & Slot</th>
                                    <th>Type</th>
                                    <th>Energy</th>
                                    <th>Final Cost</th>
                                    <th>Status</th>
                                    <th class="text-center" style="min-width: 200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model)
                                {
                                    var statusLower = b.Status.ToLower();
                                    <tr class="mgr-booking-row"
                                        data-status="@statusLower"
                                        data-date="@b.BookingDate.ToString("yyyy-MM-dd")"
                                        data-search="@($"{b.CustomerName} {b.Customer?.Fullname} {b.CustomerPhone} {b.Customer?.Mobile} {b.VehicleNumberPlate} {b.Charger?.Name} {b.Charger?.ConnectorType}".ToLower())">
                                        <td class="col-primary" data-label="Driver / Customer">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="font-weight-bold text-dark-slate">@(b.CustomerName ?? b.Customer?.Fullname ?? "Customer")</span>
                                                    <div class="small text-muted-slate"><i class="fas fa-phone mr-1"></i> @(b.CustomerPhone ?? b.Customer?.Mobile ?? "—")</div>
                                                </div>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Vehicle & Charger">
                                            <div>
                                                <strong class="text-dark-slate">@(string.IsNullOrEmpty(b.VehicleNumberPlate) ? "Plate: —" : b.VehicleNumberPlate)</strong>
                                                <div class="small text-muted-slate">@b.Charger?.Name (@b.Charger?.ConnectorType)</div>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Date & Slot">
                                            <div class="text-dark-slate font-weight-500">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted-slate">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</div>
                                        </td>
                                        <td class="col-secondary" data-label="Type">
                                            @if (b.IsWalkIn)
                                            {
                                                <span class="badge badge-otika-warning font-weight-bold">⚡ Walk-In</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-otika-info font-weight-bold">📱 App</span>
                                            }
                                        </td>
                                        <td class="col-secondary" data-label="Energy">
                                            @if (b.UnitsConsumedKwh.HasValue)
                                            {
                                                <strong class="text-dark-slate">@b.UnitsConsumedKwh.Value.ToString("F2") kWh</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted-slate">—</span>
                                            }
                                        </td>
                                        <td class="col-secondary" data-label="Final Cost">
                                            <div>
                                                @if (b.ActualCost.HasValue)
                                                {
                                                    <strong class="text-success" style="color: #28C76F !important;">₹@b.ActualCost.Value.ToString("F2")</strong>
                                                    @if (!string.IsNullOrEmpty(b.PaymentMethod))
                                                    {
                                                        <span class="badge badge-light border text-muted-slate font-11 d-block mt-1">@b.PaymentMethod</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted-slate">Est. ₹@b.EstimatedCost.ToString("F2")</span>
                                                    @if (b.BookingFee > 0 && !b.IsWalkIn)
                                                    {
                                                        <span class="badge badge-otika-warning font-11 d-block mt-1">₹@b.BookingFee.ToString("N0") Advance</span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Status">
                                            <div>
                                                @if (b.Status == "Charging")
                                                {
                                                    <span class="badge badge-otika-teal font-weight-bold px-2 py-1">
                                                        <i class="fas fa-bolt mr-1"></i> Charging
                                                    </span>
                                                }
                                                else if (b.Status == "Confirmed")
                                                {
                                                    <span class="badge badge-otika-primary">Confirmed</span>
                                                }
                                                else if (b.Status == "Completed")
                                                {
                                                    <span class="badge badge-otika-success">Completed</span>
                                                }
                                                else if (b.Status == "Cancelled")
                                                {
                                                    <span class="badge badge-otika-error" title="@b.CancellationReason">Cancelled</span>
                                                }
                                                else if (b.Status == "NoShow")
                                                {
                                                    <span class="badge badge-otika-warning">No-Show</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-otika-info">@b.Status</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center col-action" data-label="Actions">
                                            @if (b.Status == "Confirmed")
                                            {
                                                <div class="d-inline-flex align-items-center justify-content-center flex-nowrap" style="white-space: nowrap;">
                                                    <button type="button" class="btn btn-primary btn-sm mr-1 font-weight-bold"
                                                            onclick="openStartChargingModal('@b.Id', '@(b.CustomerName ?? b.Customer?.Fullname)', '@(b.VehicleNumberPlate ?? "")', '@(b.Charger?.Name)', '@(b.StartMeterReading ?? 0)')"
                                                            title="Plug in and Start Charging">
                                                        <i class="fas fa-play mr-1"></i> Start
                                                    </button>
                                                    <button type="button" class="btn btn-success btn-sm mr-1 font-weight-bold" 
                                                            onclick="openCompleteModal('@b.Id', '@(b.CustomerName ?? b.Customer?.Fullname)', '@(b.VehicleNumberPlate ?? "")', '@(b.AppliedRatePerKwh ?? 15.00m)', '@(b.StartMeterReading ?? 0)', @(b.BookingFee))" 
                                                            title="Complete with Meter Reading">
                                                        <i class="fas fa-gas-pump mr-1"></i> Bill
                                                    </button>
                                                    <form asp-action="NoShow" method="post" class="d-inline mb-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@b.Id" />
                                                        <button type="submit" class="btn btn-outline-warning btn-sm" onclick="return confirm('Mark booking as No-Show? This releases the slot and will automatically promote the next driver waiting in the queue.');" title="No Show">
                                                            <i class="fas fa-user-slash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else if (b.Status == "Charging")
                                            {
                                                <div class="d-inline-flex align-items-center justify-content-center flex-nowrap" style="white-space: nowrap;">
                                                    <button type="button" class="btn btn-success btn-sm mr-1 font-weight-bold shadow-sm" 
                                                            onclick="openCompleteModal('@b.Id', '@(b.CustomerName ?? b.Customer?.Fullname)', '@(b.VehicleNumberPlate ?? "")', '@(b.AppliedRatePerKwh ?? 15.00m)', '@(b.StartMeterReading ?? 0)', @(b.BookingFee))" 
                                                            title="Finish & Bill">
                                                        <i class="fas fa-stop-circle mr-1"></i> Finish & Bill
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (!string.IsNullOrEmpty(b.MeterPhotoUrl))
                                                {
                                                    <a href="@b.MeterPhotoUrl" target="_blank" class="btn btn-outline-info btn-sm">
                                                        <i class="fas fa-image mr-1"></i> Meter Photo
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small"><i class="fas fa-check mr-1"></i> Closed</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Walk-In / Spot Entry -->
<div class="modal fade" id="walkInModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-bolt mr-2"></i> Spot Charging / Walk-In Driver Entry</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="CreateWalkIn" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="small text-muted mb-3">Create an instant spot session for drivers arriving directly without prior online booking. This will lock the charger bay immediately.</p>
                    <div class="form-group">
                        <label class="font-weight-bold">Select Charger Bay <span class="text-danger">*</span></label>
                        <select name="chargerId" class="form-control" required>
                            @foreach (var c in activeChargers)
                            {
                                <option value="@c.Id">@c.Name (@c.ConnectorType, @c.CapacityKw kW)</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Vehicle Plate <span class="text-danger">*</span></label>
                                <input type="text" name="vehicleNumberPlate" class="form-control text-uppercase" placeholder="e.g. GJ01AB1234" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Driver Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="customerPhone" class="form-control" placeholder="10-digit mobile" required />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Driver Name:</label>
                                <input type="text" name="customerName" class="form-control" placeholder="e.g. Rahul Sharma" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Vehicle Model:</label>
                                <input type="text" name="vehicleModel" class="form-control" placeholder="e.g. Tata Nexon EV" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Estimated Duration:</label>
                                <select name="durationMinutes" class="form-control">
                                    <option value="30">30 Minutes</option>
                                    <option value="60" selected>1 Hour</option>
                                    <option value="90">1.5 Hours</option>
                                    <option value="120">2 Hours</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Initial Meter (kWh):</label>
                                <input type="number" step="0.01" name="initialMeterReading" class="form-control" placeholder="0.00" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning font-weight-bold text-dark"><i class="fas fa-play mr-1"></i> Start Spot Charging Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Start Charging Session -->
<div class="modal fade" id="startChargingModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-bolt mr-2"></i> Plug In & Start Charging Session</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="StartCharging" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="startBookingId" name="id" />
                <div class="modal-body">
                    <div class="p-3 bg-light rounded mb-3">
                        <strong id="startCustomerName" class="h6 text-dark d-block mb-1"></strong>
                        <div id="startVehiclePlate" class="text-primary font-weight-bold"></div>
                        <div id="startChargerName" class="text-muted small"></div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Initial Meter Reading (kWh) <span class="text-muted small">(Optional)</span>:</label>
                        <input type="number" step="0.01" min="0" name="initialMeterReading" id="startInitialMeter" class="form-control" placeholder="0.00" />
                        <small class="text-muted">Enter display units before plugging gun into the vehicle port.</small>
                    </div>
                    <div class="alert alert-info py-2 px-3 small mb-0 font-weight-bold">
                        <i class="fas fa-info-circle mr-1"></i> Starting the session changes status to 'Charging' and updates driver app in real-time.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary font-weight-bold"><i class="fas fa-play mr-1"></i> Start Charging Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Petrol-Pump Meter Billing & OCR Photo Complete -->
<div class="modal fade" id="completeBookingModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-gas-pump mr-2"></i> Petrol-Pump Meter Billing & Session Complete</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Complete" method="post" enctype="multipart/form-data" id="completeBillingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="completeBookingId" name="id" />
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                        <div>
                            <strong id="completeCustomerName" class="h6 text-dark mb-0"></strong>
                            <div id="completeVehiclePlate" class="small text-muted font-weight-bold"></div>
                        </div>
                        <div class="text-right">
                            <span class="text-muted small">Applicable Rate:</span>
                            <div class="h6 mb-0 text-success font-weight-bold" id="completeRateDisplay"></div>
                        </div>
                    </div>

                    <!-- OCR Meter Photo Upload Box -->
                    <div class="card border-info mb-3">
                        <div class="card-header bg-info text-white font-weight-bold py-2">
                            <i class="fas fa-camera mr-2"></i> Step 1: Upload Meter Display Photo (Optional OCR Auto-Read)
                        </div>
                        <div class="card-body p-3">
                            <div class="row align-items-center">
                                <div class="col-12 col-md-8 mb-2 mb-md-0">
                                    <input type="file" name="meterPhoto" id="meterPhotoInput" class="form-control-file" accept="image/*" />
                                    <small class="form-text text-muted">Take a photo of the charger screen showing total kWh units consumed.</small>
                                </div>
                                <div class="col-12 col-md-4">
                                    <button type="button" class="btn btn-outline-info btn-block btn-sm font-weight-bold" id="btnScanOcr" onclick="scanMeterPhoto()">
                                        <i class="fas fa-magic mr-1"></i> Scan & Read Digits
                                    </button>
                                </div>
                            </div>
                            <div id="ocrStatusMessage" class="small font-weight-bold mt-2" style="display:none;"></div>
                        </div>
                    </div>

                    <!-- Meter Reading Calculation -->
                    <div class="row">
                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold">Start Reading (kWh):</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="startMeter" name="startMeterReading" oninput="recalcBill()" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold">End Reading (kWh):</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="endMeter" name="endMeterReading" oninput="recalcBill()" />
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold text-success">Total Units Used (kWh):</label>
                                <input type="number" step="0.01" min="0" class="form-control font-weight-bold text-success border-success" id="unitsConsumed" name="unitsConsumedKwh" oninput="recalcBillFromUnits()" required />
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded border-top border-success mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="text-muted font-weight-bold">Calculated Energy Bill:</span>
                                <div class="small text-muted" id="billFormulaDisplay">0.00 kWh × ₹15.00/kWh</div>
                            </div>
                            <div class="text-right">
                                <div class="input-group" style="max-width: 180px;">
                                    <div class="input-group-prepend"><span class="input-group-text font-weight-bold">₹</span></div>
                                    <input type="number" step="0.01" min="0" class="form-control form-control-lg font-weight-bold text-success text-right" id="actualCost" name="actualCost" oninput="updateNetPayable(parseFloat(this.value)||0)" required />
                                </div>
                            </div>
                        </div>

                        <!-- Advance Booking Fee Adjustment -->
                        <div id="advanceAdjustmentRow" class="p-2 rounded bg-white border d-flex justify-content-between align-items-center mb-2" style="display:none;">
                            <div>
                                <span class="small font-weight-bold text-warning"><i class="fas fa-shield-alt mr-1"></i> Advance Slot Commitment Adjusted:</span>
                            </div>
                            <span class="font-weight-bold text-danger" id="advanceFeeDisplay">-₹0.00</span>
                        </div>

                        <!-- Net to collect -->
                        <div class="p-2 rounded bg-white border border-success d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-dark">Net Amount to Collect from Driver:</strong>
                            </div>
                            <span class="h5 mb-0 font-weight-bold text-success" id="netPayableDisplay">₹0.00</span>
                        </div>
                    </div>

                    <!-- Payment Mode Selection -->
                    <div class="form-group mt-3 mb-0">
                        <label class="font-weight-bold">Payment Collection Mode <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-control font-weight-bold" required>
                            <option value="UPI / QR Code" selected>UPI / QR Code Scan (PhonePe, GPay, Paytm)</option>
                            <option value="Cash">Cash at Counter</option>
                            <option value="Card (POS)">Debit / Credit Card (POS Terminal)</option>
                        </select>
                        <small class="text-muted">Recorded for daily station accounting and manager shift closure.</small>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success font-weight-bold"><i class="fas fa-check-circle mr-1"></i> Confirm & Finalize Billing</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentRatePerKwh = 15.00;
        var currentAdvanceFee = 0.00;

        function openStartChargingModal(id, customer, plate, charger, startMeter) {
            $('#startBookingId').val(id);
            $('#startCustomerName').text(customer || 'Customer');
            $('#startVehiclePlate').text(plate ? 'Vehicle Plate: ' + plate : 'Vehicle: Standard EV');
            $('#startChargerName').text('Charger Bay: ' + (charger || 'EV Charger'));
            $('#startInitialMeter').val(parseFloat(startMeter) > 0 ? parseFloat(startMeter) : '');
            $('#startChargingModal').modal('show');
        }

        function openCompleteModal(id, customer, plate, rate, startReading, advanceFee) {
            $('#completeBookingId').val(id);
            $('#completeCustomerName').text(customer || 'Customer');
            $('#completeVehiclePlate').text(plate ? 'Vehicle: ' + plate : 'Vehicle: Standard EV');
            currentRatePerKwh = parseFloat(rate) || 15.00;
            currentAdvanceFee = parseFloat(advanceFee) || 0.00;
            $('#completeRateDisplay').text('₹' + currentRatePerKwh.toFixed(2) + ' / kWh');
            $('#startMeter').val(parseFloat(startReading) || 0);
            $('#endMeter').val('');
            $('#unitsConsumed').val('');
            $('#actualCost').val('');
            $('#ocrStatusMessage').hide();

            if (currentAdvanceFee > 0) {
                $('#advanceFeeDisplay').text('-₹' + currentAdvanceFee.toFixed(2));
                $('#advanceAdjustmentRow').show();
            } else {
                $('#advanceAdjustmentRow').hide();
            }
            $('#netPayableDisplay').text('₹0.00');

            $('#completeBookingModal').modal('show');
        }

        function updateNetPayable(total) {
            var net = Math.max(0, total - currentAdvanceFee);
            $('#netPayableDisplay').text('₹' + net.toFixed(2));
        }

        function recalcBill() {
            var start = parseFloat($('#startMeter').val()) || 0;
            var end = parseFloat($('#endMeter').val()) || 0;
            if (end >= start) {
                var units = (end - start).toFixed(2);
                $('#unitsConsumed').val(units);
                var total = (units * currentRatePerKwh).toFixed(2);
                $('#actualCost').val(total);
                $('#billFormulaDisplay').text(units + ' kWh × ₹' + currentRatePerKwh.toFixed(2) + '/kWh');
                updateNetPayable(parseFloat(total));
            }
        }

        function recalcBillFromUnits() {
            var units = parseFloat($('#unitsConsumed').val()) || 0;
            var total = (units * currentRatePerKwh).toFixed(2);
            $('#actualCost').val(total);
            $('#billFormulaDisplay').text(units.toFixed(2) + ' kWh × ₹' + currentRatePerKwh.toFixed(2) + '/kWh');
            updateNetPayable(parseFloat(total));
        }

        function scanMeterPhoto() {
            var fileInput = document.getElementById('meterPhotoInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select or capture a meter photo first.');
                return;
            }

            var formData = new FormData();
            formData.append('photo', fileInput.files[0]);

            $('#btnScanOcr').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Reading...');
            $('#ocrStatusMessage').removeClass('text-danger text-success').addClass('text-info').text('Processing meter digits...').show();

            $.ajax({
                url: '/manager/bookings/read-meter-photo',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#btnScanOcr').prop('disabled', false).html('<i class="fas fa-magic mr-1"></i> Scan & Read Digits');
                    if (res.success) {
                        $('#unitsConsumed').val(res.detectedUnits);
                        recalcBillFromUnits();
                        $('#ocrStatusMessage').removeClass('text-info').addClass('text-success').text('✓ Auto-detected ' + res.detectedUnits + ' kWh from meter display.');
                    } else {
                        $('#ocrStatusMessage').removeClass('text-info').addClass('text-danger').text(res.message || 'Could not auto-read. Please type units manually.');
                    }
                },
                error: function() {
                    $('#btnScanOcr').prop('disabled', false).html('<i class="fas fa-magic mr-1"></i> Scan & Read Digits');
                    $('#ocrStatusMessage').removeClass('text-info').addClass('text-danger').text('OCR service busy. Please type units manually.');
                }
            });
        }

        $(document).ready(function() {
            $('#walkInModal').appendTo("body");
            $('#startChargingModal').appendTo("body");
            $('#completeBookingModal').appendTo("body");

            // Instant Real-Time Table Filter
            var searchInput = document.getElementById('liveMgrSearchInput');
            var statusFilter = document.getElementById('liveMgrStatusFilter');
            var dateFilter = document.getElementById('liveMgrDateFilter');
            var resetBtn = document.getElementById('btnMgrResetFilters');
            var countBadge = document.getElementById('liveMgrCountBadge');
            var rows = document.querySelectorAll('.mgr-booking-row');
            var totalRows = rows.length;

            function applyMgrLiveFilter() {
                var searchVal = (searchInput ? searchInput.value : '').trim().toLowerCase();
                var statusVal = (statusFilter ? statusFilter.value : '').toLowerCase();
                var dateVal = (dateFilter ? dateFilter.value : '').trim();

                var visibleCount = 0;

                rows.forEach(function(row) {
                    var rowSearch = row.getAttribute('data-search') || '';
                    var rowStatus = row.getAttribute('data-status') || '';
                    var rowDate = row.getAttribute('data-date') || '';

                    var matchSearch = !searchVal || rowSearch.indexOf(searchVal) !== -1;
                    var matchStatus = !statusVal || rowStatus === statusVal;
                    var matchDate = !dateVal || rowDate === dateVal;

                    if (matchSearch && matchStatus && matchDate) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (countBadge) {
                    countBadge.textContent = 'Showing ' + visibleCount + ' of ' + totalRows + ' bookings';
                }
            }

            if (searchInput) searchInput.addEventListener('input', applyMgrLiveFilter);
            if (statusFilter) statusFilter.addEventListener('change', applyMgrLiveFilter);
            if (dateFilter) dateFilter.addEventListener('input', applyMgrLiveFilter);

            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    if (statusFilter) statusFilter.value = '';
                    if (dateFilter) dateFilter.value = '';
                    applyMgrLiveFilter();
                });
            }
        });
    </script>
}
