@model IEnumerable<VoltNet.Models.Charger>
@{
    ViewData["Title"] = "Chargers";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}
<div class="ch">
    <div class="row">
        <div class="col-12">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible show fade">
                    <div class="alert-body">
                        <button class="close" data-dismiss="alert"><span>&times;</span></button>
                        @TempData["Success"]
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible show fade">
                    <div class="alert-body">
                        <button class="close" data-dismiss="alert"><span>&times;</span></button>
                        @TempData["Error"]
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Chargers</h4>
                    <a href="/manager/chargers/create" class="btn btn-main"><i class="fas fa-plus"></i> Add Charger</a>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="empty-box">
                            No chargers configured.
                            <div><a href="/manager/chargers/create" class="btn btn-main"><i class="fas fa-plus"></i> Add Charger</a></div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Connector</th>
                                        <th>Capacity</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="col-primary" data-label="Name">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span class="cell-strong">@item.Name</span>
                                                    <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                        <i data-feather="chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Connector"><div><span class="status s-teal">@item.ConnectorType</span></div></td>
                                            <td class="col-secondary" data-label="Capacity"><div class="cell-strong">@item.CapacityKw kW</div></td>
                                            <td data-label="Status">
                                                <div>
                                                    @if (item.Status == "Active")
                                                    {
                                                        <span class="status s-ok">Active</span>
                                                    }
                                                    else if (item.Status == "Maintenance")
                                                    {
                                                        <span class="status s-warn">Maintenance</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status s-err">@item.Status</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center col-action" data-label="Actions">
                                                <div class="row-actions">
                                                    <a href="/manager/chargers/edit/@item.Id" class="chip-btn" title="Edit">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a>
                                                    <form action="/manager/chargers/delete/@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this charger?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="icon-btn" title="Delete" aria-label="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>