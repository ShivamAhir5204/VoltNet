@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    var stationStatus = ViewBag.StationStatus as string ?? "Active";
    var totalChargers = (int)(ViewBag.TotalChargers ?? 0);
    var activeChargers = (int)(ViewBag.ActiveChargers ?? 0);
    var todayBookings = (int)(ViewBag.TodayBookings ?? 0);
    var todayRevenue = (decimal)(ViewBag.TodayRevenue ?? 0m);
}
<div class="md">

    <div class="card gap-b">
        <div class="card-body">
            <div class="top">
                <div>
                    <div class="top-title">
                        <h4>@ViewBag.StationName</h4>
                        @if (stationStatus == "Active")
                        {
                            <span class="status s-ok">Active</span>
                        }
                        else
                        {
                            <span class="status s-err">@stationStatus</span>
                        }
                    </div>
                    <div class="meta">@ViewBag.StationAddress, @ViewBag.StationCity</div>
                </div>
                <div class="actions">
                    <a href="/manager/bookings" class="btn btn-warn"><i class="fas fa-plus"></i> Walk-In Driver</a>
                    <a href="/manager/station-blocks" class="btn btn-back">Maintenance</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-charging-station"></i></div>
                <div>
                    <div class="kpi-label">Station Status</div>
                    <div class="kpi-value">@stationStatus</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-plug"></i></div>
                <div>
                    <div class="kpi-label">Charger Bays</div>
                    <div class="kpi-value">@activeChargers / @totalChargers</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card kpi kpi-warn">
                <div class="kpi-icon"><i class="fas fa-calendar-alt"></i></div>
                <div>
                    <div class="kpi-label">Today's Sessions</div>
                    <div class="kpi-value">@todayBookings</div>
                    <a href="/manager/bookings" class="kpi-link">View Bookings &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card kpi kpi-green">
                <div class="kpi-icon"><i class="fas fa-rupee-sign"></i></div>
                <div>
                    <div class="kpi-label">Today's Revenue</div>
                    <div class="kpi-value">₹@todayRevenue.ToString("N0")</div>
                    <a href="/manager/revenue" class="kpi-link">Revenue Analytics &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card gap-b">
        <div class="card-header"><h5>Quick Access</h5></div>
        <div class="card-body">
            <div class="tiles">
                <a href="/manager/station" class="tile"><span class="t-icon"><i class="fas fa-map-marker-alt"></i></span>My Station</a>
                <a href="/manager/chargers" class="tile"><span class="t-icon teal"><i class="fas fa-plug"></i></span>Chargers</a>
                <a href="/manager/rates" class="tile"><span class="t-icon warn"><i class="fas fa-tag"></i></span>Charging Rates</a>
                <a href="/manager/bookings" class="tile"><span class="t-icon green"><i class="fas fa-calendar-alt"></i></span>Bookings & Walk-In</a>
                <a href="/manager/revenue" class="tile"><span class="t-icon"><i class="fas fa-chart-line"></i></span>Revenue Analytics</a>
                <a href="/manager/station-blocks" class="tile"><span class="t-icon red"><i class="fas fa-clock"></i></span>Maintenance & Breaks</a>
            </div>
        </div>
    </div>

</div>