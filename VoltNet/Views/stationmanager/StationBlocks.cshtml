@model IEnumerable<VoltNet.Models.StationBlockSlot>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var chargers = ViewBag.Chargers as List<VoltNet.Models.Charger> ?? new List<VoltNet.Models.Charger>();
    ViewData["Title"] = $"Station Maintenance & Slot Breaks - {station?.Name}";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-1"><i class="fas fa-tools text-warning mr-2"></i> Maintenance, Breaks & Power Outage Controls</h4>
                    <p class="text-muted mb-0 small">Block individual chargers or the whole station during grid power cuts, routine maintenance, or staff breaks.</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <button type="button" class="btn btn-warning font-weight-bold text-dark" data-toggle="modal" data-target="#blockSlotModal">
                        <i class="fas fa-ban mr-1"></i> Block a Slot / Charger
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-check-double fa-3x text-success mb-3"></i>
                        <h5>No Active Blocked Slots</h5>
                        <p class="text-muted">All chargers and operating hours are currently open for customer reservations.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Charger</th>
                                    <th>Time Interval</th>
                                    <th>Reason</th>
                                    <th>Remarks</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model)
                                {
                                    <tr>
                                        <td class="col-primary" data-label="Date">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <strong class="text-dark">@b.BlockDate.ToString("dd MMM yyyy")</strong>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Charger">
                                            <div>
                                                @(b.Charger != null ? b.Charger.Name : "Whole Station (All Chargers)")
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Time Interval">
                                            <div>
                                                <span class="badge badge-light border text-danger font-weight-bold">
                                                    @b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")
                                                </span>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Reason">
                                            <div>
                                                <span class="badge badge-warning text-dark font-weight-bold">@b.Reason</span>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Remarks">
                                            <div>@(b.Remarks ?? "—")</div>
                                        </td>
                                        <td class="text-center col-action" data-label="Action">
                                            <form asp-action="Delete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Unblock this slot and restore customer booking availability?');">
                                                    <i class="fas fa-unlock mr-1"></i> Release Block
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Block Slot -->
<div class="modal fade" id="blockSlotModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-ban mr-2"></i> Block Station Slot</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Target Charger:</label>
                        <select name="chargerId" class="form-control">
                            <option value="">-- Entire Station (All Chargers) --</option>
                            @foreach (var c in chargers)
                            {
                                <option value="@c.Id">@c.Name (@c.ConnectorType, @c.CapacityKw kW)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Date:</label>
                        <input type="date" name="blockDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Start Time:</label>
                                <input type="time" name="startTime" class="form-control" value="13:00" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">End Time:</label>
                                <input type="time" name="endTime" class="form-control" value="14:00" required />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Reason:</label>
                        <select name="reason" class="form-control" required>
                            <option value="Maintenance">Charger Maintenance / Hardware Servicing</option>
                            <option value="Power Outage">Grid Power Cut / Voltage Fluctuation</option>
                            <option value="Staff Break">Station Staff Lunch / Tea Break</option>
                            <option value="Cleaning">Station Cleaning / Bay Reserved</option>
                            <option value="Other">Other Operational Issue</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Additional Remarks (Optional):</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="e.g. Technician arriving at 1:30 PM"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning font-weight-bold text-dark"><i class="fas fa-lock mr-1"></i> Confirm & Block Slot</button>
                </div>
            </form>
        </div>
    </div>
</div>
