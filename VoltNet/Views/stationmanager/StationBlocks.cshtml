@model IEnumerable<VoltNet.Models.StationBlockSlot>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var chargers = ViewBag.Chargers as List<VoltNet.Models.Charger> ?? new List<VoltNet.Models.Charger>();
    ViewData["Title"] = $"Station Maintenance - {station?.Name}";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card card-otika">
            <div class="card-header card-otika-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-0 text-dark-slate font-weight-700">
                        <i class="fas fa-tools text-otika-primary mr-2"></i> Slot Maintenance & Breaks — @(station?.Name)
                    </h4>
                </div>
                <div class="mt-2 mt-sm-0">
                    <button type="button" class="btn btn-warning font-weight-bold text-dark btn-sm" data-toggle="modal" data-target="#blockSlotModal">
                        <i class="fas fa-ban mr-1"></i> Block a Slot
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-soft-grey rounded border-otika">
                        <i class="fas fa-check-circle text-success mb-3" style="font-size: 38px;"></i>
                        <h6 class="text-dark-slate font-weight-bold mb-1">No Blocked Slots</h6>
                        <small class="text-muted-slate">All chargers and time slots are currently open for driver bookings.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped otika-table align-middle table-responsive-cards" id="table-1">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Charger</th>
                                    <th>Time Interval</th>
                                    <th>Reason</th>
                                    <th>Remarks</th>
                                    <th class="text-center" style="width: 140px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model)
                                {
                                    <tr>
                                        <td class="col-primary" data-label="Date">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <strong class="text-dark-slate">@b.BlockDate.ToString("dd MMM yyyy")</strong>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Charger">
                                            <span class="badge badge-light border text-dark-slate">
                                                @(b.Charger != null ? b.Charger.Name : "Whole Station")
                                            </span>
                                        </td>
                                        <td class="col-secondary" data-label="Time Interval">
                                            <span class="badge badge-light border text-otika-error font-weight-bold" style="color: #EA5455 !important;">
                                                @b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </td>
                                        <td class="col-secondary" data-label="Reason">
                                            <span class="badge badge-otika-warning">@b.Reason</span>
                                        </td>
                                        <td class="col-secondary" data-label="Remarks">
                                            <small class="text-muted-slate">@(b.Remarks ?? "—")</small>
                                        </td>
                                        <td class="text-center col-action" data-label="Action">
                                            <form asp-action="Delete" method="post" class="d-inline mb-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Unblock this slot and restore customer booking availability?');">
                                                    <i class="fas fa-unlock mr-1"></i> Release
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Block Slot -->
<div class="modal fade" id="blockSlotModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content card-otika border-0">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title font-weight-bold text-dark-slate">
                    <i class="fas fa-ban text-warning mr-2"></i> Block Station Slot
                </h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group">
                        <label class="small font-weight-bold text-dark-slate">Target Charger</label>
                        <select name="chargerId" class="form-control">
                            <option value="">-- Entire Station (All Chargers) --</option>
                            @foreach (var c in chargers)
                            {
                                <option value="@c.Id">@c.Name (@c.ConnectorType, @c.CapacityKw kW)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-dark-slate">Date <span class="text-danger">*</span></label>
                        <input type="date" name="blockDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="small font-weight-bold text-dark-slate">Start Time <span class="text-danger">*</span></label>
                                <input type="time" name="startTime" class="form-control" value="13:00" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="small font-weight-bold text-dark-slate">End Time <span class="text-danger">*</span></label>
                                <input type="time" name="endTime" class="form-control" value="14:00" required />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-dark-slate">Reason <span class="text-danger">*</span></label>
                        <select name="reason" class="form-control" required>
                            <option value="Maintenance">Charger Maintenance / Hardware Servicing</option>
                            <option value="Power Outage">Grid Power Cut / Voltage Fluctuation</option>
                            <option value="Staff Break">Station Staff Lunch / Tea Break</option>
                            <option value="Cleaning">Station Cleaning / Bay Reserved</option>
                            <option value="Other">Other Operational Issue</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-dark-slate">Remarks (Optional)</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="Brief note..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm font-weight-bold text-dark">
                        <i class="fas fa-lock mr-1"></i> Confirm Block
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#blockSlotModal').appendTo("body");
        });
    </script>
}
