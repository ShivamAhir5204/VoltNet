@model IEnumerable<VoltNet.Models.MaintenanceTicket>

@{
    ViewData["Title"] = "Maintenance Tickets";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var totalTickets = ViewBag.TotalTickets != null ? (int)ViewBag.TotalTickets : Model.Count();
    var openTickets = ViewBag.OpenTickets != null ? (int)ViewBag.OpenTickets : 0;
    var inProgressTickets = ViewBag.InProgressTickets != null ? (int)ViewBag.InProgressTickets : 0;
    var resolvedTickets = ViewBag.ResolvedTickets != null ? (int)ViewBag.ResolvedTickets : 0;
    var station = ViewBag.Station as VoltNet.Models.Station;
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-1"><i class="fas fa-tools text-primary mr-2"></i> Station Maintenance &amp; Equipment Tickets</h4>
                    <p class="text-muted mb-0 small">Log charger faults, track repairs, and manage station hardware health for @(station?.Name ?? "Station").</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <a href="/manager/maintenance/create" class="btn btn-primary">
                        <i class="fas fa-plus mr-1"></i> Log New Ticket
                    </a>
                </div>
            </div>
            <div class="card-body">

                <!-- KPI Metric Cards -->
                <div class="row mb-4">
                    <div class="col-6 col-md-3 mb-3 mb-md-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-primary text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-clipboard-list fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Total</h4></div>
                                <div class="card-body font-weight-bold">@totalTickets</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3 mb-md-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-danger text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Open Issues</h4></div>
                                <div class="card-body font-weight-bold text-danger">@openTickets</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mb-3 mb-md-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-warning text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-wrench fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">In Progress</h4></div>
                                <div class="card-body font-weight-bold text-warning">@inProgressTickets</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-success text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Resolved</h4></div>
                                <div class="card-body font-weight-bold text-success">@resolvedTickets</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <form method="get" action="/manager/maintenance" class="mb-4 bg-light p-3 rounded">
                    <div class="row align-items-end">
                        <div class="col-12 col-md-4 mb-2 mb-md-0">
                            <label class="font-weight-bold small text-muted">Status</label>
                            <select name="status" class="form-control form-control-sm">
                                <option value="">All Statuses</option>
                                <option value="Open" selected="@(ViewBag.SelectedStatus == "Open")">Open</option>
                                <option value="InProgress" selected="@(ViewBag.SelectedStatus == "InProgress")">In Progress</option>
                                <option value="Resolved" selected="@(ViewBag.SelectedStatus == "Resolved")">Resolved</option>
                                <option value="Closed" selected="@(ViewBag.SelectedStatus == "Closed")">Closed</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4 mb-2 mb-md-0">
                            <label class="font-weight-bold small text-muted">Priority</label>
                            <select name="priority" class="form-control form-control-sm">
                                <option value="">All Priorities</option>
                                <option value="Low" selected="@(ViewBag.SelectedPriority == "Low")">Low</option>
                                <option value="Medium" selected="@(ViewBag.SelectedPriority == "Medium")">Medium</option>
                                <option value="High" selected="@(ViewBag.SelectedPriority == "High")">High</option>
                                <option value="Critical" selected="@(ViewBag.SelectedPriority == "Critical")">Critical</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <button type="submit" class="btn btn-sm btn-primary mr-2"><i class="fas fa-filter mr-1"></i> Filter</button>
                            <a href="/manager/maintenance" class="btn btn-sm btn-outline-secondary">Reset</a>
                        </div>
                    </div>
                </form>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-light rounded">
                        <i class="fas fa-check-double fa-3x text-success mb-3"></i>
                        <h5 class="text-dark">All Equipment Operational!</h5>
                        <p class="text-muted small mb-3">No maintenance tickets found for the selected filters. All chargers and power units are running smoothly.</p>
                        <a href="/manager/maintenance/create" class="btn btn-sm btn-outline-primary">Log Issue</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle" id="table-1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Target Equipment</th>
                                    <th>Issue Title</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Reported On</th>
                                    <th>Resolution Notes</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model)
                                {
                                    var priorityClass = ticket.Priority switch
                                    {
                                        "Critical" => "badge-danger",
                                        "High" => "badge-warning",
                                        "Medium" => "badge-primary",
                                        _ => "badge-info"
                                    };

                                    var statusClass = ticket.Status switch
                                    {
                                        "Open" => "badge-danger",
                                        "InProgress" => "badge-warning text-dark",
                                        "Resolved" => "badge-success",
                                        _ => "badge-secondary"
                                    };

                                    <tr>
                                        <td>
                                            <strong class="text-primary font-weight-bold">#@ticket.Id.ToString().Substring(0, 8).ToUpper()</strong>
                                        </td>
                                        <td>
                                            @if (ticket.Charger != null)
                                            {
                                                <strong>@ticket.Charger.Name</strong>
                                                <div class="small text-muted">@ticket.Charger.ConnectorType (@(ticket.Charger.CapacityKw)kW)</div>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light border">General Station</span>
                                            }
                                        </td>
                                        <td>
                                            <strong class="text-dark">@ticket.Title</strong>
                                            <div class="small text-muted" style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @ticket.Description
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @priorityClass font-weight-bold">@ticket.Priority</span>
                                        </td>
                                        <td>
                                            <span class="badge @statusClass font-weight-bold">@ticket.Status</span>
                                        </td>
                                        <td>
                                            @ticket.CreatedAt.ToString("dd MMM yyyy")
                                            <div class="small text-muted">@ticket.CreatedAt.ToString("hh:mm tt")</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ticket.ResolutionNotes))
                                            {
                                                <span class="small text-success"><i class="fas fa-check mr-1"></i> @ticket.ResolutionNotes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-primary" 
                                                    onclick="openStatusModal('@ticket.Id', '@ticket.Title', '@ticket.Status', '@(ticket.ResolutionNotes ?? "")', @(ticket.ChargerId.HasValue ? "true" : "false"))">
                                                <i class="fas fa-edit mr-1"></i> Update
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- Modal: Update Ticket Status -->
<div class="modal fade" id="updateTicketModal" tabindex="-1" role="dialog" aria-labelledby="updateTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="updateTicketModalLabel"><i class="fas fa-tools mr-2"></i> Update Maintenance Ticket</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalTicketId" name="id" />
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-muted small">Ticket</label>
                        <div id="modalTicketTitle" class="font-weight-bold text-dark"></div>
                    </div>

                    <div class="form-group mb-3">
                        <label for="modalStatus" class="font-weight-bold">Status <span class="text-danger">*</span></label>
                        <select id="modalStatus" name="status" class="form-control" required>
                            <option value="Open">Open</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="modalResolutionNotes" class="font-weight-bold">Resolution / Progress Notes</label>
                        <textarea id="modalResolutionNotes" name="resolutionNotes" class="form-control" rows="3" placeholder="Describe actions taken or resolution details..."></textarea>
                    </div>

                    <div class="form-group form-check mb-0" id="restoreChargerContainer">
                        <input type="checkbox" class="form-check-input" id="restoreChargerActive" name="restoreChargerActive" value="true" checked />
                        <label class="form-check-label font-weight-bold" for="restoreChargerActive">
                            Re-activate charger status to "Active" if resolving
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStatusModal(id, title, status, notes, hasCharger) {
            $('#modalTicketId').val(id);
            $('#modalTicketTitle').text(title);
            $('#modalStatus').val(status);
            $('#modalResolutionNotes').val(notes);
            if (hasCharger) {
                $('#restoreChargerContainer').show();
            } else {
                $('#restoreChargerContainer').hide();
            }
            $('#updateTicketModal').modal('show');
        }

        $(document).ready(function() {
            $('#updateTicketModal').appendTo("body");
        });
    </script>
}
