@model VoltNet.Models.MaintenanceTicket

@{
    ViewData["Title"] = "Report Maintenance Issue";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var chargers = ViewBag.Chargers as List<VoltNet.Models.Charger> ?? new List<VoltNet.Models.Charger>();
    var station = ViewBag.Station as VoltNet.Models.Station;
}

<div class="row">
    <div class="col-12 col-md-8 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1"><i class="fas fa-plus-circle text-primary mr-2"></i> Report Equipment / Charger Issue</h4>
                    <p class="text-muted mb-0 small">Log a fault ticket for @(station?.Name ?? "Station") and manage charger operational availability.</p>
                </div>
                <a href="/manager/maintenance" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Tickets
                </a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StationId" />

                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Target Equipment / Charger <span class="text-muted small">(Optional)</span></label>
                        <select asp-for="ChargerId" class="form-control select2">
                            <option value="">-- General Station Hardware (Grid, Canopy, Display) --</option>
                            @foreach (var c in chargers)
                            {
                                <option value="@c.Id">@c.Name (@c.ConnectorType, @(c.CapacityKw)kW) — Current: @c.Status</option>
                            }
                        </select>
                        <span asp-validation-for="ChargerId" class="text-danger small"></span>
                    </div>

                    <div class="form-group form-check mb-3 p-3 bg-light rounded">
                        <input type="checkbox" class="form-check-input ml-0" id="setChargerMaintenance" name="setChargerMaintenance" value="true" checked />
                        <label class="form-check-label ml-4 font-weight-bold text-dark" for="setChargerMaintenance">
                            Set selected charger to <span class="badge badge-warning text-dark">Maintenance</span> immediately
                        </label>
                        <small class="form-text text-muted ml-4">
                            Prevents customers from booking slots on this specific dispenser until repairs are completed and verified.
                        </small>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Priority" class="font-weight-bold">Priority Level <span class="text-danger">*</span></label>
                        <select asp-for="Priority" class="form-control" required>
                            <option value="Low">Low — Minor cosmetic or non-critical alert</option>
                            <option value="Medium" selected>Medium — Intermittent issue or slow charging</option>
                            <option value="High">High — Single charger completely offline</option>
                            <option value="Critical">Critical — Multiple chargers down, emergency safety hazard</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="font-weight-bold">Issue Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. CCS-2 Gun Lock mechanism jammed" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="font-weight-bold">Issue Details &amp; Symptoms <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detail error codes on screen, LED indicator colors, hardware damages, or customer reports..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/manager/maintenance" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-check mr-1"></i> Submit Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
