@model VoltNet.Models.StationManager
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}
<div class="pf">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card gap-b">
        <div class="card-body">
            <div class="hero">
                <div class="avatar">@(Model.FullName?.Substring(0, 1).ToUpper() ?? "M")</div>
                <div>
                    <h4>@(Model.FullName ?? "Station Manager")</h4>
                    <div class="mail">@(Model.User?.Email ?? "—")</div>
                    <div class="pills">
                        <span class="status s-plan">Station Manager</span>
                        @if (Model.Station != null)
                        {
                            <span class="status s-plan">@Model.Station.Name</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-7 gap-b">
            <div class="card">
                <div class="card-header"><h4>Edit Profile</h4></div>
                <div class="card-body">
                    <form method="post" action="/manager/dashboard/profile" id="profileForm">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="fullname">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fullname" name="fullname" value="@Model.FullName" required />
                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" class="form-control" id="email" value="@(Model.User?.Email ?? "")" disabled readonly />
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label for="phone">Phone Number <span class="text-danger">*</span></label>
                                    <input type="tel" inputmode="numeric" class="form-control" id="phone" name="phone" value="@Model.Phone" required maxlength="10" minlength="10" pattern="[0-9]{10}" title="Enter a valid 10-digit mobile number" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="stationName">Assigned Station</label>
                            <input type="text" class="form-control" id="stationName" value="@(Model.Station?.Name ?? "Not Assigned")" disabled readonly />
                        </div>

                        <div class="form-actions">
                            <a href="/manager/dashboard/change-password" class="btn btn-back"><i class="fas fa-key"></i> Change Password</a>
                            <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5 gap-b">
            <div class="card">
                <div class="card-header"><h4>Account</h4></div>
                <div class="card-body">
                    <div class="kv"><span class="k">Full Name</span><span class="v">@(Model.FullName ?? "—")</span></div>
                    <div class="kv"><span class="k">Email</span><span class="v">@(Model.User?.Email ?? "—")</span></div>
                    <div class="kv"><span class="k">Phone</span><span class="v">@(Model.Phone ?? "—")</span></div>
                    <div class="kv"><span class="k">Station</span><span class="v">@(Model.Station?.Name ?? "Not Assigned")</span></div>
                    @if (Model.Station != null)
                    {
                        <div class="kv"><span class="k">Location</span><span class="v">@Model.Station.City, @Model.Station.State</span></div>
                    }
                    <div class="kv"><span class="k">Role</span><span class="v">Station Manager</span></div>
                    <div class="kv"><span class="k">Member Since</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy")</span></div>
                    <div class="kv">
                        <span class="k">Status</span>
                        <span class="v">
                            @if (Model.IsActive)
                            {
                                <span class="status s-ok">Active</span>
                            }
                            else
                            {
                                <span class="status s-err">Inactive</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>