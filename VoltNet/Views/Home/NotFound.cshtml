@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Page Not Found";
    ViewData["MetaDescription"] = "The page you're looking for doesn't exist. Navigate back to VoltNet's homepage to find EV charging stations near you.";
}

<section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 80px 0 60px;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 text-center">
        <div style="margin-bottom: 2rem;">
          <div style="font-size: 8rem; font-weight: 800; line-height: 1; color: var(--vn-green); opacity: 0.15;">404</div>
        </div>
        <div style="background: var(--vn-green-pale); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <i class="bi bi-geo-alt" style="font-size: 2rem; color: var(--vn-green);"></i>
        </div>
        <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--vn-dark); margin-bottom: 0.75rem;">
          Oops! Page Not Found
        </h1>
        <p style="color: var(--vn-text-muted); font-size: 1.05rem; max-width: 400px; margin: 0 auto 2rem;">
          The page you're looking for seems to have taken a detour. Let's get you back on the right route.
        </p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="/" class="btn-vn-primary">
            <i class="bi bi-house me-2"></i>Back to Home
          </a>
          <a href="/nearby-map" class="btn-vn-secondary">
            <i class="bi bi-geo-alt-fill me-2"></i>Find Stations
          </a>
        </div>
        <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--vn-border);">
          <p style="color: var(--vn-text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">
            Looking for something specific?
          </p>
          <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a href="/Home/Stations" style="color: var(--vn-green); text-decoration: none; font-weight: 500; font-size: 0.9rem;">Stations</a>
            <span style="color: var(--vn-border);">•</span>
            <a href="/Home/About" style="color: var(--vn-green); text-decoration: none; font-weight: 500; font-size: 0.9rem;">About Us</a>
            <span style="color: var(--vn-border);">•</span>
            <a href="/Home/Contact" style="color: var(--vn-green); text-decoration: none; font-weight: 500; font-size: 0.9rem;">Contact</a>
            <span style="color: var(--vn-border);">•</span>
            <a href="/Home/Faq" style="color: var(--vn-green); text-decoration: none; font-weight: 500; font-size: 0.9rem;">FAQ</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
