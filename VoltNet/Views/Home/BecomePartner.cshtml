@{
    ViewData["Title"] = "Become a Partner";
    ViewData["ActivePage"] = "BecomePartner";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<section class="vn-hero" style="min-height: 60vh;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <span class="pulse-dot"></span>
                    <span>Partner Program</span>
                </div>
                <h1 class="hero-title">
                    Own a Charging Station?<br>
                    <span class="gradient-text">Partner with VoltNet.</span>
                </h1>
                <p class="hero-description">
                    Join India's fastest-growing EV charging network. List your stations, manage operations with our powerful tools, and reach thousands of EV drivers. Apply today and start earning.
                </p>
                <div class="hero-buttons">
                    <a href="/partner/apply" class="btn-hero-primary">
                        Apply Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section style="padding: 80px 0; background: rgba(0,0,0,0.2);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge-vn">Why Partner</span>
            <h2 class="section-title">Benefits of <span class="gradient-text">Partnering with VoltNet</span></h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 30px; text-align: center;">
                    <i class="bi bi-graph-up-arrow" style="font-size: 2.5rem; color: var(--vn-primary);"></i>
                    <h5 class="mt-3" style="color: #fff;">Increase Revenue</h5>
                    <p style="color: #94a3b8;">Get discovered by thousands of EV drivers looking for charging stations in your area.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 30px; text-align: center;">
                    <i class="bi bi-tools" style="font-size: 2.5rem; color: var(--vn-primary);"></i>
                    <h5 class="mt-3" style="color: #fff;">Powerful Management</h5>
                    <p style="color: #94a3b8;">Manage stations, chargers, bookings, and managers with our all-in-one dashboard.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 30px; text-align: center;">
                    <i class="bi bi-shield-check" style="font-size: 2.5rem; color: var(--vn-primary);"></i>
                    <h5 class="mt-3" style="color: #fff;">Verified Network</h5>
                    <p style="color: #94a3b8;">Be part of a trusted, verified network that EV drivers rely on nationwide.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="/partner/apply" class="btn-hero-primary">
                Start Your Application <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
