@{
    ViewData["Title"] = "Become a Partner";
    ViewData["ActivePage"] = "BecomePartner";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero" style="padding: 160px 0 80px 0; background: var(--vn-bg); border-bottom: 1px solid var(--vn-border);">
    <div class="container text-center">
        <span class="badge-vn vn-reveal">Partnerships</span>
        <h1 class="section-title vn-reveal" style="font-size: 3.5rem; transition-delay: 100ms;">Partner with <span style="color: var(--vn-green);">VoltNet</span></h1>
        <p class="section-subtitle mx-auto vn-reveal" style="max-width: 700px; transition-delay: 200ms;">Join India's fastest-growing EV software ecosystem. Connect your hardware to our platform and reach thousands of EV drivers instantly.</p>
        <div class="mt-5 vn-reveal" style="transition-delay: 300ms;">
            <a href="/Partner/Apply" class="btn-vn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                Apply to Partner <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- Why Partner Section -->
<section style="padding: 100px 0; background: var(--vn-white);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge-vn vn-reveal">Why Partner</span>
            <h2 class="section-title vn-reveal" style="transition-delay: 100ms;">Benefits of <span style="color: var(--vn-green);">VoltNet</span></h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 vn-reveal" style="transition-delay: 100ms;">
                <div class="vn-card h-100" style="background: var(--vn-bg); border: 1px solid var(--vn-border); border-radius: var(--vn-radius-lg); padding: 40px 30px; text-align: center;">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: var(--vn-green-pale);">
                        <i class="bi bi-graph-up-arrow" style="font-size: 1.8rem; color: var(--vn-green);"></i>
                    </div>
                    <h5 class="mb-3" style="font-weight: 700; color: var(--vn-dark);">Increase Revenue</h5>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">Get discovered by thousands of EV drivers looking for charging stations in your area.</p>
                </div>
            </div>
            <div class="col-md-4 vn-reveal" style="transition-delay: 200ms;">
                <div class="vn-card h-100" style="background: var(--vn-bg); border: 1px solid var(--vn-border); border-radius: var(--vn-radius-lg); padding: 40px 30px; text-align: center;">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: var(--vn-green-pale);">
                        <i class="bi bi-pc-display-horizontal" style="font-size: 1.8rem; color: var(--vn-green);"></i>
                    </div>
                    <h5 class="mb-3" style="font-weight: 700; color: var(--vn-dark);">Powerful Management</h5>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">Manage stations, chargers, bookings, and set dynamic pricing with our all-in-one ERP dashboard.</p>
                </div>
            </div>
            <div class="col-md-4 vn-reveal" style="transition-delay: 300ms;">
                <div class="vn-card h-100" style="background: var(--vn-bg); border: 1px solid var(--vn-border); border-radius: var(--vn-radius-lg); padding: 40px 30px; text-align: center;">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: var(--vn-green-pale);">
                        <i class="bi bi-shield-check" style="font-size: 1.8rem; color: var(--vn-green);"></i>
                    </div>
                    <h5 class="mb-3" style="font-weight: 700; color: var(--vn-dark);">Verified Network</h5>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">Be part of a trusted, verified network that EV drivers rely on nationwide for seamless charging.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5 vn-reveal" style="transition-delay: 400ms;">
            <a href="/Partner/Apply" class="btn-vn-secondary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px;">
                Start Your Application <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
