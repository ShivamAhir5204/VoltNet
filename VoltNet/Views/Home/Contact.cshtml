@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero" style="padding: 160px 0 80px 0; background: var(--vn-bg); border-bottom: 1px solid var(--vn-border);">
    <div class="container text-center">
        <span class="badge-vn vn-reveal">Support</span>
        <h1 class="section-title vn-reveal" style="font-size: 3.5rem; transition-delay: 100ms;">Get In <span style="color: var(--vn-green);">Touch</span></h1>
        <p class="section-subtitle mx-auto vn-reveal" style="max-width: 600px; transition-delay: 200ms;">Have questions about the platform or need support? Our team is ready to help.</p>
    </div>
</section>

<!-- Contact Form & Info -->
<section style="padding: 100px 0; background: var(--vn-white);">
    <div class="container">
        <div class="row justify-content-center g-5">
            
            <!-- Contact Info -->
            <div class="col-lg-5">
                <h3 class="vn-reveal mb-4" style="font-weight: 700; color: var(--vn-dark);">We're here to help.</h3>
                <p class="text-muted mb-5 vn-reveal" style="transition-delay: 100ms; font-size: 1.1rem; line-height: 1.7;">Whether you have a question about charging, need technical support at a station, or want to partner with us, our team is ready to answer all your questions.</p>
                
                <div class="d-flex mb-4 align-items-start vn-reveal" style="transition-delay: 200ms;">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0; flex-shrink: 0;"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <h5 class="mb-1" style="font-weight: 700; color: var(--vn-dark);">Headquarters</h5>
                        <p class="text-muted small mb-0">VoltNet Innovation Hub,<br>Phase 1, Hinjewadi,<br>Pune, Maharashtra 411057</p>
                    </div>
                </div>
                
                <div class="d-flex mb-4 align-items-start vn-reveal" style="transition-delay: 300ms;">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0; flex-shrink: 0;"><i class="bi bi-envelope"></i></div>
                    <div>
                        <h5 class="mb-1" style="font-weight: 700; color: var(--vn-dark);">Email Us</h5>
                        <p class="text-muted small mb-0">General: hello@voltnet.com<br>Support: support@voltnet.com<br>Partners: partners@voltnet.com</p>
                    </div>
                </div>
                
                <div class="d-flex mb-4 align-items-start vn-reveal" style="transition-delay: 400ms;">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0; flex-shrink: 0;"><i class="bi bi-telephone"></i></div>
                    <div>
                        <h5 class="mb-1" style="font-weight: 700; color: var(--vn-dark);">Call Us (24/7)</h5>
                        <p class="text-muted small mb-0">Toll-Free: 1800-123-VOLT<br>Support: +91 98765 43210</p>
                    </div>
                </div>
            </div>
            
            <!-- Form -->
            <div class="col-lg-7 vn-reveal" style="transition-delay: 200ms;">
                <div class="vn-card p-5" style="background: var(--vn-bg); border: 1px solid var(--vn-border); border-radius: var(--vn-radius-lg);">
                    <h4 class="mb-4" style="font-weight: 700; color: var(--vn-dark);">Send a Message</h4>
                    <form>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Your Name</label>
                                <input type="text" class="form-control vn-form-control" placeholder="John Doe" style="border-color: var(--vn-border); background: var(--vn-white);" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Email Address</label>
                                <input type="email" class="form-control vn-form-control" placeholder="john@example.com" style="border-color: var(--vn-border); background: var(--vn-white);" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Subject</label>
                                <select class="form-select vn-form-control" style="border-color: var(--vn-border); background: var(--vn-white);" required>
                                    <option value="">Select a topic...</option>
                                    <option value="support">Charging Station Support</option>
                                    <option value="billing">Billing Inquiry</option>
                                    <option value="partner">Host a Charger (Partnership)</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Message</label>
                                <textarea class="form-control vn-form-control" rows="5" placeholder="How can we help you?" style="border-color: var(--vn-border); background: var(--vn-white);" required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="button" class="btn-vn-primary w-100" style="padding: 14px 0;">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</section>
