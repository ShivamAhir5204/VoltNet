@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero">
    <div class="container">
        <h1 class="inner-hero-title">Get In <span class="gradient-text">Touch</span></h1>
        <ul class="breadcrumb-vn">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Contact Us</li>
        </ul>
    </div>
</section>

<!-- Contact Form & Info -->
<section style="padding: 5rem 0;">
    <div class="container">
        <div class="row justify-content-center g-5">
            
            <!-- Contact Info -->
            <div class="col-lg-5 animate-on-scroll">
                <h3 class="text-white mb-4">We're here to help.</h3>
                <p class="text-secondary mb-5">Whether you have a question about charging, need technical support at a station, or want to partner with us, our team is ready to answer all your questions.</p>
                
                <div class="d-flex mb-4 align-items-start">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0;"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <h5 class="text-white mb-1">Headquarters</h5>
                        <p class="text-secondary small mb-0">VoltNet Innovation Hub,<br>Phase 1, Hinjewadi,<br>Pune, Maharashtra 411057</p>
                    </div>
                </div>
                
                <div class="d-flex mb-4 align-items-start">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0;"><i class="bi bi-envelope"></i></div>
                    <div>
                        <h5 class="text-white mb-1">Email Us</h5>
                        <p class="text-secondary small mb-0">General: hello@voltnet.com<br>Support: support@voltnet.com<br>Partners: partners@voltnet.com</p>
                    </div>
                </div>
                
                <div class="d-flex mb-4 align-items-start">
                    <div class="feature-icon" style="width: 50px; height: 50px; font-size: 1.2rem; margin-right: 15px; margin-bottom: 0;"><i class="bi bi-telephone"></i></div>
                    <div>
                        <h5 class="text-white mb-1">Call Us (24/7)</h5>
                        <p class="text-secondary small mb-0">Toll-Free: 1800-123-VOLT<br>Support: +91 98765 43210</p>
                    </div>
                </div>
            </div>
            
            <!-- Form -->
            <div class="col-lg-7 animate-on-scroll">
                <div class="p-5 rounded" style="background: var(--vn-dark-card); border: 1px solid var(--vn-border);">
                    <h4 class="text-white mb-4">Send a Message</h4>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-secondary small">Your Name</label>
                                <input type="text" class="form-control vn-form-control" placeholder="John Doe" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small">Email Address</label>
                                <input type="email" class="form-control vn-form-control" placeholder="john@example.com" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small">Subject</label>
                                <select class="form-select vn-form-control" required>
                                    <option value="">Select a topic...</option>
                                    <option value="support">Charging Station Support</option>
                                    <option value="billing">Billing Inquiry</option>
                                    <option value="partner">Host a Charger (Partnership)</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small">Message</label>
                                <textarea class="form-control vn-form-control" rows="5" placeholder="How can we help you?" required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="button" class="btn btn-hero-primary w-100 p-3" style="border-radius: var(--vn-radius-sm);">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</section>
