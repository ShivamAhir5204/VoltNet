@{
    ViewData["Title"] = "Terms of Service";
    ViewData["MetaDescription"] = "Review the terms and conditions governing the use of the VoltNet EV charging platform, reservations, and station hosting.";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero" style="padding: 160px 0 60px 0; background: var(--vn-bg); border-bottom: 1px solid var(--vn-border);">
    <div class="container text-center">
        <span class="badge-vn vn-reveal">Terms & Conditions</span>
        <h1 class="section-title vn-reveal" style="font-size: 3rem; transition-delay: 100ms;">Terms of <span style="color: var(--vn-green);">Service</span></h1>
        <p class="section-subtitle mx-auto vn-reveal" style="max-width: 600px; transition-delay: 200ms;">Last updated: January @DateTime.Now.Year. Please read these terms carefully before using VoltNet.</p>
    </div>
</section>

<!-- Terms Content -->
<section style="padding: 80px 0; background: var(--vn-white);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="vn-card p-4 p-md-5" style="border: 1px solid var(--vn-border); border-radius: var(--vn-radius-lg); background: var(--vn-white); box-shadow: var(--vn-shadow-sm);">
                    
                    <div class="mb-5">
                        <h3 class="fw-bold mb-3" style="color: var(--vn-dark);"><i class="bi bi-file-earmark-text text-success me-2"></i>1. Acceptance of Terms</h3>
                        <p class="text-secondary" style="line-height: 1.8;">
                            By accessing or using VoltNet's web portal, mobile application, or any associated EV charging services, you agree to be bound by these Terms of Service. If you do not agree to these terms, please refrain from using our services.
                        </p>
                    </div>

                    <hr style="border-color: var(--vn-border); margin: 2rem 0;">

                    <div class="mb-5">
                        <h3 class="fw-bold mb-3" style="color: var(--vn-dark);"><i class="bi bi-ev-station text-success me-2"></i>2. Charging Station Bookings & Use</h3>
                        <p class="text-secondary" style="line-height: 1.8;">
                            VoltNet provides a reservation platform connecting EV drivers with charging station owners. When booking a slot:
                        </p>
                        <ul class="text-secondary ps-4" style="line-height: 1.8;">
                            <li>Users must arrive within the designated booking window. Failure to arrive may result in forfeiture of the reserved slot.</li>
                            <li>Cancellations are subject to our 30-minute cancellation policy to ensure fair charger availability for other drivers.</li>
                            <li>Users must connect and charge only compatible electric vehicles using designated connector types (CCS2, Type 2, CHAdeMO, etc.).</li>
                            <li>Drivers must promptly unplug and vacate the charging bay once the charging session concludes.</li>
                        </ul>
                    </div>

                    <hr style="border-color: var(--vn-border); margin: 2rem 0;">

                    <div class="mb-5">
                        <h3 class="fw-bold mb-3" style="color: var(--vn-dark);"><i class="bi bi-credit-card-2-front text-success me-2"></i>3. Billing & Energy Pricing</h3>
                        <p class="text-secondary" style="line-height: 1.8;">
                            Charging rates are determined transparently per kWh consumed. Station managers record and verify meter readings. You agree to pay all charges incurred during your charging session, including any applicable government taxes (GST).
                        </p>
                    </div>

                    <hr style="border-color: var(--vn-border); margin: 2rem 0;">

                    <div class="mb-5">
                        <h3 class="fw-bold mb-3" style="color: var(--vn-dark);"><i class="bi bi-building-check text-success me-2"></i>4. Station Host & Partner Obligations</h3>
                        <p class="text-secondary" style="line-height: 1.8;">
                            Station Owners and Managers registered on VoltNet agree to maintain their equipment in safe, operational condition, uphold accurate pricing schedules, and comply with all national electrical safety standards.
                        </p>
                    </div>

                    <hr style="border-color: var(--vn-border); margin: 2rem 0;">

                    <div>
                        <h3 class="fw-bold mb-3" style="color: var(--vn-dark);"><i class="bi bi-headset text-success me-2"></i>5. Support & Inquiries</h3>
                        <p class="text-secondary" style="line-height: 1.8;">
                            For questions regarding these terms, dispute resolution, or assistance, contact our legal and support team:
                        </p>
                        <p class="mb-0 text-secondary">
                            <strong>Email:</strong> <a href="mailto:support@voltnet.com" class="text-success text-decoration-none">support@voltnet.com</a><br>
                            <strong>Phone:</strong> <a href="tel:+919876543210" class="text-success text-decoration-none">+91 98765 43210</a><br>
                            <strong>Hours:</strong> 24/7 Customer Support Available
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
