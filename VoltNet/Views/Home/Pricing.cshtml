@{
    ViewData["Title"] = "Pricing Plans";
    ViewData["ActivePage"] = "Pricing";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero">
    <div class="container">
        <h1 class="inner-hero-title">Transparent <span class="gradient-text">Software Pricing</span></h1>
        <ul class="breadcrumb-vn">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Pricing</li>
        </ul>
    </div>
</section>

<!-- Pricing Tables -->
<section style="padding: 5rem 0;">
    <div class="container">
        
        <div class="text-center mb-5">
            <h2 class="text-white">Choose Your Profile</h2>
            <p class="text-secondary">Are you an EV driver looking to charge, or a station owner looking to manage?</p>
        </div>

        <div class="row g-4 justify-content-center align-items-center">
            
            <!-- Drivers -->
            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="pricing-card shadow-lg" style="border-color: rgba(255,255,255,0.1);">
                    <h3 class="mb-2">EV Drivers</h3>
                    <p class="text-secondary small mb-4">Book & Pay for Charging</p>
                    
                    <div class="mb-4">
                        <span style="font-family: 'Space Grotesk'; font-size: 3rem; font-weight: 800; color: #fff;">Free</span>
                        <span class="text-secondary">/app usage</span>
                    </div>
                    
                    <div class="p-2 mb-4 rounded" style="background: rgba(255,255,255,0.05);">
                        <span class="text-white fw-bold small">Pay only the station's kWh rate.</span>
                    </div>
                    
                    <ul class="about-list text-start mb-4" style="font-size: 0.95rem;">
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Access to all partner stations</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Real-time charger availability</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Advance slot booking</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Secure digital payments</li>
                    </ul>
                    
                    <a href="/register" class="btn btn-hero-secondary w-100 p-3" style="border-radius: var(--vn-radius-sm);">Create Driver Account</a>
                </div>
            </div>
            
            <!-- Station Owners (Featured) -->
            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="pricing-card featured shadow-lg">
                    <span class="badge-vn position-absolute" style="top: -15px; left: 50%; transform: translateX(-50%);">FOR OWNERS</span>
                    <h3 class="mb-2 text-white">Station ERP Pro</h3>
                    <p class="text-secondary small mb-4">Complete Management Software</p>
                    
                    <div class="mb-4">
                        <span style="font-family: 'Space Grotesk'; font-size: 3rem; font-weight: 800; color: #fff;">₹4,999</span>
                        <span class="text-secondary">/mo per station</span>
                    </div>
                    
                    <div class="p-2 mb-4 rounded" style="background: rgba(0,212,170,0.1); border: 1px solid rgba(0,212,170,0.2);">
                        <span class="text-primary fw-bold">14-Day Free Trial</span>
                    </div>
                    
                    <ul class="about-list text-start mb-4 text-white" style="font-size: 0.95rem;">
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Full OCPP 1.6J/2.0 integration</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Remote start/stop & diagnostics</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Dynamic pricing controls</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Automated payment settlement (T+1)</li>
                        <li><span class="check-icon"><i class="bi bi-check-lg"></i></span> Advanced revenue analytics</li>
                    </ul>
                    
                    <a href="/register" class="btn btn-hero-primary w-100 p-3" style="border-radius: var(--vn-radius-sm);">Start ERP Trial</a>
                </div>
            </div>
            
        </div>
    </div>
</section>

<!-- Additional Fees Info -->
<section style="background: var(--vn-dark-2); padding: 4rem 0;">
    <div class="container text-center">
        <h3 class="mb-4 text-white">For Station Owners</h3>
        <div class="row justify-content-center">
            <div class="col-lg-8 text-secondary">
                <p><strong>Setup Fee:</strong> Zero setup fee. Simply configure your OCPP hardware to point to our secure endpoints.</p>
                <p><strong>Transaction Fees:</strong> A standard 1.5% payment gateway fee applies to all driver payments processed through the platform.</p>
                <p><strong>Enterprise:</strong> Managing more than 10 stations? <a asp-controller="Home" asp-action="Contact" class="text-primary">Contact us</a> for custom volume pricing and white-label options.</p>
            </div>
        </div>
    </div>
</section>
