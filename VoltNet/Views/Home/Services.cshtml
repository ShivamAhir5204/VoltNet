@{
    ViewData["Title"] = "Our Services";
    ViewData["ActivePage"] = "Services";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero" style="padding: 160px 0 80px 0; background: var(--vn-bg); border-bottom: 1px solid var(--vn-border);">
    <div class="container text-center">
        <span class="badge-vn vn-reveal">Solutions</span>
        <h1 class="section-title vn-reveal" style="font-size: 3.5rem; transition-delay: 100ms;">Software <span style="color: var(--vn-green);">Services</span></h1>
        <p class="section-subtitle mx-auto vn-reveal" style="max-width: 600px; transition-delay: 200ms;">Comprehensive digital solutions designed for modern EV infrastructure.</p>
    </div>
</section>

<!-- Services Grid -->
<section class="vn-features" style="padding: 100px 0;">
    <div class="container">
        
        <!-- For Station Owners -->
        <div class="text-center mb-5">
            <h3 class="vn-reveal" style="font-weight: 700; color: var(--vn-dark);">For Station Owners</h3>
            <p class="text-muted vn-reveal" style="transition-delay: 100ms;">Comprehensive ERP for managing your charging infrastructure.</p>
        </div>
        
        <div class="row g-4 mb-5 pb-5 border-bottom" style="border-color: var(--vn-bg) !important;">
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 100ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-pc-display-horizontal"></i></div>
                    <h4 class="mb-3">Centralized Dashboard</h4>
                    <p>Monitor all your charging stations from a single web interface. Check hardware status, active sessions, and errors in real-time.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 200ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-cash-coin"></i></div>
                    <h4 class="mb-3">Dynamic Pricing Engine</h4>
                    <p>Set custom tariffs based on time of day, day of week, or connector type. Maximize revenue during peak hours seamlessly.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 300ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <h4 class="mb-3">Advanced Analytics</h4>
                    <p>Exportable reports on energy dispensed, revenue generated, utilization rates, and customer retention metrics.</p>
                </div>
            </div>
        </div>

        <!-- For EV Drivers -->
        <div class="text-center mb-5 mt-5">
            <h3 class="vn-reveal" style="font-weight: 700; color: var(--vn-dark);">For EV Drivers</h3>
            <p class="text-muted vn-reveal" style="transition-delay: 100ms;">An intuitive platform to make charging hassle-free.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 100ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-geo-alt"></i></div>
                    <h4 class="mb-3">Station Discovery</h4>
                    <p>Find partner stations near you, filter by connector type and speed, and see real-time availability before you arrive.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 200ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-calendar-check"></i></div>
                    <h4 class="mb-3">Smart Booking</h4>
                    <p>Reserve a specific charger at a partner station in advance so you never have to wait in line.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: 300ms;">
                <div class="feature-card vn-card text-start p-4 h-100" style="background: var(--vn-white); border-radius: var(--vn-radius-lg); border: 1px solid var(--vn-border);">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <h4 class="mb-3">Secure Payments</h4>
                    <p>Pay instantly via UPI or Card. The payment is securely routed and settled directly with the station owner.</p>
                </div>
            </div>
        </div>
    </div>
</section>
