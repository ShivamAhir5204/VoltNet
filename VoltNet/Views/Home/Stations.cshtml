@{
    ViewData["Title"] = "Our Stations";
    ViewData["ActivePage"] = "Stations";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Page Hero -->
<section class="vn-inner-hero" style="padding: 160px 0 80px 0; background: var(--vn-bg); border-bottom: 1px solid var(--vn-border);">
    <div class="container text-center">
        <span class="badge-vn vn-reveal">Network</span>
        <h1 class="section-title vn-reveal" style="font-size: 3.5rem; transition-delay: 100ms;">Find a <span style="color: var(--vn-green);">Charging Station</span></h1>
        <p class="section-subtitle mx-auto vn-reveal" style="max-width: 600px; transition-delay: 200ms;">Explore our rapidly expanding network of partner stations across the country.</p>
    </div>
</section>

<!-- Filter & Search -->
<section style="background: var(--vn-white); padding: 2.5rem 0; border-bottom: 1px solid var(--vn-border); box-shadow: var(--vn-shadow-sm);">
    <div class="container vn-reveal" style="transition-delay: 300ms;">
        <form method="get" action="/Home/Stations">
            <div class="row g-3 align-items-center justify-content-center">
                <div class="col-lg-4 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent text-muted" style="border-radius: var(--vn-radius-sm) 0 0 var(--vn-radius-sm); border-color: var(--vn-border);"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="@ViewBag.SearchQuery" class="form-control vn-form-control border-start-0 ps-0" placeholder="Search city, area, or station name..." style="border-radius: 0 var(--vn-radius-sm) var(--vn-radius-sm) 0; border-color: var(--vn-border);">
                    </div>
                </div>
                <div class="col-lg-3 col-md-4">
                    <select name="city" class="form-select vn-form-control" style="border-radius: var(--vn-radius-sm); border-color: var(--vn-border);">
                        <option value="">All Cities</option>
                        @if (ViewBag.Cities != null)
                        {
                            foreach (var city in ViewBag.Cities)
                            {
                                if (ViewBag.SearchCity == city)
                                {
                                    <option value="@city" selected>@city</option>
                                }
                                else
                                {
                                    <option value="@city">@city</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-4">
                    <select name="connector" class="form-select vn-form-control" style="border-radius: var(--vn-radius-sm); border-color: var(--vn-border);">
                        <option value="">All Connector Types</option>
                        @if (ViewBag.Connectors != null)
                        {
                            foreach (var connector in ViewBag.Connectors)
                            {
                                if (ViewBag.SearchConnector == connector)
                                {
                                    <option value="@connector" selected>@connector</option>
                                }
                                else
                                {
                                    <option value="@connector">@connector</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 text-center text-md-start">
                    <button type="submit" class="btn-vn-primary w-100" style="padding: 10px 0;">Search</button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Stations Grid -->
<section class="vn-stations" style="padding: 100px 0;">
    <div class="container">
        <div class="row g-4">
            @if (ViewBag.Stations != null)
            {
                var stations = ((IEnumerable<dynamic>)ViewBag.Stations).ToList();
                if (stations.Count > 0)
                {
                    int delay = 100;
                    foreach (var station in stations)
                    {
                        <div class="col-lg-4 col-md-6 vn-reveal" style="transition-delay: @(delay)ms;">
                            <a href="/station/@station.Id" style="text-decoration: none; color: inherit; display: block;">
                                <div class="station-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;">
                                    <div class="station-img">
                                        @if (station.IsOpen)
                                        {
                                            <span class="station-status open">● Open Now</span>
                                        }
                                        else
                                        {
                                            <span class="station-status" style="background: rgba(239,68,68,0.15); color: #ef4444;">● Closed</span>
                                        }
                                        <i class="bi bi-ev-station"></i>
                                    </div>
                                    <div class="station-body">
                                        <h5>@station.Name</h5>
                                        <div class="station-meta"><i class="bi bi-geo-alt-fill"></i> @station.Address, @station.City</div>
                                        <div class="station-specs">
                                            <div class="station-spec">
                                                <div class="station-spec-value">@station.ChargerCount</div>
                                                <div class="station-spec-label">Chargers</div>
                                            </div>
                                            <div class="station-spec">
                                                <div class="station-spec-value">@(station.MaxPower)kW</div>
                                                <div class="station-spec-label">Max Power</div>
                                            </div>
                                            <div class="station-spec">
                                                <div class="station-spec-value text-success">
                                                    @(station.MinRate != null ? $"₹{station.MinRate:F2}" : "Standard")
                                                </div>
                                                <div class="station-spec-label">From / kWh</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        delay += 100;
                        if (delay > 300) delay = 100;
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted" style="padding: 60px 0;">
                        <i class="bi bi-ev-station" style="font-size: 3rem; color: #cbd5e1;"></i>
                        <h4 class="mt-3">No stations found</h4>
                        <p>Try adjusting your search filters.</p>
                        <a href="/Home/Stations" class="btn-vn-secondary mt-3">Clear Filters</a>
                    </div>
                }
            }
        </div>
    </div>
</section>
