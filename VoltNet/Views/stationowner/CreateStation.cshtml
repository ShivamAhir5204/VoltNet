@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Create Station";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12">
    <div class="card card-primary shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center py-3">
        <h4 class="text-dark font-weight-bold mb-0">
          <i class="fas fa-charging-station text-primary mr-2"></i> Create Station
        </h4>
        <a href="/owner/stations" class="btn btn-outline-secondary btn-sm font-weight-600">
          <i class="fas fa-arrow-left mr-1"></i> Back
        </a>
      </div>

      <div class="card-body p-3 p-md-4">
        <form method="post" asp-action="Create" enctype="multipart/form-data" id="createStationForm">
          @Html.AntiForgeryToken()

          @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
          {
            <div asp-validation-summary="All" class="alert alert-danger mb-3 py-2 px-3"></div>
          }

          <div class="row">
            <!-- ── LEFT COLUMN: Station Core Details ── -->
            <div class="col-12 col-lg-6 mb-3 mb-lg-0">
              <div class="p-3 rounded border bg-white h-100 shadow-none">
                <h6 class="font-weight-bold text-dark mb-3 pb-2 border-bottom">
                  <i class="fas fa-info-circle text-primary mr-1"></i> Station Basic Information
                </h6>

                <div class="form-group mb-3">
                  <label for="Name" class="font-weight-600 font-13 mb-1 text-dark">Station Name <span class="text-danger">*</span></label>
                  <input asp-for="Name" class="form-control" required placeholder="e.g. EcoVolt Fast Hub Gandhidham" />
                  <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                  <label for="Address" class="font-weight-600 font-13 mb-1 text-dark">Street Address <span class="text-danger">*</span></label>
                  <input asp-for="Address" class="form-control" required placeholder="Plot No., Highway / Landmark" />
                  <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6 mb-3">
                    <label for="City" class="font-weight-600 font-13 mb-1 text-dark">City <span class="text-danger">*</span></label>
                    <input asp-for="City" class="form-control" required placeholder="e.g. Gandhidham" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="State" class="font-weight-600 font-13 mb-1 text-dark">State <span class="text-danger">*</span></label>
                    <select asp-for="State" class="form-control" id="State" required>
                      <option value="">-- Select State --</option>
                    </select>
                    <span asp-validation-for="State" class="text-danger small"></span>
                  </div>
                </div>

                <div class="form-row align-items-end">
                  <div class="form-group col-12 col-sm-5 mb-3">
                    <label for="Latitude" class="font-weight-600 font-13 mb-1 text-dark">Latitude <span class="text-danger">*</span></label>
                    <input asp-for="Latitude" id="Latitude" type="number" step="any" class="form-control font-mono" required placeholder="23.078..." />
                    <span asp-validation-for="Latitude" class="text-danger small"></span>
                  </div>
                  <div class="form-group col-12 col-sm-4 mb-3">
                    <label for="Longitude" class="font-weight-600 font-13 mb-1 text-dark">Longitude <span class="text-danger">*</span></label>
                    <input asp-for="Longitude" id="Longitude" type="number" step="any" class="form-control font-mono" required placeholder="70.133..." />
                    <span asp-validation-for="Longitude" class="text-danger small"></span>
                  </div>
                  <div class="form-group col-12 col-sm-3 mb-3">
                    <button type="button" id="btnPickMap" class="btn btn-info btn-block" style="height: 42px;">
                      <i class="fas fa-map-marker-alt mr-1"></i> Map
                    </button>
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6 mb-2">
                    <label for="OpeningTime" class="font-weight-600 font-13 mb-1 text-dark">Opening Time <span class="text-danger">*</span></label>
                    <input asp-for="OpeningTime" type="time" class="form-control" required />
                    <span asp-validation-for="OpeningTime" class="text-danger small"></span>
                  </div>
                  <div class="form-group col-md-6 mb-2">
                    <label for="ClosingTime" class="font-weight-600 font-13 mb-1 text-dark">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" required />
                    <span asp-validation-for="ClosingTime" class="text-danger small"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- ── RIGHT COLUMN: Statutory Compliance Documents ── -->
            <div class="col-12 col-lg-6">
              <div class="p-3 rounded border bg-white h-100 shadow-none">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap">
                  <h6 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-file-contract text-primary mr-1"></i> Compliance Verification Documents
                  </h6>
                  <span class="badge badge-danger font-11 px-2 py-1 font-weight-bold">
                    4 Required
                  </span>
                </div>

                <!-- 1. DISCOM Sanction Letter -->
                <div class="p-2 mb-2 rounded bg-light border">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-bold font-13 text-dark">
                      <i class="fas fa-bolt text-warning mr-1"></i> DISCOM Sanction Letter <span class="text-danger">*</span>
                    </span>
                    <span class="badge badge-danger font-10">Required</span>
                  </div>
                  <div class="custom-file">
                    <input type="file" name="discomLetterFile" id="discomLetterFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'discomFeedback', 'discomLabel')" />
                    <label class="custom-file-label font-12 text-truncate" id="discomLabel" for="discomLetterFile">Choose DISCOM Sanction Letter...</label>
                  </div>
                  <div id="discomFeedback" class="small text-muted mt-1 font-11">
                    PDF, PNG, JPG (Max 10 MB)
                  </div>
                </div>

                <!-- 2. Land Lease / Ownership Deed -->
                <div class="p-2 mb-2 rounded bg-light border">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-bold font-13 text-dark">
                      <i class="fas fa-file-signature text-info mr-1"></i> Land Lease / Ownership <span class="text-danger">*</span>
                    </span>
                    <span class="badge badge-danger font-10">Required</span>
                  </div>
                  <div class="custom-file">
                    <input type="file" name="landLeaseFile" id="landLeaseFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'leaseFeedback', 'leaseLabel')" />
                    <label class="custom-file-label font-12 text-truncate" id="leaseLabel" for="landLeaseFile">Choose Lease Agreement / Title Deed...</label>
                  </div>
                  <div id="leaseFeedback" class="small text-muted mt-1 font-11">
                    PDF, PNG, JPG (Max 10 MB)
                  </div>
                </div>

                <!-- 3. Fire Safety NOC -->
                <div class="p-2 mb-2 rounded bg-light border">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-bold font-13 text-dark">
                      <i class="fas fa-fire-extinguisher text-danger mr-1"></i> Fire Safety NOC <span class="text-danger">*</span>
                    </span>
                    <span class="badge badge-danger font-10">Required</span>
                  </div>
                  <div class="custom-file">
                    <input type="file" name="fireNocFile" id="fireNocFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'fireFeedback', 'fireLabel')" />
                    <label class="custom-file-label font-12 text-truncate" id="fireLabel" for="fireNocFile">Choose Fire Safety NOC Certificate...</label>
                  </div>
                  <div id="fireFeedback" class="small text-muted mt-1 font-11">
                    PDF, PNG, JPG (Max 10 MB)
                  </div>
                </div>

                <!-- 4. Station Site Photographs -->
                <div class="p-2 mb-2 rounded bg-light border">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-bold font-13 text-dark">
                      <i class="fas fa-camera text-success mr-1"></i> Site Photos <span class="text-danger">*</span>
                    </span>
                    <span class="badge badge-danger font-10">Required</span>
                  </div>
                  <div class="custom-file">
                    <input type="file" name="sitePhotosFile" id="sitePhotosFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'photosFeedback', 'photosLabel')" />
                    <label class="custom-file-label font-12 text-truncate" id="photosLabel" for="sitePhotosFile">Choose Station Site Photo...</label>
                  </div>
                  <div id="photosFeedback" class="small text-muted mt-1 font-11">
                    PDF, PNG, JPG (Max 10 MB)
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Action Buttons ── -->
          <div class="mt-4 pt-3 border-top d-flex align-items-center flex-wrap">
            <button type="submit" class="btn btn-primary font-weight-700 px-4 py-2 mr-2">
              <i class="fas fa-save mr-1"></i> Submit Station for Verification
            </button>
            <a href="/owner/stations" class="btn btn-outline-secondary font-weight-600 px-3 py-2">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal: In-Page Leaflet Map Location Picker -->
<div class="modal fade" id="pickMapModal" tabindex="-1" role="dialog" aria-labelledby="pickMapModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document" style="max-width: 850px;">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 10px; overflow: hidden;">
      <div class="modal-header bg-primary text-white py-2 px-3">
        <h5 class="modal-title font-weight-bold font-15" id="pickMapModalLabel">
          <i class="fas fa-map-marked-alt mr-2"></i> Select Station GPS Location
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 px-2 py-1 bg-light rounded border">
          <div class="d-flex align-items-center font-weight-bold font-13">
            <span class="mr-3 text-dark">Lat: <span id="modalDisplayLat" class="text-primary font-mono">—</span></span>
            <span class="text-dark">Lng: <span id="modalDisplayLng" class="text-primary font-mono">—</span></span>
          </div>
          <div>
            <button type="button" id="btnModalGps" class="btn btn-sm btn-outline-primary mr-1">
              <i class="fas fa-crosshairs mr-1"></i> My Location
            </button>
            <a href="/owner/stations/PickLocation" class="btn btn-sm btn-outline-secondary">
              <i class="fas fa-external-link-alt mr-1"></i> Full Page
            </a>
          </div>
        </div>
        <div id="inlinePickMap" style="height: 380px; width: 100%; border-radius: 6px; border: 1px solid #dee2e6;"></div>
        <small class="text-muted mt-1 d-block font-11">
          <i class="fas fa-info-circle mr-1"></i> Click anywhere on the map or drag the pin to pin-point your station coordinates.
        </small>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="button" id="btnModalConfirm" class="btn btn-success btn-sm font-weight-bold px-3" disabled>
          <i class="fas fa-check mr-1"></i> Apply Coordinates
        </button>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/indian-states.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    function handleFileSelected(input, feedbackId, labelId) {
        var feedback = document.getElementById(feedbackId);
        var label = document.getElementById(labelId);
        if (!feedback) return;

        if (input.files && input.files[0]) {
            var file = input.files[0];
            var sizeMb = (file.size / (1024 * 1024)).toFixed(2);
            if (label) {
                label.textContent = file.name;
            }
            if (file.size > 10 * 1024 * 1024) {
                feedback.innerHTML = '<span class="text-danger font-weight-bold font-11"><i class="fas fa-exclamation-triangle mr-1"></i> ' + file.name + ' (' + sizeMb + ' MB) exceeds 10 MB</span>';
                input.value = '';
                if (label) label.textContent = 'Choose File...';
            } else {
                feedback.innerHTML = '<span class="text-success font-weight-bold font-11"><i class="fas fa-check-circle mr-1"></i> ' + file.name + ' (' + sizeMb + ' MB)</span>';
            }
        } else {
            feedback.innerHTML = '<span class="text-muted font-11">PDF, PNG, JPG (Max 10 MB)</span>';
            if (label) label.textContent = 'Choose File...';
        }
    }

    (function() {
        var picked = sessionStorage.getItem('ownerPickedLocation');
        if (picked) {
            var loc = JSON.parse(picked);
            document.getElementById('Latitude').value = loc.lat;
            document.getElementById('Longitude').value = loc.lng;
            sessionStorage.removeItem('ownerPickedLocation');
        }

        var mapInstance = null;
        var mapMarker = null;
        var selectedLat = null;
        var selectedLng = null;

        function initModalMap() {
            var curLat = parseFloat(document.getElementById('Latitude').value);
            var curLng = parseFloat(document.getElementById('Longitude').value);
            var initLat = (!isNaN(curLat) && curLat !== 0) ? curLat : 20.5937;
            var initLng = (!isNaN(curLng) && curLng !== 0) ? curLng : 78.9629;
            var initZoom = (!isNaN(curLat) && curLat !== 0) ? 15 : 5;

            if (!mapInstance) {
                mapInstance = L.map('inlinePickMap').setView([initLat, initLng], initZoom);

                var street = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap',
                    maxZoom: 19
                });
                street.addTo(mapInstance);

                mapInstance.on('click', function(e) {
                    setMarkerLocation(e.latlng.lat, e.latlng.lng);
                });
            } else {
                mapInstance.setView([initLat, initLng], initZoom);
            }

            if (!isNaN(curLat) && curLat !== 0 && !isNaN(curLng) && curLng !== 0) {
                setMarkerLocation(curLat, curLng);
            }

            setTimeout(function() {
                mapInstance.invalidateSize();
            }, 300);
        }

        function setMarkerLocation(lat, lng) {
            selectedLat = parseFloat(lat.toFixed(6));
            selectedLng = parseFloat(lng.toFixed(6));

            if (mapMarker) {
                mapMarker.setLatLng([selectedLat, selectedLng]);
            } else {
                mapMarker = L.marker([selectedLat, selectedLng], { draggable: true }).addTo(mapInstance);
                mapMarker.on('dragend', function(e) {
                    var pos = e.target.getLatLng();
                    setMarkerLocation(pos.lat, pos.lng);
                });
            }

            document.getElementById('modalDisplayLat').textContent = selectedLat.toFixed(6);
            document.getElementById('modalDisplayLng').textContent = selectedLng.toFixed(6);
            document.getElementById('btnModalConfirm').disabled = false;
        }

        document.getElementById('btnPickMap').addEventListener('click', function() {
            $('#pickMapModal').modal('show');
        });

        $('#pickMapModal').on('shown.bs.modal', function() {
            initModalMap();
        });

        document.getElementById('btnModalGps').addEventListener('click', function() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }
            navigator.geolocation.getCurrentPosition(function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;
                mapInstance.setView([lat, lng], 15);
                setMarkerLocation(lat, lng);
            }, function() {
                alert('Unable to retrieve your location.');
            });
        });

        document.getElementById('btnModalConfirm').addEventListener('click', function() {
            if (selectedLat !== null && selectedLng !== null) {
                document.getElementById('Latitude').value = selectedLat.toFixed(6);
                document.getElementById('Longitude').value = selectedLng.toFixed(6);
                $('#pickMapModal').modal('hide');
            }
        });

        $(document).ready(function() {
            $('#pickMapModal').appendTo("body");

            var stateSelect = $('#State');
            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    var option = new Option(state, state);
                    stateSelect.append(option);
                });
            }
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    })();
    </script>
}
