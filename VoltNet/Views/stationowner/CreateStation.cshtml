@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Create Station";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Create New Station</h4>
        <a href="/owner/stations" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
      </div>
      <div class="card-body">
        <form method="post" asp-action="Create">
          <div class="form-group">
            <label for="Name">Station Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label for="Address">Address <span class="text-danger">*</span></label>
            <input asp-for="Address" class="form-control" required />
            <span asp-validation-for="Address" class="text-danger"></span>
          </div>
          <div class="row">
            <div class="col-md-6 form-group">
              <label for="City">City <span class="text-danger">*</span></label>
              <input asp-for="City" class="form-control" required />
              <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
              <label for="State">State <span class="text-danger">*</span></label>
              <input asp-for="State" class="form-control" required />
              <span asp-validation-for="State" class="text-danger"></span>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 form-group">
              <label for="Latitude">Latitude <span class="text-danger">*</span></label>
              <input asp-for="Latitude" type="number" step="any" class="form-control" required />
              <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
              <label for="Longitude">Longitude <span class="text-danger">*</span></label>
              <input asp-for="Longitude" type="number" step="any" class="form-control" required />
              <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 form-group">
              <label for="OpeningTime">Opening Time <span class="text-danger">*</span></label>
              <input asp-for="OpeningTime" type="time" class="form-control" required />
              <span asp-validation-for="OpeningTime" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
              <label for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
              <input asp-for="ClosingTime" type="time" class="form-control" required />
              <span asp-validation-for="ClosingTime" class="text-danger"></span>
            </div>
          </div>

          <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Submit for Verification</button>
            <a href="/owner/stations" class="btn btn-light ml-2">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
