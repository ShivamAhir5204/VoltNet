@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Create Station";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="cs">
<div class="row">
  <div class="col-12">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Create Station</h4>
        <a href="/owner/stations" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
      </div>

      <div class="card-body">
        <form method="post" asp-action="Create" enctype="multipart/form-data" id="createStationForm">
          @Html.AntiForgeryToken()

          @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
          {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
          }

          <div class="row">
            <!-- LEFT: Station details -->
            <div class="col-12 col-lg-6 mb-4 mb-lg-0">
              <div class="panel">
                <h5>Station Details</h5>

                <div class="form-group">
                  <label for="Name">Station Name <span class="text-danger">*</span></label>
                  <input asp-for="Name" class="form-control" required />
                  <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                  <label for="Address">Street Address <span class="text-danger">*</span></label>
                  <input asp-for="Address" class="form-control" required />
                  <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6">
                    <label for="City">City <span class="text-danger">*</span></label>
                    <input asp-for="City" class="form-control" required />
                    <span asp-validation-for="City" class="text-danger"></span>
                  </div>
                  <div class="form-group col-md-6">
                    <label for="State">State <span class="text-danger">*</span></label>
                    <select asp-for="State" class="form-control" id="State" required>
                      <option value="">-- Select State --</option>
                    </select>
                    <span asp-validation-for="State" class="text-danger"></span>
                  </div>
                </div>

                <div class="form-row align-items-end">
                  <div class="form-group col-12 col-sm-5">
                    <label for="Latitude">Latitude <span class="text-danger">*</span></label>
                    <input asp-for="Latitude" id="Latitude" type="number" step="any" class="form-control" required />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                  </div>
                  <div class="form-group col-12 col-sm-4">
                    <label for="Longitude">Longitude <span class="text-danger">*</span></label>
                    <input asp-for="Longitude" id="Longitude" type="number" step="any" class="form-control" required />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                  </div>
                  <div class="form-group col-12 col-sm-3">
                    <button type="button" id="btnPickMap" class="btn btn-map">
                      <i class="fas fa-map-marker-alt"></i> Map
                    </button>
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6 mb-0">
                    <label for="OpeningTime">Opening Time <span class="text-danger">*</span></label>
                    <input asp-for="OpeningTime" type="time" class="form-control" required />
                    <span asp-validation-for="OpeningTime" class="text-danger"></span>
                  </div>
                  <div class="form-group col-md-6 mb-0">
                    <label for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" required />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Documents -->
            <div class="col-12 col-lg-6">
              <div class="panel">
                <h5>Documents</h5>

                <div class="doc">
                  <div class="doc-title">DISCOM Sanction Letter <span class="text-danger">*</span></div>
                  <div class="custom-file">
                    <input type="file" name="discomLetterFile" id="discomLetterFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'discomFeedback', 'discomLabel')" />
                    <label class="custom-file-label" id="discomLabel" for="discomLetterFile">Choose file</label>
                  </div>
                  <div id="discomFeedback" class="file-note">PDF, PNG, JPG (Max 10 MB)</div>
                </div>

                <div class="doc">
                  <div class="doc-title">Land Lease / Ownership <span class="text-danger">*</span></div>
                  <div class="custom-file">
                    <input type="file" name="landLeaseFile" id="landLeaseFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'leaseFeedback', 'leaseLabel')" />
                    <label class="custom-file-label" id="leaseLabel" for="landLeaseFile">Choose file</label>
                  </div>
                  <div id="leaseFeedback" class="file-note">PDF, PNG, JPG (Max 10 MB)</div>
                </div>

                <div class="doc">
                  <div class="doc-title">Fire Safety NOC <span class="text-danger">*</span></div>
                  <div class="custom-file">
                    <input type="file" name="fireNocFile" id="fireNocFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'fireFeedback', 'fireLabel')" />
                    <label class="custom-file-label" id="fireLabel" for="fireNocFile">Choose file</label>
                  </div>
                  <div id="fireFeedback" class="file-note">PDF, PNG, JPG (Max 10 MB)</div>
                </div>

                <div class="doc">
                  <div class="doc-title">Site Photos <span class="text-danger">*</span></div>
                  <div class="custom-file">
                    <input type="file" name="sitePhotosFile" id="sitePhotosFile" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" required onchange="handleFileSelected(this, 'photosFeedback', 'photosLabel')" />
                    <label class="custom-file-label" id="photosLabel" for="sitePhotosFile">Choose file</label>
                  </div>
                  <div id="photosFeedback" class="file-note">PDF, PNG, JPG (Max 10 MB)</div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Submit for Verification</button>
            <a href="/owner/stations" class="btn btn-back">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Map picker modal -->
<div class="modal fade cs-modal" id="pickMapModal" tabindex="-1" role="dialog" aria-labelledby="pickMapModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="pickMapModalLabel">Select Location</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="coords">
          <div class="c">
            <span>Lat: <span id="modalDisplayLat" class="val">—</span></span>
            <span>Lng: <span id="modalDisplayLng" class="val">—</span></span>
          </div>
          <div class="acts">
            <button type="button" id="btnModalGps" class="btn btn-ghost"><i class="fas fa-crosshairs"></i> My Location</button>
            <a href="/owner/stations/PickLocation" class="btn btn-back"><i class="fas fa-external-link-alt"></i> Full Page</a>
          </div>
        </div>
        <div id="inlinePickMap"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
        <button type="button" id="btnModalConfirm" class="btn btn-main" disabled><i class="fas fa-check"></i> Apply</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/indian-states.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    function handleFileSelected(input, feedbackId, labelId) {
        var feedback = document.getElementById(feedbackId);
        var label = document.getElementById(labelId);
        if (!feedback) return;

        if (input.files && input.files[0]) {
            var file = input.files[0];
            var sizeMb = (file.size / (1024 * 1024)).toFixed(2);
            if (label) {
                label.textContent = file.name;
            }
            if (file.size > 10 * 1024 * 1024) {
                feedback.innerHTML = '<span class="bad">' + file.name + ' (' + sizeMb + ' MB) exceeds 10 MB</span>';
                input.value = '';
                if (label) label.textContent = 'Choose file';
            } else {
                feedback.innerHTML = '<span class="ok">' + file.name + ' (' + sizeMb + ' MB)</span>';
            }
        } else {
            feedback.innerHTML = 'PDF, PNG, JPG (Max 10 MB)';
            if (label) label.textContent = 'Choose file';
        }
    }

    (function() {
        var picked = sessionStorage.getItem('ownerPickedLocation');
        if (picked) {
            var loc = JSON.parse(picked);
            document.getElementById('Latitude').value = loc.lat;
            document.getElementById('Longitude').value = loc.lng;
            sessionStorage.removeItem('ownerPickedLocation');
        }

        var mapInstance = null;
        var mapMarker = null;
        var selectedLat = null;
        var selectedLng = null;

        function initModalMap() {
            var curLat = parseFloat(document.getElementById('Latitude').value);
            var curLng = parseFloat(document.getElementById('Longitude').value);
            var initLat = (!isNaN(curLat) && curLat !== 0) ? curLat : 20.5937;
            var initLng = (!isNaN(curLng) && curLng !== 0) ? curLng : 78.9629;
            var initZoom = (!isNaN(curLat) && curLat !== 0) ? 15 : 5;

            if (!mapInstance) {
                mapInstance = L.map('inlinePickMap').setView([initLat, initLng], initZoom);

                var street = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap',
                    maxZoom: 19
                });
                street.addTo(mapInstance);

                mapInstance.on('click', function(e) {
                    setMarkerLocation(e.latlng.lat, e.latlng.lng);
                });
            } else {
                mapInstance.setView([initLat, initLng], initZoom);
            }

            if (!isNaN(curLat) && curLat !== 0 && !isNaN(curLng) && curLng !== 0) {
                setMarkerLocation(curLat, curLng);
            }

            setTimeout(function() {
                mapInstance.invalidateSize();
            }, 300);
        }

        function setMarkerLocation(lat, lng) {
            selectedLat = parseFloat(lat.toFixed(6));
            selectedLng = parseFloat(lng.toFixed(6));

            if (mapMarker) {
                mapMarker.setLatLng([selectedLat, selectedLng]);
            } else {
                mapMarker = L.marker([selectedLat, selectedLng], { draggable: true }).addTo(mapInstance);
                mapMarker.on('dragend', function(e) {
                    var pos = e.target.getLatLng();
                    setMarkerLocation(pos.lat, pos.lng);
                });
            }

            document.getElementById('modalDisplayLat').textContent = selectedLat.toFixed(6);
            document.getElementById('modalDisplayLng').textContent = selectedLng.toFixed(6);
            document.getElementById('btnModalConfirm').disabled = false;
        }

        document.getElementById('btnPickMap').addEventListener('click', function() {
            $('#pickMapModal').modal('show');
        });

        $('#pickMapModal').on('shown.bs.modal', function() {
            initModalMap();
        });

        document.getElementById('btnModalGps').addEventListener('click', function() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }
            navigator.geolocation.getCurrentPosition(function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;
                mapInstance.setView([lat, lng], 15);
                setMarkerLocation(lat, lng);
            }, function() {
                alert('Unable to retrieve your location.');
            });
        });

        document.getElementById('btnModalConfirm').addEventListener('click', function() {
            if (selectedLat !== null && selectedLng !== null) {
                document.getElementById('Latitude').value = selectedLat.toFixed(6);
                document.getElementById('Longitude').value = selectedLng.toFixed(6);
                $('#pickMapModal').modal('hide');
            }
        });

        $(document).ready(function() {
            $('#pickMapModal').appendTo("body");

            var stateSelect = $('#State');
            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    var option = new Option(state, state);
                    stateSelect.append(option);
                });
            }
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    })();
    </script>
}