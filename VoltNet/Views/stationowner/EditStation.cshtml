@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Edit Station";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="es">
<div class="row">
  <div class="col-12">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Edit Station — @Model.Name</h4>
        <a href="/owner/stations" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
      </div>

      <div class="card-body">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
          <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
        {
          <div class="alert alert-warning">
            <strong>Rejection Reason:</strong> @Model.RejectionReason
            <div>Saving changes will resubmit the station for verification.</div>
          </div>
        }

        <form method="post" asp-action="Edit" id="stationEditForm">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Id" />
          <input type="hidden" asp-for="OwnerUserId" />
          <input type="hidden" asp-for="Status" />
          <input type="hidden" asp-for="CreatedAt" />
          <input type="hidden" asp-for="RejectionReason" />

          <div class="row">
            <!-- LEFT: Info and timings -->
            <div class="col-12 col-lg-6 mb-4 mb-lg-0">
              <div class="panel">
                <h5>Station Info</h5>

                <div class="form-group">
                  <label asp-for="Name">Station Name <span class="text-danger">*</span></label>
                  <input asp-for="Name" class="form-control" required />
                  <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                  <label asp-for="Address">Street Address <span class="text-danger">*</span></label>
                  <input asp-for="Address" class="form-control" required />
                  <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-row">
                  <div class="form-group col-md-6 mb-0">
                    <label asp-for="OpeningTime">Opening Time <span class="text-danger">*</span></label>
                    <input asp-for="OpeningTime" type="time" class="form-control" required />
                    <span asp-validation-for="OpeningTime" class="text-danger"></span>
                  </div>
                  <div class="form-group col-md-6 mb-0">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" required />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: Location -->
            <div class="col-12 col-lg-6">
              <div class="panel">
                <h5>Location</h5>

                <div class="form-row">
                  <div class="form-group col-md-6">
                    <label asp-for="City">City <span class="text-danger">*</span></label>
                    <input asp-for="City" class="form-control" required />
                    <span asp-validation-for="City" class="text-danger"></span>
                  </div>
                  <div class="form-group col-md-6">
                    <label asp-for="State">State <span class="text-danger">*</span></label>
                    <select asp-for="State" class="form-control" id="State" required>
                      <option value="">-- Select State --</option>
                      @if (!string.IsNullOrEmpty(Model.State))
                      {
                        <option value="@Model.State" selected>@Model.State</option>
                      }
                    </select>
                    <span asp-validation-for="State" class="text-danger"></span>
                  </div>
                </div>

                <div class="form-row align-items-end">
                  <div class="form-group col-12 col-sm-5 mb-0">
                    <label asp-for="Latitude">Latitude <span class="text-danger">*</span></label>
                    <input asp-for="Latitude" id="Latitude" type="number" step="any" class="form-control" required />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                  </div>
                  <div class="form-group col-12 col-sm-4 mb-0">
                    <label asp-for="Longitude">Longitude <span class="text-danger">*</span></label>
                    <input asp-for="Longitude" id="Longitude" type="number" step="any" class="form-control" required />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                  </div>
                  <div class="form-group col-12 col-sm-3 mb-0 mt-3 mt-sm-0">
                    <button type="button" id="btnPickMap" class="btn btn-map">
                      <i class="fas fa-map-marker-alt"></i> Map
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Save Changes</button>
            <a href="/owner/stations" class="btn btn-back">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Map picker modal -->
<div class="modal fade es-modal" id="pickMapModal" tabindex="-1" role="dialog" aria-labelledby="pickMapModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="pickMapModalLabel">Update Location</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="coords">
          <div class="c">
            <span>Lat: <span id="modalDisplayLat" class="val">—</span></span>
            <span>Lng: <span id="modalDisplayLng" class="val">—</span></span>
          </div>
          <div class="acts">
            <button type="button" id="btnModalGps" class="btn btn-ghost"><i class="fas fa-crosshairs"></i> My Location</button>
            <a href="/owner/stations/PickLocation?returnTo=Edit&id=@Model.Id" class="btn btn-back"><i class="fas fa-external-link-alt"></i> Full Page</a>
          </div>
        </div>
        <div id="inlinePickMap"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
        <button type="button" id="btnModalConfirm" class="btn btn-main" disabled><i class="fas fa-check"></i> Apply</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/indian-states.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function() {
        var picked = sessionStorage.getItem('ownerPickedLocation');
        if (picked) {
            var loc = JSON.parse(picked);
            document.getElementById('Latitude').value = loc.lat;
            document.getElementById('Longitude').value = loc.lng;
            sessionStorage.removeItem('ownerPickedLocation');
        }

        var mapInstance = null;
        var mapMarker = null;
        var selectedLat = null;
        var selectedLng = null;

        function initModalMap() {
            var curLat = parseFloat(document.getElementById('Latitude').value);
            var curLng = parseFloat(document.getElementById('Longitude').value);
            var initLat = (!isNaN(curLat) && curLat !== 0) ? curLat : 20.5937;
            var initLng = (!isNaN(curLng) && curLng !== 0) ? curLng : 78.9629;
            var initZoom = (!isNaN(curLat) && curLat !== 0) ? 15 : 5;

            if (!mapInstance) {
                mapInstance = L.map('inlinePickMap').setView([initLat, initLng], initZoom);

                var street = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap',
                    maxZoom: 19
                });
                street.addTo(mapInstance);

                mapInstance.on('click', function(e) {
                    setMarkerLocation(e.latlng.lat, e.latlng.lng);
                });
            } else {
                mapInstance.setView([initLat, initLng], initZoom);
            }

            if (!isNaN(curLat) && curLat !== 0 && !isNaN(curLng) && curLng !== 0) {
                setMarkerLocation(curLat, curLng);
            }

            setTimeout(function() {
                mapInstance.invalidateSize();
            }, 300);
        }

        function setMarkerLocation(lat, lng) {
            selectedLat = parseFloat(lat.toFixed(6));
            selectedLng = parseFloat(lng.toFixed(6));

            if (mapMarker) {
                mapMarker.setLatLng([selectedLat, selectedLng]);
            } else {
                mapMarker = L.marker([selectedLat, selectedLng], { draggable: true }).addTo(mapInstance);
                mapMarker.on('dragend', function(e) {
                    var pos = e.target.getLatLng();
                    setMarkerLocation(pos.lat, pos.lng);
                });
            }

            document.getElementById('modalDisplayLat').textContent = selectedLat.toFixed(6);
            document.getElementById('modalDisplayLng').textContent = selectedLng.toFixed(6);
            document.getElementById('btnModalConfirm').disabled = false;
        }

        document.getElementById('btnPickMap').addEventListener('click', function() {
            $('#pickMapModal').modal('show');
        });

        $('#pickMapModal').on('shown.bs.modal', function() {
            initModalMap();
        });

        document.getElementById('btnModalGps').addEventListener('click', function() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }
            navigator.geolocation.getCurrentPosition(function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;
                mapInstance.setView([lat, lng], 15);
                setMarkerLocation(lat, lng);
            }, function() {
                alert('Unable to retrieve your location.');
            });
        });

        document.getElementById('btnModalConfirm').addEventListener('click', function() {
            if (selectedLat !== null && selectedLng !== null) {
                document.getElementById('Latitude').value = selectedLat.toFixed(6);
                document.getElementById('Longitude').value = selectedLng.toFixed(6);
                $('#pickMapModal').modal('hide');
            }
        });

        $(document).ready(function() {
            $('#pickMapModal').appendTo("body");

            var stateSelect = $('#State');
            var currentState = '@(Model.State ?? "")';

            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    if (state !== currentState) {
                        var option = new Option(state, state);
                        stateSelect.append(option);
                    }
                });
            }
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    })();
    </script>
}