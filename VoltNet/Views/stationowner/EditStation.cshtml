@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Edit Station";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12 col-lg-10 col-xl-8 mx-auto">
    <div class="card">
      <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <h4>Edit Station</h4>
        <a href="/owner/stations" class="btn btn-outline-secondary btn-sm mt-2 mt-sm-0"><i class="fas fa-arrow-left mr-1"></i> Back</a>
      </div>
      <div class="card-body">
        <form method="post" asp-action="Edit" id="stationEditForm">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Id" />
          <input type="hidden" asp-for="OwnerUserId" />
          <input type="hidden" asp-for="Status" />
          <input type="hidden" asp-for="CreatedAt" />
          <input type="hidden" asp-for="RejectionReason" />

          <div class="form-group">
            <label asp-for="Name" class="font-weight-bold">Station Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required placeholder="Enter station name" />
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>

          <div class="form-group">
            <label asp-for="Address" class="font-weight-bold">Address <span class="text-danger">*</span></label>
            <input asp-for="Address" class="form-control" required placeholder="Enter street address" />
            <span asp-validation-for="Address" class="text-danger"></span>
          </div>

          <div class="row">
            <div class="col-12 col-md-6 form-group">
              <label asp-for="City" class="font-weight-bold">City <span class="text-danger">*</span></label>
              <input asp-for="City" class="form-control" required placeholder="Enter city" />
              <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 form-group">
              <label asp-for="State" class="font-weight-bold">State <span class="text-danger">*</span></label>
              <select asp-for="State" class="form-control" id="State" required>
                <option value="">-- Select State --</option>
              </select>
              <span asp-validation-for="State" class="text-danger"></span>
            </div>
          </div>

          <div class="row align-items-end">
            <div class="col-12 col-sm-6 col-md-4 form-group">
              <label asp-for="Latitude" class="font-weight-bold">Latitude <span class="text-danger">*</span></label>
              <input asp-for="Latitude" id="Latitude" type="number" step="any" class="form-control" required />
              <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="col-12 col-sm-6 col-md-4 form-group">
              <label asp-for="Longitude" class="font-weight-bold">Longitude <span class="text-danger">*</span></label>
              <input asp-for="Longitude" id="Longitude" type="number" step="any" class="form-control" required />
              <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-4 form-group">
              <button type="button" id="btnPickMap" class="btn btn-info btn-block">
                <i class="fas fa-map-marker-alt mr-1"></i> Pick on Map
              </button>
            </div>
          </div>

          <div class="row">
            <div class="col-12 col-md-6 form-group">
              <label asp-for="OpeningTime" class="font-weight-bold">Opening Time <span class="text-danger">*</span></label>
              <input asp-for="OpeningTime" type="time" class="form-control" required />
              <span asp-validation-for="OpeningTime" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6 form-group">
              <label asp-for="ClosingTime" class="font-weight-bold">Closing Time <span class="text-danger">*</span></label>
              <input asp-for="ClosingTime" type="time" class="form-control" required />
              <span asp-validation-for="ClosingTime" class="text-danger"></span>
            </div>
          </div>

          @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
          {
            <div class="alert alert-warning">
              <strong>Previous Rejection Reason:</strong> @Model.RejectionReason
              <div class="small text-muted mt-1">Saving your edits will automatically resubmit this station for verification.</div>
            </div>
          }

          <div class="form-group mt-4 d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save Changes</button>
            <a href="/owner/stations" class="btn btn-outline-secondary ml-0 ml-sm-2 mt-2 mt-sm-0">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function() {
        // Check if we have picked location from map
        var picked = sessionStorage.getItem('ownerPickedLocation');
        if (picked) {
            try {
                var loc = JSON.parse(picked);
                document.getElementById('Latitude').value = loc.lat;
                document.getElementById('Longitude').value = loc.lng;
            } catch(e) {}
            sessionStorage.removeItem('ownerPickedLocation');
        }

        // Pick from Map button
        document.getElementById('btnPickMap').addEventListener('click', function() {
            var lat = document.getElementById('Latitude').value;
            var lng = document.getElementById('Longitude').value;
            if (lat && lng && parseFloat(lat) !== 0 && parseFloat(lng) !== 0) {
                sessionStorage.setItem('ownerPickLocationInitial', JSON.stringify({ lat: lat, lng: lng }));
            }
            window.location.href = '/owner/stations/PickLocation?returnTo=Edit&id=@Model.Id';
        });

        $(document).ready(function() {
            var stateSelect = $('#State');
            var selectedState = '@Model.State';

            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    var option = new Option(state, state);
                    if (state === selectedState) {
                        option.selected = true;
                    }
                    stateSelect.append(option);
                });
            }
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    })();
    </script>
}
