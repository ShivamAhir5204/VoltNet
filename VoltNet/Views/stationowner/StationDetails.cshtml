@model VoltNet.Models.Station
@{
    ViewData["Title"] = "Station Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var managers = ViewBag.Managers as List<VoltNet.Models.StationManager> ?? new List<VoltNet.Models.StationManager>();
}

<div class="sd">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<!-- Overview -->
<div class="card gap-b">
    <div class="card-body">
        <div class="top">
            <div>
                <div class="top-title">
                    <h4>@Model.Name</h4>
                    @if (Model.Status == "Active")
                    {
                        <span class="status s-ok">Active</span>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <span class="status s-plan">Approved (Offline)</span>
                    }
                    else if (Model.Status == "PendingVerification")
                    {
                        <span class="status s-warn">Pending Verification</span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="status s-err">Rejected</span>
                    }
                    else
                    {
                        <span class="status s-plain">@Model.Status</span>
                    }
                </div>
                <div class="meta">@Model.City, @Model.State &bull; @Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm") &bull; @managers.Count Manager(s)</div>
            </div>

            <div class="actions">
                <a href="/owner/revenue/station/@Model.Id" class="btn btn-ghost"><i class="fas fa-chart-line"></i> Revenue</a>
                <a href="/owner/rates/@Model.Id" class="btn btn-main"><i class="fas fa-bolt"></i> Rates</a>
                <a href="/owner/stations/Edit/@Model.Id" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
                <a href="/owner/stations" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </div>

        @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="alert alert-danger mt-3 mb-0"><strong>Rejection Reason:</strong> @Model.RejectionReason</div>
        }
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-6 gap-b">
        <div class="card h-100">
            <div class="card-header"><h5>Location</h5></div>
            <div class="card-body">
                <div class="kv"><span class="k">Station Name</span><span class="v">@Model.Name</span></div>
                <div class="kv"><span class="k">City</span><span class="v">@Model.City</span></div>
                <div class="kv"><span class="k">State</span><span class="v">@Model.State</span></div>
                <div class="kv"><span class="k">Latitude</span><span class="v mono">@Model.Latitude</span></div>
                <div class="kv"><span class="k">Longitude</span><span class="v mono">@Model.Longitude</span></div>
                <span class="lbl">Address</span>
                <div class="box">@Model.Address</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6 gap-b">
        <div class="card h-100">
            <div class="card-header"><h5>Operation</h5></div>
            <div class="card-body">
                <div class="kv">
                    <span class="k">Status</span>
                    <span class="v">
                        @if (Model.Status == "Active")
                        {
                            <span class="status s-ok">Active (Online)</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="status s-plan">Approved (Requires Subscription)</span>
                        }
                        else if (Model.Status == "PendingVerification")
                        {
                            <span class="status s-warn">Under Admin Verification</span>
                        }
                        else
                        {
                            <span class="status s-err">@Model.Status</span>
                        }
                    </span>
                </div>
                <div class="kv"><span class="k">Opening Time</span><span class="v">@Model.OpeningTime.ToString(@"hh\:mm")</span></div>
                <div class="kv"><span class="k">Closing Time</span><span class="v">@Model.ClosingTime.ToString(@"hh\:mm")</span></div>
                <div class="kv"><span class="k">Registered On</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span></div>
                <div class="kv">
                    <span class="k">Subscription</span>
                    <span class="v">
                        @if (Model.OwnerSubscriptionId != null)
                        {
                            <a href="/owner/subscription/@Model.OwnerSubscriptionId/details" class="link">View Plan &rarr;</a>
                        }
                        else
                        {
                            <a href="/owner/subscription" class="btn btn-warn"><i class="fas fa-link"></i> Assign to Plan</a>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Managers -->
<div class="card gap-b">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Station Managers (@managers.Count)</h5>
        <a href="/owner/station-managers/Create" class="btn btn-ghost"><i class="fas fa-plus"></i> Add Manager</a>
    </div>
    <div class="card-body">
        @if (!managers.Any())
        {
            <div class="empty-box">
                No managers assigned.
                <div><a href="/owner/station-managers/Create" class="btn btn-main"><i class="fas fa-plus"></i> Add Manager</a></div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var mgr in managers)
                {
                    <div class="col-12 col-md-6 mb-3">
                        <div class="mgr">
                            <div>
                                <div class="name">@mgr.FullName</div>
                                <div class="sub">@(mgr.User?.Email ?? "—")</div>
                                <div class="sub">@mgr.Phone</div>
                                <a href="/owner/station-managers/Edit/@mgr.Id" class="link">Edit &rarr;</a>
                            </div>
                            <div>
                                @if (mgr.IsActive)
                                {
                                    <span class="status s-ok">Active</span>
                                }
                                else
                                {
                                    <span class="status s-err">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Documents -->
<div class="card gap-b">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Documents (@(Model.Documents?.Count ?? 0))</h5>
        <button type="button" class="btn btn-ghost" data-toggle="modal" data-target="#uploadDocModal"><i class="fas fa-plus"></i> Upload</button>
    </div>

    @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="card-body" style="padding-bottom:0">
            <div class="alert alert-danger mb-0">
                <strong>Verification rejected.</strong> @Model.RejectionReason
                <div>Re-upload corrected files to restart verification.</div>
            </div>
        </div>
    }

    @if (Model.Documents == null || !Model.Documents.Any())
    {
        <div class="card-body">
            <div class="empty-box">
                No documents uploaded.
                <div><button type="button" class="btn btn-main" data-toggle="modal" data-target="#uploadDocModal"><i class="fas fa-plus"></i> Upload Documents</button></div>
            </div>
        </div>
    }
    else
    {
        <div class="card-body flush">
            <div class="table-responsive">
                <table class="table table-striped align-middle no-datatable table-responsive-cards">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Ref / Sanction No.</th>
                            <th>File</th>
                            <th>Status</th>
                            <th>Uploaded</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td class="col-primary" data-label="Document">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="cell-strong">@doc.DocumentType</span>
                                        <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                            <i data-feather="chevron-down"></i>
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(doc.RejectionReason))
                                    {
                                        <div class="cell-err">Feedback: @doc.RejectionReason</div>
                                    }
                                </td>
                                <td class="col-secondary" data-label="Ref / No."><div>@(doc.DocumentNumber ?? "—")</div></td>
                                <td class="col-secondary" data-label="File">
                                    <div>
                                        <div class="cell-sub">@doc.OriginalFileName</div>
                                        <span class="status s-plain mt-1">@(doc.FileSizeBytes / 1024) KB</span>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <div>
                                        @if (doc.Status == "Verified")
                                        {
                                            <span class="status s-ok">Verified</span>
                                        }
                                        else if (doc.Status == "Rejected")
                                        {
                                            <span class="status s-err">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="status s-warn">Pending Review</span>
                                        }
                                    </div>
                                </td>
                                <td class="col-secondary" data-label="Uploaded"><div>@doc.UploadedAt.ToString("dd MMM yyyy")</div></td>
                                <td class="text-right col-action" data-label="Action">
                                    <div class="row-actions">
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-edit" title="Preview / Download">
                                            <i class="fas fa-external-link-alt"></i> View
                                        </a>
                                        @if (doc.Status != "Verified")
                                        {
                                            <form method="post" action="/owner/stations/DeleteDocument" onsubmit="return confirm('Delete this document?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="documentId" value="@doc.Id" />
                                                <input type="hidden" name="stationId" value="@Model.Id" />
                                                <button type="submit" class="icon-btn icon-btn-delete" title="Delete" aria-label="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

</div>

@section Modals {
<div class="modal fade sd-modal" id="uploadDocModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form method="post" action="/owner/stations/UploadDocument" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="stationId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Upload Document</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Document Type <span class="text-danger">*</span></label>
                        <select name="documentType" class="form-control" required>
                            <option value="">-- Select Document --</option>
                            <option value="DISCOM Sanction Letter">DISCOM Electricity Sanction Letter (Power Load)</option>
                            <option value="Land Lease / Ownership">Land Lease Agreement / Ownership Deed</option>
                            <option value="Fire Safety NOC">Fire Safety NOC / Clearance Certificate</option>
                            <option value="CEIG Clearance / SLD">CEIG Safety Clearance / Single Line Diagram (SLD)</option>
                            <option value="Station Site Photographs">Station Site & Charger Installation Photographs</option>
                            <option value="Owner Business GST / Trade License">Owner Business Registration / GST Certificate</option>
                            <option value="Other Regulatory Approval">Other Regulatory Clearance</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Reference / Sanction No.</label>
                        <input type="text" name="documentNumber" class="form-control" />
                    </div>
                    <div class="form-group mb-0">
                        <label>File <span class="text-danger">*</span></label>
                        <input type="file" name="documentFile" class="form-control-file w-100" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
                        <span class="file-note">PDF, PNG, JPG (Max 10 MB)</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-main"><i class="fas fa-plus"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
}