@model VoltNet.Models.Station
@{
    ViewData["Title"] = "Station Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var managers = ViewBag.Managers as List<VoltNet.Models.StationManager> ?? new List<VoltNet.Models.StationManager>();
}

<div class="section-header">
    <div class="section-header-back">
        <a href="/owner/stations" class="btn btn-icon"><i class="fas fa-arrow-left"></i></a>
    </div>
    <h1>Station Details</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/owner/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item"><a href="/owner/stations">My Stations</a></div>
        <div class="breadcrumb-item">@Model.Name</div>
    </div>
</div>

<!-- Top Overview Card -->
<div class="card mb-4" style="border: 1px solid #dce2eb; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
    <div class="card-body py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
            <div class="d-flex align-items-center mb-3 mb-md-0">
                <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" 
                     style="width: 58px; height: 58px; background: #eef2f7; color: #6777ef; font-size: 24px; flex-shrink: 0;">
                    <i class="fas fa-charging-station"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center flex-wrap">
                        <h3 class="mb-1 font-weight-bold mr-3" style="color: #212529; font-size: 22px;">@Model.Name</h3>
                        @if (Model.Status == "Active")
                        {
                            <span class="badge badge-success font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-check-circle mr-1"></i> Active
                            </span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge badge-primary font-weight-700 px-3 py-1 font-13">
                                Approved (Offline)
                            </span>
                        }
                        else if (Model.Status == "PendingVerification")
                        {
                            <span class="badge badge-warning font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-clock mr-1"></i> Pending Verification
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge badge-danger font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-ban mr-1"></i> Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-secondary font-weight-700 px-3 py-1 font-13">
                                @Model.Status
                            </span>
                        }
                    </div>
                    <div class="font-weight-600" style="color: #34395e; font-size: 14px;">
                        <span><i class="fas fa-map-marker-alt text-danger mr-1"></i> @Model.City, @Model.State</span>
                        <span class="text-muted mx-2">•</span>
                        <span>Operating: @Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm")</span>
                        <span class="text-muted mx-2">•</span>
                        <span>@managers.Count Manager(s)</span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center" style="gap: 8px;">
                <a href="/owner/rates/@Model.Id" class="btn btn-primary font-weight-600">
                    <i class="fas fa-bolt mr-1"></i> Manage Rates
                </a>
                <a href="/owner/stations/Edit/@Model.Id" class="btn btn-outline-primary font-weight-600">
                    <i class="fas fa-edit mr-1"></i> Edit Station
                </a>
                <a href="/owner/stations" class="btn btn-outline-secondary font-weight-600">
                    <i class="fas fa-arrow-left mr-1"></i> Back
                </a>
            </div>
        </div>

        @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="alert alert-light mt-3 mb-0 py-2 px-3" style="border: 1px solid #dce2eb; border-left: 4px solid #fc544b; border-radius: 6px;">
                <span class="text-danger font-weight-bold font-14">Rejection Reason:</span>
                <span class="font-weight-600 text-dark font-14 ml-2">@Model.RejectionReason</span>
            </div>
        }
    </div>
</div>

<div class="row">
    <!-- ─── Location & Geographic Specs ──────────────────────────────── -->
    <div class="col-12 col-lg-6 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-primary">
                <i class="fas fa-map-pin"></i> Location & Address
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Station Name</span>
                <span class="detail-value font-weight-bold text-dark font-16">@Model.Name</span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">City</span>
                <span class="detail-value font-weight-600 text-dark font-15">@Model.City</span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">State</span>
                <span class="detail-value font-weight-600 text-dark font-15">@Model.State</span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Latitude</span>
                <span class="detail-value text-monospace font-weight-600 text-dark font-14">@Model.Latitude</span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Longitude</span>
                <span class="detail-value text-monospace font-weight-600 text-dark font-14">@Model.Longitude</span>
            </div>

            <div class="detail-row mt-3">
                <span class="detail-label">Complete Physical Address</span>
                <div class="detail-box mt-1">
                    @Model.Address
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Operation & Subscription Status ───────────────────────────── -->
    <div class="col-12 col-lg-6 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-success">
                <i class="fas fa-clock"></i> Operation & Availability
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Public Status</span>
                <span class="detail-value">
                    @if (Model.Status == "Active")
                    {
                        <span class="badge badge-success font-weight-700 font-13 px-3 py-1">
                            <i class="fas fa-check-circle mr-1"></i> Active (Online)
                        </span>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <span class="badge badge-primary font-weight-700 font-13 px-3 py-1">
                            Approved (Requires Subscription)
                        </span>
                    }
                    else if (Model.Status == "PendingVerification")
                    {
                        <span class="badge badge-warning font-weight-700 font-13 px-3 py-1">
                            Under Admin Verification
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-danger font-weight-700 font-13 px-3 py-1">
                            @Model.Status
                        </span>
                    }
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Opening Time</span>
                <span class="detail-value font-weight-bold text-dark font-16">
                    <i class="fas fa-sun text-warning mr-1"></i> @Model.OpeningTime.ToString(@"hh\:mm")
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Closing Time</span>
                <span class="detail-value font-weight-bold text-dark font-16">
                    <i class="fas fa-moon text-dark mr-1"></i> @Model.ClosingTime.ToString(@"hh\:mm")
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Registered On</span>
                <span class="detail-value font-weight-600 text-dark font-15">
                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Linked Subscription</span>
                <span class="detail-value">
                    @if (Model.OwnerSubscriptionId != null)
                    {
                        <a href="/owner/subscription/@Model.OwnerSubscriptionId/details" class="font-weight-bold text-primary font-14">
                            <i class="fas fa-link mr-1"></i> View Linked Plan &rarr;
                        </a>
                    }
                    else
                    {
                        <a href="/owner/subscription" class="btn btn-sm btn-outline-warning font-weight-bold">
                            <i class="fas fa-exclamation-triangle mr-1"></i> Assign to Plan
                        </a>
                    }
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ─── Assigned Managers Section ─────────────────────────────────── -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-info d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    <i class="fas fa-users"></i>
                    <span>Assigned Station Managers</span>
                    <span class="badge badge-info font-weight-700 font-13 ml-2">@managers.Count Manager(s)</span>
                </div>
                <a href="/owner/station-managers/Create" class="btn btn-sm btn-outline-primary font-weight-600 mt-2 mt-sm-0">
                    <i class="fas fa-user-plus mr-1"></i> Add Station Manager
                </a>
            </div>

            @if (!managers.Any())
            {
                <div class="text-center py-4" style="background: #ffffff; border: 1px dashed #dce2eb; border-radius: 8px;">
                    <i class="fas fa-user-shield text-muted mb-2" style="font-size: 36px;"></i>
                    <h6 class="font-weight-bold text-dark mb-1">No Managers Assigned to this Station</h6>
                    <p class="mb-3 font-weight-500" style="color: #34395e; font-size: 14px;">
                        Assign station managers to oversee day-to-day operations and monitor active charging sessions.
                    </p>
                    <a href="/owner/station-managers/Create" class="btn btn-primary font-weight-600">
                        <i class="fas fa-plus mr-1"></i> Assign New Manager
                    </a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var mgr in managers)
                    {
                        <div class="col-12 col-md-6 mb-3">
                            <div class="station-chip">
                                <div class="d-flex align-items-center" style="gap: 12px;">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 42px; height: 42px; background: #eef2f7; color: #6777ef; font-size: 18px; flex-shrink: 0;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <strong>@mgr.FullName</strong>
                                        <div class="font-weight-600" style="font-size: 13px; color: #34395e;">
                                            <i class="fas fa-envelope text-primary mr-1"></i> @(mgr.User?.Email ?? "—")
                                        </div>
                                        <div class="font-weight-600" style="font-size: 13px; color: #34395e;">
                                            <i class="fas fa-phone text-success mr-1"></i> @mgr.Phone
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    @if (mgr.IsActive)
                                    {
                                        <span class="badge badge-success font-weight-700 font-12">
                                            <i class="fas fa-check-circle mr-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger font-weight-700 font-12">
                                            Inactive
                                        </span>
                                    }
                                    <div class="mt-2">
                                        <a href="/owner/station-managers/Edit/@mgr.Id" class="btn btn-sm btn-link p-0 font-weight-600" style="font-size: 12px;">
                                            Edit Manager &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
