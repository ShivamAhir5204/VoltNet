@model VoltNet.Models.Station

@{
    ViewData["Title"] = "Station Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <h4 class="mb-0">Station: @Model.Name</h4>
        <div class="mt-2 mt-sm-0">
          <a href="/owner/rates/@Model.Id" class="btn btn-primary btn-sm mr-1"><i class="fas fa-bolt mr-1"></i> Manage Rates</a>
          <a href="/owner/stations/Edit/@Model.Id" class="btn btn-warning btn-sm mr-1"><i class="fas fa-edit mr-1"></i> Edit</a>
          <a href="/owner/stations" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back</a>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-12 col-md-6 mb-3 mb-md-0">
            <div class="table-responsive">
              <table class="table table-bordered">
                <tr><th style="width:35%">Name</th><td>@Model.Name</td></tr>
                <tr><th>Address</th><td>@Model.Address</td></tr>
                <tr><th>City</th><td>@Model.City</td></tr>
                <tr><th>State</th><td>@Model.State</td></tr>
                <tr><th>Latitude</th><td>@Model.Latitude</td></tr>
                <tr><th>Longitude</th><td>@Model.Longitude</td></tr>
              </table>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="table-responsive">
              <table class="table table-bordered">
                <tr>
                  <th style="width:35%">Status</th>
                  <td>
                    @if (Model.Status == "Active")
                    {
                      <span class="badge badge-success">Active</span>
                    }
                    else if (Model.Status == "PendingVerification")
                    {
                      <span class="badge badge-warning text-dark">Pending Verification</span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                      <span class="badge badge-danger">Rejected</span>
                    }
                    else
                    {
                      <span class="badge badge-secondary">@Model.Status</span>
                    }
                  </td>
                </tr>
                @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
                {
                  <tr><th>Rejection Reason</th><td class="text-danger">@Model.RejectionReason</td></tr>
                }
                <tr><th>Opening Time</th><td>@Model.OpeningTime.ToString(@"hh\:mm")</td></tr>
                <tr><th>Closing Time</th><td>@Model.ClosingTime.ToString(@"hh\:mm")</td></tr>
                <tr><th>Created At</th><td>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@{
    var managers = ViewBag.Managers as List<VoltNet.Models.StationManager>;
}
@if (managers != null && managers.Any())
{
<div class="row mt-3">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>Assigned Managers</h4>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Assigned</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var mgr in managers)
              {
                <tr>
                  <td class="font-weight-bold">@mgr.FullName</td>
                  <td>@(mgr.User?.Email ?? "—")</td>
                  <td>@mgr.Phone</td>
                  <td>
                    @if (mgr.IsActive)
                    {
                      <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                      <span class="badge badge-danger">Inactive</span>
                    }
                  </td>
                  <td>@mgr.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
}
