@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "My Stations";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>My Stations</h4>
        <a href="/owner/stations/Create" class="btn btn-primary">
          <i class="fas fa-plus"></i> Create New
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped align-middle" id="table-1">
            <thead>
              <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Status</th>
                <th>Opening</th>
                <th>Closing</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model)
              {
                <tr>
                  <td>@item.Name</td>
                  <td>@item.Address</td>
                  <td>@item.City</td>
                  <td>@item.State</td>
                  <td>
                    @if (item.Status == "Active")
                    {
                      <span class="badge bg-success">Active</span>
                    }
                    else if (item.Status == "PendingVerification")
                    {
                      <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.Status == "Rejected")
                    {
                      <span class="badge bg-danger">Rejected</span>
                    }
                    else if (item.Status == "Suspended")
                    {
                      <span class="badge bg-secondary">Suspended</span>
                    }
                    else
                    {
                      <span class="badge bg-info">@item.Status</span>
                    }
                  </td>
                  <td>@item.OpeningTime.ToString(@"hh\:mm")</td>
                  <td>@item.ClosingTime.ToString(@"hh\:mm")</td>
                  <td class="text-center">
                    <form asp-action="Details" method="post" class="d-inline-block">
                      <input type="hidden" name="id" value="@item.Id" />
                      <button type="submit" class="btn btn-info btn-sm" title="Details"><i class="fas fa-info-circle"></i> View</button>
                    </form>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
