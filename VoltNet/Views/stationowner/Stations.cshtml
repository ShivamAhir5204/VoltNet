@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "My Stations";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <h4 class="mb-0">My Stations</h4>
        <a href="/owner/stations/Create" class="btn btn-primary mt-2 mt-sm-0">
          <i class="fas fa-plus"></i> Create New
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle" id="table-1">
            <thead>
              <tr>
                <th>Name</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Status</th>
                <th>Opening</th>
                <th>Closing</th>
                <th class="text-center" style="min-width: 280px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in Model)
              {
                <tr>
                  <td class="font-weight-bold">@item.Name</td>
                  <td>@item.Address</td>
                  <td>@item.City</td>
                  <td>@item.State</td>
                  <td>
                    @if (item.Status == "Active")
                    {
                      <span class="badge badge-success">Active</span>
                    }
                    else if (item.Status == "PendingVerification")
                    {
                      <span class="badge badge-warning text-dark">Pending</span>
                    }
                    else if (item.Status == "Rejected")
                    {
                      <span class="badge badge-danger" title="@item.RejectionReason">Rejected</span>
                    }
                    else if (item.Status == "Suspended")
                    {
                      <span class="badge badge-secondary">Suspended</span>
                    }
                    else
                    {
                      <span class="badge badge-info">@item.Status</span>
                    }
                  </td>
                  <td>@item.OpeningTime.ToString(@"hh\:mm")</td>
                  <td>@item.ClosingTime.ToString(@"hh\:mm")</td>
                  <td class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center flex-wrap">
                      <a href="/owner/rates/@item.Id" class="btn btn-primary btn-sm mr-1 mb-1" title="Manage Charging Rates">
                        <i class="fas fa-bolt mr-1"></i> Rates
                      </a>
                      <a href="/owner/stations/Edit/@item.Id" class="btn btn-warning btn-sm mr-1 mb-1" title="Edit Station">
                        <i class="fas fa-edit mr-1"></i> Edit
                      </a>
                      <form asp-action="Details" method="post" class="d-inline mr-1 mb-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-info btn-sm" title="Details"><i class="fas fa-info-circle mr-1"></i> View</button>
                      </form>
                      <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline mb-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete station \'@item.Name\'?');" title="Delete">
                          <i class="fas fa-trash mr-1"></i> Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
