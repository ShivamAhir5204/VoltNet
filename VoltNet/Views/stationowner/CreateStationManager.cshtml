@{
    ViewData["Title"] = "Create Station Manager";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Create Station Manager</h4>
        <a href="/owner/station-managers" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
      </div>
      <div class="card-body">
        @if (ViewBag.Error != null)
        {
          <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" asp-action="Create">
          <div class="form-group">
            <label for="fullName">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="fullName" name="fullName" required placeholder="Enter full name" />
          </div>
          <div class="form-group">
            <label for="email">Email <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" name="email" required placeholder="Enter email address" />
          </div>
          <div class="form-group">
            <label for="phone">Phone <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="phone" name="phone" required maxlength="10" placeholder="Enter phone number" />
          </div>
          <div class="form-group">
            <label for="password">Initial Password <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="password" name="password" required minlength="6" placeholder="Set initial password" />
            <small class="form-text text-muted">The manager can change this after first login.</small>
          </div>
          <div class="form-group">
            <label for="stationId">Assign to Station <span class="text-danger">*</span></label>
            <select class="form-control" id="stationId" name="stationId" required>
              <option value="">-- Select Station --</option>
              @if (ViewBag.StationList != null)
              {
                @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.StationList)
                {
                  <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                }
              }
            </select>
          </div>
          <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Create Manager</button>
            <a href="/owner/station-managers" class="btn btn-light ml-2">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
