@{
    ViewData["Title"] = "Create Station Manager";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="cm">
<div class="row">
  <div class="col-12">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Create Station Manager</h4>
        <a href="/owner/station-managers" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
      </div>

      <div class="card-body">
        @if (ViewBag.Error != null)
        {
          <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Create">
          @Html.AntiForgeryToken()

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="fullName">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="fullName" name="fullName" required />
            </div>

            <div class="form-group col-md-6">
              <label for="phone">Mobile Number <span class="text-danger">*</span></label>
              <input type="tel" inputmode="numeric" class="form-control" id="phone" name="phone" required maxlength="10" pattern="[6-9][0-9]{9}" title="10-digit Indian mobile number starting with 6, 7, 8, or 9" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="email">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="email" name="email" required />
            </div>

            <div class="form-group col-md-6">
              <label for="password">Initial Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="password" required minlength="6" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="stationId">Station <span class="text-danger">*</span></label>
              <select class="form-control" id="stationId" name="stationId" required>
                <option value="">-- Select Station --</option>
                @if (ViewBag.StationList != null)
                {
                  @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.StationList)
                  {
                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                  }
                }
              </select>
            </div>

            <div class="form-group col-md-6">
              <label>Permissions</label>
              <div class="perm">
                <input type="checkbox" id="canManageRates" name="canManageRates" value="true" />
                <label for="canManageRates">Can manage charging rates</label>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Create Manager</button>
            <a href="/owner/station-managers" class="btn btn-back">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
</div>