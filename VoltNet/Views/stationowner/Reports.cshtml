@model IEnumerable<VoltNet.Controllers.stationowner.StationPerformanceDto>

@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0m;
    var totalKwh = ViewBag.TotalKwh != null ? (decimal)ViewBag.TotalKwh : 0m;
    var totalSessions = ViewBag.TotalSessions != null ? (int)ViewBag.TotalSessions : 0;
    var stationsCount = ViewBag.StationsCount != null ? (int)ViewBag.StationsCount : Model.Count();
    var avgTicket = totalSessions > 0 ? (totalRevenue / totalSessions) : 0m;

    var monthLabels = ViewBag.MonthLabels as List<string> ?? new List<string>();
    var monthRevenue = ViewBag.MonthRevenue as List<decimal> ?? new List<decimal>();
    var connectorLabels = ViewBag.ConnectorLabels as List<string> ?? new List<string>();
    var connectorCounts = ViewBag.ConnectorCounts as List<int> ?? new List<int>();
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                <div>
                    <h4 class="mb-1"><i class="fas fa-chart-line text-primary mr-2"></i> Station Network Performance &amp; Revenue Analytics</h4>
                    <p class="text-muted mb-0 small">High-level financial KPIs, electricity consumption trends, and charger utilization across your stations.</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <div class="btn-group flex-wrap" role="group" aria-label="Report date range">
                        <a href="/owner/reports" class="btn btn-sm @(ViewBag.SelectedDays == null ? "btn-primary" : "btn-outline-primary")">All Time</a>
                        <a href="/owner/reports?days=30" class="btn btn-sm @(ViewBag.SelectedDays == 30 ? "btn-primary" : "btn-outline-primary")">Last 30 Days</a>
                        <a href="/owner/reports?days=90" class="btn btn-sm @(ViewBag.SelectedDays == 90 ? "btn-primary" : "btn-outline-primary")">Last 90 Days</a>
                        <a href="/owner/reports?days=365" class="btn btn-sm @(ViewBag.SelectedDays == 365 ? "btn-primary" : "btn-outline-primary")">1 Year</a>
                    </div>
                </div>
            </div>
            <div class="card-body">

                <!-- KPI Metric Cards -->
                <div class="row">
                    <div class="col-12 col-sm-6 col-lg-3 mb-3">
                        <div class="card card-statistic-1 border mb-0 h-100">
                            <div class="card-icon bg-success text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-rupee-sign fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Total Revenue</h4></div>
                                <div class="card-body font-weight-bold text-success">₹@totalRevenue.ToString("F2")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 mb-3">
                        <div class="card card-statistic-1 border mb-0 h-100">
                            <div class="card-icon bg-primary text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-bolt fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Energy Delivered</h4></div>
                                <div class="card-body font-weight-bold text-primary">@totalKwh.ToString("F2") kWh</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 mb-3">
                        <div class="card card-statistic-1 border mb-0 h-100">
                            <div class="card-icon bg-info text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-charging-station fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Total Sessions</h4></div>
                                <div class="card-body font-weight-bold">@totalSessions</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 mb-3">
                        <div class="card card-statistic-1 border mb-0 h-100">
                            <div class="card-icon bg-warning text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-calculator fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0"><h4 class="text-muted">Avg / Session</h4></div>
                                <div class="card-body font-weight-bold text-warning">₹@avgTicket.ToString("F2")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interactive Charts Row -->
                <div class="row mb-4">
                    <div class="col-12 col-lg-8 mb-4 mb-lg-0">
                        <div class="card border mb-0 h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="font-weight-bold text-dark mb-0"><i class="fas fa-chart-bar text-primary mr-2"></i> Revenue Trend (Past 6 Months)</h6>
                            </div>
                            <div class="card-body">
                                <canvas id="revenueTrendChart" class="w-100" style="height: 260px; max-height: 260px;"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card border mb-0 h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="font-weight-bold text-dark mb-0"><i class="fas fa-plug text-info mr-2"></i> Connector Utilization</h6>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center">
                                <canvas id="connectorChart" class="w-100" style="height: 260px; max-height: 260px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Station-wise Performance Table -->
                <h5 class="font-weight-bold text-dark mb-3">
                    <i class="fas fa-list-alt text-primary mr-2"></i> Station-wise Performance Breakdown
                </h5>

                @if (!Model.Any())
                {
                    <div class="text-center py-4 bg-light rounded">
                        <p class="text-muted mb-0">No station records found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle" id="table-1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Station Name</th>
                                    <th>Location</th>
                                    <th class="text-center">Chargers</th>
                                    <th class="text-center">Sessions Handled</th>
                                    <th class="text-center">Energy Delivered</th>
                                    <th class="text-right">Total Revenue (₹)</th>
                                    <th class="text-center">Avg Session (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var avgSt = item.TotalSessions > 0 ? (item.TotalRevenue / item.TotalSessions) : 0m;
                                    <tr>
                                        <td>
                                            <strong class="text-dark">@item.StationName</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted"><i class="fas fa-map-marker-alt text-danger mr-1"></i> @item.City</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-light border font-weight-bold">@item.ChargersCount</span>
                                        </td>
                                        <td class="text-center font-weight-bold">
                                            @item.TotalSessions
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-light border text-primary font-weight-bold">@item.TotalKwh.ToString("F2") kWh</span>
                                        </td>
                                        <td class="text-right">
                                            <strong class="text-success">₹@item.TotalRevenue.ToString("F2")</strong>
                                        </td>
                                        <td class="text-center text-muted">
                                            ₹@avgSt.ToString("F2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/otika/assets/bundles/chartjs/chart.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Revenue Bar Chart
            var revCtx = document.getElementById('revenueTrendChart');
            if (revCtx) {
                var monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels));
                var monthRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthRevenue));

                new Chart(revCtx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [{
                            label: 'Revenue (₹)',
                            data: monthRevenue,
                            backgroundColor: 'rgba(103, 119, 239, 0.7)',
                            borderColor: '#6777ef',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            yAxes: [{
                                ticks: {
                                    beginAtZero: true,
                                    callback: function(value) { return '₹' + value; }
                                }
                            }]
                        }
                    }
                });
            }

            // Connector Doughnut Chart
            var connCtx = document.getElementById('connectorChart');
            if (connCtx) {
                var connLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(connectorLabels));
                var connCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(connectorCounts));

                if (connLabels.length === 0) {
                    connLabels = ["No Data"];
                    connCounts = [1];
                }

                new Chart(connCtx, {
                    type: 'doughnut',
                    data: {
                        labels: connLabels,
                        datasets: [{
                            data: connCounts,
                            backgroundColor: ['#6777ef', '#63ed7a', '#ffa426', '#fc544b', '#3abaf4']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'bottom' }
                    }
                });
            }
        });
    </script>
}
