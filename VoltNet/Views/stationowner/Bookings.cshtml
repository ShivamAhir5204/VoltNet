@model IEnumerable<VoltNet.Models.Booking>

@{
    var ownerStations = ViewBag.OwnerStations as List<VoltNet.Models.Station> ?? new List<VoltNet.Models.Station>();
    ViewData["Title"] = "Station Bookings";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card card-otika">
            <div class="card-header card-otika-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-0 text-dark-slate font-weight-700">
                        <i class="fas fa-calendar-check text-otika-primary mr-2"></i> Bookings
                    </h4>
                </div>
                <div class="mt-2 mt-sm-0">
                    <span class="badge badge-light border text-muted-slate font-weight-600 px-3 py-2" id="liveCountBadge">
                        Showing @Model.Count() bookings
                    </span>
                </div>
            </div>
            <div class="card-body">
                <!-- Otika Instant Real-time Filter Bar -->
                <div class="otika-filter-bar">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-3 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Quick Search</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0 text-muted-slate"><i class="fas fa-search"></i></span>
                                </div>
                                <input type="text" id="liveSearchInput" class="form-control otika-search-input border-left-0" placeholder="Driver, email, charger..." />
                            </div>
                        </div>
                        <div class="col-12 col-md-3 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Station</label>
                            <select id="liveStationFilter" class="form-control otika-search-input">
                                <option value="">All Stations</option>
                                @foreach (var stn in ownerStations)
                                {
                                    <option value="@stn.Name.ToLower()">@stn.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Status</label>
                            <select id="liveStatusFilter" class="form-control otika-search-input">
                                <option value="">All Statuses</option>
                                <option value="confirmed">Confirmed</option>
                                <option value="charging">Charging</option>
                                <option value="completed">Completed</option>
                                <option value="cancelled">Cancelled</option>
                                <option value="noshow">No-Show</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2 mb-2 mb-md-0">
                            <label class="small font-weight-bold text-dark-slate mb-1">Date</label>
                            <input type="date" id="liveDateFilter" class="form-control otika-search-input" />
                        </div>
                        <div class="col-12 col-md-1 d-flex align-items-end">
                            <button type="button" id="btnResetFilters" class="btn btn-outline-secondary btn-block mt-4" title="Reset Filters">
                                <i class="fas fa-redo-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-soft-grey rounded border-otika">
                        <i class="fas fa-calendar-times text-muted-slate mb-3" style="font-size: 38px;"></i>
                        <h6 class="text-dark-slate font-weight-bold mb-1">No Bookings Recorded</h6>
                        <small class="text-muted-slate">Reservations will display here when customers book a charging slot.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped otika-table align-middle table-responsive-cards" id="bookingsTable">
                            <thead>
                                <tr>
                                    <th>Station</th>
                                    <th>Customer</th>
                                    <th>Charger</th>
                                    <th>Date</th>
                                    <th>Slot</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model)
                                {
                                    var statusLower = b.Status.ToLower();
                                    <tr class="booking-row"
                                        data-station="@(b.Station?.Name?.ToLower() ?? "")"
                                        data-status="@statusLower"
                                        data-date="@b.BookingDate.ToString("yyyy-MM-dd")"
                                        data-search="@($"{b.Station?.Name} {b.Customer?.Fullname} {b.Customer?.Email} {b.Charger?.Name} {b.Charger?.ConnectorType}".ToLower())">
                                        <td class="col-primary" data-label="Station">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="font-weight-bold text-dark-slate">@b.Station?.Name</span>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Customer">
                                            <div>
                                                <strong class="text-dark-slate">@(b.Customer?.Fullname ?? "Customer")</strong>
                                                <div class="small text-muted-slate">@(b.Customer?.Email ?? "—")</div>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Charger">
                                            <div>
                                                <span class="badge badge-light border text-dark-slate">@b.Charger?.Name</span>
                                                <span class="small text-muted-slate ml-1">@b.Charger?.ConnectorType</span>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Date">
                                            <span class="text-dark-slate font-weight-500">@b.BookingDate.ToString("dd MMM yyyy")</span>
                                        </td>
                                        <td class="col-secondary" data-label="Slot">
                                            <span class="badge badge-light border text-otika-primary font-weight-600">
                                                @b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </td>
                                        <td class="col-secondary" data-label="Amount">
                                            <strong class="text-success" style="color: #28C76F !important;">
                                                ₹@(b.ActualCost?.ToString("F2") ?? b.EstimatedCost.ToString("F2"))
                                            </strong>
                                        </td>
                                        <td class="col-secondary" data-label="Status">
                                            @if (b.Status == "Confirmed")
                                            {
                                                <span class="badge badge-otika-primary">Confirmed</span>
                                            }
                                            else if (b.Status == "Completed")
                                            {
                                                <span class="badge badge-otika-success">Completed</span>
                                            }
                                            else if (b.Status == "Cancelled")
                                            {
                                                <span class="badge badge-otika-error" title="@b.CancellationReason">Cancelled</span>
                                            }
                                            else if (b.Status == "NoShow")
                                            {
                                                <span class="badge badge-otika-warning">No-Show</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-otika-info">@b.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="noMatchAlert" class="text-center py-4 bg-soft-grey rounded border-otika mt-2" style="display: none;">
                        <i class="fas fa-search text-muted-slate mb-2" style="font-size: 26px;"></i>
                        <p class="text-muted-slate mb-0 font-14">No bookings match your filter criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var searchInput = document.getElementById('liveSearchInput');
        var stationFilter = document.getElementById('liveStationFilter');
        var statusFilter = document.getElementById('liveStatusFilter');
        var dateFilter = document.getElementById('liveDateFilter');
        var resetBtn = document.getElementById('btnResetFilters');
        var countBadge = document.getElementById('liveCountBadge');
        var noMatchAlert = document.getElementById('noMatchAlert');
        var rows = document.querySelectorAll('.booking-row');
        var totalRows = rows.length;

        function applyLiveFilter() {
            var searchVal = (searchInput ? searchInput.value : '').trim().toLowerCase();
            var stationVal = (stationFilter ? stationFilter.value : '').toLowerCase();
            var statusVal = (statusFilter ? statusFilter.value : '').toLowerCase();
            var dateVal = (dateFilter ? dateFilter.value : '').trim();

            var visibleCount = 0;

            rows.forEach(function (row) {
                var rowSearch = row.getAttribute('data-search') || '';
                var rowStation = row.getAttribute('data-station') || '';
                var rowStatus = row.getAttribute('data-status') || '';
                var rowDate = row.getAttribute('data-date') || '';

                var matchSearch = !searchVal || rowSearch.indexOf(searchVal) !== -1;
                var matchStation = !stationVal || rowStation.indexOf(stationVal) !== -1;
                var matchStatus = !statusVal || rowStatus === statusVal;
                var matchDate = !dateVal || rowDate === dateVal;

                if (matchSearch && matchStation && matchStatus && matchDate) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (countBadge) {
                countBadge.textContent = 'Showing ' + visibleCount + ' of ' + totalRows + ' bookings';
            }
            if (noMatchAlert) {
                noMatchAlert.style.display = (visibleCount === 0 && totalRows > 0) ? 'block' : 'none';
            }
        }

        if (searchInput) searchInput.addEventListener('input', applyLiveFilter);
        if (stationFilter) stationFilter.addEventListener('change', applyLiveFilter);
        if (statusFilter) statusFilter.addEventListener('change', applyLiveFilter);
        if (dateFilter) dateFilter.addEventListener('input', applyLiveFilter);

        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                if (searchInput) searchInput.value = '';
                if (stationFilter) stationFilter.value = '';
                if (statusFilter) statusFilter.value = '';
                if (dateFilter) dateFilter.value = '';
                applyLiveFilter();
            });
        }
    })();
</script>
}
