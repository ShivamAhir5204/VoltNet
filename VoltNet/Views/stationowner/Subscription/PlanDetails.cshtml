@model VoltNet.Models.SubscriptionPlan
@{
    ViewData["Title"] = $"Subscribe to {Model.Name}";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var razorpayKey = ViewBag.RazorpayKeyId as string ?? "";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @TempData["Error"]
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Success</div>
            @TempData["Success"]
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-9">
        <div class="card card-primary shadow-sm mb-4">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                <div>
                    <span class="badge badge-primary mb-1">
                        <i class="fas fa-crown mr-1"></i> Selected Plan
                    </span>
                    <h3 class="font-weight-bold text-dark mb-0">@Model.Name Plan</h3>
                    <p class="text-muted small mb-0">@Model.Description</p>
                </div>
                <div class="text-sm-right mt-3 mt-sm-0">
                    <div class="h2 font-weight-bold text-primary mb-0">₹@Model.PricePerMonth.ToString("N0")</div>
                    <small class="text-muted">per @Model.DurationDays Days Billing Cycle</small>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row">
                    <!-- Left: Features list -->
                    <div class="col-12 col-md-7 pr-md-4 mb-4 mb-md-0">
                        <h5 class="font-weight-bold text-dark mb-4">
                            <i class="fas fa-layer-group mr-2 text-primary"></i>What's Included in This Plan
                        </h5>

                        <ul class="list-unstyled">
                            <li class="media mb-3">
                                <div class="bg-success text-white rounded-circle p-2 mr-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-check small"></i>
                                </div>
                                <div class="media-body">
                                    <strong class="text-dark">Activate up to @Model.MaxStations EV Station(s)</strong>
                                    <small class="text-muted d-block">Make them publicly accessible to drivers across the network</small>
                                </div>
                            </li>

                            <li class="media mb-3">
                                <div class="bg-success text-white rounded-circle p-2 mr-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-check small"></i>
                                </div>
                                <div class="media-body">
                                    <strong class="text-dark">@Model.MaxManagersPerStation Station Manager(s) per Station</strong>
                                    <small class="text-muted d-block">Assign dedicated managers for day-to-day station operations</small>
                                </div>
                            </li>

                            <li class="media mb-3">
                                <div class="bg-success text-white rounded-circle p-2 mr-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-check small"></i>
                                </div>
                                <div class="media-body">
                                    <strong class="text-dark">Valid for @Model.DurationDays Days</strong>
                                    <small class="text-muted d-block">Instant activation as soon as payment is confirmed</small>
                                </div>
                            </li>

                            <li class="media mb-3">
                                <div class="bg-success text-white rounded-circle p-2 mr-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-check small"></i>
                                </div>
                                <div class="media-body">
                                    <strong class="text-dark">Real-Time Tariff &amp; Slot Booking Control</strong>
                                    <small class="text-muted d-block">Full management access from your owner dashboard</small>
                                </div>
                            </li>

                            <li class="media">
                                <div class="bg-success text-white rounded-circle p-2 mr-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fas fa-check small"></i>
                                </div>
                                <div class="media-body">
                                    <strong class="text-dark">Official Invoices &amp; Tax Receipts</strong>
                                    <small class="text-muted d-block">Instant downloadable PDF/text receipts for business accounting</small>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Right: Order Summary & Checkout Action -->
                    <div class="col-12 col-md-5">
                        <div class="card border bg-light shadow-none mb-0">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-dark mb-3">Order Summary</h6>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Plan Name</span>
                                    <span class="font-weight-bold text-dark">@Model.Name</span>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Duration</span>
                                    <span class="text-dark">@Model.DurationDays Days</span>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Station Capacity</span>
                                    <span class="text-dark">@Model.MaxStations Station(s)</span>
                                </div>

                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-muted">GST (Included)</span>
                                    <span class="text-dark">₹0.00</span>
                                </div>

                                <hr class="my-3">

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="font-weight-bold text-dark">Total Payable</span>
                                    <span class="font-weight-bold text-success h4 mb-0">₹@Model.PricePerMonth.ToString("N0")</span>
                                </div>

                                <button type="button" class="btn btn-primary btn-lg btn-block" id="btnPay" onclick="startRazorpayPayment('@Model.Id', '@Model.Name', @Model.PricePerMonth)">
                                    <i class="fas fa-lock mr-2"></i> Pay ₹@Model.PricePerMonth.ToString("N0") Now
                                </button>

                                <div class="text-center mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-shield-alt mr-1 text-success"></i> 256-bit SSL Encrypted &amp; Razorpay Secure
                                    </small>
                                </div>

                                <div class="mt-3 text-center">
                                    <a href="/owner/subscription/plans" class="text-muted small">
                                        <i class="fas fa-arrow-left mr-1"></i> Choose a different plan
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Razorpay Payment Simulation -->
<div class="modal fade" id="paymentModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-body text-center p-5">
                <div id="stageInitiating">
                    <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                    <h5 class="font-weight-bold text-dark mb-1">Connecting to Gateway...</h5>
                    <p class="text-muted small mb-0">Creating secure payment order with Razorpay</p>
                </div>
                <div id="stageProcessing" style="display: none;">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center bg-warning text-white rounded-circle" style="width: 70px; height: 70px;">
                        <i class="fas fa-rupee-sign fa-2x"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark mb-1" id="paymentPlanTitle">Processing Payment...</h5>
                    <p class="text-muted small mb-0" id="paymentAmountSubtitle">Securing transaction...</p>
                </div>
                <div id="stageSuccess" style="display: none;">
                    <div class="mb-3 mx-auto d-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 70px; height: 70px;">
                        <i class="fas fa-check fa-2x"></i>
                    </div>
                    <h4 class="font-weight-bold text-success mb-1">Payment Successful!</h4>
                    <p class="text-muted small mb-3">Subscription activated. Redirecting to dashboard...</p>
                    <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden form for verified payment submission -->
<form id="paymentVerifyForm" method="post" action="/owner/subscription/verify-payment" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="razorpay_order_id" id="inp_order_id" />
    <input type="hidden" name="razorpay_payment_id" id="inp_payment_id" />
    <input type="hidden" name="planId" id="inp_plan_id" />
</form>

@section Scripts {
    <script>
        var isProcessing = false;

        function startRazorpayPayment(planId, planName, amount) {
            if (isProcessing) return;
            isProcessing = true;

            $('#btnPay').prop('disabled', true);
            
            // Show modal and start stage 1
            $('#stageInitiating').show();
            $('#stageProcessing').hide();
            $('#stageSuccess').hide();
            $('#paymentModal').modal('show');

            var token = $('input[name="__RequestVerificationToken"]').val();

            // Step 1: Create Order
            $.ajax({
                url: '/owner/subscription/create-order',
                type: 'POST',
                data: { planId: planId, __RequestVerificationToken: token },
                success: function(data) {
                    if (!data.success) {
                        $('#paymentModal').modal('hide');
                        isProcessing = false;
                        $('#btnPay').prop('disabled', false);
                        alert(data.message || 'Failed to create order.');
                        return;
                    }

                    // Step 2: Show Processing animation
                    setTimeout(function() {
                        $('#stageInitiating').hide();
                        $('#paymentPlanTitle').text('Processing ' + planName + ' Plan...');
                        $('#paymentAmountSubtitle').html('Securing transaction of <strong>₹' + Number(amount).toLocaleString('en-IN') + '</strong>');
                        $('#stageProcessing').show();

                        // Step 3: Success Celebration
                        setTimeout(function() {
                            $('#stageProcessing').hide();
                            $('#stageSuccess').show();

                            var fakePaymentId = 'pay_SIM_' + Math.random().toString(36).substr(2, 9).toUpperCase();
                            $('#inp_order_id').val(data.orderId);
                            $('#inp_payment_id').val(fakePaymentId);
                            $('#inp_plan_id').val(planId);

                            // Auto submit after showing success checkmark
                            setTimeout(function() {
                                $('#paymentVerifyForm').submit();
                            }, 1500);

                        }, 2000);
                    }, 800);
                },
                error: function() {
                    $('#paymentModal').modal('hide');
                    isProcessing = false;
                    $('#btnPay').prop('disabled', false);
                    alert('Could not connect to payment server. Please try again.');
                }
            });
        }
    </script>
}
