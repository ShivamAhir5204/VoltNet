@model VoltNet.Models.SubscriptionPlan
@{
    var isUpgrade = (bool)(ViewBag.IsUpgrade ?? false);
    var activeSub = ViewBag.ActiveSubscription as VoltNet.Models.OwnerSubscription;
    var unusedCredit = (decimal)(ViewBag.UnusedCredit ?? 0m);
    var upgradePayable = (decimal)(ViewBag.UpgradePayable ?? Model.PricePerMonth);
    var remainingDays = (int)(ViewBag.RemainingDays ?? 0);

    ViewData["Title"] = isUpgrade ? $"Upgrade to {Model.Name}" : $"Subscribe to {Model.Name}";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var razorpayKey = ViewBag.RazorpayKeyId as string ?? "";
    var isEnterprise = Model.MaxStations > 10;
    var isGrowth = Model.MaxStations > 1 && !isEnterprise;
    var badgeText = isUpgrade ? "Plan Upgrade" : (isEnterprise ? "Enterprise" : (isGrowth ? "Growth" : "Starter"));
    var badgeClass = isUpgrade ? "s-warn" : (isEnterprise ? "s-dark" : (isGrowth ? "s-plan" : "s-info"));
}
<div class="sp">

    <div class="head">
        <h4>@(isUpgrade ? $"Upgrade to {Model.Name}" : $"Subscribe to {Model.Name}")</h4>
        <a href="/owner/subscription/plans" class="btn btn-back"><i class="fas fa-arrow-left"></i> Plans</a>
    </div>

    @if (isUpgrade && activeSub != null)
    {
        <div class="banner gap-b">
            <div class="b-icon"><i class="fas fa-bolt"></i></div>
            <div>
                <strong>Upgrading from @activeSub.Plan?.Name</strong><br />
                @remainingDays days left &bull; Credit: <strong>₹@unusedCredit.ToString("N2")</strong>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-lg-7 gap-b">
            <div class="card gap-b">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Plan</h5>
                    <span class="status @badgeClass">@badgeText</span>
                </div>
                <div class="card-body">
                    <div class="kv"><span class="k">Plan Name</span><span class="v">@Model.Name</span></div>
                    <div class="kv"><span class="k">Monthly Rate</span><span class="v">₹@Model.PricePerMonth.ToString("N0")</span></div>
                    <div class="kv"><span class="k">Billing Duration</span><span class="v">@Model.DurationDays Days</span></div>
                    <div class="kv"><span class="k">Max Stations</span><span class="v">@Model.MaxStations</span></div>
                    <div class="kv" style="border-bottom:0"><span class="k">Managers / Station</span><span class="v">@Model.MaxManagersPerStation</span></div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="desc">@Model.Description</div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5>Included</h5></div>
                <div class="card-body">
                    <div class="benefit"><i class="fas fa-check-circle"></i> Live navigation & discovery</div>
                    <div class="benefit"><i class="fas fa-check-circle"></i> Customer booking & scheduling</div>
                    <div class="benefit"><i class="fas fa-check-circle"></i> 24-hour purchase refund</div>
                    <div class="benefit"><i class="fas fa-check-circle"></i> Priority partner support</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5 gap-b">
            <div class="card">
                <div class="card-header"><h5>Order Summary</h5></div>
                <div class="card-body">
                    <div class="kv"><span class="k">Tier</span><span class="v">@Model.Name</span></div>
                    <div class="kv"><span class="k">Billing Cycle</span><span class="v">@Model.DurationDays Days</span></div>
                    <div class="kv"><span class="k">Subtotal</span><span class="v">₹@Model.PricePerMonth.ToString("N2")</span></div>

                    @if (isUpgrade && unusedCredit > 0)
                    {
                        <div class="kv credit">
                            <span class="k">Prorated Credit (@remainingDays days)</span>
                            <span class="v">-₹@unusedCredit.ToString("N2")</span>
                        </div>
                    }

                    <div class="kv" style="border-bottom:0"><span class="k">GST / Taxes</span><span class="v">Included</span></div>

                    <div class="total">
                        <span>Total Payable</span>
                        <span class="amt">₹@(isUpgrade ? upgradePayable.ToString("N0") : Model.PricePerMonth.ToString("N0"))</span>
                    </div>

                    <button type="button" class="btn btn-main btn-pay" id="btnPay" onclick="startRazorpayPayment('@Model.Id', '@Model.Name', @(isUpgrade ? upgradePayable : Model.PricePerMonth))">
                        <i class="fas fa-@(isUpgrade ? "bolt" : "lock")"></i> @(isUpgrade ? $"Pay ₹{upgradePayable.ToString("N0")} & Upgrade Now" : $"Pay ₹{Model.PricePerMonth.ToString("N0")} & Activate")
                    </button>

                    <a href="/owner/subscription/plans" class="btn btn-back btn-block mt-3"><i class="fas fa-arrow-left"></i> Choose a different plan</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment simulation overlay -->
<div class="razorpay-overlay" id="paymentOverlay">
    <div class="razorpay-modal">
        <div id="stageInitiating" class="payment-stage-container">
            <div class="processing-pulse mb-3">
                <div class="processing-pulse-inner"><i class="fas fa-lock"></i></div>
            </div>
            <h5 class="font-weight-bold mb-0">@(isUpgrade ? "Starting upgrade..." : "Connecting to payment gateway...")</h5>
        </div>

        <div id="stageTrainCoin" class="coin-train-stage">
            <div class="train-convoy">
                <div class="cargo-wagon">
                    <div class="golden-coin-3d" style="width: 28px; height: 28px; font-size: 0.9rem; margin-top: -12px;">₹</div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
                <div class="cargo-wagon">
                    <div class="golden-coin-3d">₹</div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
                <div class="train-engine">
                    <div class="engine-chimney"><div class="smoke-puff"></div><div class="smoke-puff"></div></div>
                    <div class="engine-light"></div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
            </div>

            <div class="rail-track-bed">
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
            </div>
            <div class="rail-steel"></div>
            <div class="rail-glow"></div>

            <div style="position: absolute; bottom: 8px; left: 0; width: 100%; text-align: center;">
                <h6 class="font-weight-bold mb-0" style="font-size: 0.9rem;">Processing payment...</h6>
                <small style="color:#34395E;font-weight:600;">₹@(isUpgrade ? upgradePayable.ToString("N0") : Model.PricePerMonth.ToString("N0"))</small>
            </div>
        </div>

        <div id="stageSuccess" class="success-celebration">
            <div class="success-icon-badge"><i class="fas fa-check"></i></div>
            <h4 class="font-weight-bold mb-3">Payment Successful</h4>
            <div class="spinner-border spinner-border-sm" style="color:#28C76F" role="status"></div>
        </div>
    </div>
</div>

<!-- Hidden form for verified payment submission -->
<form id="paymentVerifyForm" method="post" action="/owner/subscription/verify-payment" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="razorpay_order_id" id="inp_order_id" />
    <input type="hidden" name="razorpay_payment_id" id="inp_payment_id" />
    <input type="hidden" name="planId" id="inp_plan_id" />
</form>

@section Scripts {
    <script>
        var isProcessing = false;

        function startRazorpayPayment(planId, planName, amount) {
            if (isProcessing) return;
            isProcessing = true;
            $('#btnPay').prop('disabled', true);

            $('#stageInitiating').show();
            $('#stageTrainCoin').removeClass('active');
            $('#stageSuccess').removeClass('active');
            $('#paymentOverlay').addClass('active');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/owner/subscription/create-order',
                type: 'POST',
                data: { planId: planId, __RequestVerificationToken: token },
                success: function(data) {
                    if (!data.success) {
                        $('#paymentOverlay').removeClass('active');
                        isProcessing = false;
                        $('#btnPay').prop('disabled', false);
                        alert(data.message || 'Failed to create order.');
                        return;
                    }

                    setTimeout(function() {
                        $('#stageInitiating').hide();
                        $('#stageTrainCoin').addClass('active');

                        setTimeout(function() {
                            $('#stageTrainCoin').removeClass('active');
                            $('#stageSuccess').addClass('active');

                            var fakePaymentId = 'pay_SIM_' + Math.random().toString(36).substr(2, 9).toUpperCase();
                            $('#inp_order_id').val(data.orderId);
                            $('#inp_payment_id').val(fakePaymentId);
                            $('#inp_plan_id').val(planId);

                            setTimeout(function() {
                                $('#paymentVerifyForm').submit();
                            }, 1600);

                        }, 2800);
                    }, 800);
                },
                error: function() {
                    $('#paymentOverlay').removeClass('active');
                    isProcessing = false;
                    $('#btnPay').prop('disabled', false);
                    alert('Could not connect to payment server. Please try again.');
                }
            });
        }
    </script>
}