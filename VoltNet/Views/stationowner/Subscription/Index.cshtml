@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "My Subscriptions";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var pendingCancellationCount = (int)(ViewBag.PendingCancellationCount ?? 0);
    var totalStationsUsed = (int)(ViewBag.TotalStationsUsed ?? 0);
    var totalStationsAllowed = (int)(ViewBag.TotalStationsAllowed ?? 0);
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

<style>
    /* Clean Minimalist Stat Cards matching Otika */
    .stat-card-white {
        background: #ffffff;
        border: 1px solid #dce2eb;
        border-radius: 8px;
        padding: 20px 22px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card-white:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    }
    .stat-card-white .stat-title {
        font-size: 13px;
        font-weight: 700;
        color: #34395e;
        margin-bottom: 4px;
        text-transform: none;
    }
    .stat-card-white .stat-number {
        font-size: 24px;
        font-weight: 700;
        color: #212529;
        line-height: 1.2;
    }
    .stat-card-white .stat-icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Subscription Card (Minimalist Otika Style) */
    .owner-sub-card {
        background: #ffffff;
        border: 1px solid #dce2eb;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        height: calc(100% - 24px);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .owner-sub-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }
    .owner-sub-card.border-active { border-top: 4px solid #6777ef; }
    .owner-sub-card.border-pending { border-top: 4px solid #ffa426; }
    .owner-sub-card.border-expired { border-top: 4px solid #fc544b; }
    .owner-sub-card.border-cancelled { border-top: 4px solid #6c757d; }

    .owner-sub-header {
        padding: 20px 24px 16px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }
    .owner-sub-header h4 {
        font-size: 18px;
        font-weight: 700;
        color: #212529;
        margin: 0;
    }
    .owner-sub-body {
        padding: 20px 24px;
        flex-grow: 1;
    }
    .owner-sub-footer {
        padding: 16px 24px;
        background: #ffffff;
        border-top: 1px solid #edf0f5;
        border-radius: 0 0 8px 8px;
    }

    .metric-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 10px;
        margin-bottom: 10px;
        border-bottom: 1px dashed #e8ebf1;
    }
    .metric-row:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .metric-label {
        font-size: 13px;
        font-weight: 700;
        color: #34395e;
    }
    .metric-value {
        font-size: 14px;
        font-weight: 600;
        color: #212529;
        text-align: right;
    }

    /* Station Chip Preview */
    .station-mini-chip {
        display: inline-flex;
        align-items: center;
        background: #fdfdff;
        border: 1px solid #e4e6fc;
        border-radius: 6px;
        padding: 6px 12px;
        margin-right: 6px;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #212529;
    }

    /* Modal Styling */
    .modal { z-index: 1050 !important; }
    .modal-backdrop { z-index: 1040 !important; }
    .modal-dialog { z-index: 1051 !important; }
</style>

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div>
                <h4 class="font-weight-bold text-dark mb-1" style="font-size: 22px;">My Subscriptions</h4>
                <div class="font-14 font-weight-600" style="color: #34395e;">
                    Manage your active charging network plans, station allocations, and billing.
                </div>
            </div>
            <div class="mt-2 mt-sm-0">
                @if (Model.Any())
                {
                    <span class="badge badge-success font-weight-700 px-3 py-2 font-13 mr-2">
                        <i class="fas fa-check-circle mr-1"></i> 1/1 Active Plan (Max Allowed)
                    </span>
                    <a href="/owner/subscription/plans" class="btn btn-outline-secondary font-weight-600 px-3 py-2">
                        <i class="fas fa-layer-group mr-1"></i> View Plans
                    </a>
                }
                else
                {
                    <a href="/owner/subscription/plans" class="btn btn-primary font-weight-700 px-4 py-2 shadow-sm">
                        <i class="fas fa-plus mr-1"></i> Choose Subscription Plan
                    </a>
                }
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        <!-- ─── Stat Cards (Otika Style) ─────────────────────────────────── -->
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Active Plans</div>
                        <div class="stat-number">@activeCount</div>
                    </div>
                    <div class="stat-icon-circle bg-primary text-white">
                        <i class="fas fa-bolt"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Station Quotas</div>
                        <div class="stat-number">@totalStationsUsed / @totalStationsAllowed</div>
                    </div>
                    <div class="stat-icon-circle bg-info text-white">
                        <i class="fas fa-charging-station"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Total Invested</div>
                        <div class="stat-number">₹@totalSpent.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-circle bg-success text-white">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">All Subscriptions</div>
                        <div class="stat-number">@totalCount</div>
                    </div>
                    <div class="stat-icon-circle bg-dark text-white">
                        <i class="fas fa-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── Navigation Tabs ─────────────────────────────────────────── -->
        <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center flex-wrap">
                <a href="/owner/subscription" class="btn btn-primary font-weight-700 mr-2 mb-2 mb-sm-0">
                    <i class="fas fa-bolt mr-1"></i> Active Plans (@activeCount)
                </a>
                <a href="/owner/subscription/history" class="btn btn-outline-secondary font-weight-600 mb-2 mb-sm-0">
                    <i class="fas fa-history mr-1"></i> Expired & Cancelled (@historyCount)
                </a>
            </div>
            @if (pendingCancellationCount > 0)
            {
                <span class="badge badge-warning font-weight-700 font-13 px-3 py-2">
                    <i class="fas fa-clock mr-1"></i> @pendingCancellationCount Cancellation Request(s) Under Review
                </span>
            }
        </div>

        <!-- ─── Active Subscriptions Grid ────────────────────────────────── -->
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="card p-5 text-center shadow-sm" style="border: 1px solid #dce2eb; border-radius: 8px;">
                        <div style="padding: 2rem 0;">
                            <i class="fas fa-charging-station text-muted" style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.5;"></i>
                            <h4 class="font-weight-bold text-dark mb-2">No Active Subscriptions</h4>
                            <p class="font-15 font-weight-500 mb-4 max-w-500 mx-auto" style="color: #495057; max-width: 500px;">
                                You currently have no active subscription plans running. Purchase a plan to make your EV charging stations live and visible to drivers on the VoltNet network.
                            </p>
                            <div>
                                <a href="/owner/subscription/plans" class="btn btn-primary font-weight-700 px-4 py-2 mr-2">
                                    <i class="fas fa-shopping-cart mr-2"></i> Browse & Buy Plans
                                </a>
                                @if (historyCount > 0)
                                {
                                    <a href="/owner/subscription/history" class="btn btn-outline-secondary font-weight-600 px-4 py-2">
                                        <i class="fas fa-history mr-2"></i> View Past Plans (@historyCount)
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var sub in Model)
                {
                    var isCancelled = sub.Status == "Cancelled";
                    var isCancellationPending = sub.Status == "CancellationPending";
                    var isExpired = sub.EndDate < DateTime.UtcNow && !isCancelled && !isCancellationPending;
                    var isActive = sub.Status == "Active" && sub.EndDate >= DateTime.UtcNow;
                    var daysLeft = isActive ? (int)Math.Ceiling((sub.EndDate - DateTime.UtcNow).TotalDays) : 0;
                    var isExpiringSoon = isActive && daysLeft <= 7;

                    // 24-Hour Cancellation Policy
                    var hoursSincePurchase = (DateTime.UtcNow - sub.CreatedAt).TotalHours;
                    var isWithin24Hours = hoursSincePurchase <= 24;
                    var remainingHours = isWithin24Hours ? (int)Math.Ceiling(24 - hoursSincePurchase) : 0;

                    var borderClass = isCancellationPending ? "border-pending" : (isActive ? "border-active" : (isCancelled ? "border-cancelled" : "border-expired"));

                    var assignedCount = sub.Stations?.Count ?? 0;
                    var maxStations = sub.Plan?.MaxStations ?? 0;
                    var maxManagers = sub.Plan?.MaxManagersPerStation ?? 0;
                    var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
                    var planCost = sub.AmountPaid > 0 ? sub.AmountPaid : (sub.Plan?.PricePerMonth ?? 0m);

                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="owner-sub-card @borderClass">
                            <!-- Card Header -->
                            <div class="owner-sub-header">
                                <div>
                                    <h4>@(sub.Plan?.Name ?? "Plan")</h4>
                                    <div class="font-13 font-weight-600 mt-1" style="color: #34395e;">
                                        Plan ID: <span class="text-monospace text-dark font-weight-700">@sub.PlanId.ToString()[..8].ToUpper()</span>
                                    </div>
                                </div>
                                <div>
                                    @if (isCancellationPending)
                                    {
                                        <span class="badge badge-warning font-weight-700 font-13 px-2 py-1">
                                            <i class="fas fa-clock mr-1"></i> Review Pending
                                        </span>
                                    }
                                    else if (isActive)
                                    {
                                        <span class="badge badge-success font-weight-700 font-13 px-2 py-1">
                                            <i class="fas fa-check-circle mr-1"></i> Active
                                        </span>
                                    }
                                    else if (isCancelled)
                                    {
                                        <span class="badge badge-danger font-weight-700 font-13 px-2 py-1">
                                            <i class="fas fa-ban mr-1"></i> Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary font-weight-700 font-13 px-2 py-1">
                                            <i class="fas fa-hourglass-end mr-1"></i> Expired
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="owner-sub-body">
                                @if (isCancellationPending)
                                {
                                    <div class="alert alert-warning p-2 mb-3 font-13 font-weight-600" style="border-radius: 6px;">
                                        <i class="fas fa-clock mr-1"></i> Cancellation submitted & awaiting Admin approval.
                                        <div class="small font-weight-normal mt-1 text-truncate">Reason: @sub.CancellationReason</div>
                                    </div>
                                }
                                else if (isExpiringSoon)
                                {
                                    <div class="alert alert-warning p-2 mb-3 font-13 font-weight-600" style="border-radius: 6px;">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>
                                        Expires in @daysLeft day(s)! Renew to maintain station visibility.
                                    </div>
                                }

                                <!-- Metric Rows with New Schema -->
                                <div class="metric-row">
                                    <span class="metric-label">Monthly Price</span>
                                    <span class="metric-value font-weight-bold text-dark font-16">
                                        ₹@planCost.ToString("N0")
                                    </span>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Station Quota</span>
                                    <span class="metric-value font-weight-bold @(assignedCount == maxStations ? "text-primary" : "text-dark")">
                                        <i class="fas fa-charging-station text-primary mr-1"></i> @assignedCount / @maxStations Assigned
                                    </span>
                                </div>

                                <!-- Progress bar for station capacity -->
                                <div class="mb-3">
                                    <div class="progress" style="height: 6px; background-color: #edf0f5; border-radius: 3px;">
                                        <div class="progress-bar @(usagePercent >= 100 ? "bg-primary" : "bg-success")" 
                                             role="progressbar" style="width: @usagePercent%; border-radius: 3px;"></div>
                                    </div>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Managers Quota</span>
                                    <span class="metric-value font-weight-600 text-dark">
                                        <i class="fas fa-user-shield text-info mr-1"></i> Up to @maxManagers / Station
                                    </span>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Valid Until</span>
                                    <span class="metric-value font-weight-600 text-dark">
                                        @sub.EndDate.ToString("dd MMM yyyy")
                                        @if (isActive)
                                        {
                                            <span class="badge badge-light font-weight-700 ml-1">@daysLeft d left</span>
                                        }
                                    </span>
                                </div>

                                <!-- Assigned Stations Quick Preview -->
                                <div class="mt-3 pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="metric-label font-13">Linked Stations (@assignedCount)</span>
                                        @if (isActive && assignedCount < maxStations)
                                        {
                                            <a href="/owner/subscription/@sub.Id/assign" class="font-12 font-weight-700 text-primary">
                                                + Link More
                                            </a>
                                        }
                                    </div>
                                    @if (sub.Stations != null && sub.Stations.Any())
                                    {
                                        <div>
                                            @foreach (var st in sub.Stations.Take(3))
                                            {
                                                <div class="station-mini-chip">
                                                    <i class="fas fa-charging-station text-primary mr-1"></i>
                                                    @st.Name
                                                    <span class="badge badge-success ml-1" style="font-size: 10px;">@st.Status</span>
                                                </div>
                                            }
                                            @if ((sub.Stations?.Count ?? 0) > 3)
                                            {
                                                <span class="font-12 font-weight-700 text-muted ml-1">+@((sub.Stations?.Count ?? 0) - 3) more</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="font-13 font-weight-600 text-warning">
                                            <i class="fas fa-exclamation-circle mr-1"></i> No stations linked yet. Click "Manage Stations" below to activate your chargers.
                                        </div>
                                    }
                                </div>

                                <!-- 24h Refund Window Indicator -->
                                @if (isActive && isWithin24Hours)
                                {
                                    <div class="mt-3 p-2 rounded" style="background: #f0f7ff; border: 1px dashed #bee5eb;">
                                        <span class="font-12 font-weight-700 text-info">
                                            <i class="fas fa-shield-alt mr-1"></i> 100% Refund Eligible (@remainingHours h remaining)
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Card Footer Action Buttons -->
                            <div class="owner-sub-footer">
                                <div class="d-flex flex-wrap" style="gap: 6px;">
                                    @if (isActive)
                                    {
                                        <a href="/owner/subscription/@sub.Id/assign" class="btn btn-primary btn-sm font-weight-700 flex-fill">
                                            <i class="fas fa-tasks mr-1"></i> Manage Stations
                                        </a>
                                    }

                                    <a href="/owner/subscription/@sub.Id/details" class="btn btn-outline-info btn-sm font-weight-600 flex-fill">
                                        <i class="fas fa-eye mr-1"></i> Details
                                    </a>

                                    <a href="/owner/subscription/@sub.Id/receipt" class="btn btn-outline-secondary btn-sm font-weight-600 flex-fill">
                                        <i class="fas fa-download mr-1"></i> Receipt
                                    </a>

                                    @if (isActive && isWithin24Hours)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm font-weight-600 flex-fill" 
                                                onclick="openCancelModal('@sub.Id', '@sub.Plan?.Name', @planCost, true, @remainingHours)">
                                            <i class="fas fa-undo-alt mr-1"></i> Cancel
                                        </button>
                                    }
                                    else if (isCancellationPending)
                                    {
                                        <button type="button" class="btn btn-warning btn-sm font-weight-600 flex-fill" disabled>
                                            <i class="fas fa-hourglass-half mr-1"></i> Reviewing
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ─── Owner Cancellation Request Modal (Clean Otika Theme) ─── -->
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 8px; border: 1px solid #dce2eb; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <form id="cancelForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white border-bottom py-3">
                    <h5 class="modal-title font-weight-bold text-dark" id="cancelModalLabel" style="font-size: 18px;">
                        <i class="fas fa-undo-alt text-danger mr-2"></i>Request Subscription Cancellation
                    </h5>
                    <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <!-- Policy Warning Banner -->
                    <div id="cancelEligibleBox" class="alert alert-warning mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-shield-alt mr-2 text-warning"></i>
                            <strong class="text-dark font-14">24-Hour Purchase Refund Window Active</strong>
                        </div>
                        <p class="font-13 mb-0 font-weight-600 text-dark">
                            You are requesting cancellation for the <strong id="modalPlanName"></strong> plan. 
                            Time remaining to request 100% refund: <strong class="text-danger" id="modalTimeLeft"></strong> hour(s).
                        </p>
                    </div>

                    <div id="cancelIneligibleBox" class="alert alert-danger mb-3" style="display: none;">
                        <i class="fas fa-ban mr-2"></i>
                        <strong class="font-14">Cancellation Window Closed:</strong> Subscriptions can only be cancelled within 24 hours of purchase. More than 24 hours have elapsed.
                    </div>

                    <div class="p-3 rounded mb-3" style="background: #ffffff; border: 1px solid #dce2eb;">
                        <h6 class="font-weight-bold text-dark mb-2 font-14">Important Notice:</h6>
                        <ul class="font-13 font-weight-600 pl-3 mb-0" style="color: #34395e;">
                            <li>All linked stations will be taken <strong class="text-dark">offline</strong> upon Admin approval.</li>
                            <li>The cancellation request will be reviewed by the VoltNet Admin team.</li>
                            <li>Upon approval, a 100% refund of <strong id="modalRefundAmount" class="text-success font-14"></strong> will be processed.</li>
                        </ul>
                    </div>

                    <div class="form-group" id="reasonGroup">
                        <label class="font-weight-bold text-dark font-14">
                            Reason for Cancellation <span class="text-danger">*</span>
                        </label>
                        <textarea name="cancellationReason" id="cancellationReason" class="form-control" rows="3" required minlength="10" maxlength="500" 
                                  placeholder="Please describe why you wish to cancel (e.g., Selected wrong station capacity, relocated chargers)..."></textarea>
                        <small class="font-weight-600 font-12" style="color: #495057;">Minimum 10 characters required. Maximum 500 characters.</small>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top py-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary font-weight-600" data-dismiss="modal">Keep Subscription</button>
                    <button type="submit" id="btnSubmitCancel" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-paper-plane mr-1"></i> Submit Cancellation Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#cancelModal').appendTo("body");
        });

        function openCancelModal(id, planName, amount, isWithin24, hoursLeft) {
            $('#cancelForm').attr('action', '/owner/subscription/' + id + '/cancel');
            $('#modalPlanName').text(planName);
            $('#modalRefundAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#cancellationReason').val('');

            if (isWithin24) {
                $('#cancelEligibleBox').show();
                $('#cancelIneligibleBox').hide();
                $('#modalTimeLeft').text(hoursLeft);
                $('#reasonGroup').show();
                $('#btnSubmitCancel').prop('disabled', false).show();
            } else {
                $('#cancelEligibleBox').hide();
                $('#cancelIneligibleBox').show();
                $('#reasonGroup').hide();
                $('#btnSubmitCancel').prop('disabled', true).hide();
            }

            $('#cancelModal').modal('show');
        }
    </script>
}

