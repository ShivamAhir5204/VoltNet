@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscriptions";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var pendingCancellationCount = (int)(ViewBag.PendingCancellationCount ?? 0);
    var totalStationsUsed = (int)(ViewBag.TotalStationsUsed ?? 0);
    var totalStationsAllowed = (int)(ViewBag.TotalStationsAllowed ?? 0);
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

<div class="sp">

    <div class="head">
        <h4>Subscriptions</h4>
        <a href="/owner/subscription/plans" class="btn btn-main"><i class="fas fa-plus"></i> Plans & Upgrade</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Top stat cards -->
    <div class="row">
        <div class="col-12 col-sm-6 col-lg-3 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-bolt"></i></div>
                <div><div class="kpi-label">Active Plans</div><div class="kpi-value">@activeCount</div></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 gap-b">
            <div class="card kpi kpi-info">
                <div class="kpi-icon"><i class="fas fa-charging-station"></i></div>
                <div><div class="kpi-label">Station Quota</div><div class="kpi-value">@totalStationsUsed / @totalStationsAllowed</div></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 gap-b">
            <div class="card kpi kpi-green">
                <div class="kpi-icon"><i class="fas fa-rupee-sign"></i></div>
                <div><div class="kpi-label">Total Invested</div><div class="kpi-value">₹@totalSpent.ToString("N0")</div></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-history"></i></div>
                <div><div class="kpi-label">All Records</div><div class="kpi-value">@totalCount</div></div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="bar-row">
        <div class="chips">
            <a href="/owner/subscription" class="chip active">Active Plans (@activeCount)</a>
            <a href="/owner/subscription/history" class="chip">Past Plans (@historyCount)</a>
        </div>
        @if (pendingCancellationCount > 0)
        {
            <span class="status s-warn">@pendingCancellationCount Cancellation Under Review</span>
        }
    </div>

    <!-- Subscriptions grid -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body empty-box">
                        <h5>No active subscriptions</h5>
                        <a href="/owner/subscription/plans" class="btn btn-main"><i class="fas fa-shopping-cart"></i> View Plans</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var sub in Model)
            {
                var isCancelled = sub.Status == "Cancelled";
                var isCancellationPending = sub.Status == "CancellationPending";
                var isActive = sub.Status == "Active" && sub.EndDate >= DateTime.UtcNow;
                var daysLeft = isActive ? (int)Math.Ceiling((sub.EndDate - DateTime.UtcNow).TotalDays) : 0;
                var hoursSincePurchase = (DateTime.UtcNow - sub.CreatedAt).TotalHours;
                var isWithin24Hours = hoursSincePurchase <= 24;
                var remainingHours = isWithin24Hours ? (int)Math.Ceiling(24 - hoursSincePurchase) : 0;

                var borderClass = isCancellationPending ? "border-pending" : (isActive ? "border-active" : (isCancelled ? "border-cancelled" : "border-expired"));
                var assignedCount = sub.Stations?.Count ?? 0;
                var maxStations = sub.Plan?.MaxStations ?? 0;
                var maxManagers = sub.Plan?.MaxManagersPerStation ?? 0;
                var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
                var planCost = sub.AmountPaid > 0 ? sub.AmountPaid : (sub.Plan?.PricePerMonth ?? 0m);

                <div class="col-12 col-md-6 col-lg-4 gap-b">
                    <div class="card sub-card @borderClass">
                        <div class="sub-head">
                            <div>
                                <h5>@(sub.Plan?.Name ?? "Plan")</h5>
                                <div class="sub-id">#@sub.PlanId.ToString()[..8].ToUpper()</div>
                            </div>
                            <div>
                                @if (isCancellationPending)
                                {
                                    <span class="status s-warn">Review Pending</span>
                                }
                                else if (isActive)
                                {
                                    <span class="status s-ok">Active</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="status s-err">Cancelled</span>
                                }
                                else
                                {
                                    <span class="status s-plain">Expired</span>
                                }
                            </div>
                        </div>

                        <div class="sub-body">
                            <div class="kv"><span class="k">Price</span><span class="v">₹@planCost.ToString("N0")</span></div>
                            <div class="kv" style="border-bottom:0;padding-bottom:0"><span class="k">Stations</span><span class="v">@assignedCount / @maxStations</span></div>
                            <div class="progress"><div class="progress-bar bar-indigo" role="progressbar" style="width: @usagePercent%;"></div></div>
                            <div class="kv"><span class="k">Managers</span><span class="v">@maxManagers / station</span></div>
                            <div class="kv" style="border-bottom:0">
                                <span class="k">Valid Until</span>
                                <span class="v">
                                    @sub.EndDate.ToString("dd MMM yyyy")
                                    @if (isActive)
                                    {
                                        <span class="status s-plain ml-1">@daysLeft d</span>
                                    }
                                </span>
                            </div>

                            <div class="linked">
                                <div class="linked-top">
                                    <span>Stations (@assignedCount)</span>
                                    @if (isActive && assignedCount < maxStations)
                                    {
                                        <a href="/owner/subscription/@sub.Id/assign">+ Link</a>
                                    }
                                </div>
                                @if (sub.Stations != null && sub.Stations.Any())
                                {
                                    <div>
                                        @foreach (var st in sub.Stations.Take(3))
                                        {
                                            <span class="chip-st">@st.Name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="cell-sub" style="color:#34395E;font-size:14px">None linked</span>
                                }
                            </div>
                        </div>

                        <div class="sub-foot">
                            @if (isActive)
                            {
                                <a href="/owner/subscription/@sub.Id/assign" class="btn btn-main">Manage</a>
                                <a href="/owner/subscription/plans" class="btn btn-warn">Upgrade</a>
                            }
                            <a href="/owner/subscription/@sub.Id/details" class="btn btn-back">Details</a>
                            @if (isActive && isWithin24Hours)
                            {
                                <button type="button" class="btn btn-reject"
                                        onclick="openCancelModal('@sub.Id', '@sub.Plan?.Name', @planCost, true, @remainingHours)">
                                    Cancel
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Cancellation modal -->
<div class="modal fade sp-modal" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="cancelForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelModalLabel">Cancel Subscription</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div id="cancelEligibleBox" class="impact">
                        <strong>24-hour refund window</strong><br />
                        Plan: <strong id="modalPlanName"></strong> &bull; Refund: <strong id="modalRefundAmount"></strong> &bull; Remaining: <strong id="modalTimeLeft"></strong>h
                    </div>

                    <div id="cancelIneligibleBox" class="impact danger" style="display: none;">
                        Cancellation window closed (more than 24 hours).
                    </div>

                    <div class="form-group mb-0" id="reasonGroup">
                        <label>Reason (min 10 characters) <span class="text-danger">*</span></label>
                        <textarea name="cancellationReason" id="cancellationReason" class="form-control" rows="3" required minlength="10" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Keep</button>
                    <button type="submit" id="btnSubmitCancel" class="btn btn-reject">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#cancelModal').appendTo("body");
        });

        function openCancelModal(id, planName, amount, isWithin24, hoursLeft) {
            $('#cancelForm').attr('action', '/owner/subscription/' + id + '/cancel');
            $('#modalPlanName').text(planName);
            $('#modalRefundAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#cancellationReason').val('');

            if (isWithin24) {
                $('#cancelEligibleBox').show();
                $('#cancelIneligibleBox').hide();
                $('#modalTimeLeft').text(hoursLeft);
                $('#reasonGroup').show();
                $('#btnSubmitCancel').prop('disabled', false).show();
            } else {
                $('#cancelEligibleBox').hide();
                $('#cancelIneligibleBox').show();
                $('#reasonGroup').hide();
                $('#btnSubmitCancel').prop('disabled', true).hide();
            }

            $('#cancelModal').modal('show');
        }
    </script>
}