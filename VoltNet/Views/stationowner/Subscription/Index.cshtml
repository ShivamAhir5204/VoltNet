@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscriptions";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var pendingCancellationCount = (int)(ViewBag.PendingCancellationCount ?? 0);
    var totalStationsUsed = (int)(ViewBag.TotalStationsUsed ?? 0);
    var totalStationsAllowed = (int)(ViewBag.TotalStationsAllowed ?? 0);
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

<style>
    .stat-card-white {
        background: #FFFFFF;
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 14px;
        box-shadow: 0 1px 4px rgba(53, 60, 72, 0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card-white:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(53, 60, 72, 0.08);
    }
    .stat-card-white .stat-title {
        font-size: 12px;
        font-weight: 700;
        color: #34395E;
        margin-bottom: 2px;
    }
    .stat-card-white .stat-number {
        font-size: 20px;
        font-weight: 700;
        color: #353C48;
        line-height: 1.2;
    }
    .stat-card-white .stat-icon-circle {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .owner-sub-card {
        background: #FFFFFF;
        border: 1px solid #E3EAEF;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(53, 60, 72, 0.04);
        margin-bottom: 16px;
        display: flex;
        flex-direction: column;
        height: calc(100% - 16px);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .owner-sub-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(53, 60, 72, 0.08);
    }
    .owner-sub-card.border-active { border-top: 4px solid #6777EF; }
    .owner-sub-card.border-pending { border-top: 4px solid #FFA117; }
    .owner-sub-card.border-expired { border-top: 4px solid #EA5455; }
    .owner-sub-card.border-cancelled { border-top: 4px solid #96A2B4; }

    .owner-sub-header {
        padding: 12px 16px;
        border-bottom: 1px solid #E3EAEF;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .owner-sub-body {
        padding: 12px 16px;
        flex-grow: 1;
    }
    .owner-sub-footer {
        padding: 10px 16px;
        background: #F9F9F9;
        border-top: 1px solid #E3EAEF;
        border-radius: 0 0 8px 8px;
    }

    .metric-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 6px;
        margin-bottom: 6px;
        border-bottom: 1px dashed #E3EAEF;
    }
    .metric-row:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .metric-label {
        font-size: 13px;
        font-weight: 600;
        color: #34395E;
    }
    .metric-value {
        font-size: 13px;
        font-weight: 700;
        color: #353C48;
    }

    .station-mini-chip {
        display: inline-flex;
        align-items: center;
        background: #F9F9F9;
        border: 1px solid #E3EAEF;
        border-radius: 6px;
        padding: 4px 10px;
        margin-right: 5px;
        margin-bottom: 5px;
        font-size: 12px;
        font-weight: 600;
        color: #34395E;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
            <div>
                <h4 class="font-weight-700 text-dark-slate mb-0">
                    <i class="fas fa-layer-group text-otika-primary mr-2"></i> Subscriptions
                </h4>
            </div>
            <div class="mt-2 mt-sm-0">
                <a href="/owner/subscription/plans" class="btn btn-otika-primary btn-sm">
                    <i class="fas fa-plus mr-1"></i> Plans & Upgrade
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        <!-- Top Stat Cards -->
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Active Plans</div>
                        <div class="stat-number">@activeCount</div>
                    </div>
                    <div class="stat-icon-circle badge-otika-primary">
                        <i class="fas fa-bolt"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Station Quota</div>
                        <div class="stat-number">@totalStationsUsed / @totalStationsAllowed</div>
                    </div>
                    <div class="stat-icon-circle badge-otika-info">
                        <i class="fas fa-charging-station"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">Total Invested</div>
                        <div class="stat-number">₹@totalSpent.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-circle badge-otika-success">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card-white">
                    <div>
                        <div class="stat-title">All Records</div>
                        <div class="stat-number">@totalCount</div>
                    </div>
                    <div class="stat-icon-circle bg-dark text-white">
                        <i class="fas fa-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center flex-wrap">
                <a href="/owner/subscription" class="btn btn-otika-primary btn-sm mr-2 mb-2 mb-sm-0">
                    Active Plans (@activeCount)
                </a>
                <a href="/owner/subscription/history" class="btn btn-outline-secondary btn-sm mb-2 mb-sm-0">
                    Past Plans (@historyCount)
                </a>
            </div>
            @if (pendingCancellationCount > 0)
            {
                <span class="badge badge-otika-warning font-weight-600 px-3 py-2 font-12">
                    <i class="fas fa-clock mr-1"></i> @pendingCancellationCount Cancellation Under Review
                </span>
            }
        </div>

        <!-- Active Subscriptions Grid -->
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="card card-otika p-5 text-center">
                        <i class="fas fa-charging-station text-muted-slate mb-3" style="font-size: 38px;"></i>
                        <h6 class="text-dark-slate font-weight-bold mb-1">No Active Subscriptions</h6>
                        <small class="text-muted-slate mb-3 d-block">Subscribe to a plan to activate and list your stations.</small>
                        <div>
                            <a href="/owner/subscription/plans" class="btn btn-otika-primary btn-sm">
                                <i class="fas fa-shopping-cart mr-1"></i> View Plans
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var sub in Model)
                {
                    var isCancelled = sub.Status == "Cancelled";
                    var isCancellationPending = sub.Status == "CancellationPending";
                    var isActive = sub.Status == "Active" && sub.EndDate >= DateTime.UtcNow;
                    var daysLeft = isActive ? (int)Math.Ceiling((sub.EndDate - DateTime.UtcNow).TotalDays) : 0;
                    var hoursSincePurchase = (DateTime.UtcNow - sub.CreatedAt).TotalHours;
                    var isWithin24Hours = hoursSincePurchase <= 24;
                    var remainingHours = isWithin24Hours ? (int)Math.Ceiling(24 - hoursSincePurchase) : 0;

                    var borderClass = isCancellationPending ? "border-pending" : (isActive ? "border-active" : (isCancelled ? "border-cancelled" : "border-expired"));
                    var assignedCount = sub.Stations?.Count ?? 0;
                    var maxStations = sub.Plan?.MaxStations ?? 0;
                    var maxManagers = sub.Plan?.MaxManagersPerStation ?? 0;
                    var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
                    var planCost = sub.AmountPaid > 0 ? sub.AmountPaid : (sub.Plan?.PricePerMonth ?? 0m);

                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="owner-sub-card @borderClass">
                            <div class="owner-sub-header">
                                <div>
                                    <h5 class="text-dark-slate font-weight-700 mb-0">@(sub.Plan?.Name ?? "Plan")</h5>
                                    <small class="text-muted-slate font-mono">#@sub.PlanId.ToString()[..8].ToUpper()</small>
                                </div>
                                <div>
                                    @if (isCancellationPending)
                                    {
                                        <span class="badge badge-otika-warning">Review Pending</span>
                                    }
                                    else if (isActive)
                                    {
                                        <span class="badge badge-otika-success">Active</span>
                                    }
                                    else if (isCancelled)
                                    {
                                        <span class="badge badge-otika-error">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Expired</span>
                                    }
                                </div>
                            </div>

                            <div class="owner-sub-body">
                                <div class="metric-row">
                                    <span class="metric-label">Price</span>
                                    <span class="metric-value font-15 text-dark-slate">₹@planCost.ToString("N0")</span>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Stations</span>
                                    <span class="metric-value">@assignedCount / @maxStations</span>
                                </div>

                                <div class="mb-3 mt-1">
                                    <div class="progress" style="height: 5px; background-color: #E3EAEF; border-radius: 3px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @usagePercent%; border-radius: 3px;"></div>
                                    </div>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Managers</span>
                                    <span class="metric-value text-muted-slate">@maxManagers / station</span>
                                </div>

                                <div class="metric-row">
                                    <span class="metric-label">Valid Until</span>
                                    <span class="metric-value">
                                        @sub.EndDate.ToString("dd MMM yyyy")
                                        @if (isActive)
                                        {
                                            <span class="badge badge-light border text-otika-primary ml-1">@daysLeft d</span>
                                        }
                                    </span>
                                </div>

                                <div class="mt-3 pt-2 border-top border-otika">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="font-weight-700 text-dark-slate">Stations (@assignedCount)</small>
                                        @if (isActive && assignedCount < maxStations)
                                        {
                                            <a href="/owner/subscription/@sub.Id/assign" class="small text-otika-primary font-weight-700">+ Link</a>
                                        }
                                    </div>
                                    @if (sub.Stations != null && sub.Stations.Any())
                                    {
                                        <div>
                                            @foreach (var st in sub.Stations.Take(3))
                                            {
                                                <span class="station-mini-chip">
                                                    <i class="fas fa-charging-station text-otika-primary mr-1"></i>@st.Name
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted-slate">No stations linked yet.</small>
                                    }
                                </div>
                            </div>

                            <div class="owner-sub-footer">
                                <div class="d-flex flex-wrap" style="gap: 5px;">
                                    @if (isActive)
                                    {
                                        <a href="/owner/subscription/@sub.Id/assign" class="btn btn-otika-primary btn-sm flex-fill">
                                            Manage
                                        </a>
                                        <a href="/owner/subscription/plans" class="btn btn-warning btn-sm flex-fill font-weight-700">
                                            Upgrade
                                        </a>
                                    }
                                    <a href="/owner/subscription/@sub.Id/details" class="btn btn-outline-secondary btn-sm flex-fill">
                                        Details
                                    </a>
                                    @if (isActive && isWithin24Hours)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm flex-fill" 
                                                onclick="openCancelModal('@sub.Id', '@sub.Plan?.Name', @planCost, true, @remainingHours)">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Owner Cancellation Request Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content card-otika border-0">
            <form id="cancelForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white border-bottom py-3">
                    <h5 class="modal-title font-weight-bold text-dark-slate" id="cancelModalLabel">
                        <i class="fas fa-undo-alt text-danger mr-2"></i>Cancel Subscription
                    </h5>
                    <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <div id="cancelEligibleBox" class="alert alert-warning mb-3">
                        <strong class="text-dark font-13">24-Hour Refund Window Active</strong>
                        <p class="font-12 mb-0 mt-1">
                            Plan: <strong id="modalPlanName"></strong> &bull; Refund: <strong id="modalRefundAmount" class="text-success"></strong> &bull; Remaining: <strong id="modalTimeLeft"></strong>h
                        </p>
                    </div>

                    <div id="cancelIneligibleBox" class="alert alert-danger mb-3" style="display: none;">
                        <small>Cancellation window closed (more than 24 hours elapsed).</small>
                    </div>

                    <div class="form-group" id="reasonGroup">
                        <label class="small font-weight-bold text-dark-slate">Reason for Cancellation <span class="text-danger">*</span></label>
                        <textarea name="cancellationReason" id="cancellationReason" class="form-control" rows="3" required minlength="10" maxlength="500" placeholder="Brief explanation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Keep</button>
                    <button type="submit" id="btnSubmitCancel" class="btn btn-danger btn-sm font-weight-bold">
                        Confirm Cancellation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#cancelModal').appendTo("body");
        });

        function openCancelModal(id, planName, amount, isWithin24, hoursLeft) {
            $('#cancelForm').attr('action', '/owner/subscription/' + id + '/cancel');
            $('#modalPlanName').text(planName);
            $('#modalRefundAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#cancellationReason').val('');

            if (isWithin24) {
                $('#cancelEligibleBox').show();
                $('#cancelIneligibleBox').hide();
                $('#modalTimeLeft').text(hoursLeft);
                $('#reasonGroup').show();
                $('#btnSubmitCancel').prop('disabled', false).show();
            } else {
                $('#cancelEligibleBox').hide();
                $('#cancelIneligibleBox').show();
                $('#reasonGroup').hide();
                $('#btnSubmitCancel').prop('disabled', true).hide();
            }

            $('#cancelModal').modal('show');
        }
    </script>
}
