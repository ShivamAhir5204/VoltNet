@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "My Subscriptions";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var totalStationsUsed = (int)(ViewBag.TotalStationsUsed ?? 0);
    var totalStationsAllowed = (int)(ViewBag.TotalStationsAllowed ?? 0);
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Success</div>
            @TempData["Success"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @TempData["Error"]
        </div>
    </div>
}

<!-- Summary Stats -->
<div class="row">
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
        <div class="card card-statistic-1 border mb-0 h-100">
            <div class="card-icon bg-success text-white d-flex align-items-center justify-content-center">
                <i class="fas fa-check-circle fa-2x"></i>
            </div>
            <div class="card-wrap">
                <div class="card-header py-0"><h4 class="text-muted">Active Plans</h4></div>
                <div class="card-body font-weight-bold text-success">@activeCount</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
        <div class="card card-statistic-1 border mb-0 h-100">
            <div class="card-icon bg-primary text-white d-flex align-items-center justify-content-center">
                <i class="fas fa-charging-station fa-2x"></i>
            </div>
            <div class="card-wrap">
                <div class="card-header py-0"><h4 class="text-muted">Stations Used</h4></div>
                <div class="card-body font-weight-bold text-primary">@totalStationsUsed / @totalStationsAllowed</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
        <div class="card card-statistic-1 border mb-0 h-100">
            <div class="card-icon bg-warning text-white d-flex align-items-center justify-content-center">
                <i class="fas fa-rupee-sign fa-2x"></i>
            </div>
            <div class="card-wrap">
                <div class="card-header py-0"><h4 class="text-muted">Total Invested</h4></div>
                <div class="card-body font-weight-bold text-warning">₹@totalSpent.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
        <div class="card card-statistic-1 border mb-0 h-100">
            <div class="card-icon bg-info text-white d-flex align-items-center justify-content-center">
                <i class="fas fa-history fa-2x"></i>
            </div>
            <div class="card-wrap">
                <div class="card-header py-0"><h4 class="text-muted">Total Subscriptions</h4></div>
                <div class="card-body font-weight-bold text-info">@totalCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Navigation Tabs & Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center my-4">
    <div class="mb-3 mb-md-0">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link active" href="/owner/subscription">
                    <i class="fas fa-bolt mr-1"></i> Active Subscriptions <span class="badge badge-white text-primary ml-1">@activeCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/owner/subscription/history">
                    <i class="fas fa-history mr-1"></i> Expired &amp; Cancelled <span class="badge badge-secondary ml-1">@historyCount</span>
                </a>
            </li>
        </ul>
    </div>
    <div>
        <a href="/owner/subscription/plans" class="btn btn-primary btn-lg shadow-sm">
            <i class="fas fa-plus mr-1"></i> Buy New Plan
        </a>
    </div>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <h2>No Active Subscriptions</h2>
                        <p class="lead text-muted">
                            You currently have no active subscription plans running. Purchase a plan to make your EV stations live and visible to drivers.
                        </p>
                        <div class="mt-4">
                            <a href="/owner/subscription/plans" class="btn btn-primary btn-lg mr-2">
                                <i class="fas fa-shopping-cart mr-1"></i> Browse &amp; Buy Plans
                            </a>
                            @if (historyCount > 0)
                            {
                                <a href="/owner/subscription/history" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-history mr-1"></i> View Past Plans (@historyCount)
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var sub in Model)
        {
            var isCancelled = sub.Status == "Cancelled";
            var isCancellationPending = sub.Status == "CancellationPending";
            var isExpired = sub.EndDate < DateTime.UtcNow && !isCancelled && !isCancellationPending;
            var isActive = sub.Status == "Active" && sub.EndDate >= DateTime.UtcNow;
            var daysLeft = isActive ? (sub.EndDate - DateTime.UtcNow).Days : 0;
            var isExpiringSoon = isActive && daysLeft <= 7;
            
            // 24 Hour Purchase Timeline Calculation
            var hoursSincePurchase = (DateTime.UtcNow - sub.CreatedAt).TotalHours;
            var isWithin24Hours = hoursSincePurchase <= 24;
            var remainingHours = isWithin24Hours ? (int)Math.Ceiling(24 - hoursSincePurchase) : 0;
            
            var cardBorderClass = isCancelled ? "card-secondary" : (isCancellationPending ? "card-warning" : (isExpired ? "card-danger" : (isExpiringSoon ? "card-warning" : "card-success")));
            var statusText = isCancelled ? "Cancelled" : (isCancellationPending ? "Cancellation Review" : (isExpired ? "Expired" : (isExpiringSoon ? "Expiring Soon" : "Active")));
            var badgeClass = isCancelled ? "badge-secondary" : (isCancellationPending ? "badge-warning text-dark" : (isExpired ? "badge-danger" : (isExpiringSoon ? "badge-warning text-dark" : "badge-success")));
            
            var assignedCount = sub.Stations?.Count ?? 0;
            var maxStations = sub.Plan?.MaxStations ?? 0;
            var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
            var progressColor = usagePercent >= 100 ? "bg-danger" : (usagePercent >= 75 ? "bg-warning" : "bg-success");
            var planCost = sub.AmountPaid > 0 ? sub.AmountPaid : (sub.Plan?.PricePerMonth ?? 0m);

            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card @cardBorderClass shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="text-dark font-weight-bold mb-0">@(sub.Plan?.Name ?? "Plan")</h4>
                        <span class="badge @badgeClass">@statusText</span>
                    </div>

                    <div class="card-body">
                        @if (isCancellationPending)
                        {
                            <div class="alert alert-warning alert-has-icon mb-3">
                                <div class="alert-icon"><i class="fas fa-clock"></i></div>
                                <div class="alert-body">
                                    <div class="alert-title">Pending Review</div>
                                    <small class="d-block text-truncate">Reason: @sub.CancellationReason</small>
                                </div>
                            </div>
                        }
                        else if (isExpiringSoon)
                        {
                            <div class="alert alert-warning alert-has-icon mb-3">
                                <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
                                <div class="alert-body">
                                    <div class="alert-title">Expiring Soon</div>
                                    <strong>@daysLeft day(s) left!</strong> Renew soon to keep your stations online.
                                </div>
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-6">
                                <span class="text-muted small d-block">Start Date</span>
                                <strong class="text-dark">@sub.StartDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="col-6 text-right">
                                <span class="text-muted small d-block">End Date</span>
                                <strong class="text-dark">@sub.EndDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>

                        <!-- Usage Bar -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small font-weight-bold">Station Usage</span>
                                <span class="text-dark small font-weight-bold">@assignedCount / @maxStations</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @progressColor" role="progressbar" style="width: @usagePercent%" aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Amount Paid</span>
                            <div class="h3 font-weight-bold text-primary mb-0">₹@planCost.ToString("N0")</div>
                        </div>
                    </div>

                    <div class="card-footer bg-light border-top">
                        <div class="btn-group btn-group-sm w-100 flex-wrap" role="group">
                            @if (isActive)
                            {
                                <a href="/owner/subscription/@sub.Id/assign" class="btn btn-outline-primary">
                                    <i class="fas fa-tasks mr-1"></i> Stations
                                </a>
                            }

                            <a href="/owner/subscription/@sub.Id/details" class="btn btn-outline-info">
                                <i class="fas fa-info-circle mr-1"></i> Details
                            </a>

                            <a href="/owner/subscription/@sub.Id/receipt" class="btn btn-outline-secondary">
                                <i class="fas fa-download mr-1"></i> Receipt
                            </a>

                            @if (isActive)
                            {
                                <button type="button" class="btn btn-outline-danger" 
                                        onclick="openCancelModal('@sub.Id', '@sub.Plan?.Name', @planCost, @(isWithin24Hours ? "true" : "false"), @remainingHours)">
                                    <i class="fas fa-times-circle mr-1"></i> Cancel
                                </button>
                            }
                            else if (isCancellationPending)
                            {
                                <button type="button" class="btn btn-warning" disabled title="Cancellation request submitted">
                                    <i class="fas fa-hourglass-half mr-1"></i> Reviewing
                                </button>
                            }
                            else if (isExpired || isCancelled)
                            {
                                <a href="/owner/subscription/plan/@sub.PlanId" class="btn btn-outline-success">
                                    <i class="fas fa-sync-alt mr-1"></i> Renew
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ─── Owner Cancellation Request Modal ─── -->
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden; border: none; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
            <form id="cancelForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title text-white font-weight-bold" id="cancelModalLabel">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Cancel Subscription Plan
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <!-- Policy Warning Banner -->
                    <div id="cancelEligibleBox" class="alert alert-warning mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-shield-alt mr-2 fa-lg text-warning"></i>
                            <strong class="text-dark">24-Hour Cancellation Policy</strong>
                        </div>
                        <p class="small mb-0 text-dark">
                            You are requesting cancellation for <strong id="modalPlanName"></strong>. 
                            Time remaining in eligible refund window: <strong class="text-danger" id="modalTimeLeft"></strong> hour(s).
                        </p>
                    </div>

                    <div id="cancelIneligibleBox" class="alert alert-danger mb-3" style="display: none;">
                        <i class="fas fa-ban mr-2"></i>
                        <strong>Cancellation Policy Expired:</strong> Cancellations are only allowed within 24 hours of purchase. More than 24 hours have elapsed since this subscription was created.
                    </div>

                    <div class="bg-light p-3 rounded mb-3">
                        <h6 class="font-weight-bold text-dark mb-2" style="font-size: 0.9rem;">Important Circumstances:</h6>
                        <ul class="text-muted small pl-3 mb-0">
                            <li>All assigned stations will be taken <strong>offline</strong> upon Admin approval.</li>
                            <li>Your reason will be verified by the VoltNet Administration team.</li>
                            <li>Upon approval, a 100% refund of <strong id="modalRefundAmount" class="text-success"></strong> will be initiated to your original payment method.</li>
                            <li>A confirmation email with full details will be dispatched upon decision.</li>
                        </ul>
                    </div>

                    <div class="form-group" id="reasonGroup">
                        <label class="font-weight-bold text-dark">
                            Reason for Cancellation <span class="text-danger">*</span>
                        </label>
                        <textarea name="cancellationReason" id="cancellationReason" class="form-control" rows="3" required minlength="10" maxlength="500" 
                                  placeholder="Please describe in detail why you wish to cancel this plan (e.g., Selected wrong station capacity, changing business location)..."></textarea>
                        <small class="form-text text-muted">Minimum 10 characters required. Maximum 500 characters.</small>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-dismiss="modal">Keep Subscription</button>
                    <button type="submit" id="btnSubmitCancel" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-paper-plane mr-1"></i> Submit Cancellation Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Move modal to body to prevent stacking context or dull backdrop lock issue
            $('#cancelModal').appendTo("body");
        });

        function openCancelModal(id, planName, amount, isWithin24, hoursLeft) {
            $('#cancelForm').attr('action', '/owner/subscription/' + id + '/cancel');
            $('#modalPlanName').text(planName);
            $('#modalRefundAmount').text('₹' + Number(amount).toLocaleString('en-IN'));
            $('#cancellationReason').val('');

            if (isWithin24) {
                $('#cancelEligibleBox').show();
                $('#cancelIneligibleBox').hide();
                $('#modalTimeLeft').text(hoursLeft);
                $('#reasonGroup').show();
                $('#btnSubmitCancel').prop('disabled', false).show();
            } else {
                $('#cancelEligibleBox').hide();
                $('#cancelIneligibleBox').show();
                $('#reasonGroup').hide();
                $('#btnSubmitCancel').prop('disabled', true).hide();
            }

            $('#cancelModal').modal('show');
        }
    </script>
}
