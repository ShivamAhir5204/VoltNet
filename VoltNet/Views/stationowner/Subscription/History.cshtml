@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscription History";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

<div class="section-header">
    <h1>Subscription History</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/owner/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item"><a href="/owner/subscription">Subscriptions</a></div>
        <div class="breadcrumb-item">History</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-check-circle mr-2 font-18"></i>
            <div>@TempData["Success"]</div>
        </div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle mr-2 font-18"></i>
            <div>@TempData["Error"]</div>
        </div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- ─── Navigation Tabs & Buy Button ─────────────────────────────── -->
<div class="card mb-4" style="border: 1px solid #dce2eb; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <ul class="nav nav-pills" style="gap: 8px;">
                <li class="nav-item">
                    <a class="nav-link font-weight-bold" href="/owner/subscription" 
                       style="border-radius: 6px; padding: 8px 18px; color: #34395e;">
                        <i class="fas fa-bolt mr-2 text-primary"></i> Active Plans (@activeCount)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active font-weight-bold" href="/owner/subscription/history" 
                       style="border-radius: 6px; padding: 8px 18px; background-color: #6777ef; color: #ffffff;">
                        <i class="fas fa-history mr-2"></i> Expired & Cancelled (@historyCount)
                    </a>
                </li>
            </ul>
            <div class="mt-3 mt-md-0">
                @if (activeCount > 0)
                {
                    <a href="/owner/subscription" class="btn btn-outline-primary font-weight-700 px-4 py-2">
                        <i class="fas fa-bolt mr-1"></i> View Active Plan
                    </a>
                }
                else
                {
                    <a href="/owner/subscription/plans" class="btn btn-primary font-weight-700 px-4 py-2">
                        <i class="fas fa-plus mr-1"></i> Choose New Plan
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card p-5 text-center" style="border: 1px solid #dce2eb; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                <div class="py-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 72px; height: 72px; background: #eef2f7; color: #6777ef; font-size: 32px;">
                        <i class="fas fa-history"></i>
                    </div>
                    <h4 class="font-weight-bold text-dark mb-2">No Past Subscriptions</h4>
                    <p class="font-weight-500 max-w-500 mx-auto mb-4" style="color: #34395e; font-size: 15px;">
                        You do not have any expired or cancelled subscriptions. All your active subscriptions are running smoothly.
                    </p>
                    <a href="/owner/subscription" class="btn btn-primary font-weight-600 px-4">
                        <i class="fas fa-bolt mr-2"></i> View Active Plans
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var sub in Model)
        {
            var isCancelled = sub.Status == "Cancelled";
            var isUpgraded = sub.Status == "Upgraded";
            var isExpired = sub.EndDate < DateTime.UtcNow && !isCancelled && !isUpgraded;
            var statusText = isCancelled ? "Cancelled" : (isUpgraded ? "Upgraded" : "Expired");
            var badgeClass = isCancelled ? "badge-danger" : (isUpgraded ? "badge-info" : "badge-secondary");

            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="detail-card d-flex flex-column justify-content-between">
                    <div>
                        <!-- Card Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                            <div>
                                <h4 class="mb-1 font-weight-bold" style="color: #212529; font-size: 18px;">
                                    @(sub.Plan?.Name ?? "Plan")
                                </h4>
                                <div class="font-weight-700 text-dark font-16">
                                    ₹@sub.AmountPaid.ToString("N0") 
                                    <span class="font-weight-500 text-muted font-13">/ @(sub.Plan?.DurationDays ?? 30) days</span>
                                </div>
                            </div>
                            <span class="badge @badgeClass font-weight-700 font-12 px-3 py-1">
                                @if (isCancelled)
                                {
                                    <i class="fas fa-ban mr-1"></i>
                                }
                                else if (isUpgraded)
                                {
                                    <i class="fas fa-arrow-circle-up mr-1"></i>
                                }
                                else
                                {
                                    <i class="fas fa-hourglass-end mr-1"></i>
                                }
                                @statusText
                            </span>
                        </div>

                        <!-- Info Rows -->
                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Start Date</span>
                            <span class="detail-value font-weight-600 text-dark">
                                @sub.StartDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Ended On</span>
                            <span class="detail-value font-weight-600 text-dark">
                                @sub.EndDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Max Stations</span>
                            <span class="detail-value font-weight-bold text-primary">
                                @(sub.Plan?.MaxStations ?? 1) Station(s)
                            </span>
                        </div>

                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Payment ID</span>
                            <span class="detail-value text-monospace font-weight-600 text-dark font-12">
                                @(sub.PaymentId?.Length > 15 ? sub.PaymentId[..15] + "..." : sub.PaymentId)
                            </span>
                        </div>

                        <!-- Status Alert / Refund Section -->
                        <div class="mt-3">
                            @if (isCancelled)
                            {
                                <div class="detail-box" style="border-left: 4px solid #fc544b; background: #ffffff;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-danger font-weight-bold font-13">
                                            <i class="fas fa-times-circle mr-1"></i> Cancelled by Owner
                                        </span>
                                        @if (sub.RefundAmount.HasValue)
                                        {
                                            <span class="text-success font-weight-bold font-13">
                                                Refund: ₹@sub.RefundAmount.Value.ToString("N0")
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationReason))
                                    {
                                        <div class="font-weight-500 font-13 text-dark text-truncate" title="@sub.CancellationReason">
                                            <strong>Reason:</strong> @sub.CancellationReason
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationAdminRemarks))
                                    {
                                        <div class="font-weight-600 font-12 text-primary mt-1">
                                            <strong>Admin Note:</strong> @sub.CancellationAdminRemarks
                                        </div>
                                    }
                                </div>
                            }
                            else if (isUpgraded)
                            {
                                <div class="detail-box" style="border-left: 4px solid #0ea5e9; background: #f0f9ff;">
                                    <span class="font-weight-600 text-info" style="font-size: 13px;">
                                        <i class="fas fa-arrow-circle-up mr-1 text-info"></i> Upgraded to higher tier plan. Linked stations transitioned with zero interruption.
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="detail-box" style="border-left: 4px solid #cdd3d8; background: #ffffff;">
                                    <span class="font-weight-600" style="color: #34395e; font-size: 13px;">
                                        <i class="fas fa-clock mr-1 text-secondary"></i> Billing period completed on @sub.EndDate.ToString("dd MMM yyyy").
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="pt-3 mt-3 border-top d-flex flex-wrap" style="gap: 8px;">
                        <a href="/owner/subscription/@sub.Id/details" class="btn btn-outline-primary font-weight-600 btn-sm flex-fill">
                            <i class="fas fa-info-circle mr-1"></i> Details
                        </a>
                        <a href="/owner/subscription/@sub.Id/receipt" class="btn btn-outline-secondary font-weight-600 btn-sm flex-fill">
                            <i class="fas fa-file-pdf mr-1 text-danger"></i> Receipt PDF
                        </a>
                        @if (activeCount > 0)
                        {
                            <a href="/owner/subscription" class="btn btn-outline-primary font-weight-600 btn-sm flex-fill text-center">
                                <i class="fas fa-check-circle mr-1"></i> Active Plan Running
                            </a>
                        }
                        else if (sub.PlanId != Guid.Empty && sub.Plan != null)
                        {
                            <a href="/owner/subscription/plan/@sub.PlanId" class="btn btn-primary font-weight-600 btn-sm flex-fill text-center">
                                <i class="fas fa-sync-alt mr-1"></i> Renew Plan
                            </a>
                        }
                        else
                        {
                            <a href="/owner/subscription/plans" class="btn btn-primary font-weight-600 btn-sm flex-fill text-center">
                                <i class="fas fa-shopping-cart mr-1"></i> Choose Plan
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
