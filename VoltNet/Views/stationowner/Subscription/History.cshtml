@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscription History";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}
<div class="sp">

    <div class="head">
        <h4>Subscription History</h4>
        <div class="head-actions">
            @if (activeCount > 0)
            {
                <a href="/owner/subscription" class="btn btn-ghost"><i class="fas fa-bolt"></i> View Active Plan</a>
            }
            else
            {
                <a href="/owner/subscription/plans" class="btn btn-main"><i class="fas fa-plus"></i> Choose New Plan</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="chips">
        <a class="chip" href="/owner/subscription">Active Plans (@activeCount)</a>
        <a class="chip active" href="/owner/subscription/history">Expired & Cancelled (@historyCount)</a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body empty-box">
                        <h5>No past subscriptions</h5>
                        <a href="/owner/subscription" class="btn btn-main"><i class="fas fa-bolt"></i> View Active Plans</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var sub in Model)
            {
                var isCancelled = sub.Status == "Cancelled";
                var isUpgraded = sub.Status == "Upgraded";
                var isExpired = sub.EndDate < DateTime.UtcNow && !isCancelled && !isUpgraded;
                var statusText = isCancelled ? "Cancelled" : (isUpgraded ? "Upgraded" : "Expired");
                var pillClass = isCancelled ? "s-err" : (isUpgraded ? "s-info" : "s-plain");

                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card sub-card">
                        <div class="sub-head">
                            <div>
                                <h5>@(sub.Plan?.Name ?? "Plan")</h5>
                                <div class="price">₹@sub.AmountPaid.ToString("N0") <span>/ @(sub.Plan?.DurationDays ?? 30) days</span></div>
                            </div>
                            <span class="status @pillClass">@statusText</span>
                        </div>

                        <div class="sub-body">
                            <div class="kv"><span class="k">Start Date</span><span class="v">@sub.StartDate.ToString("dd MMM yyyy")</span></div>
                            <div class="kv"><span class="k">Ended On</span><span class="v">@sub.EndDate.ToString("dd MMM yyyy")</span></div>
                            <div class="kv"><span class="k">Max Stations</span><span class="v">@(sub.Plan?.MaxStations ?? 1)</span></div>
                            <div class="kv"><span class="k">Payment ID</span><span class="v mono">@(sub.PaymentId?.Length > 15 ? sub.PaymentId[..15] + "..." : sub.PaymentId)</span></div>

                            @if (isCancelled)
                            {
                                <div class="note n-red">
                                    <div class="row2">
                                        <span>Cancelled by owner</span>
                                        @if (sub.RefundAmount.HasValue)
                                        {
                                            <span class="money">Refund: ₹@sub.RefundAmount.Value.ToString("N0")</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationReason))
                                    {
                                        <div title="@sub.CancellationReason"><strong>Reason:</strong> @sub.CancellationReason</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationAdminRemarks))
                                    {
                                        <div class="mt-1"><strong>Admin Note:</strong> @sub.CancellationAdminRemarks</div>
                                    }
                                </div>
                            }
                            else if (isUpgraded)
                            {
                                <div class="note n-info">Upgraded to a higher plan.</div>
                            }
                        </div>

                        <div class="sub-foot">
                            <a href="/owner/subscription/@sub.Id/details" class="btn btn-back"><i class="fas fa-info-circle"></i> Details</a>
                            <a href="/owner/subscription/@sub.Id/receipt" class="btn btn-back"><i class="fas fa-file-pdf"></i> Receipt</a>
                            @if (activeCount > 0)
                            {
                                <a href="/owner/subscription" class="btn btn-ghost"><i class="fas fa-bolt"></i> Active Plan</a>
                            }
                            else if (sub.PlanId != Guid.Empty && sub.Plan != null)
                            {
                                <a href="/owner/subscription/plan/@sub.PlanId" class="btn btn-main"><i class="fas fa-sync-alt"></i> Renew</a>
                            }
                            else
                            {
                                <a href="/owner/subscription/plans" class="btn btn-main"><i class="fas fa-shopping-cart"></i> Choose Plan</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>