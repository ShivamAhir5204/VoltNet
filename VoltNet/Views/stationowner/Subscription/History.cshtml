@model IEnumerable<VoltNet.Models.OwnerSubscription>
@{
    ViewData["Title"] = "Subscription History";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var activeCount = (int)(ViewBag.ActiveCount ?? 0);
    var historyCount = (int)(ViewBag.HistoryCount ?? 0);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Success</div>
            @TempData["Success"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @TempData["Error"]
        </div>
    </div>
}

<!-- Navigation Tabs & Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div class="mb-3 mb-md-0">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link" href="/owner/subscription">
                    <i class="fas fa-bolt mr-1"></i> Active Subscriptions <span class="badge badge-secondary ml-1">@activeCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/owner/subscription/history">
                    <i class="fas fa-history mr-1"></i> Expired &amp; Cancelled <span class="badge badge-white text-primary ml-1">@historyCount</span>
                </a>
            </li>
        </ul>
    </div>
    <div>
        <a href="/owner/subscription/plans" class="btn btn-primary btn-lg shadow-sm">
            <i class="fas fa-plus mr-1"></i> Buy New Plan
        </a>
    </div>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <h2>No Past Subscriptions</h2>
                        <p class="lead text-muted">
                            You have no cancelled or expired plans. All your active subscriptions are running smoothly.
                        </p>
                        <a href="/owner/subscription" class="btn btn-primary mt-3">
                            <i class="fas fa-bolt mr-1"></i> View Active Subscriptions
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var sub in Model)
        {
            var isCancelled = sub.Status == "Cancelled";
            var isExpired = sub.EndDate < DateTime.UtcNow && !isCancelled;
            var cardBorderClass = isCancelled ? "card-warning" : "card-danger";
            var statusText = isCancelled ? "Cancelled" : "Expired";
            var badgeClass = isCancelled ? "badge-warning text-dark" : "badge-danger";

            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card @cardBorderClass shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="text-dark font-weight-bold mb-0">@(sub.Plan?.Name ?? "Plan")</h4>
                            <small class="text-muted">₹@sub.AmountPaid.ToString("N0") / @(sub.Plan?.DurationDays ?? 30) days</small>
                        </div>
                        <span class="badge @badgeClass">@statusText</span>
                    </div>

                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <span class="text-muted small d-block">Start Date</span>
                                <strong class="text-dark">@sub.StartDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="col-6 text-right">
                                <span class="text-muted small d-block">Ended Date</span>
                                <strong class="text-dark">@sub.EndDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded mb-3 border">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block font-weight-bold">Plan Capacity</span>
                                    <strong class="text-dark">@(sub.Plan?.MaxStations ?? 1) Station(s) Max</strong>
                                </div>
                                <div class="text-right">
                                    <span class="text-muted small d-block font-weight-bold">Payment ID</span>
                                    <span class="badge badge-light border">
                                        @(sub.PaymentId?.Length > 14 ? sub.PaymentId[..14] + "..." : (sub.PaymentId ?? "N/A"))
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="small mb-0">
                            @if (isCancelled)
                            {
                                <div class="alert alert-secondary p-2 mb-0">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-danger font-weight-bold"><i class="fas fa-times-circle mr-1"></i>Cancelled</span>
                                        @if (sub.RefundAmount.HasValue)
                                        {
                                            <span class="text-success font-weight-bold">Refund: ₹@sub.RefundAmount.Value.ToString("N0")</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationReason))
                                    {
                                        <div class="text-muted text-truncate" title="@sub.CancellationReason">
                                            <strong>Reason:</strong> @sub.CancellationReason
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sub.CancellationAdminRemarks))
                                    {
                                        <div class="text-info mt-1">
                                            <strong>Admin Note:</strong> @sub.CancellationAdminRemarks
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted"><i class="fas fa-clock mr-1 text-danger"></i> This subscription expired on @sub.EndDate.ToString("dd MMM yyyy").</div>
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-light border-top">
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <a href="/owner/subscription/@sub.Id/details" class="btn btn-outline-info">
                                <i class="fas fa-info-circle mr-1"></i> Details
                            </a>

                            <a href="/owner/subscription/@sub.Id/receipt" class="btn btn-outline-secondary">
                                <i class="fas fa-download mr-1"></i> Receipt
                            </a>

                            @if (sub.PlanId != Guid.Empty && sub.Plan != null)
                            {
                                <a href="/owner/subscription/plan/@sub.PlanId" class="btn btn-outline-primary">
                                    <i class="fas fa-sync-alt mr-1"></i> Renew
                                </a>
                            }
                            else
                            {
                                <a href="/owner/subscription/plans" class="btn btn-primary">
                                    <i class="fas fa-shopping-cart mr-1"></i> Choose Plan
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
