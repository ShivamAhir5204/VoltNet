@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Assign Stations";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var allStations = ViewBag.AllStations as List<VoltNet.Models.Station> ?? new List<VoltNet.Models.Station>();
}

<div class="section-header">
    <div class="section-header-back">
        <a href="/owner/subscription" class="btn btn-icon"><i class="fas fa-arrow-left"></i></a>
    </div>
    <h1>Assign Stations to Plan</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/owner/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item"><a href="/owner/subscription">Subscriptions</a></div>
        <div class="breadcrumb-item">Assign</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12 col-md-4">
        <div class="card card-primary">
            <div class="card-header">
                <h4>Plan Details</h4>
            </div>
            <div class="card-body">
                <h5 class="text-primary">@(Model.Plan?.Name)</h5>
                <p class="text-muted">@(Model.Plan?.Description)</p>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span class="font-weight-bold">Expires On:</span>
                    <span>@Model.EndDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="font-weight-bold">Max Stations:</span>
                    <span class="badge badge-info">@(Model.Plan?.MaxStations ?? 0)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="font-weight-bold">Currently Assigned:</span>
                    <span class="badge badge-warning" id="assignedCountBadge">@(Model.Stations?.Count ?? 0)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8">
        <div class="card">
            <div class="card-header">
                <h4>Select Stations to Activate</h4>
            </div>
            <div class="card-body">
                <form method="post" action="/owner/subscription/@Model.Id/assign" id="assignForm">
                    @Html.AntiForgeryToken()
                    
                    @if (!allStations.Any())
                    {
                        <div class="alert alert-warning">
                            You don't have any stations yet. <a href="/owner/stations/Create">Create one first</a>.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Select up to @(Model.Plan?.MaxStations ?? 0) stations below to link them to this active plan. Stations not linked to an active plan will not be visible to the public.</p>
                        
                        <div id="quotaWarning" class="alert alert-danger" style="display: none; border-left: 5px solid #dc3545;">
                            <i class="fas fa-exclamation-triangle mr-2"></i> You have selected more stations than your plan allows (Max @(Model.Plan?.MaxStations ?? 0)). Please uncheck some stations to continue.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">Assign</th>
                                        <th>Station Name</th>
                                        <th>City</th>
                                        <th>Current Status</th>
                                        <th>Subscription Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var station in allStations)
                                    {
                                        var isAssignedToThis = station.OwnerSubscriptionId == Model.Id;
                                        var isAssignedToOther = station.OwnerSubscriptionId != null && station.OwnerSubscriptionId != Model.Id;
                                        
                                        <tr>
                                            <td>
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input station-checkbox" 
                                                           name="stationIds" value="@station.Id" id="chk_@station.Id"
                                                           @(isAssignedToThis ? "checked" : "")
                                                           @(isAssignedToOther ? "disabled" : "")>
                                                    <label class="custom-control-label" for="chk_@station.Id"></label>
                                                </div>
                                            </td>
                                            <td>
                                                <strong>@station.Name</strong>
                                                @if (isAssignedToOther)
                                                {
                                                    <br><small class="text-danger">Used in another plan</small>
                                                }
                                            </td>
                                            <td>@station.City</td>
                                            <td>
                                                @if(station.Status == "Active") { <span class="badge badge-success">Active Public</span> }
                                                else if(station.Status == "Approved") { <span class="badge badge-primary">Approved (Offline)</span> }
                                                else { <span class="badge badge-warning">@station.Status</span> }
                                            </td>
                                            <td>
                                                @if (isAssignedToThis) { <span class="text-success"><i class="fas fa-check-circle"></i> Linked Here</span> }
                                                else { <span class="text-muted">Not Linked</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="mt-4 text-right">
                            <button type="submit" class="btn btn-primary btn-lg" id="btnSave">
                                <i class="fas fa-save mr-2"></i> Save Assignments
                            </button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var maxAllowed = parseInt('@(Model.Plan?.MaxStations ?? 0)');
            
            function updateCount() {
                var checkedCount = $('.station-checkbox:checked').length;
                $('#assignedCountBadge').text(checkedCount);
                
                if (checkedCount > maxAllowed) {
                    $('#assignedCountBadge').removeClass('badge-warning').addClass('badge-danger');
                    $('#btnSave').prop('disabled', true);
                    
                    // Show inline warning instead of blocking alert
                    $('#quotaWarning').slideDown(200);
                    
                    // Add shake animation to visually alert the user
                    $('#quotaWarning').removeClass('shake');
                    void $('#quotaWarning')[0].offsetWidth; // trigger reflow
                    $('#quotaWarning').addClass('shake');
                } else {
                    $('#assignedCountBadge').removeClass('badge-danger').addClass('badge-warning');
                    $('#btnSave').prop('disabled', false);
                    $('#quotaWarning').slideUp(200);
                }
            }
            
            $('.station-checkbox').change(function() {
                updateCount();
            });
        });
    </script>
    <style>
        .shake {
            animation: shake 0.5s;
        }
        @@keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
            100% { transform: translateX(0); }
        }
    </style>
}
