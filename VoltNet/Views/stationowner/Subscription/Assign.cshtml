@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Assign Stations";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var allStations = ViewBag.AllStations as List<VoltNet.Models.Station> ?? new List<VoltNet.Models.Station>();
}

<div class="mb-3">
    <a href="/owner/subscription" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Back to Subscriptions
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @TempData["Error"]
        </div>
    </div>
}

<div class="row">
    <div class="col-12 col-md-4 mb-4">
        <div class="card card-primary shadow-sm h-100">
            <div class="card-header">
                <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-info-circle text-primary mr-2"></i>Plan Details</h4>
            </div>
            <div class="card-body">
                <h5 class="text-primary font-weight-bold">@(Model.Plan?.Name)</h5>
                <p class="text-muted small">@(Model.Plan?.Description)</p>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Expires On:</span>
                    <span class="font-weight-bold text-dark">@Model.EndDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Max Stations:</span>
                    <span class="badge badge-info">@(Model.Plan?.MaxStations ?? 0)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Currently Assigned:</span>
                    <span class="badge badge-warning text-dark" id="assignedCountBadge">@(Model.Stations?.Count ?? 0)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-charging-station text-warning mr-2"></i>Select Stations to Activate</h4>
            </div>
            <div class="card-body">
                <form method="post" action="/owner/subscription/@Model.Id/assign" id="assignForm">
                    @Html.AntiForgeryToken()
                    
                    @if (!allStations.Any())
                    {
                        <div class="alert alert-warning alert-has-icon">
                            <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
                            <div class="alert-body">
                                <div class="alert-title">No Stations Found</div>
                                You don't have any stations yet. <a href="/owner/stations/Create" class="font-weight-bold">Create one first</a>.
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">
                            Select up to <strong>@(Model.Plan?.MaxStations ?? 0)</strong> stations below to link them to this active plan. Stations not linked to an active plan will not be visible on the public driver map.
                        </p>
                        
                        <div id="quotaWarning" class="alert alert-danger alert-has-icon" style="display: none;">
                            <div class="alert-icon"><i class="fas fa-exclamation-circle"></i></div>
                            <div class="alert-body">
                                <div class="alert-title">Quota Exceeded</div>
                                You have selected more stations than your plan allows (Max @(Model.Plan?.MaxStations ?? 0)). Please uncheck stations to proceed.
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">Select</th>
                                        <th>Station Name</th>
                                        <th>City</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Subscription Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var station in allStations)
                                    {
                                        var isAssignedToThis = station.OwnerSubscriptionId == Model.Id;
                                        var isAssignedToOther = station.OwnerSubscriptionId != null && station.OwnerSubscriptionId != Model.Id;
                                        
                                        <tr>
                                            <td class="text-center">
                                                <div class="custom-control custom-checkbox d-inline-block">
                                                    <input type="checkbox" class="custom-control-input station-checkbox" 
                                                           name="stationIds" value="@station.Id" id="chk_@station.Id"
                                                           @(isAssignedToThis ? "checked" : "")
                                                           @(isAssignedToOther ? "disabled" : "")>
                                                    <label class="custom-control-label" for="chk_@station.Id"></label>
                                                </div>
                                            </td>
                                            <td>
                                                <strong class="text-dark">@station.Name</strong>
                                                @if (isAssignedToOther)
                                                {
                                                    <br><small class="text-danger"><i class="fas fa-lock mr-1"></i>Linked to another plan</small>
                                                }
                                            </td>
                                            <td><span class="text-muted">@station.City</span></td>
                                            <td class="text-center">
                                                @if(station.Status == "Active") { <span class="badge badge-success">Active Public</span> }
                                                else if(station.Status == "Approved") { <span class="badge badge-primary">Approved</span> }
                                                else { <span class="badge badge-secondary">@station.Status</span> }
                                            </td>
                                            <td class="text-center">
                                                @if (isAssignedToThis) { <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i>Linked Here</span> }
                                                else { <span class="text-muted small">Not Linked</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg btn-block" id="btnSave">
                                <i class="fas fa-save mr-1"></i> Save Assignments
                            </button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var maxAllowed = parseInt('@(Model.Plan?.MaxStations ?? 0)');
            
            function updateCount() {
                var checkedCount = $('.station-checkbox:checked').length;
                $('#assignedCountBadge').text(checkedCount);
                
                if (checkedCount > maxAllowed) {
                    $('#assignedCountBadge').removeClass('badge-warning text-dark').addClass('badge-danger text-white');
                    $('#btnSave').prop('disabled', true);
                    $('#quotaWarning').slideDown(200);
                } else {
                    $('#assignedCountBadge').removeClass('badge-danger text-white').addClass('badge-warning text-dark');
                    $('#btnSave').prop('disabled', false);
                    $('#quotaWarning').slideUp(200);
                }
            }
            
            $('.station-checkbox').change(function() {
                updateCount();
            });
        });
    </script>
}
