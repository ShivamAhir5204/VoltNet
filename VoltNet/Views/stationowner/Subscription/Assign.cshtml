@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Assign Stations";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var allStations = ViewBag.AllStations as List<VoltNet.Models.Station> ?? new List<VoltNet.Models.Station>();
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var currentAssignedCount = Model.Stations?.Count ?? 0;
    var currentQuotaPercent = maxStations > 0 ? Math.Min(100, (int)((double)currentAssignedCount / maxStations * 100)) : 0;
}
<div class="sp">
    <div class="head">
        <h4>Assign Stations</h4>
        <a href="/owner/subscription/@Model.Id/details" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="row">
        <div class="col-12 col-lg-4 mb-4">
            <div class="card">
                <div class="card-header"><h5>Plan Quota</h5></div>
                <div class="card-body">
                    <div class="kv"><span class="k">Plan</span><span class="v"><span class="status s-plan">@(Model.Plan?.Name ?? "Plan")</span></span></div>
                    <div class="kv"><span class="k">Monthly Rate</span><span class="v">₹@(Model.Plan?.PricePerMonth.ToString("N0") ?? Model.AmountPaid.ToString("N0"))</span></div>
                    <div class="kv"><span class="k">Expires On</span><span class="v">@Model.EndDate.ToString("dd MMM yyyy")</span></div>
                    <div class="kv"><span class="k">Max Stations</span><span class="v">@maxStations</span></div>
                    <div class="kv"><span class="k">Managers / Station</span><span class="v">@(Model.Plan?.MaxManagersPerStation ?? 0)</span></div>
                    <div class="kv"><span class="k">Selected</span><span class="v"><span class="status s-ok badge-success" id="assignedCountBadge">@currentAssignedCount / @maxStations</span></span></div>

                    <div class="quota-top"><span>Quota</span><span id="quotaPercentText">@currentQuotaPercent%</span></div>
                    <div class="progress">
                        <div class="progress-bar bg-primary" id="quotaProgressBar" role="progressbar" style="width: @currentQuotaPercent%; transition: width 0.3s ease;" aria-valuenow="@currentQuotaPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>

                    <a href="/owner/subscription/plans" class="btn btn-warn btn-block mt-4"><i class="fas fa-bolt"></i> Upgrade Plan</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Select Stations</h5>
                    <a href="/owner/stations/Create" class="btn btn-ghost"><i class="fas fa-plus"></i> Add Station</a>
                </div>

                <form method="post" action="/owner/subscription/@Model.Id/assign" id="assignForm">
                    @Html.AntiForgeryToken()

                    @if (!allStations.Any())
                    {
                        <div class="card-body empty-box">
                            <h5>No stations found</h5>
                            <a href="/owner/stations/Create" class="btn btn-main"><i class="fas fa-plus"></i> Register Station</a>
                        </div>
                    }
                    else
                    {
                        <div class="card-body" style="padding-bottom:0">
                            <div id="quotaWarning" class="alert alert-danger" style="display: none;">
                                Quota exceeded. Your plan allows a maximum of @maxStations. Uncheck some stations.
                            </div>
                        </div>

                        <div class="card-body flush">
                            <div class="table-responsive">
                                <table class="table align-middle no-datatable table-responsive-cards">
                                    <thead>
                                        <tr>
                                            <th>Station</th>
                                            <th>Location</th>
                                            <th>Status</th>
                                            <th>Link</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var station in allStations)
                                        {
                                            var isAssignedToThis = station.OwnerSubscriptionId == Model.Id;
                                            var isAssignedToOther = station.OwnerSubscriptionId != null && station.OwnerSubscriptionId != Model.Id;

                                            <tr class="@(isAssignedToThis ? "row-linked" : "")">
                                                <td class="col-primary" data-label="Station">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <div class="pick">
                                                            <input type="checkbox" class="chk station-checkbox"
                                                                   name="stationIds" value="@station.Id" id="chk_@station.Id"
                                                                   @(isAssignedToThis ? "checked" : "")
                                                                   @(isAssignedToOther ? "disabled" : "")>
                                                            <label for="chk_@station.Id" class="cell-strong">@station.Name</label>
                                                        </div>
                                                        <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                            <i data-feather="chevron-down"></i>
                                                        </button>
                                                    </div>
                                                    @if (isAssignedToOther)
                                                    {
                                                        <div class="cell-err">Linked to another plan</div>
                                                    }
                                                </td>
                                                <td class="col-secondary" data-label="Location">
                                                    <div>
                                                        <div class="cell-strong">@station.City</div>
                                                        <div class="cell-sub">@station.State</div>
                                                    </div>
                                                </td>
                                                <td class="col-secondary" data-label="Status">
                                                    <div>
                                                        @if (station.Status == "Active")
                                                        {
                                                            <span class="status s-ok">Active</span>
                                                        }
                                                        else if (station.Status == "Approved")
                                                        {
                                                            <span class="status s-plan">Approved</span>
                                                        }
                                                        else if (station.Status == "PendingVerification")
                                                        {
                                                            <span class="status s-warn">Pending Verification</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="status s-plain">@station.Status</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td data-label="Link">
                                                    <div>
                                                        @if (isAssignedToThis)
                                                        {
                                                            <span class="status s-ok">Linked Here</span>
                                                        }
                                                        else if (isAssignedToOther)
                                                        {
                                                            <span class="status s-err">In Other Plan</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="status s-plain">Unassigned</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-main" id="btnSave"><i class="fas fa-save"></i> Save Assignments</button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var maxAllowed = parseInt('@maxStations');

            function updateCount() {
                var checkedCount = $('.station-checkbox:checked').length;
                var badge = $('#assignedCountBadge');
                var warning = $('#quotaWarning');
                var btnSave = $('#btnSave');
                var progressBar = $('#quotaProgressBar');
                var percentText = $('#quotaPercentText');

                badge.text(checkedCount + ' / ' + maxAllowed);

                var pct = maxAllowed > 0 ? Math.min(100, Math.round((checkedCount / maxAllowed) * 100)) : 0;
                progressBar.css('width', pct + '%');
                percentText.text(pct + '%');

                if (checkedCount > maxAllowed) {
                    badge.removeClass('badge-success badge-warning').addClass('badge-danger');
                    progressBar.removeClass('bg-primary bg-warning').addClass('bg-danger');
                    btnSave.prop('disabled', true);
                    warning.slideDown(200);
                } else if (checkedCount === maxAllowed) {
                    badge.removeClass('badge-danger badge-warning').addClass('badge-success');
                    progressBar.removeClass('bg-danger bg-warning').addClass('bg-primary');
                    btnSave.prop('disabled', false);
                    warning.slideUp(200);
                } else {
                    badge.removeClass('badge-danger').addClass('badge-success');
                    progressBar.removeClass('bg-danger').addClass('bg-primary');
                    btnSave.prop('disabled', false);
                    warning.slideUp(200);
                }
            }

            $('.station-checkbox').on('change', function() {
                updateCount();
            });

            // Run initial sync
            updateCount();
        });
    </script>
}