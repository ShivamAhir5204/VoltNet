@model IEnumerable<VoltNet.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Subscription Plans";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var razorpayKey = ViewBag.RazorpayKeyId as string ?? "";
    var hasActiveSub = (bool)(ViewBag.HasActiveSubscription ?? false);
    var activeSub = ViewBag.ActiveSubscription as VoltNet.Models.OwnerSubscription;
    var remainingDays = (int)(ViewBag.RemainingDays ?? 0);
    var unusedCredit = (decimal)(ViewBag.UnusedCredit ?? 0m);
}
<div class="sp">

    <div class="head">
        <h4>Subscription Plans</h4>
        <a href="/owner/subscription" class="btn btn-back"><i class="fas fa-arrow-left"></i> My Subscriptions</a>
    </div>

    @if (hasActiveSub)
    {
        <div class="card gap-b">
            <div class="card-body">
                <div class="active-bar">
                    <div>
                        <div class="ab-title">
                            <span>Active Plan: @(activeSub?.Plan?.Name ?? "Active") (Max @(activeSub?.Plan?.MaxStations ?? 1) Stations)</span>
                            <span class="status s-warn">@remainingDays Days Left</span>
                        </div>
                        <div class="ab-meta">
                            Valid till <strong>@activeSub?.EndDate.ToString("dd MMM yyyy")</strong>
                            &bull; Unused credit: <span class="status s-ok">₹@unusedCredit.ToString("N0")</span>
                        </div>
                    </div>
                    <a href="/owner/subscription" class="btn btn-back"><i class="fas fa-cog"></i> Manage Active Plan</a>
                </div>
            </div>
        </div>
    }

    <div class="row">
        @foreach (var plan in Model)
        {
            var isEnterprise = plan.MaxStations > 10;
            var isGrowth = plan.MaxStations > 1 && !isEnterprise;
            var badgeText = isEnterprise ? "Enterprise" : (isGrowth ? "Popular" : "Starter");
            var badgeClass = isEnterprise ? "s-dark" : (isGrowth ? "s-plan" : "s-info");

            var isCurrentPlan = hasActiveSub && activeSub?.PlanId == plan.Id;
            var isHigherTier = hasActiveSub && (plan.PricePerMonth > (activeSub?.Plan?.PricePerMonth ?? 0) || plan.MaxStations > (activeSub?.Plan?.MaxStations ?? 0));
            var isLowerTier = hasActiveSub && !isCurrentPlan && !isHigherTier;

            decimal upgradePayable = 0;
            if (isHigherTier)
            {
                upgradePayable = Math.Max(0, Math.Round(plan.PricePerMonth - unusedCredit, 2));
            }

            <div class="col-12 col-md-6 col-lg-4 gap-b">
                <div class="card plan @(isCurrentPlan ? "current" : "")">
                    <div class="plan-top">
                        <h5>@plan.Name</h5>
                        @if (isCurrentPlan)
                        {
                            <span class="status s-ok">Current Plan</span>
                        }
                        else if (isHigherTier)
                        {
                            <span class="status s-warn">Upgrade</span>
                        }
                        else
                        {
                            <span class="status @badgeClass">@badgeText</span>
                        }
                    </div>

                    <div class="plan-price">₹@plan.PricePerMonth.ToString("N0") <span>/ @plan.DurationDays Days</span></div>

                    <div class="features">
                        <div class="feature"><i class="fas fa-check"></i><span>Up to <strong>@plan.MaxStations</strong> charging stations</span></div>
                        <div class="feature"><i class="fas fa-check"></i><span>Up to <strong>@plan.MaxManagersPerStation</strong> managers / station</span></div>
                        <div class="feature"><i class="fas fa-check"></i><span>IoT telemetry & dynamic rates</span></div>
                        <div class="feature"><i class="fas fa-check"></i><span>24h full refund guarantee</span></div>
                    </div>

                    <div>
                        @if (isCurrentPlan)
                        {
                            <button type="button" class="btn btn-current" disabled><i class="fas fa-check-circle"></i> Current Plan</button>
                        }
                        else if (isHigherTier)
                        {
                            <div class="credit-box">After ₹@unusedCredit.ToString("N0") credit: <strong>₹@upgradePayable.ToString("N0")</strong></div>
                            <button type="button" class="btn btn-warning btn-warn" onclick="initPayment('@plan.Id', '@plan.Name', @upgradePayable, true, @unusedCredit)">
                                <i class="fas fa-arrow-circle-up"></i> Upgrade (₹@upgradePayable.ToString("N0"))
                            </button>
                        }
                        else if (isLowerTier)
                        {
                            <button type="button" class="btn btn-back" disabled title="Downgrading is not permitted while current subscription is active">
                                <i class="fas fa-lock"></i> Lower Tier
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-buy-plan btn-main" onclick="initPayment('@plan.Id', '@plan.Name', @plan.PricePerMonth, false, 0)">
                                <i class="fas fa-bolt"></i> Select Plan — ₹@plan.PricePerMonth.ToString("N0")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Payment simulation overlay -->
<div class="razorpay-overlay" id="paymentOverlay">
    <div class="razorpay-modal">
        <div id="stageInitiating" class="payment-stage-container">
            <div class="processing-pulse mb-3">
                <div class="processing-pulse-inner"><i class="fas fa-lock"></i></div>
            </div>
            <h5 class="font-weight-bold mb-0">Connecting to payment gateway...</h5>
        </div>

        <div id="stageTrainCoin" class="coin-train-stage">
            <div class="train-convoy">
                <div class="cargo-wagon">
                    <div class="golden-coin-3d" style="width: 28px; height: 28px; font-size: 0.9rem; margin-top: -12px;">₹</div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
                <div class="cargo-wagon">
                    <div class="golden-coin-3d">₹</div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
                <div class="train-engine">
                    <div class="engine-chimney"><div class="smoke-puff"></div><div class="smoke-puff"></div></div>
                    <div class="engine-light"></div>
                    <div class="train-wheels"><div class="train-wheel"></div><div class="train-wheel"></div></div>
                </div>
            </div>

            <div class="rail-track-bed">
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
                <div class="track-sleeper"></div><div class="track-sleeper"></div><div class="track-sleeper"></div>
            </div>
            <div class="rail-steel"></div>
            <div class="rail-glow"></div>

            <div style="position: absolute; bottom: 8px; left: 0; width: 100%; text-align: center;">
                <h6 class="font-weight-bold mb-0" id="trainTitle" style="font-size: 0.9rem;">Processing payment...</h6>
                <small id="trainSub" style="color:#34395E;font-weight:600;">Securing transaction...</small>
            </div>
        </div>

        <div id="stageSuccess" class="success-celebration">
            <div class="success-icon-badge"><i class="fas fa-check"></i></div>
            <h4 class="font-weight-bold mb-3">Payment Successful</h4>
            <div class="spinner-border spinner-border-sm" style="color:#28C76F" role="status"></div>
        </div>
    </div>
</div>

<!-- Hidden form for verified payment submission -->
<form id="paymentVerifyForm" method="post" action="/owner/subscription/verify-payment" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="razorpay_order_id" id="inp_order_id" />
    <input type="hidden" name="razorpay_payment_id" id="inp_payment_id" />
    <input type="hidden" name="planId" id="inp_plan_id" />
</form>

@section Scripts {
    <script>
        var isPaymentInProgress = false;

        function initPayment(planId, planName, amount, isUpgrade, credit) {
            if (isPaymentInProgress) return;
            isPaymentInProgress = true;

            $('.btn-buy-plan, .btn-warning').prop('disabled', true);

            $('#stageInitiating').show();
            $('#stageTrainCoin').removeClass('active');
            $('#stageSuccess').removeClass('active');
            $('#paymentOverlay').addClass('active');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/owner/subscription/create-order',
                type: 'POST',
                data: { planId: planId, __RequestVerificationToken: token },
                success: function(data) {
                    if (!data.success) {
                        $('#paymentOverlay').removeClass('active');
                        isPaymentInProgress = false;
                        $('.btn-buy-plan, .btn-warning').prop('disabled', false);
                        alert(data.message || 'Failed to create order.');
                        return;
                    }

                    setTimeout(function() {
                        $('#stageInitiating').hide();
                        if (data.isUpgrade) {
                            $('#trainTitle').text('Upgrading to ' + planName + ' Plan...');
                            $('#trainSub').html('Securing transaction of <strong>₹' + data.finalPayable.toLocaleString('en-IN') + '</strong> (after ₹' + data.creditDeducted.toLocaleString('en-IN') + ' prorated credit)');
                        } else {
                            $('#trainTitle').text('Processing ' + planName + ' Plan...');
                            $('#trainSub').html('Securing transaction of <strong>₹' + amount.toLocaleString('en-IN') + '</strong>');
                        }
                        $('#stageTrainCoin').addClass('active');

                        setTimeout(function() {
                            $('#stageTrainCoin').removeClass('active');
                            $('#stageSuccess').addClass('active');

                            var fakePaymentId = 'pay_SIM_' + Math.random().toString(36).substr(2, 9).toUpperCase();
                            $('#inp_order_id').val(data.orderId);
                            $('#inp_payment_id').val(fakePaymentId);
                            $('#inp_plan_id').val(planId);

                            setTimeout(function() {
                                $('#paymentVerifyForm').submit();
                            }, 1600);

                        }, 2800);
                    }, 800);
                },
                error: function() {
                    $('#paymentOverlay').removeClass('active');
                    isPaymentInProgress = false;
                    $('.btn-buy-plan, .btn-warning').prop('disabled', false);
                    alert('Server error. Please try again.');
                }
            });
        }
    </script>
}