@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var isNowExpired = Model.EndDate < DateTime.UtcNow && Model.Status != "Cancelled";
    var isPending = Model.Status == "CancellationPending";
    var isCancelled = Model.Status == "Cancelled";
    var isActive = Model.Status == "Active" && !isNowExpired;

    var daysLeft = isActive ? Math.Max(0, (Model.EndDate - DateTime.UtcNow).Days) : 0;
    var totalDays = Math.Max(1, (Model.EndDate - Model.StartDate).Days);
    var elapsedDays = Math.Max(0, (DateTime.UtcNow - Model.StartDate).Days);
    var timelinePercent = Math.Min(100, (int)((double)elapsedDays / totalDays * 100));
    var timelineBar = isCancelled ? "bar-red" : (isNowExpired ? "bar-grey" : (daysLeft <= 5 ? "bar-amber" : "bar-green"));

    var assignedCount = Model.Stations?.Count ?? 0;
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var quotaPercent = maxStations > 0 ? Math.Min(100, (int)((double)assignedCount / maxStations * 100)) : 0;

    var hoursSincePurchase = (DateTime.UtcNow - Model.CreatedAt).TotalHours;
    var canRequestCancel = isActive && hoursSincePurchase <= 24;
    var remainingCancelHours = Math.Max(0, (int)(24 - hoursSincePurchase));
}

<div class="sp">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Top summary -->
    <div class="card gap-b">
        <div class="card-body">
            <div class="top">
                <div>
                    <div class="top-title">
                        <h4>@(Model.Plan?.Name ?? "Plan Details")</h4>
                        @if (isActive)
                        {
                            <span class="status s-ok">Active</span>
                        }
                        else if (isPending)
                        {
                            <span class="status s-warn">Review Pending</span>
                        }
                        else if (isCancelled)
                        {
                            <span class="status s-err">Cancelled</span>
                        }
                        else
                        {
                            <span class="status s-plain">Expired</span>
                        }
                    </div>
                    <div class="meta">
                        ₹@Model.AmountPaid.ToString("N0") &bull; @(Model.Plan?.DurationDays ?? 30) Days &bull; ID: <span class="mono">@(Model.PaymentId?.Length > 16 ? Model.PaymentId[..16] + "..." : Model.PaymentId)</span>
                    </div>
                </div>

                <div class="actions">
                    <a href="/owner/subscription/@Model.Id/receipt" class="btn btn-ghost"><i class="fas fa-file-pdf"></i> Receipt</a>
                    @if (isActive)
                    {
                        <a href="/owner/subscription/@Model.Id/assign" class="btn btn-main"><i class="fas fa-link"></i> Manage Stations</a>
                        @if (canRequestCancel)
                        {
                            <button type="button" class="btn btn-reject" data-toggle="modal" data-target="#cancelModal">
                                <i class="fas fa-undo"></i> Cancel (@remainingCancelHours h left)
                            </button>
                        }
                    }
                    else
                    {
                        <a href="/owner/subscription/plans" class="btn btn-main"><i class="fas fa-sync-alt"></i> Select Plan</a>
                    }
                    <a href="/owner/subscription" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6 gap-b">
            <div class="card h-100">
                <div class="card-header"><h5>Plan</h5></div>
                <div class="card-body">
                    <div class="kv"><span class="k">Tier</span><span class="v">@(Model.Plan?.Name ?? "Plan")</span></div>
                    <div class="kv"><span class="k">Monthly Rate</span><span class="v">₹@(Model.Plan?.PricePerMonth.ToString("N0") ?? Model.AmountPaid.ToString("N0"))</span></div>
                    <div class="kv"><span class="k">Station Limit</span><span class="v">@maxStations</span></div>
                    <div class="kv"><span class="k">Managers / Station</span><span class="v">@(Model.Plan?.MaxManagersPerStation ?? 0)</span></div>
                    <div class="kv"><span class="k">Capacity Used</span><span class="v">@assignedCount of @maxStations (@quotaPercent%)</span></div>
                    <div class="progress"><div class="progress-bar bar-indigo" role="progressbar" style="width: @quotaPercent%;"></div></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 gap-b">
            <div class="card h-100">
                <div class="card-header"><h5>Billing</h5></div>
                <div class="card-body">
                    <div class="kv"><span class="k">Amount Paid</span><span class="v money">₹@Model.AmountPaid.ToString("N2")</span></div>
                    <div class="kv"><span class="k">Purchased On</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</span></div>
                    <div class="kv"><span class="k">Validity</span><span class="v">@Model.StartDate.ToString("dd MMM yyyy") &mdash; @Model.EndDate.ToString("dd MMM yyyy")</span></div>
                    <div class="kv">
                        <span class="k">Status</span>
                        <span class="v">
                            @if (isActive)
                            {
                                <span class="status s-ok">@daysLeft Days Remaining</span>
                            }
                            else if (isPending)
                            {
                                <span class="status s-warn">Review Pending</span>
                            }
                            else
                            {
                                <span class="status s-plain">Expired</span>
                            }
                        </span>
                    </div>
                    <div class="kv"><span class="k">Timeline</span><span class="v">@timelinePercent% elapsed</span></div>
                    <div class="progress"><div class="progress-bar @timelineBar" role="progressbar" style="width: @timelinePercent%;"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Assigned stations -->
    <div class="card gap-b">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Assigned Stations (@assignedCount / @maxStations)</h5>
            @if (isActive)
            {
                <a href="/owner/subscription/@Model.Id/assign" class="btn btn-ghost"><i class="fas fa-link"></i> Edit Links</a>
            }
        </div>
        @if (Model.Stations == null || !Model.Stations.Any())
        {
            <div class="card-body empty-box">
                <h5>No stations linked</h5>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-main"><i class="fas fa-plus"></i> Link Stations</a>
                }
            </div>
        }
        else
        {
            <div class="card-body flush">
                <div class="table-responsive">
                    <table class="table align-middle no-datatable table-responsive-cards">
                        <thead>
                            <tr>
                                <th>Station</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var st in Model.Stations)
                            {
                                <tr>
                                    <td class="col-primary" data-label="Station">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="cell-strong">@st.Name</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Location"><div>@st.City, @st.State</div></td>
                                    <td data-label="Status">
                                        <div>
                                            @if (st.Status == "Active")
                                            {
                                                <span class="status s-ok">Active</span>
                                            }
                                            else if (st.Status == "Approved")
                                            {
                                                <span class="status s-plan">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="status s-warn">@st.Status</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-right col-action" data-label="Action">
                                        <a href="/owner/stations" class="link">View &rarr;</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Cancellation details -->
    @if (isPending || isCancelled || !string.IsNullOrWhiteSpace(Model.CancellationReason))
    {
        <div class="card gap-b">
            <div class="card-header"><h5>Cancellation & Refund</h5></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="kv">
                            <span class="k">Status</span>
                            <span class="v">
                                @if (isCancelled)
                                {
                                    <span class="status s-err">Approved & Cancelled</span>
                                }
                                else
                                {
                                    <span class="status s-warn">Pending Admin Review</span>
                                }
                            </span>
                        </div>
                        <div class="kv"><span class="k">Requested On</span><span class="v">@(Model.CancellationRequestedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A")</span></div>
                        <div class="kv"><span class="k">Refund</span><span class="v money">@(Model.RefundAmount.HasValue ? $"₹{Model.RefundAmount.Value:N2}" : "Pending Review")</span></div>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <span class="lbl">Reason</span>
                        <div class="box">@(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason specified" : Model.CancellationReason)</div>
                        @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks))
                        {
                            <span class="lbl mt-3">Admin Remarks</span>
                            <div class="box">@Model.CancellationAdminRemarks</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Cancellation modal -->
@if (canRequestCancel)
{
    <div class="modal fade sp-modal" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form method="post" action="/owner/subscription/@Model.Id/cancel">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Cancel Subscription</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <div class="impact">@(Model.Plan?.Name) &mdash; full refund of ₹@Model.AmountPaid.ToString("N0") after verification</div>
                        <div class="form-group mb-0">
                            <label>Reason (min 10 characters) <span class="text-danger">*</span></label>
                            <textarea name="cancellationReason" id="reasonTextarea" class="form-control" rows="3" minlength="10" maxlength="500" required></textarea>
                            <span class="counter" id="charCounter">0 / 500 characters</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-cancel" data-dismiss="modal">Keep Plan</button>
                        <button type="submit" class="btn btn-reject" id="btnConfirmCancel" disabled>Confirm Cancellation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var textarea = $('#reasonTextarea');
            var charCounter = $('#charCounter');
            var submitBtn = $('#btnConfirmCancel');

            if (textarea.length) {
                textarea.on('input', function() {
                    var len = $(this).val().trim().length;
                    charCounter.text(len + ' / 500 characters');
                    submitBtn.prop('disabled', len < 10);
                });
            }
        });
    </script>
}