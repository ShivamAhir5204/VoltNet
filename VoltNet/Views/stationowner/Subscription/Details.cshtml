@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var isCancelled = Model.Status == "Cancelled";
    var isExpired = Model.EndDate < DateTime.UtcNow && !isCancelled;
    var isActive = Model.Status == "Active" && Model.EndDate >= DateTime.UtcNow;
    var daysLeft = isActive ? (Model.EndDate - DateTime.UtcNow).Days : 0;
    var totalDays = (Model.EndDate - Model.StartDate).Days;
    var elapsedDays = (DateTime.UtcNow - Model.StartDate).Days;
    var timelinePercent = totalDays > 0 ? Math.Min(100, (int)((double)elapsedDays / totalDays * 100)) : 100;

    var assignedCount = Model.Stations?.Count ?? 0;
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
}

<style>
    .detail-header {
        border-radius: 12px;
        padding: 2rem;
        color: white;
        margin-bottom: 1.5rem;
    }
    .detail-header.active { background: linear-gradient(135deg, #2E9D54, #1a7a3b); }
    .detail-header.cancelled { background: linear-gradient(135deg, #ffc107, #fd7e14); color: #333; }
    .detail-header.expired { background: linear-gradient(135deg, #dc3545, #c82333); }

    .timeline-bar {
        height: 10px;
        border-radius: 5px;
        background: #e9ecef;
        overflow: hidden;
        margin: 0.5rem 0;
    }
    .timeline-bar .fill {
        height: 100%;
        border-radius: 5px;
        background: linear-gradient(90deg, #2E9D54, #47d176);
        transition: width 0.5s ease;
    }

    .detail-card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f4f4f4;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #6c757d; font-weight: 500; }
    .detail-value { font-weight: 600; text-align: right; }

    .station-chip {
        display: inline-flex;
        align-items: center;
        background: #f0f9f4;
        border: 1px solid #c3e6cb;
        border-radius: 20px;
        padding: 0.35rem 0.85rem;
        margin: 0.25rem;
        font-size: 0.85rem;
        font-weight: 500;
    }
    .station-chip i { color: #2E9D54; margin-right: 6px; }
</style>

<div class="section-header">
    <div class="section-header-back">
        <a href="/owner/subscription" class="btn btn-icon"><i class="fas fa-arrow-left"></i></a>
    </div>
    <h1>Subscription Details</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/owner/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item"><a href="/owner/subscription">Subscriptions</a></div>
        <div class="breadcrumb-item">Details</div>
    </div>
</div>

<!-- ─── Hero Header ────────────────────────────────────────────────── -->
<div class="detail-header @(isCancelled ? "cancelled" : (isExpired ? "expired" : "active"))">
    <div class="row align-items-center">
        <div class="col-12 col-md-8">
            <h2 class="mb-1">@(Model.Plan?.Name ?? "Unknown Plan")</h2>
            <p class="mb-0 opacity-80">@(Model.Plan?.Description ?? "")</p>
        </div>
        <div class="col-12 col-md-4 text-md-right mt-3 mt-md-0">
            <div style="font-size: 2.2rem; font-weight: 700;">₹@Model.AmountPaid.ToString("N0")</div>
            <span class="badge badge-light" style="font-size: 0.9rem;">
                @(isCancelled ? "Cancelled" : (isExpired ? "Expired" : (daysLeft <= 7 ? $"{daysLeft} Days Left" : "Active")))
            </span>
        </div>
    </div>
</div>

<div class="row">
    <!-- ─── Left Column: Subscription Info ─────────────────────────── -->
    <div class="col-12 col-md-6 mb-4">
        <div class="card detail-card">
            <div class="card-header"><h4>Plan Information</h4></div>
            <div class="card-body">
                <div class="detail-row">
                    <span class="detail-label">Plan Name</span>
                    <span class="detail-value">@(Model.Plan?.Name)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Max Stations</span>
                    <span class="detail-value">@maxStations</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Max Managers / Station</span>
                    <span class="detail-value">@(Model.Plan?.MaxManagersPerStation ?? 0)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Duration</span>
                    <span class="detail-value">@totalDays Days</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span class="detail-value">
                        @if (isActive) { <span class="badge badge-success">Active</span> }
                        else if (isCancelled) { <span class="badge badge-warning">Cancelled</span> }
                        else { <span class="badge badge-danger">Expired</span> }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Right Column: Payment Info ─────────────────────────────── -->
    <div class="col-12 col-md-6 mb-4">
        <div class="card detail-card">
            <div class="card-header"><h4>Payment Details</h4></div>
            <div class="card-body">
                <div class="detail-row">
                    <span class="detail-label">Payment ID</span>
                    <span class="detail-value text-monospace" style="font-size: 0.85rem;">@Model.PaymentId</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Amount Paid</span>
                    <span class="detail-value text-primary">₹@Model.AmountPaid.ToString("N2")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Start Date</span>
                    <span class="detail-value">@Model.StartDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">End Date</span>
                    <span class="detail-value">@Model.EndDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Purchased On</span>
                    <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Timeline Progress ──────────────────────────────────────────── -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card detail-card">
            <div class="card-header"><h4>Subscription Timeline</h4></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">@Model.StartDate.ToString("dd MMM yyyy")</small>
                    <small class="font-weight-bold">@(isActive ? $"{daysLeft} days remaining" : (isCancelled ? "Cancelled" : "Expired"))</small>
                    <small class="text-muted">@Model.EndDate.ToString("dd MMM yyyy")</small>
                </div>
                <div class="timeline-bar">
                    <div class="fill" style="width: @(timelinePercent)%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Assigned Stations ──────────────────────────────────────────── -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card detail-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Assigned Stations (@assignedCount / @maxStations)</h4>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit mr-1"></i> Edit Assignments
                    </a>
                }
            </div>
            <div class="card-body">
                @if (assignedCount == 0)
                {
                    <p class="text-muted text-center py-3">No stations are assigned to this subscription.</p>
                }
                else
                {
                    @foreach (var station in Model.Stations!)
                    {
                        <span class="station-chip">
                            <i class="fas fa-charging-station"></i> @station.Name — @station.City
                        </span>
                    }
                }
                
                <div class="mt-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Station Quota Usage</small>
                        <small class="font-weight-bold">@usagePercent%</small>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 4px;">
                        <div class="progress-bar @(usagePercent >= 100 ? "bg-danger" : "bg-success")" style="width: @usagePercent%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Action Buttons ─────────────────────────────────────────────── -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex flex-wrap" style="gap: 10px;">
            <a href="/owner/subscription/@Model.Id/receipt" class="btn btn-primary">
                <i class="fas fa-download mr-2"></i> Download Receipt
            </a>

            @if (isActive)
            {
                <a href="/owner/subscription/@Model.Id/assign" class="btn btn-info">
                    <i class="fas fa-tasks mr-2"></i> Manage Stations
                </a>

                <form method="post" action="/owner/subscription/@Model.Id/cancel" onsubmit="return confirm('Are you sure you want to cancel this subscription? All assigned stations will go offline immediately. No refund will be issued.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fas fa-times-circle mr-2"></i> Cancel Subscription
                    </button>
                </form>
            }
            else
            {
                <a href="/owner/subscription/plans" class="btn btn-success">
                    <i class="fas fa-sync-alt mr-2"></i> Buy New Plan
                </a>
            }
        </div>
    </div>
</div>
