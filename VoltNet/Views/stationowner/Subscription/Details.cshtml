@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var isNowExpired = Model.EndDate < DateTime.UtcNow && Model.Status != "Cancelled";
    var isPending = Model.Status == "CancellationPending";
    var isCancelled = Model.Status == "Cancelled";
    var isActive = Model.Status == "Active" && !isNowExpired;

    var daysLeft = isActive ? Math.Max(0, (Model.EndDate - DateTime.UtcNow).Days) : 0;
    var totalDays = Math.Max(1, (Model.EndDate - Model.StartDate).Days);
    var elapsedDays = Math.Max(0, (DateTime.UtcNow - Model.StartDate).Days);
    var timelinePercent = Math.Min(100, (int)((double)elapsedDays / totalDays * 100));

    var assignedCount = Model.Stations?.Count ?? 0;
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var quotaPercent = maxStations > 0 ? Math.Min(100, (int)((double)assignedCount / maxStations * 100)) : 0;

    var hoursSincePurchase = (DateTime.UtcNow - Model.CreatedAt).TotalHours;
    var canRequestCancel = isActive && hoursSincePurchase <= 24;
    var remainingCancelHours = Math.Max(0, (int)(24 - hoursSincePurchase));
}

<div class="section-header">
    <div class="section-header-back">
        <a href="/owner/subscription" class="btn btn-icon"><i class="fas fa-arrow-left"></i></a>
    </div>
    <h1>Subscription Details</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/owner/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item"><a href="/owner/subscription">Subscriptions</a></div>
        <div class="breadcrumb-item">Details</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-check-circle mr-2 font-18"></i>
            <div>@TempData["Success"]</div>
        </div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle mr-2 font-18"></i>
            <div>@TempData["Error"]</div>
        </div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- ─── Top Overview Card ─────────────────────────────────────────── -->
<div class="card mb-4" style="border: 1px solid #dce2eb; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
    <div class="card-body py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
            <div class="d-flex align-items-center mb-3 mb-md-0">
                <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" 
                     style="width: 58px; height: 58px; background: #eef2f7; color: #6777ef; font-size: 24px; flex-shrink: 0;">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center flex-wrap">
                        <h3 class="mb-1 font-weight-bold mr-3" style="color: #212529; font-size: 22px;">@(Model.Plan?.Name ?? "Custom Plan")</h3>
                        @if (isActive)
                        {
                            <span class="badge badge-success font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-check-circle mr-1"></i> Active
                            </span>
                        }
                        else if (isPending)
                        {
                            <span class="badge badge-warning font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-clock mr-1"></i> Cancellation Pending
                            </span>
                        }
                        else if (isCancelled)
                        {
                            <span class="badge badge-danger font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-ban mr-1"></i> Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-secondary font-weight-700 px-3 py-1 font-13">
                                <i class="fas fa-hourglass-end mr-1"></i> Expired
                            </span>
                        }
                    </div>
                    <div class="font-weight-600" style="color: #34395e; font-size: 14px;">
                        <span>₹@Model.AmountPaid.ToString("N0")</span>
                        <span class="text-muted mx-1">•</span>
                        <span>@(Model.Plan?.DurationDays ?? 30) Days Duration</span>
                        <span class="text-muted mx-1">•</span>
                        <span class="text-monospace">ID: @(Model.PaymentId?.Length > 16 ? Model.PaymentId[..16] + "..." : Model.PaymentId)</span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center" style="gap: 8px;">
                <a href="/owner/subscription/@Model.Id/receipt" class="btn btn-outline-secondary font-weight-600">
                    <i class="fas fa-download mr-1"></i> Receipt
                </a>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-primary font-weight-600">
                        <i class="fas fa-charging-station mr-1"></i> Manage Stations
                    </a>
                    @if (canRequestCancel)
                    {
                        <button type="button" class="btn btn-outline-danger font-weight-600" data-toggle="modal" data-target="#cancelModal">
                            <i class="fas fa-times-circle mr-1"></i> Request Cancellation
                        </button>
                    }
                }
                else
                {
                    <a href="/owner/subscription/plans" class="btn btn-primary font-weight-600">
                        <i class="fas fa-sync-alt mr-1"></i> Choose New Plan
                    </a>
                }
            </div>
        </div>

        @if (canRequestCancel)
        {
            <div class="alert alert-light mt-3 mb-0 py-2 px-3 d-flex align-items-center justify-content-between flex-wrap" 
                 style="background: #ffffff; border: 1px dashed #6777ef; border-radius: 6px;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt text-primary mr-2 font-16"></i>
                    <span class="font-weight-600" style="color: #212529; font-size: 13px;">
                        24-Hour Cancellation Eligible: You can request cancellation with a full refund within the next <strong>@remainingCancelHours hour(s)</strong>.
                    </span>
                </div>
                <button type="button" class="btn btn-sm btn-link text-danger font-weight-bold p-0" data-toggle="modal" data-target="#cancelModal">
                    Cancel Now
                </button>
            </div>
        }
    </div>
</div>

<div class="row">
    <!-- ─── Card 1: Plan Details & Quotas ─────────────────────────────── -->
    <div class="col-12 col-lg-6 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-primary">
                <i class="fas fa-layer-group"></i> Plan Tier & Quotas
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Plan Tier</span>
                <span class="detail-value">
                    <span class="badge badge-primary font-weight-700 font-14 px-3 py-1">@(Model.Plan?.Name ?? "Standard Plan")</span>
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Plan Price</span>
                <span class="detail-value font-weight-bold text-dark font-18">
                    ₹@(Model.Plan?.PricePerMonth.ToString("N0") ?? Model.AmountPaid.ToString("N0"))
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Duration Days</span>
                <span class="detail-value font-weight-bold text-dark font-15">
                    @(Model.Plan?.DurationDays ?? 30) Days
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Max Stations Allowed</span>
                <span class="detail-value font-weight-bold text-dark font-15">
                    <i class="fas fa-charging-station text-primary mr-1"></i> @(Model.Plan?.MaxStations ?? 0) Stations
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Max Managers / Station</span>
                <span class="detail-value font-weight-bold text-dark font-15">
                    <i class="fas fa-user-shield text-info mr-1"></i> @(Model.Plan?.MaxManagersPerStation ?? 0) Managers
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Plan?.Description))
            {
                <div class="detail-row mt-3">
                    <span class="detail-label">Plan Description</span>
                    <div class="detail-box mt-1">
                        @Model.Plan.Description
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ─── Card 2: Billing & Validity ───────────────────────────────── -->
    <div class="col-12 col-lg-6 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-success">
                <i class="fas fa-credit-card"></i> Billing & Validity
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Amount Paid</span>
                <span class="detail-value font-weight-bold text-success font-22">
                    ₹@Model.AmountPaid.ToString("N2")
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Payment ID</span>
                <span class="detail-value text-monospace font-weight-700 text-dark font-14">
                    @(Model.PaymentId ?? "N/A")
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Purchased On</span>
                <span class="detail-value font-weight-600 text-dark font-15">
                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Start Date</span>
                <span class="detail-value font-weight-600 text-dark font-15">
                    @Model.StartDate.ToString("dd MMM yyyy, hh:mm tt") UTC
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">End Date</span>
                <span class="detail-value font-weight-600 text-dark font-15">
                    @Model.EndDate.ToString("dd MMM yyyy, hh:mm tt") UTC
                </span>
            </div>

            <div class="detail-row detail-row-inline">
                <span class="detail-label">Validity Status</span>
                <span class="detail-value">
                    @if (isActive)
                    {
                        <span class="badge badge-success font-weight-700 font-13 px-3 py-1">
                            @daysLeft Days Remaining
                        </span>
                    }
                    else if (isPending)
                    {
                        <span class="badge badge-warning font-weight-700 font-13 px-3 py-1">
                            Pending Admin Review
                        </span>
                    }
                    else if (isCancelled)
                    {
                        <span class="badge badge-danger font-weight-700 font-13 px-3 py-1">
                            Cancelled & Inactive
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-secondary font-weight-700 font-13 px-3 py-1">
                            Plan Expired
                        </span>
                    }
                </span>
            </div>

            <!-- Timeline Bar -->
            <div class="mt-3 pt-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-700" style="font-size: 13px; color: #34395e;">Duration Timeline</span>
                    <span class="font-weight-700 font-13 text-dark">
                        @(isActive ? $"{daysLeft} days remaining" : (isCancelled ? "Cancelled" : "Expired"))
                    </span>
                </div>
                <div class="progress" style="height: 8px; border-radius: 4px; background-color: #e9ecef;">
                    <div class="progress-bar @(isCancelled ? "bg-danger" : (isNowExpired ? "bg-secondary" : (daysLeft <= 5 ? "bg-warning" : "bg-success")))" 
                         role="progressbar" style="width: @(timelinePercent)%;" aria-valuenow="@timelinePercent" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <small class="font-weight-600" style="color: #34395e;">@Model.StartDate.ToString("dd MMM yyyy")</small>
                    <small class="font-weight-600" style="color: #34395e;">@Model.EndDate.ToString("dd MMM yyyy")</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── Assigned Stations ──────────────────────────────────────────── -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="detail-card">
            <div class="detail-card-title text-primary d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    <i class="fas fa-charging-station"></i> 
                    <span>Assigned EV Stations</span>
                    <span class="badge badge-primary font-weight-700 font-13 ml-2">@assignedCount / @maxStations Assigned</span>
                </div>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-sm btn-outline-primary font-weight-600 mt-2 mt-sm-0">
                        <i class="fas fa-edit mr-1"></i> Edit Assigned Stations
                    </a>
                }
            </div>

            <!-- Quota Bar -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="font-weight-700" style="font-size: 13px; color: #34395e;">Station Quota Usage</span>
                    <span class="font-weight-700 font-13 text-dark">@quotaPercent% utilized</span>
                </div>
                <div class="progress" style="height: 8px; border-radius: 4px; background-color: #e9ecef;">
                    <div class="progress-bar @(quotaPercent >= 100 ? "bg-info" : "bg-primary")" 
                         role="progressbar" style="width: @quotaPercent%;" aria-valuenow="@quotaPercent" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
            </div>

            @if (Model.Stations == null || !Model.Stations.Any())
            {
                <div class="text-center py-4" style="background: #ffffff; border: 1px dashed #dce2eb; border-radius: 8px;">
                    <i class="fas fa-charging-station text-muted mb-2" style="font-size: 36px;"></i>
                    <h6 class="font-weight-bold text-dark mb-1">No EV Stations Currently Assigned</h6>
                    <p class="mb-3 font-weight-500" style="color: #34395e; font-size: 14px;">
                        Stations must be linked to this subscription to become active and visible for customer bookings.
                    </p>
                    @if (isActive)
                    {
                        <a href="/owner/subscription/@Model.Id/assign" class="btn btn-primary font-weight-600">
                            <i class="fas fa-plus mr-1"></i> Assign Stations Now
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var station in Model.Stations)
                    {
                        <div class="col-12 col-md-6 mb-3">
                            <div class="station-chip">
                                <div class="d-flex align-items-center" style="gap: 12px;">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 42px; height: 42px; background: #eef2f7; color: #6777ef; font-size: 18px; flex-shrink: 0;">
                                        <i class="fas fa-charging-station"></i>
                                    </div>
                                    <div>
                                        <strong>@station.Name</strong>
                                        <div class="font-weight-600" style="font-size: 13px; color: #34395e;">
                                            <i class="fas fa-map-marker-alt text-danger mr-1"></i> @station.City, @station.State
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    @if (station.Status == "Active")
                                    {
                                        <span class="badge badge-success font-weight-700 font-12">
                                            <i class="fas fa-check-circle mr-1"></i> Active
                                        </span>
                                    }
                                    else if (station.Status == "Approved")
                                    {
                                        <span class="badge badge-primary font-weight-700 font-12">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning font-weight-700 font-12">
                                            @station.Status
                                        </span>
                                    }
                                    <div>
                                        <a href="/owner/stations" class="btn btn-sm btn-link p-0 font-weight-600" style="font-size: 12px;">
                                            View Station &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ─── Cancellation & Refund Overview (If applicable) ─────────────── -->
@if (isPending || isCancelled || !string.IsNullOrWhiteSpace(Model.CancellationReason))
{
    <div class="row">
        <div class="col-12 mb-4">
            <div class="detail-card">
                <div class="detail-card-title text-danger">
                    <i class="fas fa-times-circle"></i> Cancellation & Refund Overview
                </div>

                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Request Status</span>
                            <span class="detail-value">
                                @if (isPending)
                                {
                                    <span class="badge badge-warning font-weight-700 font-14 px-3 py-1">
                                        <i class="fas fa-clock mr-1"></i> Pending Admin Approval
                                    </span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge badge-danger font-weight-700 font-14 px-3 py-1">
                                        <i class="fas fa-ban mr-1"></i> Approved & Cancelled
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Requested On</span>
                            <span class="detail-value font-weight-600 text-dark font-15">
                                @(Model.CancellationRequestedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A") UTC
                            </span>
                        </div>

                        <div class="detail-row detail-row-inline">
                            <span class="detail-label">Refund Amount</span>
                            <span class="detail-value font-weight-bold text-success font-18">
                                @(Model.RefundAmount.HasValue ? $"₹{Model.RefundAmount.Value:N2}" : "Pending Review")
                            </span>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-row">
                            <span class="detail-label">Cancellation Reason</span>
                            <div class="detail-box">
                                @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason specified" : Model.CancellationReason)
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks))
                        {
                            <div class="detail-row mt-3">
                                <span class="detail-label">Admin Remarks</span>
                                <div class="detail-box" style="border-left: 4px solid #6777ef;">
                                    @Model.CancellationAdminRemarks
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ─── Cancellation Request Modal ─────────────────────────────────── -->
@if (canRequestCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border: 1px solid #dce2eb; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
                <form method="post" action="/owner/subscription/@Model.Id/cancel" id="cancelSubForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header" style="border-bottom: 1px solid #edf0f5; padding: 20px 24px;">
                        <h5 class="modal-title font-weight-bold" id="cancelModalTitle" style="color: #212529; font-size: 18px;">
                            <i class="fas fa-shield-alt text-danger mr-2"></i> Request Subscription Cancellation
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body" style="padding: 24px;">
                        <div class="alert alert-light mb-3" style="border: 1px solid #dce2eb; border-left: 4px solid #fc544b; border-radius: 6px;">
                            <div class="font-weight-bold text-dark font-14 mb-1">24-Hour Purchase Guarantee</div>
                            <div class="font-weight-600" style="color: #34395e; font-size: 13px;">
                                You are requesting cancellation for <strong>@(Model.Plan?.Name)</strong> (Paid: ₹@Model.AmountPaid.ToString("N0")). 
                                Requests submitted within 24 hours of purchase are eligible for a full refund after Admin verification.
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label class="font-weight-bold" style="color: #212529; font-size: 14px;">
                                Cancellation Reason <span class="text-danger">*</span>
                            </label>
                            <textarea name="cancellationReason" id="reasonTextarea" class="form-control" rows="4" 
                                      placeholder="Please describe why you wish to cancel this plan (minimum 10 characters)..." 
                                      minlength="10" maxlength="500" required 
                                      style="border: 1px solid #dce2eb; border-radius: 6px; font-size: 14px; font-weight: 500;"></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted font-weight-600" id="charCounter">0 / 500 characters</small>
                                <small class="text-danger font-weight-bold" id="minCharWarning" style="display: none;">Minimum 10 characters required</small>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #edf0f5; padding: 16px 24px;">
                        <button type="button" class="btn btn-secondary font-weight-600" data-dismiss="modal">Keep Subscription</button>
                        <button type="submit" class="btn btn-danger font-weight-600" id="btnConfirmCancel">
                            <i class="fas fa-paper-plane mr-1"></i> Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var textarea = $('#reasonTextarea');
            var charCounter = $('#charCounter');
            var minWarning = $('#minCharWarning');
            var submitBtn = $('#btnConfirmCancel');

            if (textarea.length) {
                textarea.on('input', function() {
                    var len = $(this).val().trim().length;
                    charCounter.text(len + ' / 500 characters');
                    if (len > 0 && len < 10) {
                        minWarning.show();
                        submitBtn.prop('disabled', true);
                    } else {
                        minWarning.hide();
                        submitBtn.prop('disabled', false);
                    }
                });
            }
        });
    </script>
}
