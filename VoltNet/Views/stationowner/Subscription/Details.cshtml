@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var isNowExpired = Model.EndDate < DateTime.UtcNow && Model.Status != "Cancelled";
    var isPending = Model.Status == "CancellationPending";
    var isCancelled = Model.Status == "Cancelled";
    var isActive = Model.Status == "Active" && !isNowExpired;

    var daysLeft = isActive ? Math.Max(0, (Model.EndDate - DateTime.UtcNow).Days) : 0;
    var totalDays = Math.Max(1, (Model.EndDate - Model.StartDate).Days);
    var elapsedDays = Math.Max(0, (DateTime.UtcNow - Model.StartDate).Days);
    var timelinePercent = Math.Min(100, (int)((double)elapsedDays / totalDays * 100));

    var assignedCount = Model.Stations?.Count ?? 0;
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var quotaPercent = maxStations > 0 ? Math.Min(100, (int)((double)assignedCount / maxStations * 100)) : 0;

    var hoursSincePurchase = (DateTime.UtcNow - Model.CreatedAt).TotalHours;
    var canRequestCancel = isActive && hoursSincePurchase <= 24;
    var remainingCancelHours = Math.Max(0, (int)(24 - hoursSincePurchase));
}

<div class="row">
    <div class="col-12">
        <!-- ── Top Action & Summary Bar ── -->
        <div class="card card-primary shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="rounded p-2 bg-light mr-3 text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-layer-group fa-lg"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap">
                                <h5 class="text-dark font-weight-bold mb-0 mr-2">@(Model.Plan?.Name ?? "Plan Details")</h5>
                                @if (isActive)
                                {
                                    <span class="badge badge-success font-weight-700 px-2 py-1 font-11">Active</span>
                                }
                                else if (isPending)
                                {
                                    <span class="badge badge-warning text-dark font-weight-700 px-2 py-1 font-11">Review Pending</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge badge-danger font-weight-700 px-2 py-1 font-11">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary font-weight-700 px-2 py-1 font-11">Expired</span>
                                }
                            </div>
                            <small class="text-muted">
                                ₹@Model.AmountPaid.ToString("N0") &bull; @(Model.Plan?.DurationDays ?? 30) Days &bull; ID: <span class="font-mono text-dark">@(Model.PaymentId?.Length > 16 ? Model.PaymentId[..16] + "..." : Model.PaymentId)</span>
                            </small>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center" style="gap: 6px;">
                        <a href="/owner/subscription/@Model.Id/receipt" class="btn btn-outline-danger btn-sm font-weight-600">
                            <i class="fas fa-file-pdf mr-1"></i> PDF Receipt
                        </a>
                        @if (isActive)
                        {
                            <a href="/owner/subscription/@Model.Id/assign" class="btn btn-primary btn-sm font-weight-600">
                                <i class="fas fa-link mr-1"></i> Manage Stations
                            </a>
                            @if (canRequestCancel)
                            {
                                <button type="button" class="btn btn-outline-warning btn-sm font-weight-600 text-dark" data-toggle="modal" data-target="#cancelModal">
                                    <i class="fas fa-undo mr-1"></i> Cancel (@remainingCancelHours h left)
                                </button>
                            }
                        }
                        else
                        {
                            <a href="/owner/subscription/plans" class="btn btn-primary btn-sm font-weight-600">
                                <i class="fas fa-sync-alt mr-1"></i> Select Plan
                            </a>
                        }
                        <a href="/owner/subscription" class="btn btn-outline-secondary btn-sm font-weight-600">
                            <i class="fas fa-arrow-left mr-1"></i> Back
                        </a>
                    </div>
                </div>

                @if (canRequestCancel)
                {
                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 font-12 d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-clock mr-1"></i> 24-Hour Refund Active: Cancel within <strong>@remainingCancelHours hour(s)</strong> for a full refund.</span>
                        <a href="javascript:void(0)" class="text-danger font-weight-bold" data-toggle="modal" data-target="#cancelModal">Cancel Now</a>
                    </div>
                }
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3 font-13">
                <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 font-13">
                <i class="fas fa-exclamation-circle mr-1"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        <!-- ── Compact 2-Column Specs: Left=Plan Specs, Right=Billing/Schedule ── -->
        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <div class="card card-primary h-100 shadow-sm mb-0">
                    <div class="card-header py-2 px-3 bg-white border-bottom">
                        <h6 class="font-weight-bold text-dark mb-0 font-14">
                            <i class="fas fa-sliders-h text-primary mr-1"></i> Plan Specifications & Quota
                        </h6>
                    </div>
                    <div class="card-body p-3 font-13">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Tier Name</span>
                            <span class="font-weight-bold text-dark">@(Model.Plan?.Name ?? "Plan")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Monthly Rate</span>
                            <span class="font-weight-bold text-dark">₹@(Model.Plan?.PricePerMonth.ToString("N0") ?? Model.AmountPaid.ToString("N0"))</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Station Limit</span>
                            <span class="font-weight-bold text-primary">@maxStations Stations Max</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Managers / Station</span>
                            <span class="font-weight-bold text-dark">@(Model.Plan?.MaxManagersPerStation ?? 0) Managers</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted font-weight-600">Capacity Used</span>
                            <span class="font-weight-bold text-dark">@assignedCount of @maxStations (@quotaPercent%)</span>
                        </div>
                        <div class="progress mt-1" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @quotaPercent%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <div class="card card-primary h-100 shadow-sm mb-0">
                    <div class="card-header py-2 px-3 bg-white border-bottom">
                        <h6 class="font-weight-bold text-dark mb-0 font-14">
                            <i class="fas fa-receipt text-primary mr-1"></i> Billing & Validity Schedule
                        </h6>
                    </div>
                    <div class="card-body p-3 font-13">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Amount Paid</span>
                            <span class="font-weight-bold text-success font-15">₹@Model.AmountPaid.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Purchased On</span>
                            <span class="font-weight-600 text-dark">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Validity Period</span>
                            <span class="font-weight-600 text-dark">@Model.StartDate.ToString("dd MMM yyyy") &mdash; @Model.EndDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted font-weight-600">Status</span>
                            <span>
                                @if (isActive)
                                {
                                    <span class="badge badge-success px-2 py-0 font-11">@daysLeft Days Remaining</span>
                                }
                                else if (isPending)
                                {
                                    <span class="badge badge-warning text-dark px-2 py-0 font-11">Review Pending</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-0 font-11">Expired</span>
                                }
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted font-weight-600">Timeline</span>
                            <small class="text-muted">@timelinePercent% elapsed</small>
                        </div>
                        <div class="progress mt-1" style="height: 6px;">
                            <div class="progress-bar @(isCancelled ? "bg-danger" : (isNowExpired ? "bg-secondary" : (daysLeft <= 5 ? "bg-warning" : "bg-success")))" role="progressbar" style="width: @timelinePercent%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Assigned Stations Table / Grid ── -->
        <div class="card card-primary shadow-sm mb-3">
            <div class="card-header py-2 px-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="font-weight-bold text-dark mb-0 font-14">
                    <i class="fas fa-charging-station text-primary mr-1"></i> Assigned EV Stations (@assignedCount / @maxStations)
                </h6>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-outline-primary btn-sm py-1 font-12 font-weight-600">
                        <i class="fas fa-link mr-1"></i> Edit Linkings
                    </a>
                }
            </div>
            <div class="card-body p-3">
                @if (Model.Stations == null || !Model.Stations.Any())
                {
                    <div class="text-center py-4 bg-light rounded border">
                        <i class="fas fa-charging-station text-muted mb-2 font-24"></i>
                        <h6 class="text-dark font-weight-bold mb-1 font-13">No Stations Linked Yet</h6>
                        <small class="text-muted d-block mb-2">Link stations to publish them for driver bookings.</small>
                        @if (isActive)
                        {
                            <a href="/owner/subscription/@Model.Id/assign" class="btn btn-primary btn-sm font-weight-600">
                                <i class="fas fa-plus mr-1"></i> Link Stations Now
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover border mb-0 font-13">
                            <thead class="bg-light">
                                <tr>
                                    <th>Station Name</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var st in Model.Stations)
                                {
                                    <tr>
                                        <td class="font-weight-bold text-dark">
                                            <i class="fas fa-gas-pump text-primary mr-1"></i> @st.Name
                                        </td>
                                        <td class="text-muted">
                                            <i class="fas fa-map-marker-alt text-danger mr-1"></i> @st.City, @st.State
                                        </td>
                                        <td>
                                            @if (st.Status == "Active")
                                            {
                                                <span class="badge badge-success px-2 py-0 font-11">Active</span>
                                            }
                                            else if (st.Status == "Approved")
                                            {
                                                <span class="badge badge-primary px-2 py-0 font-11">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning text-dark px-2 py-0 font-11">@st.Status</span>
                                            }
                                        </td>
                                        <td class="text-right">
                                            <a href="/owner/stations" class="btn btn-sm btn-link p-0 font-12 font-weight-600">View &rarr;</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- ── Cancellation Details (Only if applicable) ── -->
        @if (isPending || isCancelled || !string.IsNullOrWhiteSpace(Model.CancellationReason))
        {
            <div class="card border-danger shadow-sm mb-3">
                <div class="card-header py-2 px-3 bg-light border-bottom text-danger font-weight-bold font-14">
                    <i class="fas fa-info-circle mr-1"></i> Cancellation & Refund Status
                </div>
                <div class="card-body p-3 font-13">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span class="text-muted">Status</span>
                                <span class="font-weight-bold @(isCancelled ? "text-danger" : "text-warning")">
                                    @(isCancelled ? "Approved & Cancelled" : "Pending Admin Review")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span class="text-muted">Requested On</span>
                                <span class="font-weight-600 text-dark">@(Model.CancellationRequestedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A")</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Refund Amount</span>
                                <span class="font-weight-bold text-success font-15">@(Model.RefundAmount.HasValue ? $"₹{Model.RefundAmount.Value:N2}" : "Pending Review")</span>
                            </div>
                        </div>
                        <div class="col-md-6 mt-2 mt-md-0">
                            <label class="font-weight-600 text-dark mb-1">Reason Provided:</label>
                            <div class="p-2 bg-light rounded border text-muted small">
                                @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason specified" : Model.CancellationReason)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.CancellationAdminRemarks))
                            {
                                <label class="font-weight-600 text-dark mt-2 mb-1">Admin Remarks:</label>
                                <div class="p-2 bg-light rounded border-left border-primary text-dark small">
                                    @Model.CancellationAdminRemarks
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ── Cancellation Modal ── -->
@if (canRequestCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow">
                <form method="post" action="/owner/subscription/@Model.Id/cancel">
                    @Html.AntiForgeryToken()
                    <div class="modal-header py-3 px-4 border-bottom">
                        <h6 class="modal-title font-weight-bold text-dark mb-0">
                            <i class="fas fa-undo text-danger mr-1"></i> Cancel Subscription
                        </h6>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body p-4 font-13">
                        <div class="alert alert-warning py-2 px-3 mb-3 font-12">
                            <strong>24h Guarantee:</strong> Requesting cancellation for <strong>@(Model.Plan?.Name)</strong> (₹@Model.AmountPaid.ToString("N0")). Eligible for full refund after verification.
                        </div>
                        <div class="form-group mb-0">
                            <label class="font-weight-600 text-dark font-13 mb-1">Reason for Cancellation <span class="text-danger">*</span></label>
                            <textarea name="cancellationReason" id="reasonTextarea" class="form-control font-13" rows="3" minlength="10" maxlength="500" required placeholder="Brief reason (minimum 10 characters)..."></textarea>
                            <small class="text-muted d-block mt-1 font-11" id="charCounter">0 / 500 characters</small>
                        </div>
                    </div>
                    <div class="modal-footer py-2 px-4 bg-light d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Keep Plan</button>
                        <button type="submit" class="btn btn-danger btn-sm font-weight-bold" id="btnConfirmCancel" disabled>
                            Confirm Cancellation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var textarea = $('#reasonTextarea');
            var charCounter = $('#charCounter');
            var submitBtn = $('#btnConfirmCancel');

            if (textarea.length) {
                textarea.on('input', function() {
                    var len = $(this).val().trim().length;
                    charCounter.text(len + ' / 500 characters');
                    submitBtn.prop('disabled', len < 10);
                });
            }
        });
    </script>
}
