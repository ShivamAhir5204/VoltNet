@model VoltNet.Models.OwnerSubscription
@{
    ViewData["Title"] = "Subscription Details";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";

    var isCancelled = Model.Status == "Cancelled";
    var isExpired = Model.EndDate < DateTime.UtcNow && !isCancelled;
    var isActive = Model.Status == "Active" && Model.EndDate >= DateTime.UtcNow;
    var daysLeft = isActive ? (Model.EndDate - DateTime.UtcNow).Days : 0;
    var totalDays = (Model.EndDate - Model.StartDate).Days;
    var elapsedDays = (DateTime.UtcNow - Model.StartDate).Days;
    var timelinePercent = totalDays > 0 ? Math.Min(100, (int)((double)elapsedDays / totalDays * 100)) : 100;

    var assignedCount = Model.Stations?.Count ?? 0;
    var maxStations = Model.Plan?.MaxStations ?? 0;
    var usagePercent = maxStations > 0 ? (int)((double)assignedCount / maxStations * 100) : 0;
    var cardBorderClass = isCancelled ? "card-warning" : (isExpired ? "card-danger" : "card-success");
    var badgeClass = isCancelled ? "badge-warning text-dark" : (isExpired ? "badge-danger" : "badge-success");
}

<div class="mb-4">
    <a href="/owner/subscription" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fas fa-arrow-left mr-1"></i> Back to Subscriptions
    </a>
</div>

<!-- Hero Card -->
<div class="card @cardBorderClass shadow-sm mb-4">
    <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <div>
            <h3 class="font-weight-bold text-dark mb-1">@(Model.Plan?.Name ?? "Subscription Plan")</h3>
            <p class="text-muted small mb-0">@(Model.Plan?.Description ?? "Active charging network plan")</p>
        </div>
        <div class="text-sm-right mt-3 mt-sm-0">
            <div class="h2 font-weight-bold text-primary mb-0">₹@Model.AmountPaid.ToString("N0")</div>
            <span class="badge @badgeClass">
                @(isCancelled ? "Cancelled" : (isExpired ? "Expired" : (daysLeft <= 7 ? $"{daysLeft} Days Left" : "Active")))
            </span>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Subscription Info -->
    <div class="col-12 col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-info-circle text-primary mr-2"></i>Plan Information</h4>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Plan Name</span>
                        <strong class="text-dark">@(Model.Plan?.Name)</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Max Stations</span>
                        <span class="badge badge-light border font-weight-bold">@maxStations</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Max Managers / Station</span>
                        <span class="badge badge-light border font-weight-bold">@(Model.Plan?.MaxManagersPerStation ?? 0)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Duration</span>
                        <span class="text-dark font-weight-bold">@totalDays Days</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Status</span>
                        <span class="badge @badgeClass">
                            @(isCancelled ? "Cancelled" : (isExpired ? "Expired" : "Active"))
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Column: Payment Info -->
    <div class="col-12 col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-receipt text-success mr-2"></i>Payment Details</h4>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Payment ID</span>
                        <span class="badge badge-light border">@Model.PaymentId</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Amount Paid</span>
                        <strong class="text-success h5 mb-0">₹@Model.AmountPaid.ToString("N2")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Start Date</span>
                        <span class="text-dark font-weight-bold">@Model.StartDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">End Date</span>
                        <span class="text-dark font-weight-bold">@Model.EndDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-muted">Purchased On</span>
                        <span class="text-dark font-weight-bold">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Timeline Progress -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-clock text-info mr-2"></i>Subscription Timeline</h4>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">@Model.StartDate.ToString("dd MMM yyyy")</span>
                    <span class="font-weight-bold text-dark small">@(isActive ? $"{daysLeft} days remaining" : (isCancelled ? "Cancelled" : "Expired"))</span>
                    <span class="text-muted small">@Model.EndDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(timelinePercent)%;" aria-valuenow="@timelinePercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Assigned Stations -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                <h4 class="font-weight-bold text-dark mb-2 mb-sm-0">
                    <i class="fas fa-charging-station text-warning mr-2"></i>Assigned Stations (@assignedCount / @maxStations)
                </h4>
                @if (isActive)
                {
                    <a href="/owner/subscription/@Model.Id/assign" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit mr-1"></i> Edit Assignments
                    </a>
                }
            </div>
            <div class="card-body">
                @if (assignedCount == 0)
                {
                    <div class="text-center py-4 bg-light rounded">
                        <p class="text-muted mb-0">No stations are assigned to this subscription.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap mb-3">
                        @foreach (var station in Model.Stations!)
                        {
                            <span class="badge badge-light border p-2 mr-2 mb-2 font-weight-normal text-dark">
                                <i class="fas fa-charging-station text-primary mr-1"></i> <strong>@station.Name</strong> — @station.City
                            </span>
                        }
                    </div>
                }
                
                <div class="mt-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small font-weight-bold">Station Quota Usage</span>
                        <span class="font-weight-bold text-dark small">@usagePercent%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar @(usagePercent >= 100 ? "bg-danger" : "bg-success")" role="progressbar" style="width: @usagePercent%" aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex flex-wrap">
            <a href="/owner/subscription/@Model.Id/receipt" class="btn btn-primary mr-2 mb-2">
                <i class="fas fa-download mr-1"></i> Download Receipt
            </a>

            @if (isActive)
            {
                <a href="/owner/subscription/@Model.Id/assign" class="btn btn-info mr-2 mb-2">
                    <i class="fas fa-tasks mr-1"></i> Manage Stations
                </a>

                <form method="post" action="/owner/subscription/@Model.Id/cancel" class="d-inline mr-2 mb-2" onsubmit="return confirm('Are you sure you want to cancel this subscription? All assigned stations will go offline immediately. No refund will be issued.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fas fa-times-circle mr-1"></i> Cancel Subscription
                    </button>
                </form>
            }
            else
            {
                <a href="/owner/subscription/plans" class="btn btn-success mr-2 mb-2">
                    <i class="fas fa-sync-alt mr-1"></i> Buy New Plan
                </a>
            }
        </div>
    </div>
</div>
