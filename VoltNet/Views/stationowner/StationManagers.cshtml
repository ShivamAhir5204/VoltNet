@model IEnumerable<VoltNet.Models.StationManager>

@{
    ViewData["Title"] = "Station Managers";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="sm">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Station Managers</h4>
        <a href="/owner/station-managers/Create" class="btn btn-main"><i class="fas fa-plus"></i> Add Manager</a>
      </div>
      <div class="card-body">
        @if (!Model.Any())
        {
          <div class="empty-box" style="margin-top:16px">No station managers.</div>
        }
        else
        {
          <div class="table-responsive">
            <table class="table table-striped align-middle table-responsive-cards" id="table-1">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Station</th>
                  <th>Rate Permission</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var mgr in Model)
                {
                  <tr>
                    <td class="col-primary" data-label="Name">
                      <div class="d-flex align-items-center justify-content-between">
                        <span class="cell-strong">@mgr.FullName</span>
                        <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                          <i data-feather="chevron-down"></i>
                        </button>
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Email"><div>@(mgr.User?.Email ?? "—")</div></td>
                    <td class="col-secondary" data-label="Phone"><div>@mgr.Phone</div></td>
                    <td class="col-secondary" data-label="Assigned Station"><div><span class="status s-plain">@(mgr.Station?.Name ?? "Unassigned")</span></div></td>
                    <td class="col-secondary" data-label="Rate Permission">
                      <div>
                        @if (mgr.CanManageRates)
                        {
                          <span class="status s-teal">Allowed</span>
                        }
                        else
                        {
                          <span class="status s-plain">Locked</span>
                        }
                      </div>
                    </td>
                    <td data-label="Status">
                      <div>
                        @if (mgr.IsActive)
                        {
                          <span class="status s-ok">Active</span>
                        }
                        else
                        {
                          <span class="status s-err">Inactive</span>
                        }
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Created"><div>@mgr.CreatedAt.ToString("dd MMM yyyy")</div></td>
                    <td class="text-center col-action" data-label="Actions">
                      <div class="row-actions">
                        <a href="/owner/station-managers/Edit/@mgr.Id" class="chip-btn chip-btn-edit" title="Edit Manager">
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <form asp-action="ToggleRatePermission" method="post">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="chip-btn @(mgr.CanManageRates ? "chip-btn-off" : "chip-btn-on")" title="@(mgr.CanManageRates ? "Revoke rate permission" : "Grant rate permission")">
                            <i class="fas @(mgr.CanManageRates ? "fa-lock" : "fa-unlock")"></i> @(mgr.CanManageRates ? "Lock" : "Allow Rates")
                          </button>
                        </form>
                        @if (mgr.IsActive)
                        {
                          <form asp-action="Deactivate" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@mgr.Id" />
                            <button type="submit" class="icon-btn icon-btn-off" onclick="return confirm('Deactivate this manager?');" title="Deactivate" aria-label="Deactivate">
                              <i class="fas fa-ban"></i>
                            </button>
                          </form>
                        }
                        else
                        {
                          <form asp-action="Activate" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@mgr.Id" />
                            <button type="submit" class="icon-btn icon-btn-approve" onclick="return confirm('Activate this manager?');" title="Activate" aria-label="Activate">
                              <i class="fas fa-check"></i>
                            </button>
                          </form>
                        }
                        <form asp-action="Delete" method="post">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="icon-btn icon-btn-delete" onclick="return confirm('Delete manager \'@mgr.FullName\'?');" title="Delete" aria-label="Delete">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>
</div>

</div>