@model IEnumerable<VoltNet.Models.StationManager>

@{
    ViewData["Title"] = "Station Managers";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <h4 class="mb-0">Station Managers</h4>
        <a href="/owner/station-managers/Create" class="btn btn-primary mt-2 mt-sm-0">
          <i class="fas fa-plus"></i> Create New Manager
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle" id="table-1">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Station</th>
                <th>Rate Edit Permission</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-center" style="min-width: 320px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var mgr in Model)
              {
                <tr>
                  <td class="font-weight-bold">@mgr.FullName</td>
                  <td>@(mgr.User?.Email ?? "—")</td>
                  <td>@mgr.Phone</td>
                  <td>@(mgr.Station?.Name ?? "—")</td>
                  <td>
                    @if (mgr.CanManageRates)
                    {
                      <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> Allowed</span>
                    }
                    else
                    {
                      <span class="badge badge-light border text-muted"><i class="fas fa-lock mr-1"></i> Restricted</span>
                    }
                  </td>
                  <td>
                    @if (mgr.IsActive)
                    {
                      <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                      <span class="badge badge-danger">Inactive</span>
                    }
                  </td>
                  <td>@mgr.CreatedAt.ToString("dd MMM yyyy")</td>
                  <td class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center flex-wrap">
                      <a href="/owner/station-managers/Edit/@mgr.Id" class="btn btn-warning btn-sm mr-1 mb-1" title="Edit Manager">
                        <i class="fas fa-edit mr-1"></i> Edit
                      </a>
                      <form asp-action="ToggleRatePermission" method="post" class="d-inline mr-1 mb-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@mgr.Id" />
                        <button type="submit" class="btn @(mgr.CanManageRates ? "btn-outline-danger" : "btn-outline-success") btn-sm" title="@(mgr.CanManageRates ? "Revoke rate permission" : "Grant rate permission")">
                          <i class="fas @(mgr.CanManageRates ? "fa-lock" : "fa-unlock") mr-1"></i> @(mgr.CanManageRates ? "Lock Rates" : "Allow Rates")
                        </button>
                      </form>
                      @if (mgr.IsActive)
                      {
                        <form asp-action="Deactivate" method="post" class="d-inline mr-1 mb-1">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Deactivate this manager?');" title="Deactivate">
                            <i class="fas fa-ban mr-1"></i> Deactivate
                          </button>
                        </form>
                      }
                      else
                      {
                        <form asp-action="Activate" method="post" class="d-inline mr-1 mb-1">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Activate this manager?');" title="Activate">
                            <i class="fas fa-check mr-1"></i> Activate
                          </button>
                        </form>
                      }
                      <form asp-action="Delete" method="post" class="d-inline mb-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@mgr.Id" />
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to permanently delete manager \'@mgr.FullName\'?');" title="Delete">
                          <i class="fas fa-trash mr-1"></i> Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
