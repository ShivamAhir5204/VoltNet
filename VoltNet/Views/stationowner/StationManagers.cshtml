@model IEnumerable<VoltNet.Models.StationManager>

@{
    ViewData["Title"] = "Station Managers";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
  <div class="col-12">
    <div class="card card-otika">
      <div class="card-header card-otika-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h4 class="mb-0 text-dark-slate font-weight-700">
            <i class="fas fa-user-tie text-otika-primary mr-2"></i> Station Managers
          </h4>
        </div>
        <a href="/owner/station-managers/Create" class="btn btn-otika-primary mt-2 mt-sm-0">
          <i class="fas fa-plus mr-1"></i> Add Manager
        </a>
      </div>
      <div class="card-body">
        @if (!Model.Any())
        {
          <div class="text-center py-5 bg-soft-grey rounded border-otika">
            <i class="fas fa-user-shield text-muted-slate mb-3" style="font-size: 38px;"></i>
            <h6 class="text-dark-slate font-weight-bold mb-1">No Station Managers</h6>
            <small class="text-muted-slate">Assign managers to run day-to-day operations and charging sessions.</small>
          </div>
        }
        else
        {
          <div class="table-responsive">
            <table class="table table-striped otika-table align-middle table-responsive-cards" id="table-1">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Assigned Station</th>
                  <th>Rate Permission</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th class="text-center" style="min-width: 280px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var mgr in Model)
                {
                  <tr>
                    <td class="col-primary" data-label="Name">
                      <div class="d-flex align-items-center justify-content-between">
                        <span class="font-weight-bold text-dark-slate">@mgr.FullName</span>
                        <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                          <i data-feather="chevron-down"></i>
                        </button>
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Email"><div class="text-dark-slate">@(mgr.User?.Email ?? "—")</div></td>
                    <td class="col-secondary" data-label="Phone"><div class="text-muted-slate">@mgr.Phone</div></td>
                    <td class="col-secondary" data-label="Assigned Station">
                      <div>
                        <span class="badge badge-light border text-dark-slate font-weight-600">
                          <i class="fas fa-charging-station text-otika-primary mr-1"></i> @(mgr.Station?.Name ?? "Unassigned")
                        </span>
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Rate Permission">
                      <div>
                        @if (mgr.CanManageRates)
                        {
                          <span class="badge badge-otika-teal"><i class="fas fa-check mr-1"></i> Allowed</span>
                        }
                        else
                        {
                          <span class="badge badge-light border text-muted-slate"><i class="fas fa-lock mr-1"></i> Locked</span>
                        }
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Status">
                      <div>
                        @if (mgr.IsActive)
                        {
                          <span class="badge badge-otika-success">Active</span>
                        }
                        else
                        {
                          <span class="badge badge-otika-error">Inactive</span>
                        }
                      </div>
                    </td>
                    <td class="col-secondary" data-label="Created"><div class="text-muted-slate small">@mgr.CreatedAt.ToString("dd MMM yyyy")</div></td>
                    <td class="text-center col-action" data-label="Actions">
                      <div class="d-inline-flex align-items-center justify-content-center flex-nowrap" style="gap: 4px;">
                        <a href="/owner/station-managers/Edit/@mgr.Id" class="btn btn-warning btn-sm" title="Edit Manager">
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <form asp-action="ToggleRatePermission" method="post" class="d-inline mb-0">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="btn @(mgr.CanManageRates ? "btn-outline-danger" : "btn-outline-success") btn-sm" title="@(mgr.CanManageRates ? "Revoke rate permission" : "Grant rate permission")">
                            <i class="fas @(mgr.CanManageRates ? "fa-lock" : "fa-unlock")"></i> @(mgr.CanManageRates ? "Lock" : "Allow Rates")
                          </button>
                        </form>
                        @if (mgr.IsActive)
                        {
                          <form asp-action="Deactivate" method="post" class="d-inline mb-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@mgr.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Deactivate this manager?');" title="Deactivate">
                              <i class="fas fa-ban"></i>
                            </button>
                          </form>
                        }
                        else
                        {
                          <form asp-action="Activate" method="post" class="d-inline mb-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@mgr.Id" />
                            <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Activate this manager?');" title="Activate">
                              <i class="fas fa-check"></i>
                            </button>
                          </form>
                        }
                        <form asp-action="Delete" method="post" class="d-inline mb-0">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@mgr.Id" />
                          <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete manager \'@mgr.FullName\'?');" title="Delete">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>
</div>
