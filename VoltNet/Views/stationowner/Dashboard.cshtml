@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="db">

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-xl-4 col-md-6 col-12 gap-b">
        <div class="card kpi kpi-indigo">
            <div class="kpi-icon"><i class="fas fa-charging-station"></i></div>
            <div>
                <div class="kpi-label">My Stations</div>
                <div class="kpi-value">@(ViewBag.TotalStations ?? 0)</div>
                <div class="kpi-note"><b>@(ViewBag.ActiveStations ?? 0)</b> Active</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 col-12 gap-b">
        <div class="card kpi kpi-warn">
            <div class="kpi-icon"><i class="fas fa-clock"></i></div>
            <div>
                <div class="kpi-label">Pending</div>
                <div class="kpi-value">@(ViewBag.PendingStations ?? 0)</div>
                <div class="kpi-note">Verification</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 col-12 gap-b">
        <div class="card kpi kpi-teal">
            <div class="kpi-icon"><i class="fas fa-users"></i></div>
            <div>
                <div class="kpi-label">Managers</div>
                <div class="kpi-value">@(ViewBag.TotalManagers ?? 0)</div>
                <div class="kpi-note"><b>@(ViewBag.ActiveManagers ?? 0)</b> Active</div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.RecentStations != null)
{
<div class="row">
    <div class="col-12">
        <div class="card gap-b">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>Recent Stations</h4>
                <a href="/owner/stations" class="btn btn-main">View All</a>
            </div>
            <div class="card-body flush">
                <div class="table-responsive">
                    <table class="table table-striped align-middle no-datatable table-responsive-cards">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>City</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var station in (List<VoltNet.Models.Station>)ViewBag.RecentStations)
                            {
                                <tr>
                                    <td class="col-primary" data-label="Name">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="cell-strong">@station.Name</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="City"><div>@station.City</div></td>
                                    <td data-label="Status">
                                        <div>
                                            @if (station.Status == "Active")
                                            {
                                                <span class="status s-ok">Active</span>
                                            }
                                            else if (station.Status == "PendingVerification")
                                            {
                                                <span class="status s-warn">Pending</span>
                                            }
                                            else if (station.Status == "Rejected")
                                            {
                                                <span class="status s-err">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="status s-plain">@station.Status</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Created"><div>@station.CreatedAt.ToString("dd MMM yyyy")</div></td>
                                    <td class="text-center col-action" data-label="Action">
                                        <div>
                                            <a href="/owner/stations/Edit/@station.Id" class="btn btn-edit" title="Edit Station">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
}

</div>