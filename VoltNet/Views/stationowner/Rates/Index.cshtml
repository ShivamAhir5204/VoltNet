@model IEnumerable<VoltNet.Models.ChargingRate>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var availableConnectors = ViewBag.AvailableConnectors as List<string> ?? new List<string>();
    var stationChargers = station?.Chargers?.OrderBy(c => c.Name).ToList() ?? new List<VoltNet.Models.Charger>();

    // Identify active configured connector types so we only show types that are NOT yet added
    var activeConfiguredTypes = Model.Where(r => r.IsActive).Select(r => r.ConnectorType.Trim()).ToList();
    var unconfiguredInstalledConnectors = availableConnectors
        .Where(c => !activeConfiguredTypes.Any(act => act.Equals(c, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    var allStandardTypes = new[] { "CCS2", "Type 2", "Type 2 (AC)", "CHAdeMO", "GB/T", "15A Domestic", "15A Domestic (3-Pin)", "Type 1", "DC Fast" };
    var unconfiguredStandardTypes = allStandardTypes
        .Where(std => !activeConfiguredTypes.Any(act => act.Equals(std, StringComparison.OrdinalIgnoreCase)) &&
                      !unconfiguredInstalledConnectors.Any(inst => inst.Equals(std, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    ViewData["Title"] = $"Charging Rates - {station?.Name}";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="rt-page">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <h4>Charging Rates — @(station?.Name)</h4>
                <div class="header-actions">
                    <button type="button" class="btn btn-main" data-toggle="modal" data-target="#addRateModal">
                        <i class="fas fa-plus"></i> Add Rate
                    </button>
                    <a href="/owner/rates" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
                </div>
            </div>
            <div class="card-body">

                <!-- Summary tiles -->
                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <div class="kpi kpi-indigo">
                            <div class="kpi-icon"><i class="fas fa-plug"></i></div>
                            <div class="kpi-text">
                                <div class="kpi-label">Chargers</div>
                                <div class="kpi-value">@stationChargers.Count</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <div class="kpi kpi-green">
                            <div class="kpi-icon"><i class="fas fa-check"></i></div>
                            <div class="kpi-text">
                                <div class="kpi-label">Active Rates</div>
                                <div class="kpi-value">@Model.Count(r => r.IsActive)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <div class="kpi kpi-teal">
                            <div class="kpi-icon"><i class="fas fa-tag"></i></div>
                            <div class="kpi-text">
                                <div class="kpi-label">Starting Price</div>
                                <div class="kpi-value">
                                    @if (Model.Any(r => r.IsActive))
                                    {
                                        <span>₹@Model.Where(r => r.IsActive).Min(r => r.RatePerKwh).ToString("F2") <small>/ kWh</small></span>
                                    }
                                    else
                                    {
                                        <span class="cell-muted">Not Set</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── SECTION 1: Charger Points & Their Assigned Charging Rates ── -->
                <hr class="divider" />
                <div>
                    <h5 class="section-title">Charger Points</h5>

                    @if (!stationChargers.Any())
                    {
                        <div class="empty-box">No chargers installed yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle no-datatable table-responsive-cards">
                                <thead>
                                    <tr>
                                        <th>Charger</th>
                                        <th>Connector</th>
                                        <th>Power</th>
                                        <th>Status</th>
                                        <th>Rate</th>
                                        <th>Hourly Fee</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var charger in stationChargers)
                                    {
                                        var mappedRate = Model.FirstOrDefault(r => r.IsActive && r.ConnectorType.Equals(charger.ConnectorType.Trim(), StringComparison.OrdinalIgnoreCase));
                                        <tr>
                                            <td class="col-primary" data-label="Charger">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span class="cell-strong">@charger.Name</span>
                                                    <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                        <i data-feather="chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Connector">
                                                <div><span class="status status-teal">@charger.ConnectorType</span></div>
                                            </td>
                                            <td class="col-secondary" data-label="Power">
                                                <div class="cell-strong">@charger.CapacityKw kW</div>
                                            </td>
                                            <td data-label="Status">
                                                <div>
                                                    @if (charger.Status == "Active")
                                                    {
                                                        <span class="status status-success">Active</span>
                                                    }
                                                    else if (charger.Status == "Maintenance")
                                                    {
                                                        <span class="status status-warn">Maintenance</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status status-plain">@charger.Status</span>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="Rate">
                                                <div>
                                                    @if (mappedRate != null)
                                                    {
                                                        <span class="cell-money">₹@mappedRate.RatePerKwh.ToString("F2") / kWh</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status status-error">Rate Not Set</span>
                                                        <button type="button" class="chip-btn chip-btn-edit ml-1" onclick="openAddRateForConnector('@charger.ConnectorType')">
                                                            Set Rate
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Hourly Fee">
                                                <div>
                                                    @if (mappedRate != null && mappedRate.RatePerHour.HasValue && mappedRate.RatePerHour.Value > 0)
                                                    {
                                                        <span class="cell-strong">₹@mappedRate.RatePerHour.Value.ToString("F2") / hr</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="cell-muted">—</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- ── SECTION 2: Active Rate Tariffs by Connector Type ── -->
                <hr class="divider" />
                <div>
                    <h5 class="section-title">Rates by Connector</h5>

                    @if (!Model.Any())
                    {
                        <div class="empty-box">
                            No rates configured.
                            <div>
                                <button type="button" class="btn btn-main" data-toggle="modal" data-target="#addRateModal">
                                    <i class="fas fa-plus"></i> Add First Rate
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle no-datatable table-responsive-cards" id="table-1">
                                <thead>
                                    <tr>
                                        <th>Connector</th>
                                        <th>Rate (per kWh)</th>
                                        <th>Hourly Fee</th>
                                        <th>Status</th>
                                        <th>Updated</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rate in Model)
                                    {
                                        <tr>
                                            <td class="col-primary" data-label="Connector">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span class="status status-teal">@rate.ConnectorType</span>
                                                    <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                        <i data-feather="chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td data-label="Rate (per kWh)">
                                                <div>
                                                    <span class="cell-money">₹@rate.RatePerKwh.ToString("F2")</span>
                                                    <span class="cell-muted">/ kWh</span>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Hourly Fee">
                                                <div>
                                                    @if (rate.RatePerHour.HasValue && rate.RatePerHour.Value > 0)
                                                    {
                                                        <span class="cell-strong">₹@rate.RatePerHour.Value.ToString("F2")</span>
                                                        <span class="cell-muted">/ hr</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="cell-muted">—</span>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="Status">
                                                <div>
                                                    @if (rate.IsActive)
                                                    {
                                                        <span class="status status-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status status-plain">Inactive</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Updated">
                                                <div class="cell-muted">
                                                    @(rate.UpdatedAt?.ToString("dd MMM yyyy") ?? rate.CreatedAt.ToString("dd MMM yyyy"))
                                                </div>
                                            </td>
                                            <td class="text-center col-action" data-label="Actions">
                                                <div class="row-actions">
                                                    <button type="button" class="chip-btn chip-btn-edit"
                                                            onclick="openEditRateModal('@rate.Id', '@rate.ConnectorType', '@rate.RatePerKwh', '@(rate.RatePerHour ?? 0)')"
                                                            title="Edit Rate">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <form asp-action="ToggleStatus" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@rate.Id" />
                                                        <button type="submit" class="chip-btn @(rate.IsActive ? "chip-btn-off" : "chip-btn-on")"
                                                                title="@(rate.IsActive ? "Deactivate rate" : "Activate rate")">
                                                            <i class="fas @(rate.IsActive ? "fa-ban" : "fa-check")"></i>
                                                            @(rate.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

</div>
<!-- Modal: Add Rate (Only displays types NOT yet added) -->
<div class="modal fade rt-modal" id="addRateModal" tabindex="-1" role="dialog" aria-labelledby="addRateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRateModalTitle">Add Charging Rate</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="stationId" value="@(station?.Id)" />
                <div class="modal-body">
                    <div class="form-group">
                        <label for="connectorType">Connector Type <span class="text-danger">*</span></label>
                        <select class="form-control" id="connectorType" name="connectorType" required>
                            <option value="">-- Select Connector --</option>
                            @if (unconfiguredInstalledConnectors.Any())
                            {
                                <optgroup label="Installed at Station (Not Configured Yet)">
                                    @foreach (var connector in unconfiguredInstalledConnectors)
                                    {
                                        <option value="@connector">@connector (Installed)</option>
                                    }
                                </optgroup>
                            }
                            @if (unconfiguredStandardTypes.Any())
                            {
                                <optgroup label="Other Standard EV Connectors">
                                    @foreach (var std in unconfiguredStandardTypes)
                                    {
                                        <option value="@std">@std</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="ratePerKwh">Rate per kWh (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">₹</span>
                            </div>
                            <input type="number" step="0.01" min="0.01" max="150.00" class="form-control border-left-0" id="ratePerKwh" name="ratePerKwh" required oninput="calculateEstimate('add')" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="ratePerHour">Rate per Hour (₹)</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">₹</span>
                            </div>
                            <input type="number" step="0.01" min="0.00" max="2000.00" class="form-control border-left-0" id="ratePerHour" name="ratePerHour" />
                        </div>
                    </div>

                    <!-- Live Estimation Box -->
                    <div class="preview">
                        <span>30 kWh Preview</span>
                        <span class="value" id="addCostPreview">₹0.00</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Rate -->
<div class="modal fade rt-modal" id="editRateModal" tabindex="-1" role="dialog" aria-labelledby="editRateModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRateModalTitle">Edit Charging Rate</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRateId" name="id" />
                <div class="modal-body">
                    <div class="form-group">
                        <label>Connector Type</label>
                        <input type="text" class="form-control" id="editConnectorType" readonly disabled />
                    </div>

                    <div class="form-group">
                        <label for="editRatePerKwh">Rate per kWh (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">₹</span>
                            </div>
                            <input type="number" step="0.01" min="0.01" max="150.00" class="form-control border-left-0" id="editRatePerKwh" name="ratePerKwh" required oninput="calculateEstimate('edit')" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="editRatePerHour">Rate per Hour (₹)</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">₹</span>
                            </div>
                            <input type="number" step="0.01" min="0.00" max="2000.00" class="form-control border-left-0" id="editRatePerHour" name="ratePerHour" />
                        </div>
                    </div>

                    <div class="preview">
                        <span>30 kWh Preview</span>
                        <span class="value" id="editCostPreview">₹0.00</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditRateModal(id, connector, kwh, hour) {
            $('#editRateId').val(id);
            $('#editConnectorType').val(connector);
            $('#editRatePerKwh').val(parseFloat(kwh).toFixed(2));
            $('#editRatePerHour').val(hour && parseFloat(hour) > 0 ? parseFloat(hour).toFixed(2) : '');
            calculateEstimate('edit');
            $('#editRateModal').modal('show');
        }

        function openAddRateForConnector(connector) {
            $('#connectorType').val(connector);
            $('#addRateModal').modal('show');
        }

        function calculateEstimate(type) {
            var val = type === 'add' ? $('#ratePerKwh').val() : $('#editRatePerKwh').val();
            var cost = (parseFloat(val) || 0) * 30;
            var target = type === 'add' ? '#addCostPreview' : '#editCostPreview';
            $(target).text('₹' + cost.toFixed(2));
        }

        $(document).ready(function() {
            $('#addRateModal, #editRateModal').appendTo("body");
        });
    </script>
}