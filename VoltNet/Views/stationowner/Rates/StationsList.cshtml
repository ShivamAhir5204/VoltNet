@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "Charging Rates Overview";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Success</div>
            @TempData["Success"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @TempData["Error"]
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                <div>
                    <h4 class="mb-1"><i class="fas fa-bolt text-warning mr-2"></i> Station Charging Rates</h4>
                    <p class="text-muted mb-0 small">Select any station to configure energy pricing (₹/kWh) and hourly session fees.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle" id="table-1">
                        <thead class="thead-light">
                            <tr>
                                <th>Station Name</th>
                                <th>Location</th>
                                <th class="text-center">Chargers Installed</th>
                                <th class="text-center">Configured Rates</th>
                                <th>Starting Price</th>
                                <th class="text-center">Station Status</th>
                                <th class="text-center" style="min-width: 150px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stn in Model)
                            {
                                var activeRates = stn.ChargingRates.Where(r => r.IsActive).ToList();
                                <tr>
                                    <td>
                                        <strong class="text-dark">@stn.Name</strong>
                                    </td>
                                    <td>
                                        <span class="text-muted"><i class="fas fa-map-marker-alt text-danger mr-1"></i> @stn.City, @stn.State</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-light border">@stn.Chargers.Count Chargers</span>
                                    </td>
                                    <td class="text-center">
                                        @if (activeRates.Any())
                                        {
                                            <span class="badge badge-success">@activeRates.Count Active Rates</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning text-dark">No Rates Set</span>
                                        }
                                    </td>
                                    <td>
                                        @if (activeRates.Any())
                                        {
                                            <strong class="text-success font-weight-bold">₹@activeRates.Min(r => r.RatePerKwh).ToString("F2")/kWh</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (stn.Status == "Active")
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@stn.Status</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/owner/rates/@stn.Id" class="btn btn-primary btn-sm">
                                            <i class="fas fa-sliders-h mr-1"></i> Configure Rates
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
