@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "Charging Rates";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="rl-page">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <h4>Charging Rates</h4>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="empty-box">No stations found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                            <thead>
                                <tr>
                                    <th>Station</th>
                                    <th>Location</th>
                                    <th>Chargers</th>
                                    <th>Active Rates</th>
                                    <th>Starting Price</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stn in Model)
                                {
                                    var activeRates = stn.ChargingRates.Where(r => r.IsActive).ToList();
                                    <tr>
                                        <td class="col-primary" data-label="Station">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="cell-strong">@stn.Name</span>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Location">
                                            <div class="cell-muted">@stn.City, @stn.State</div>
                                        </td>
                                        <td class="col-secondary" data-label="Chargers">
                                            <div><span class="status status-plain">@stn.Chargers.Count</span></div>
                                        </td>
                                        <td class="col-secondary" data-label="Active Rates">
                                            <div>
                                                @if (activeRates.Any())
                                                {
                                                    <span class="status status-teal">@activeRates.Count Configured</span>
                                                }
                                                else
                                                {
                                                    <span class="status status-warn">No Rates</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Starting Price">
                                            <div>
                                                @if (activeRates.Any())
                                                {
                                                    <span class="cell-money">₹@activeRates.Min(r => r.RatePerKwh).ToString("F2")</span><span class="cell-muted"> / kWh</span>
                                                }
                                                else
                                                {
                                                    <span class="cell-muted">—</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Status">
                                            <div>
                                                @if (stn.Status == "Active")
                                                {
                                                    <span class="status status-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status status-plain">@stn.Status</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center col-action" data-label="Action">
                                            <a href="/owner/rates/@stn.Id" class="btn btn-main">
                                                <i class="fas fa-sliders-h"></i> Rates
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

</div>