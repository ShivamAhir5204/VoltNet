@model IEnumerable<VoltNet.Models.Station>

@{
    ViewData["Title"] = "Charging Rates";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card card-otika">
            <div class="card-header card-otika-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-0 text-dark-slate font-weight-700">
                        <i class="fas fa-bolt text-otika-primary mr-2"></i> Station Charging Rates
                    </h4>
                </div>
                <div class="mt-2 mt-sm-0">
                    <span class="badge badge-light border text-muted-slate font-weight-600 px-3 py-2">
                        @Model.Count() Stations
                    </span>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-soft-grey rounded border-otika">
                        <i class="fas fa-charging-station text-muted-slate mb-3" style="font-size: 38px;"></i>
                        <h6 class="text-dark-slate font-weight-bold mb-1">No Stations Found</h6>
                        <small class="text-muted-slate">Add a station first to configure energy pricing.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped otika-table align-middle table-responsive-cards" id="table-1">
                            <thead>
                                <tr>
                                    <th>Station</th>
                                    <th>Location</th>
                                    <th>Chargers</th>
                                    <th>Active Rates</th>
                                    <th>Starting Price</th>
                                    <th>Status</th>
                                    <th class="text-center" style="min-width: 140px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stn in Model)
                                {
                                    var activeRates = stn.ChargingRates.Where(r => r.IsActive).ToList();
                                    <tr>
                                        <td class="col-primary" data-label="Station">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="font-weight-bold text-dark-slate">@stn.Name</span>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Location">
                                            <div class="text-muted-slate small"><i class="fas fa-map-marker-alt text-danger mr-1"></i> @stn.City, @stn.State</div>
                                        </td>
                                        <td class="col-secondary" data-label="Chargers">
                                            <span class="badge badge-light border text-dark-slate">@stn.Chargers.Count Chargers</span>
                                        </td>
                                        <td class="col-secondary" data-label="Active Rates">
                                            @if (activeRates.Any())
                                            {
                                                <span class="badge badge-otika-teal">@activeRates.Count Configured</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-otika-warning">No Rates</span>
                                            }
                                        </td>
                                        <td class="col-secondary" data-label="Starting Price">
                                            @if (activeRates.Any())
                                            {
                                                <strong class="text-success font-weight-bold">₹@activeRates.Min(r => r.RatePerKwh).ToString("F2")<span class="text-muted small">/kWh</span></strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted-slate">—</span>
                                            }
                                        </td>
                                        <td class="col-secondary" data-label="Status">
                                            @if (stn.Status == "Active")
                                            {
                                                <span class="badge badge-otika-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">@stn.Status</span>
                                            }
                                        </td>
                                        <td class="text-center col-action" data-label="Action">
                                            <a href="/owner/rates/@stn.Id" class="btn btn-otika-primary btn-sm">
                                                <i class="fas fa-sliders-h mr-1"></i> Rates
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
