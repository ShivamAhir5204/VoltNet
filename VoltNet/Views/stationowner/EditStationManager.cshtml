@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Edit Station Manager";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="em">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Edit Station Manager — @Model.FullName</h4>
                    <a href="/owner/station-managers" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
                </div>

                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form method="post" asp-action="Edit" id="managerEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="fullName">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="fullName" name="fullName" value="@Model.FullName" required />
                            </div>

                            <div class="form-group col-md-6">
                                <label for="phone">Mobile Number <span class="text-danger">*</span></label>
                                <input type="tel" inputmode="numeric" class="form-control" id="phone" name="phone" value="@Model.Phone" required maxlength="10" pattern="[6-9][0-9]{9}" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="email">Login Email</label>
                                <input type="email" class="form-control" id="email" value="@(Model.User?.Email)" disabled readonly />
                            </div>

                            <div class="form-group col-md-6">
                                <label for="stationId">Station <span class="text-danger">*</span></label>
                                <select class="form-control" id="stationId" name="stationId" required>
                                    <option value="">-- Select Station --</option>
                                    @if (ViewBag.StationList != null)
                                    {
                                        @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.StationList)
                                        {
                                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Permissions</label>
                            <div class="perm">
                                <input type="checkbox" id="canManageRates" name="canManageRates" value="true" @(Model.CanManageRates ? "checked" : "") />
                                <label for="canManageRates">Can manage charging rates</label>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-main"><i class="fas fa-save"></i> Save Changes</button>
                            <a href="/owner/station-managers" class="btn btn-back">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>