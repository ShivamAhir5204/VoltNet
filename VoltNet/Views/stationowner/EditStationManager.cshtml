@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Edit Station Manager";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12 col-md-10 col-lg-8 mx-auto">
    <div class="card">
      <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
        <h4>Edit Station Manager</h4>
        <a href="/owner/station-managers" class="btn btn-secondary btn-sm mt-2 mt-sm-0"><i class="fas fa-arrow-left mr-1"></i> Back</a>
      </div>
      <div class="card-body">
        @if (ViewBag.Error != null)
        {
          <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" asp-action="Edit" id="managerEditForm">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@Model.Id" />

          <div class="form-group">
            <label for="fullName" class="font-weight-bold">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="fullName" name="fullName" value="@Model.FullName" required placeholder="Enter full name" />
          </div>

          <div class="form-group">
            <label for="email" class="font-weight-bold">Email Address</label>
            <input type="email" class="form-control" id="email" value="@(Model.User?.Email)" disabled readonly />
            <small class="form-text text-muted">Manager email is permanent for login security.</small>
          </div>

          <div class="form-group">
            <label for="phone" class="font-weight-bold">Phone <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone" required maxlength="10" pattern="[0-9]{10}" placeholder="Enter 10-digit mobile number" />
          </div>

          <div class="form-group">
            <label for="stationId" class="font-weight-bold">Assign to Station <span class="text-danger">*</span></label>
            <select class="form-control" id="stationId" name="stationId" required>
              <option value="">-- Select Station --</option>
              @if (ViewBag.StationList != null)
              {
                @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.StationList)
                {
                  <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                }
              }
            </select>
          </div>
          <div class="form-group">
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="canManageRates" name="canManageRates" value="true" @(Model.CanManageRates ? "checked" : "")>
              <label class="custom-control-label font-weight-bold" for="canManageRates">
                Allow Manager to Set & Edit Charging Rates
              </label>
            </div>
            <small class="form-text text-muted">Grant or revoke permission for this manager to set prices per kWh or hour.</small>
          </div>

          <div class="form-group mt-4 d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save Changes</button>
            <a href="/owner/station-managers" class="btn btn-light ml-0 ml-sm-2 mt-2 mt-sm-0">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
