@model VoltNet.Models.StationManager

@{
    ViewData["Title"] = "Edit Station Manager";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
  <div class="col-12">
    <div class="card card-primary shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center py-3">
        <h4 class="text-dark font-weight-bold mb-0">
          <i class="fas fa-user-edit text-primary mr-2"></i> Edit Station Manager — @Model.FullName
        </h4>
        <a href="/owner/station-managers" class="btn btn-outline-secondary btn-sm font-weight-600">
          <i class="fas fa-arrow-left mr-1"></i> Back
        </a>
      </div>

      <div class="card-body p-3 p-md-4">
        @if (ViewBag.Error != null)
        {
          <div class="alert alert-danger mb-3 py-2 px-3 font-13">
            <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Error
          </div>
        }

        <form method="post" asp-action="Edit" id="managerEditForm">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@Model.Id" />

          <div class="form-row">
            <div class="form-group col-md-6 mb-3">
              <label for="fullName" class="font-weight-600 font-13 mb-1 text-dark">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="fullName" name="fullName" value="@Model.FullName" required placeholder="Enter full name" />
            </div>

            <div class="form-group col-md-6 mb-3">
              <label for="phone" class="font-weight-600 font-13 mb-1 text-dark">Mobile Number <span class="text-danger">*</span></label>
              <input type="text" class="form-control font-mono" id="phone" name="phone" value="@Model.Phone" required maxlength="10" pattern="[6-9][0-9]{9}" placeholder="10-digit mobile number" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6 mb-3">
              <label for="email" class="font-weight-600 font-13 mb-1 text-dark">Login Email Address</label>
              <input type="email" class="form-control bg-light" id="email" value="@(Model.User?.Email)" disabled readonly />
              <small class="form-text text-muted font-11">Manager email is permanent for account identity security.</small>
            </div>

            <div class="form-group col-md-6 mb-3">
              <label for="stationId" class="font-weight-600 font-13 mb-1 text-dark">Assigned Charging Station <span class="text-danger">*</span></label>
              <select class="form-control" id="stationId" name="stationId" required>
                <option value="">-- Select Station --</option>
                @if (ViewBag.StationList != null)
                {
                  @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.StationList)
                  {
                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                  }
                }
              </select>
            </div>
          </div>

          <div class="form-group mb-3 p-3 rounded bg-light border">
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="canManageRates" name="canManageRates" value="true" @(Model.CanManageRates ? "checked" : "")>
              <label class="custom-control-label font-weight-bold font-13 text-dark" for="canManageRates">
                Allow Manager to Configure Charging Tariffs
              </label>
            </div>
            <small class="form-text text-muted font-11 ml-4">Enables or restricts this manager's ability to create and update connector rates and hourly pricing.</small>
          </div>

          <div class="mt-3 pt-3 border-top d-flex align-items-center">
            <button type="submit" class="btn btn-primary font-weight-700 px-4 py-2 mr-2">
              <i class="fas fa-save mr-1"></i> Save Changes
            </button>
            <a href="/owner/station-managers" class="btn btn-outline-secondary font-weight-600 px-3 py-2">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
