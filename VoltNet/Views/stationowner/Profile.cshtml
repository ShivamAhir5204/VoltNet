@model VoltNet.Models.StationOwner
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="section-header d-none">
    <h1>My Profile</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-has-icon alert-dismissible show fade mb-4">
        <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
        <div class="alert-body">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Success</div>
            @TempData["Success"]
        </div>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-has-icon alert-dismissible show fade mb-4">
        <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="alert-body">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            <div class="alert-title">Error</div>
            @ViewBag.Error
        </div>
    </div>
}

<div class="row">
    <!-- Left Column: Author Box & Account Info (Otika Profile Standard) -->
    <div class="col-12 col-md-12 col-lg-4 mb-4">
        <div class="card author-box">
            <div class="card-body">
                <div class="author-box-center">
                    <img alt="Owner avatar" src="~/otika/assets/img/admin.png" class="rounded-circle author-box-picture shadow-sm">
                    <div class="clearfix"></div>
                    <div class="author-box-name mt-2">
                        <h5 class="mb-0 text-dark">@(Model.FullName ?? "Station Owner")</h5>
                    </div>
                    <div class="author-box-job text-muted small mt-1">Station Owner (@Model.Status)</div>
                </div>
                <div class="text-center mt-3">
                    <span class="badge badge-success px-3 py-1 font-weight-bold">
                        <i class="fas fa-shield-alt mr-1"></i> Verified Partner
                    </span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-id-card text-primary mr-2"></i> Account Overview</h4>
            </div>
            <div class="card-body">
                <div class="py-2">
                    <p class="clearfix border-bottom pb-2 mb-2">
                        <span class="float-left text-muted font-weight-bold">Role</span>
                        <span class="float-right text-dark font-weight-bold">Station Owner</span>
                    </p>
                    <p class="clearfix border-bottom pb-2 mb-2">
                        <span class="float-left text-muted font-weight-bold">Email</span>
                        <span class="float-right text-dark" style="word-break: break-all;">@Model.User.Email</span>
                    </p>
                    <p class="clearfix border-bottom pb-2 mb-2">
                        <span class="float-left text-muted font-weight-bold">Phone</span>
                        <span class="float-right text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Not set" : Model.Phone)</span>
                    </p>
                    <p class="clearfix border-bottom pb-2 mb-2">
                        <span class="float-left text-muted font-weight-bold">Business</span>
                        <span class="float-right text-dark">@(string.IsNullOrEmpty(Model.BusinessName) ? "—" : Model.BusinessName)</span>
                    </p>
                    <p class="clearfix mb-0">
                        <span class="float-left text-muted font-weight-bold">Member Since</span>
                        <span class="float-right text-dark">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Edit Profile Form -->
    <div class="col-12 col-md-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <h4 class="mb-0"><i class="fas fa-user-edit text-primary mr-2"></i> Edit Owner Profile</h4>
                <a href="/owner/change-password" class="btn btn-outline-primary btn-sm mt-2 mt-sm-0">
                    <i class="fas fa-key mr-1"></i> Change Password
                </a>
            </div>
            <div class="card-body">
                <form method="post" action="/owner/profile" id="profileForm">
                    @Html.AntiForgeryToken()

                    <div class="section-title mt-0 mb-3 font-weight-bold text-primary">Personal Information</div>
                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label for="fullname" class="font-weight-bold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fullname" name="fullname"
                                   value="@Model.FullName" required placeholder="Enter your full name" />
                        </div>
                        <div class="col-12 col-md-6 form-group">
                            <label for="phone" class="font-weight-bold">Mobile Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="phone" name="phone"
                                   value="@Model.Phone" required maxlength="10" minlength="10"
                                   pattern="[0-9]{10}" title="Enter a valid 10-digit mobile number"
                                   placeholder="e.g. 9876543210" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email" class="font-weight-bold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" name="email"
                               value="@Model.User.Email" required placeholder="e.g. name@example.com" />
                    </div>

                    <div class="section-title mt-4 mb-3 font-weight-bold text-primary">Business & Tax Details</div>
                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label for="businessName" class="font-weight-bold">Business / Company Name</label>
                            <input type="text" class="form-control" id="businessName" name="businessName"
                                   value="@Model.BusinessName" placeholder="e.g. VoltNet Enterprises LLP" />
                        </div>
                        <div class="col-12 col-md-6 form-group">
                            <label for="businessRegistrationNumber" class="font-weight-bold">Registration / CIN Number</label>
                            <input type="text" class="form-control" id="businessRegistrationNumber" name="businessRegistrationNumber"
                                   value="@Model.BusinessRegistrationNumber" placeholder="e.g. U12345MH2024PTC123456" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="gstNumber" class="font-weight-bold">GST Number</label>
                        <input type="text" class="form-control text-uppercase" id="gstNumber" name="gstNumber"
                               value="@Model.GSTNumber" placeholder="e.g. 24AAACH7409R1ZZ" />
                    </div>

                    <div class="section-title mt-4 mb-3 font-weight-bold text-primary">Location & Address</div>
                    <div class="form-group">
                        <label for="address" class="font-weight-bold">Registered Office Address</label>
                        <input type="text" class="form-control" id="address" name="address"
                               value="@Model.Address" placeholder="Full operating address" />
                    </div>
                    
                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label for="city" class="font-weight-bold">City</label>
                            <input type="text" class="form-control" id="city" name="city"
                                   value="@Model.City" placeholder="e.g. Ahmedabad" />
                        </div>
                        <div class="col-12 col-md-6 form-group">
                            <label for="State" class="font-weight-bold">State</label>
                            <select class="form-control select2" id="State" name="state" data-selected="@Model.State">
                                <option value="">-- Select State --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group mt-4 d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center">
                        <button type="submit" class="btn btn-primary px-4 mb-2 mb-sm-0 mr-sm-2">
                            <i class="fas fa-save mr-1"></i> Save Changes
                        </button>
                        <a href="/owner/dashboard" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var stateSelect = $('#State');
            
            // Populate states from indianStates helper
            if (typeof indianStates !== 'undefined') {
                indianStates.forEach(function(state) {
                    var option = new Option(state, state);
                    stateSelect.append(option);
                });
            }
            
            // Set selected value
            var selectedState = stateSelect.data('selected');
            if (selectedState) {
                stateSelect.val(selectedState);
            }
            
            // Initialize Select2
            if ($.fn.select2) {
                stateSelect.select2({
                    placeholder: "-- Select State --",
                    width: '100%'
                });
            }
        });
    </script>
}
