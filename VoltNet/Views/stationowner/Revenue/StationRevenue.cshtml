@model VoltNet.Controllers.stationowner.OwnerIndividualStationRevenueViewModel
@{
    ViewData["Title"] = $"{Model.Station.Name} — Revenue Intelligence";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var paymentBreakdown = ViewBag.PaymentBreakdown as dynamic;
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex flex-wrap align-items-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 mb-1">
                        <li class="breadcrumb-item"><a href="/owner/dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/owner/revenue">Revenue Analytics</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Station.Name</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center flex-wrap">
                    <h3 class="mb-0 text-primary font-weight-bold mr-3"><i class="fas fa-charging-station mr-2"></i>@Model.Station.Name</h3>
                    @if (Model.Station.Status == "Active")
                    {
                        <span class="badge badge-success px-3 py-1 font-weight-bold"><i class="fas fa-check-circle mr-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary px-3 py-1">@Model.Station.Status</span>
                    }
                </div>
                <small class="text-muted"><i class="fas fa-map-marker-alt text-danger mr-1"></i>@Model.Station.Address, @Model.Station.City, @Model.Station.State • Operating: @Model.Station.OpeningTime.ToString(@"hh\:mm") - @Model.Station.ClosingTime.ToString(@"hh\:mm")</small>
            </div>
            <div class="mt-3 mt-md-0 d-flex flex-wrap">
                <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" class="btn btn-outline-success btn-lg shadow-sm mr-2">
                    <i class="fas fa-file-csv mr-2"></i>Export Station Data
                </a>
                <a href="/owner/stations/details/@Model.Station.Id" class="btn btn-outline-primary btn-lg shadow-sm mr-2">
                    <i class="fas fa-cog mr-1"></i> Station Management
                </a>
                <a href="/owner/revenue" class="btn btn-light btn-lg shadow-sm">
                    <i class="fas fa-arrow-left mr-1"></i> All Stations
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Macro Lifetime & Periodic KPI Cards -->
<div class="row">
    <!-- Today -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
        <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color:#fff;">
            <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                <i class="fas fa-coins fa-2x text-white"></i>
            </div>
            <div class="card-wrap p-3">
                <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">Today's Revenue</div>
                <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.TodayRevenue.ToString("N0")</div>
                <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.TodayBookings completed sessions</small>
            </div>
        </div>
    </div>

    <!-- This Week -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
        <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color:#fff;">
            <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                <i class="fas fa-calendar-week fa-2x text-white"></i>
            </div>
            <div class="card-wrap p-3">
                <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">This Week</div>
                <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.WeekRevenue.ToString("N0")</div>
                <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions</small>
            </div>
        </div>
    </div>

    <!-- This Month -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
        <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%); color:#fff;">
            <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                <i class="fas fa-calendar-alt fa-2x text-white"></i>
            </div>
            <div class="card-wrap p-3">
                <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">This Month</div>
                <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.MonthRevenue.ToString("N0")</div>
                <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions</small>
            </div>
        </div>
    </div>

    <!-- All-Time Station Revenue -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
        <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #f857a6 0%, #ff5858 100%); color:#fff;">
            <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                <i class="fas fa-trophy fa-2x text-white"></i>
            </div>
            <div class="card-wrap p-3">
                <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">All-Time Collection</div>
                <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.AllTimeRevenue.ToString("N0")</div>
                <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.TotalEnergyKwh.ToString("N0") kWh dispensed</small>
            </div>
        </div>
    </div>
</div>

<!-- Operational Highlights Matrix -->
<div class="row mb-4">
    <!-- Top Charger -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:12px; border-left: 4px solid #3498db !important;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle p-3 mr-3 bg-light text-primary">
                    <i class="fas fa-plug fa-2x"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase font-weight-bold">Highest Grossing Charger</div>
                    <h5 class="font-weight-bold text-dark mb-0 mt-1">@Model.TopChargerName</h5>
                    <small class="text-muted"><span class="badge badge-light border">@Model.TopChargerConnector</span> • @Model.TopChargerSharePct% of revenue (₹@Model.TopChargerRevenue.ToString("N0"))</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Hour -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:12px; border-left: 4px solid #e74c3c !important;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle p-3 mr-3 bg-light text-danger">
                    <i class="fas fa-fire fa-2x"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase font-weight-bold">Peak Demand Hour</div>
                    <h5 class="font-weight-bold text-dark mb-0 mt-1">@Model.PeakHourRange</h5>
                    <small class="text-muted"><i class="fas fa-clock mr-1"></i>Highest concurrent booking density</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Bay Utilization -->
    <div class="col-lg-4 col-md-12 col-12">
        <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:12px; border-left: 4px solid #2ecc71 !important;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small text-uppercase font-weight-bold">Bay Utilization Efficiency</span>
                <span class="badge badge-success font-weight-bold">@Model.UtilizationPct% Booked</span>
            </div>
            <div class="progress mb-2" style="height: 8px; border-radius: 4px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @Model.UtilizationPct%;" aria-valuenow="@Model.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <small class="text-muted">Calculated across @Model.Station.Chargers?.Count bays over selected window</small>
        </div>
    </div>
</div>

<!-- Custom Date Filter Panel with Presets -->
<div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
    <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center">
        <h6 class="mb-0 font-weight-bold text-dark"><i class="fas fa-sliders-h text-primary mr-2"></i>Date Range & Granularity Filter</h6>
        <div class="btn-group btn-group-sm mt-2 mt-md-0" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="applyStationPreset(7, 'day')">Last 7 Days</button>
            <button type="button" class="btn btn-outline-primary" onclick="applyStationPreset(30, 'day')">Last 30 Days</button>
            <button type="button" class="btn btn-outline-primary" onclick="applyStationPreset(90, 'week')">Last 90 Days</button>
            <button type="button" class="btn btn-outline-primary" onclick="applyStationPreset(365, 'month')">Past 1 Year</button>
        </div>
    </div>
    <div class="card-body pt-0">
        <form method="get" action="/owner/revenue/station/@Model.Station.Id" id="stationFilterForm" class="row align-items-end">
            <div class="col-lg-4 col-md-4 col-sm-6 mb-2 mb-md-0">
                <label class="font-weight-bold text-muted small mb-1">From Date</label>
                <input type="date" name="startDate" id="stStartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6 mb-2 mb-md-0">
                <label class="font-weight-bold text-muted small mb-1">To Date</label>
                <input type="date" name="endDate" id="stEndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-2 col-sm-6 mb-2 mb-md-0">
                <label class="font-weight-bold text-muted small mb-1">Interval</label>
                <select name="groupBy" id="stGroupBy" class="form-control">
                    <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                    <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                    <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2 col-sm-6 d-flex">
                <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-filter mr-1"></i>Filter</button>
                <a href="/owner/revenue/station/@Model.Station.Id" class="btn btn-light ml-2" title="Reset"><i class="fas fa-redo"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Interactive Time-Series Chart Canvas -->
<div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
    <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-chart-area text-success mr-2"></i>Station Monetization & Telemetry Progression</h5>
            <small class="text-muted">Aggregated @Model.GroupBy telemetry for @Model.Station.Name from @Model.StartDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy")</small>
        </div>
        <!-- Metric Switcher Buttons -->
        <div class="btn-group btn-group-toggle mt-2 mt-md-0" data-toggle="buttons">
            <label class="btn btn-sm btn-outline-success active" onclick="switchStationMetric('revenue')">
                <input type="radio" name="options" checked> Revenue (₹)
            </label>
            <label class="btn btn-sm btn-outline-primary" onclick="switchStationMetric('energy')">
                <input type="radio" name="options"> Energy (kWh)
            </label>
            <label class="btn btn-sm btn-outline-info" onclick="switchStationMetric('count')">
                <input type="radio" name="options"> Sessions (Count)
            </label>
            <label class="btn btn-sm btn-outline-warning" onclick="switchStationMetric('aov')">
                <input type="radio" name="options"> AOV (₹)
            </label>
        </div>
    </div>
    <div class="card-body">
        @if (Model.PeriodRevenue == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-chart-line fa-3x mb-2 text-black-50"></i>
                <p>No completed session revenue in this date range.</p>
            </div>
        }
        else
        {
            <div style="position: relative; height: 330px;">
                <canvas id="stationTelemetryChart"></canvas>
            </div>
        }
    </div>
</div>

<!-- Charger-by-Charger Breakdown & Payment Mode Split -->
<div class="row">
    <!-- Charger Breakdown Table & Bar Chart -->
    <div class="col-lg-8 col-12 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius:12px;">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-plug text-primary mr-2"></i>Per-Charger Bay Monetization Matrix</h6>
                    <small class="text-muted">Breakdown across all charging units installed at @Model.Station.Name</small>
                </div>
                <span class="badge badge-light border">@Model.ChargerBreakdowns.Count Charger(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Charger Bay</th>
                                <th>Connector & Power</th>
                                <th class="text-center">Sessions</th>
                                <th class="text-center">Energy (kWh)</th>
                                <th class="text-right">Total Revenue</th>
                                <th style="width: 140px;">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChargerBreakdowns.Any())
                            {
                                <tr><td colspan="6" class="text-center py-4 text-muted">No chargers configured for this station.</td></tr>
                            }
                            else
                            {
                                @foreach (var ch in Model.ChargerBreakdowns)
                                {
                                    <tr>
                                        <td class="font-weight-bold text-dark">
                                            <i class="fas fa-bolt text-warning mr-2"></i>@ch.ChargerName
                                        </td>
                                        <td>
                                            <span class="badge badge-light border">@ch.ConnectorType</span>
                                            @if (ch.CapacityKw > 0)
                                            {
                                                <small class="text-muted ml-1">(@ch.CapacityKw kW)</small>
                                            }
                                        </td>
                                        <td class="text-center font-weight-bold">@ch.TotalBookings</td>
                                        <td class="text-center font-weight-bold text-info">@ch.TotalEnergyKwh.ToString("N1")</td>
                                        <td class="text-right font-weight-bold text-success">₹@ch.TotalRevenue.ToString("N2")</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 mr-2" style="height: 6px;">
                                                    <div class="progress-bar bg-success" style="width: @ch.RevenueSharePercentage%;"></div>
                                                </div>
                                                <small class="font-weight-bold">@ch.RevenueSharePercentage%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Breakdown for Station -->
    <div class="col-lg-4 col-12 mb-4">
        <div class="card shadow-sm border-0 h-100" style="border-radius:12px;">
            <div class="card-header bg-white border-0 py-3">
                <h6 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-wallet text-success mr-2"></i>Payment Mode Split</h6>
                <small class="text-muted">Collections breakdown by payment type</small>
            </div>
            <div class="card-body">
                @if (paymentBreakdown != null)
                {
                    @foreach (var p in paymentBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="font-weight-bold text-dark">
                                    @if (p.Method.ToString().Contains("UPI")) { <i class="fas fa-qrcode text-primary mr-1"></i> }
                                    else if (p.Method.ToString().Contains("Cash")) { <i class="fas fa-money-bill-wave text-success mr-1"></i> }
                                    else { <i class="fas fa-credit-card text-warning mr-1"></i> }
                                    @p.Method
                                </span>
                                <span class="font-weight-bold text-success">₹@p.Amount.ToString("N0") <small class="text-muted">(@p.Count)</small></span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: @p.Share%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">No transactions in this period.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Itemized Sessions Ledger Table -->
<div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-receipt text-primary mr-2"></i>Recent Completed Charging Sessions</h6>
            <small class="text-muted">Showing latest 15 completed transactions at @Model.Station.Name</small>
        </div>
        <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" class="btn btn-sm btn-outline-success">
            <i class="fas fa-download mr-1"></i>Export All (@Model.PeriodBookings)
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Ref Code</th>
                        <th>Charger</th>
                        <th>Date & Time</th>
                        <th>Vehicle & Driver</th>
                        <th class="text-center">Energy (kWh)</th>
                        <th class="text-right">Session Amount</th>
                        <th class="text-center">Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentSessions.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No completed transactions found in this window.</td></tr>
                    }
                    else
                    {
                        @foreach (var b in Model.RecentSessions)
                        {
                            var refCode = $"VN-{b.Id.ToString()[..8].ToUpper()}";
                            var cost = b.ActualCost ?? b.EstimatedCost;
                            <tr>
                                <td class="font-weight-bold text-primary">@refCode</td>
                                <td>
                                    <span class="badge badge-light border">@(b.Charger?.Name ?? "Charger")</span>
                                </td>
                                <td>
                                    <div>@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">@(b.CustomerName ?? b.Customer?.Fullname ?? "Walk-In")</div>
                                    <small class="text-muted">@(b.VehicleModel ?? b.VehicleNumberPlate ?? "EV")</small>
                                </td>
                                <td class="text-center font-weight-bold text-info">@(b.UnitsConsumedKwh?.ToString("N1") ?? "—")</td>
                                <td class="text-right font-weight-bold text-success font-size-15">₹@cost.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge badge-light border text-dark">@(b.PaymentMethod ?? "UPI")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function applyStationPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('stStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('stEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('stGroupBy').value = group;
            document.getElementById('stationFilterForm').submit();
        }

        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRev = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let stChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Revenue (₹)',
                data: dataRev,
                borderColor: '#2ecc71',
                backgroundColor: 'rgba(46, 204, 113, 0.15)',
                prefix: '₹',
                suffix: ''
            },
            energy: {
                label: 'Energy (kWh)',
                data: dataEnergy,
                borderColor: '#3498db',
                backgroundColor: 'rgba(52, 152, 219, 0.15)',
                prefix: '',
                suffix: ' kWh'
            },
            count: {
                label: 'Sessions Count',
                data: dataCount,
                borderColor: '#9b59b6',
                backgroundColor: 'rgba(155, 89, 182, 0.15)',
                prefix: '',
                suffix: ' sessions'
            },
            aov: {
                label: 'Average Order Value (₹)',
                data: dataAov,
                borderColor: '#f39c12',
                backgroundColor: 'rgba(243, 156, 18, 0.15)',
                prefix: '₹',
                suffix: ''
            }
        };

        function initStationChart(metric) {
            const ctx = document.getElementById('stationTelemetryChart');
            if (!ctx) return;

            const cfg = metricConfigs[metric];
            if (stChart) {
                stChart.destroy();
            }

            stChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.borderColor,
                        backgroundColor: cfg.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: labels.length > 40 ? 1 : 3.5,
                        pointHoverRadius: 6,
                        pointBackgroundColor: cfg.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + cfg.label + ': ' + cfg.prefix + Number(ctx.raw).toLocaleString('en-IN') + cfg.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (val) {
                                    return cfg.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + cfg.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchStationMetric(metric) {
            initStationChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (labels.length > 0) {
                initStationChart('revenue');
            }
        });
    </script>
}
