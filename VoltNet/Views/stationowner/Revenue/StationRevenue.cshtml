@model VoltNet.Controllers.stationowner.OwnerIndividualStationRevenueViewModel
@{
    ViewData["Title"] = $"{Model.Station.Name} — Revenue";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var paymentBreakdown = ViewBag.PaymentBreakdown as dynamic;
}

<!-- Page Header -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 mb-1">
                        <li class="breadcrumb-item"><a href="/owner/dashboard" style="color: #6777EF; font-weight: 600;">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/owner/revenue" style="color: #6777EF; font-weight: 600;">Revenue</a></li>
                        <li class="breadcrumb-item active" aria-current="page" style="color: #96A2B4; font-weight: 600;">@Model.Station.Name</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center flex-wrap">
                    <h4 class="mb-0 font-weight-bold mr-3" style="color: #353C48; font-size: 22px;">
                        <i class="fas fa-charging-station mr-2" style="color: #6777EF;"></i>@Model.Station.Name
                    </h4>
                    @if (Model.Station.Status == "Active")
                    {
                        <span class="badge px-2 py-1 font-weight-bold" style="background: rgba(40, 199, 111, 0.12); color: #28C76F; border-radius: 6px; font-size: 11px;">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge px-2 py-1 font-weight-bold" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 6px; font-size: 11px;">
                            @Model.Station.Status
                        </span>
                    }
                </div>
                <div class="font-weight-500 mt-1" style="color: #96A2B4; font-size: 13px;">
                    <i class="fas fa-map-marker-alt mr-1" style="color: #EA5455;"></i>@Model.Station.Address, @Model.Station.City &bull; @Model.Station.OpeningTime.ToString(@"hh\:mm") - @Model.Station.ClosingTime.ToString(@"hh\:mm")
                </div>
            </div>
            <div class="action-btns mt-3 mt-lg-0 d-flex flex-wrap">
                <a href="/owner/revenue/station/@Model.Station.Id/export-pdf?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
                   class="btn font-weight-bold px-3 py-2 shadow-sm mr-2 mb-2 mb-sm-0" 
                   style="background: #E8F4FD; border: 1.5px solid #2B6CB0; color: #2B6CB0; border-radius: 6px; font-size: 13px;">
                    <i class="fas fa-file-pdf mr-1 text-danger"></i>Download PDF
                </a>
                <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
                   class="btn font-weight-bold px-3 py-2 shadow-sm mr-2 mb-2 mb-sm-0" 
                   style="background: #FFFFFF; border: 1.5px solid #28C76F; color: #28C76F; border-radius: 6px; font-size: 13px;">
                    <i class="fas fa-file-csv mr-1"></i>Export CSV
                </a>
                <a href="/owner/stations/details/@Model.Station.Id" 
                   class="btn font-weight-bold px-3 py-2 shadow-sm mr-2 mb-2 mb-sm-0" 
                   style="background: #FFFFFF; border: 1.5px solid #6777EF; color: #6777EF; border-radius: 6px; font-size: 13px;">
                    <i class="fas fa-cog mr-1"></i>Manage
                </a>
                <a href="/owner/revenue" 
                   class="btn font-weight-bold px-3 py-2 shadow-sm mb-2 mb-sm-0" 
                   style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; font-size: 13px;">
                    <i class="fas fa-arrow-left mr-1"></i>All Stations
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Macro Lifetime Cards -->
<div class="row">
    <!-- Today -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
        <div class="revenue-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-label">Today</div>
                <div class="stat-icon-box" style="background: rgba(103, 119, 239, 0.12); color: #6777EF;">
                    <i class="fas fa-coins"></i>
                </div>
            </div>
            <div>
                <div class="stat-value">₹@Model.TodayRevenue.ToString("N0")</div>
                <div class="mt-2">
                    <span class="stat-badge" style="background: rgba(40, 199, 111, 0.12); color: #28C76F;">
                        <i class="fas fa-bolt mr-1"></i>@Model.TodayBookings sessions
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- This Week -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
        <div class="revenue-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-label">This Week</div>
                <div class="stat-icon-box" style="background: rgba(61, 201, 179, 0.12); color: #3DC9B3;">
                    <i class="fas fa-calendar-week"></i>
                </div>
            </div>
            <div>
                <div class="stat-value">₹@Model.WeekRevenue.ToString("N0")</div>
                <div class="mt-2">
                    <span class="stat-badge" style="background: rgba(61, 201, 179, 0.12); color: #3DC9B3;">
                        <i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- This Month -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
        <div class="revenue-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-label">This Month</div>
                <div class="stat-icon-box" style="background: rgba(58, 186, 244, 0.12); color: #3ABAF4;">
                    <i class="fas fa-calendar-alt"></i>
                </div>
            </div>
            <div>
                <div class="stat-value">₹@Model.MonthRevenue.ToString("N0")</div>
                <div class="mt-2">
                    <span class="stat-badge" style="background: rgba(58, 186, 244, 0.12); color: #3ABAF4;">
                        <i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- All-Time -->
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
        <div class="revenue-stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-label">All-Time</div>
                <div class="stat-icon-box" style="background: rgba(255, 161, 23, 0.12); color: #FFA117;">
                    <i class="fas fa-trophy"></i>
                </div>
            </div>
            <div>
                <div class="stat-value">₹@Model.AllTimeRevenue.ToString("N0")</div>
                <div class="mt-2">
                    <span class="stat-badge" style="background: rgba(255, 161, 23, 0.12); color: #FFA117;">
                        <i class="fas fa-bolt mr-1"></i>@Model.TotalEnergyKwh.ToString("N0") kWh
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Operational Highlights -->
<div class="row mb-4">
    <!-- Top Charger -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="revenue-op-card" style="border-left: 4px solid #6777EF !important;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle mr-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(103, 119, 239, 0.12); color: #6777EF; font-size: 18px; flex-shrink: 0;">
                    <i class="fas fa-plug"></i>
                </div>
                <div style="min-width: 0;">
                    <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">Top Charger</div>
                    <h6 class="font-weight-bold mb-1 mt-1 text-truncate" style="color: #353C48; font-size: 16px;" title="@Model.TopChargerName">@Model.TopChargerName</h6>
                    <div>
                        <span class="badge" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; font-size: 11px;">@Model.TopChargerConnector</span>
                        <span class="font-weight-bold ml-1" style="color: #28C76F; font-size: 12px;">₹@Model.TopChargerRevenue.ToString("N0")</span>
                        <span class="font-weight-600 ml-1" style="color: #96A2B4; font-size: 12px;">(@Model.TopChargerSharePct%)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Hour -->
    <div class="col-lg-4 col-md-6 col-12 mb-3 mb-lg-0">
        <div class="revenue-op-card" style="border-left: 4px solid #EA5455 !important;">
            <div class="d-flex align-items-center">
                <div class="rounded-circle mr-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(234, 84, 85, 0.12); color: #EA5455; font-size: 18px; flex-shrink: 0;">
                    <i class="fas fa-fire"></i>
                </div>
                <div>
                    <div class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">Peak Hour</div>
                    <h6 class="font-weight-bold mb-1 mt-1" style="color: #353C48; font-size: 16px;">@Model.PeakHourRange</h6>
                    <span class="badge" style="background: rgba(234, 84, 85, 0.12); color: #EA5455; font-size: 11px;">
                        <i class="fas fa-clock mr-1"></i>Peak Density
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bay Utilization -->
    <div class="col-lg-4 col-md-12 col-12">
        <div class="revenue-op-card d-flex flex-column justify-content-between" style="border-left: 4px solid #3DC9B3 !important;">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="font-weight-bold text-uppercase" style="color: #96A2B4; font-size: 11px; letter-spacing: 0.5px;">Bay Utilization</span>
                    <span class="badge font-weight-bold px-2 py-1" style="background: rgba(61, 201, 179, 0.15); color: #3DC9B3; border-radius: 6px; font-size: 11px;">
                        @Model.UtilizationPct%
                    </span>
                </div>
                <div class="progress mb-2" style="height: 6px; background: #F2F2F2; border-radius: 3px;">
                    <div class="progress-bar" role="progressbar" style="width: @Model.UtilizationPct%; background: #3DC9B3; border-radius: 3px;" aria-valuenow="@Model.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="font-weight-600" style="color: #96A2B4; font-size: 12px;">
                @Model.Station.Chargers?.Count bays configured
            </div>
        </div>
    </div>
</div>

<!-- Date Filter Panel -->
<div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
    <div class="card-header border-0 py-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
            <i class="fas fa-sliders-h mr-2" style="color: #6777EF;"></i>Date Filter
        </h6>
        <div class="otika-preset-group d-flex flex-wrap mt-2 mt-md-0" role="group">
            <button type="button" class="otika-preset-btn mr-1 mb-1" onclick="applyStationPreset(7, 'day')">7 Days</button>
            <button type="button" class="otika-preset-btn mr-1 mb-1" onclick="applyStationPreset(30, 'day')">30 Days</button>
            <button type="button" class="otika-preset-btn mr-1 mb-1" onclick="applyStationPreset(90, 'week')">90 Days</button>
            <button type="button" class="otika-preset-btn mb-1" onclick="applyStationPreset(365, 'month')">1 Year</button>
        </div>
    </div>
    <div class="card-body p-3 p-md-4">
        <form method="get" action="/owner/revenue/station/@Model.Station.Id" id="stationFilterForm" class="row align-items-end">
            <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px;">From</label>
                <input type="date" name="startDate" id="stStartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;" />
            </div>
            <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px;">To</label>
                <input type="date" name="endDate" id="stEndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 mb-3 mb-lg-0">
                <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px;">Interval</label>
                <select name="groupBy" id="stGroupBy" class="form-control" style="border: 1px solid #E3EAEF; border-radius: 6px; font-weight: 600; color: #353C48;">
                    <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                    <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                    <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex">
                <button type="submit" class="btn btn-block font-weight-bold" style="background: #6777EF; color: #FFFFFF; border-radius: 6px; padding: 9px 16px;">
                    <i class="fas fa-filter mr-1"></i>Apply
                </button>
                <a href="/owner/revenue/station/@Model.Station.Id" class="btn ml-2 d-flex align-items-center justify-content-center" title="Reset Filters" style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; width: 44px;">
                    <i class="fas fa-redo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Filtered Period Summary Tiles -->
<div class="row mb-4">
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="revenue-highlight-card">
            <div class="highlight-label">Period Revenue</div>
            <div class="highlight-value" style="color: #28C76F;">₹@Model.PeriodRevenue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="revenue-highlight-card">
            <div class="highlight-label">Sessions</div>
            <div class="highlight-value" style="color: #6777EF;">@Model.PeriodBookings</div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12 mb-3 mb-xl-0">
        <div class="revenue-highlight-card">
            <div class="highlight-label">Energy</div>
            <div class="highlight-value" style="color: #3DC9B3;">@Model.PeriodEnergyKwh.ToString("N1") <span style="font-size: 13px; font-weight: 600;">kWh</span></div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6 col-12">
        <div class="revenue-highlight-card">
            <div class="highlight-label">Avg Order Value</div>
            <div class="highlight-value" style="color: #FFA117;">₹@Model.PeriodAvgTicket.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Interactive Time-Series Chart Canvas -->
<div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
    <div class="card-header border-0 py-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
            <i class="fas fa-chart-area mr-2" style="color: #28C76F;"></i>Revenue & Telemetry
        </h6>
        <!-- Metric Switcher Buttons -->
        <div class="otika-metric-switcher mt-2 mt-md-0" id="stationMetricSwitcher">
            <button type="button" class="btn active-revenue" id="btn-metric-revenue" onclick="switchStationMetric('revenue')">
                <i class="fas fa-rupee-sign mr-1"></i>Revenue
            </button>
            <button type="button" class="btn" id="btn-metric-energy" onclick="switchStationMetric('energy')">
                <i class="fas fa-bolt mr-1"></i>Energy
            </button>
            <button type="button" class="btn" id="btn-metric-count" onclick="switchStationMetric('count')">
                <i class="fas fa-charging-station mr-1"></i>Sessions
            </button>
            <button type="button" class="btn" id="btn-metric-aov" onclick="switchStationMetric('aov')">
                <i class="fas fa-tag mr-1"></i>AOV
            </button>
        </div>
    </div>
    <div class="card-body p-3 p-md-4">
        @if (Model.PeriodRevenue == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-chart-line fa-3x mb-3" style="color: #96A2B4; opacity: 0.4;"></i>
                <div class="font-weight-600" style="color: #96A2B4; font-size: 14px;">No session data in this period.</div>
            </div>
        }
        else
        {
            <div style="position: relative; height: 320px;">
                <canvas id="stationTelemetryChart"></canvas>
            </div>
        }
    </div>
</div>

<!-- Charger Breakdown & Payment Mode Split -->
<div class="row">
    <!-- Charger Breakdown Table -->
    <div class="col-lg-8 col-12 mb-4">
        <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
            <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
                <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
                    <i class="fas fa-plug mr-2" style="color: #6777EF;"></i>Charger Earnings
                </h6>
                <span class="badge px-2 py-1 font-weight-bold" style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; font-size: 11px;">
                    @Model.ChargerBreakdowns.Count Chargers
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color: #353C48;">
                        <thead style="background: #F9F9F9; border-bottom: 1.5px solid #E3EAEF; color: #34395E; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                            <tr>
                                <th class="pl-4 py-3 border-0">Charger</th>
                                <th class="py-3 border-0">Connector</th>
                                <th class="py-3 border-0 text-center">Sessions</th>
                                <th class="py-3 border-0 text-center">Energy (kWh)</th>
                                <th class="py-3 border-0 text-right">Revenue</th>
                                <th class="pr-4 py-3 border-0" style="width: 140px;">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChargerBreakdowns.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4" style="color: #96A2B4; font-weight: 500;">
                                        No chargers configured.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ch in Model.ChargerBreakdowns)
                                {
                                    <tr style="border-top: 1px solid #E3EAEF;">
                                        <td class="pl-4 font-weight-bold" style="color: #353C48; vertical-align: middle;">
                                            <i class="fas fa-bolt mr-2" style="color: #FFA117;"></i>@ch.ChargerName
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <span class="badge font-weight-600 px-2 py-1" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px;">
                                                @ch.ConnectorType
                                            </span>
                                            @if (ch.CapacityKw > 0)
                                            {
                                                <small class="font-weight-600 ml-1" style="color: #96A2B4;">(@ch.CapacityKw kW)</small>
                                            }
                                        </td>
                                        <td class="text-center font-weight-bold" style="color: #353C48; vertical-align: middle;">@ch.TotalBookings</td>
                                        <td class="text-center font-weight-bold" style="color: #3DC9B3; vertical-align: middle;">@ch.TotalEnergyKwh.ToString("N1")</td>
                                        <td class="text-right font-weight-bold" style="color: #28C76F; vertical-align: middle; font-size: 15px;">₹@ch.TotalRevenue.ToString("N0")</td>
                                        <td class="pr-4" style="vertical-align: middle;">
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 mr-2" style="height: 6px; background: #F2F2F2; border-radius: 3px;">
                                                    <div class="progress-bar" style="width: @ch.RevenueSharePercentage%; background: #28C76F; border-radius: 3px;"></div>
                                                </div>
                                                <small class="font-weight-bold" style="color: #34395E; min-width: 38px; text-align: right;">@ch.RevenueSharePercentage%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Breakdown -->
    <div class="col-lg-4 col-12 mb-4">
        <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
            <div class="card-header border-0 py-3" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
                <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
                    <i class="fas fa-wallet mr-2" style="color: #28C76F;"></i>Payment Methods
                </h6>
            </div>
            <div class="card-body p-3 p-md-4">
                @if (paymentBreakdown != null)
                {
                    @foreach (var p in paymentBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="font-weight-bold" style="color: #34395E; font-size: 13px;">
                                    @if (p.Method.ToString().Contains("UPI")) { <i class="fas fa-qrcode mr-1" style="color: #6777EF;"></i> }
                                    else if (p.Method.ToString().Contains("Cash")) { <i class="fas fa-money-bill-wave mr-1" style="color: #28C76F;"></i> }
                                    else { <i class="fas fa-credit-card mr-1" style="color: #FFA117;"></i> }
                                    @p.Method
                                </span>
                                <span class="font-weight-bold" style="color: #28C76F;">₹@p.Amount.ToString("N0") <small style="color: #96A2B4; font-weight: 500;">(@p.Count)</small></span>
                            </div>
                            <div class="progress" style="height: 6px; background: #F2F2F2; border-radius: 3px;">
                                <div class="progress-bar" style="width: @p.Share%; background: #6777EF; border-radius: 3px;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4" style="color: #96A2B4; font-weight: 500;">No transactions.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Itemized Sessions Ledger Table -->
<div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
    <div class="card-header border-0 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="background: #FFFFFF; border-bottom: 1px solid #F2F2F2 !important;">
        <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
            <i class="fas fa-receipt mr-2" style="color: #6777EF;"></i>Recent Sessions
        </h6>
        <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" 
           class="btn font-weight-bold px-3 py-1 mt-2 mt-sm-0" 
           style="background: #FFFFFF; border: 1.5px solid #28C76F; color: #28C76F; border-radius: 6px; font-size: 12px;">
            <i class="fas fa-download mr-1"></i>Export CSV
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="color: #353C48;">
                <thead style="background: #F9F9F9; border-bottom: 1.5px solid #E3EAEF; color: #34395E; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                    <tr>
                        <th class="pl-4 py-3 border-0">Ref</th>
                        <th class="py-3 border-0">Charger</th>
                        <th class="py-3 border-0">Date & Time</th>
                        <th class="py-3 border-0">Customer & Vehicle</th>
                        <th class="py-3 border-0 text-center">Energy</th>
                        <th class="py-3 border-0 text-right">Amount</th>
                        <th class="pr-4 py-3 border-0 text-center">Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentSessions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4" style="color: #96A2B4; font-weight: 500;">
                                No transactions found in this period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.RecentSessions)
                        {
                            var refCode = $"VN-{b.Id.ToString()[..8].ToUpper()}";
                            var cost = b.ActualCost ?? b.EstimatedCost;
                            <tr style="border-top: 1px solid #E3EAEF;">
                                <td class="pl-4 font-weight-bold" style="color: #6777EF; vertical-align: middle;">@refCode</td>
                                <td style="vertical-align: middle;">
                                    <span class="badge font-weight-600 px-2 py-1" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px;">
                                        @(b.Charger?.Name ?? "Charger")
                                    </span>
                                </td>
                                <td style="vertical-align: middle;">
                                    <div class="font-weight-600" style="color: #353C48;">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <small style="color: #96A2B4; font-weight: 500;">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td style="vertical-align: middle;">
                                    <div class="font-weight-bold" style="color: #353C48;">@(b.CustomerName ?? b.Customer?.Fullname ?? "Walk-In")</div>
                                    <small style="color: #96A2B4; font-weight: 500;">@(b.VehicleModel ?? b.VehicleNumberPlate ?? "EV")</small>
                                </td>
                                <td class="text-center font-weight-bold" style="color: #3DC9B3; vertical-align: middle;">@(b.UnitsConsumedKwh?.ToString("N1") ?? "—") <small style="color: #96A2B4;">kWh</small></td>
                                <td class="text-right font-weight-bold" style="color: #28C76F; vertical-align: middle; font-size: 15px;">₹@cost.ToString("N0")</td>
                                <td class="pr-4 text-center" style="vertical-align: middle;">
                                    <span class="badge font-weight-600 px-2 py-1" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; border-radius: 4px;">
                                        @(b.PaymentMethod ?? "UPI")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function applyStationPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('stStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('stEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('stGroupBy').value = group;
            document.getElementById('stationFilterForm').submit();
        }

        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRev = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let stChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Revenue (₹)',
                data: dataRev,
                borderColor: '#28C76F',
                backgroundColor: 'rgba(40, 199, 111, 0.12)',
                prefix: '₹',
                suffix: '',
                activeClass: 'active-revenue'
            },
            energy: {
                label: 'Energy (kWh)',
                data: dataEnergy,
                borderColor: '#3DC9B3',
                backgroundColor: 'rgba(61, 201, 179, 0.12)',
                prefix: '',
                suffix: ' kWh',
                activeClass: 'active-energy'
            },
            count: {
                label: 'Sessions',
                data: dataCount,
                borderColor: '#6777EF',
                backgroundColor: 'rgba(103, 119, 239, 0.12)',
                prefix: '',
                suffix: ' sessions',
                activeClass: 'active-sessions'
            },
            aov: {
                label: 'AOV (₹)',
                data: dataAov,
                borderColor: '#FFA117',
                backgroundColor: 'rgba(255, 161, 23, 0.12)',
                prefix: '₹',
                suffix: '',
                activeClass: 'active-aov'
            }
        };

        function initStationChart(metric) {
            const ctx = document.getElementById('stationTelemetryChart');
            if (!ctx) return;

            const cfg = metricConfigs[metric];
            if (stChart) {
                stChart.destroy();
            }

            stChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.borderColor,
                        backgroundColor: cfg.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: labels.length > 40 ? 1 : 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: cfg.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#34395E',
                            titleColor: '#FFFFFF',
                            bodyColor: '#FFFFFF',
                            borderColor: '#E3EAEF',
                            borderWidth: 1,
                            padding: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + cfg.label + ': ' + cfg.prefix + Number(ctx.raw).toLocaleString('en-IN') + cfg.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#F2F2F2' },
                            ticks: { color: '#96A2B4', font: { family: 'inherit', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#F2F2F2' },
                            ticks: {
                                color: '#96A2B4',
                                font: { family: 'inherit', size: 11 },
                                callback: function (val) {
                                    return cfg.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + cfg.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchStationMetric(metric) {
            const switcher = document.getElementById('stationMetricSwitcher');
            if (switcher) {
                const buttons = switcher.querySelectorAll('.btn');
                buttons.forEach(btn => {
                    btn.classList.remove('active-revenue', 'active-energy', 'active-sessions', 'active-aov');
                });
                const activeBtn = document.getElementById('btn-metric-' + metric);
                if (activeBtn) {
                    activeBtn.classList.add(metricConfigs[metric].activeClass);
                }
            }
            initStationChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (labels.length > 0) {
                initStationChart('revenue');
            }
        });
    </script>
}
