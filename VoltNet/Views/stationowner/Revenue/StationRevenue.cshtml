@model VoltNet.Controllers.stationowner.OwnerIndividualStationRevenueViewModel
@{
    ViewData["Title"] = $"{Model.Station.Name} — Revenue";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    var paymentBreakdown = ViewBag.PaymentBreakdown as dynamic;
}
<div class="sr-page">

    <!-- Header -->
    <div class="sr-head">
        <div>
            <div class="sr-title">
                <h4>@Model.Station.Name</h4>
                @if (Model.Station.Status == "Active")
                {
                    <span class="pill pill-success">Active</span>
                }
                else
                {
                    <span class="pill pill-plain">@Model.Station.Status</span>
                }
            </div>
            <div class="sr-meta">@Model.Station.Address, @Model.Station.City &bull; @Model.Station.OpeningTime.ToString(@"hh\:mm") - @Model.Station.ClosingTime.ToString(@"hh\:mm")</div>
        </div>
        <div class="sr-actions">
            <a href="/owner/revenue/station/@Model.Station.Id/export-pdf?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" class="btn btn-ghost">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
            <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" class="btn btn-back">
                <i class="fas fa-file-csv"></i> CSV
            </a>
            <a href="/owner/stations/details/@Model.Station.Id" class="btn btn-back">
                <i class="fas fa-cog"></i> Manage
            </a>
            <a href="/owner/revenue" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> All Stations
            </a>
        </div>
    </div>

    <!-- Lifetime cards -->
    <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-coins"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Today</div>
                    <div class="kpi-value">₹@Model.TodayRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.TodayBookings sessions</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-calendar-week"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">This Week</div>
                    <div class="kpi-value">₹@Model.WeekRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.WeekBookings sessions</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-info">
                <div class="kpi-icon"><i class="fas fa-calendar-alt"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">This Month</div>
                    <div class="kpi-value">₹@Model.MonthRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.MonthBookings sessions</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-warn">
                <div class="kpi-icon"><i class="fas fa-trophy"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">All-Time</div>
                    <div class="kpi-value">₹@Model.AllTimeRevenue.ToString("N0")</div>
                    <div class="kpi-note">@Model.TotalEnergyKwh.ToString("N0") kWh</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Operational highlights -->
    <div class="row">
        <div class="col-lg-4 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-indigo">
                <div class="kpi-icon"><i class="fas fa-plug"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Top Charger</div>
                    <div class="kpi-value sm" title="@Model.TopChargerName">@Model.TopChargerName</div>
                    <div class="kpi-note">
                        <span class="pill pill-plain">@Model.TopChargerConnector</span>
                        <strong>₹@Model.TopChargerRevenue.ToString("N0")</strong>
                        <span>(@Model.TopChargerSharePct%)</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12 gap-b">
            <div class="card kpi kpi-red">
                <div class="kpi-icon"><i class="fas fa-fire"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Peak Hour</div>
                    <div class="kpi-value sm">@Model.PeakHourRange</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-12 col-12 gap-b">
            <div class="card kpi kpi-teal">
                <div class="kpi-icon"><i class="fas fa-bolt"></i></div>
                <div class="kpi-text">
                    <div class="kpi-label">Bay Utilization</div>
                    <div class="kpi-value sm">@Model.UtilizationPct%</div>
                    <div class="share mt-1">
                        <div class="progress" aria-hidden="true">
                            <div class="progress-bar bar-teal" role="progressbar" style="width: @Model.UtilizationPct%;" aria-valuenow="@Model.UtilizationPct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="kpi-note">@Model.Station.Chargers?.Count bays</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Date filter -->
    <div class="card gap-b">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Date Filter</h5>
            <div class="chips">
                <button type="button" class="btn chip" onclick="applyStationPreset(7, 'day')">7 Days</button>
                <button type="button" class="btn chip" onclick="applyStationPreset(30, 'day')">30 Days</button>
                <button type="button" class="btn chip" onclick="applyStationPreset(90, 'week')">90 Days</button>
                <button type="button" class="btn chip" onclick="applyStationPreset(365, 'month')">1 Year</button>
            </div>
        </div>
        <div class="card-body">
            <form method="get" action="/owner/revenue/station/@Model.Station.Id" id="stationFilterForm" class="row align-items-end">
                <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                    <label class="form-label">From</label>
                    <input type="date" name="startDate" id="stStartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-sm-6 col-lg-4 mb-3 mb-lg-0">
                    <label class="form-label">To</label>
                    <input type="date" name="endDate" id="stEndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 mb-3 mb-lg-0">
                    <label class="form-label">Interval</label>
                    <select name="groupBy" id="stGroupBy" class="form-control">
                        <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                        <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                        <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-main"><i class="fas fa-filter"></i> Apply</button>
                        <a href="/owner/revenue/station/@Model.Station.Id" class="btn btn-back btn-icon" title="Reset Filters" aria-label="Reset Filters">
                            <i class="fas fa-redo"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Period tiles -->
    <div class="row">
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card tile tile-success">
                <div class="tile-label">Period Revenue</div>
                <div class="tile-value">₹@Model.PeriodRevenue.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card tile tile-indigo">
                <div class="tile-label">Sessions</div>
                <div class="tile-value">@Model.PeriodBookings</div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card tile tile-teal">
                <div class="tile-label">Energy</div>
                <div class="tile-value">@Model.PeriodEnergyKwh.ToString("N1") <small>kWh</small></div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 col-12 gap-b">
            <div class="card tile tile-warn">
                <div class="tile-label">Avg Order Value</div>
                <div class="tile-value">₹@Model.PeriodAvgTicket.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- Time-series chart -->
    <div class="card gap-b">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Revenue & Telemetry</h5>
            <div class="chips" id="stationMetricSwitcher">
                <button type="button" class="btn chip active-revenue" id="btn-metric-revenue" onclick="switchStationMetric('revenue')">Revenue</button>
                <button type="button" class="btn chip" id="btn-metric-energy" onclick="switchStationMetric('energy')">Energy</button>
                <button type="button" class="btn chip" id="btn-metric-count" onclick="switchStationMetric('count')">Sessions</button>
                <button type="button" class="btn chip" id="btn-metric-aov" onclick="switchStationMetric('aov')">AOV</button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.PeriodRevenue == 0)
            {
                <div class="chart-empty">No session data in this period.</div>
            }
            else
            {
                <div class="chart-box">
                    <canvas id="stationTelemetryChart"></canvas>
                </div>
            }
        </div>
    </div>

    <!-- Charger breakdown and payment split -->
    <div class="row">
        <div class="col-lg-8 col-12 gap-b">
            <div class="card h-100">
                <div class="card-header"><h5>Charger Earnings</h5></div>
                <div class="card-body flush">
                    <div class="table-responsive">
                        <table class="table align-middle no-datatable table-responsive-cards">
                            <thead>
                                <tr>
                                    <th>Charger</th>
                                    <th>Connector</th>
                                    <th class="text-center">Sessions</th>
                                    <th class="text-center">kWh</th>
                                    <th class="text-right">Revenue</th>
                                    <th>Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.ChargerBreakdowns.Any())
                                {
                                    <tr><td colspan="6" class="cell-empty">No chargers configured.</td></tr>
                                }
                                else
                                {
                                    @foreach (var ch in Model.ChargerBreakdowns)
                                    {
                                        <tr>
                                            <td class="col-primary" data-label="Charger">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span class="cell-strong">@ch.ChargerName</span>
                                                    <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                        <i data-feather="chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Connector">
                                                <div>
                                                    <span class="pill pill-plain">@ch.ConnectorType</span>
                                                    @if (ch.CapacityKw > 0)
                                                    {
                                                        <span class="cell-sub">(@ch.CapacityKw kW)</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="col-secondary text-center" data-label="Sessions"><div class="cell-strong">@ch.TotalBookings</div></td>
                                            <td class="col-secondary text-center" data-label="Energy (kWh)"><div class="cell-kwh">@ch.TotalEnergyKwh.ToString("N1")</div></td>
                                            <td class="text-right" data-label="Revenue"><div class="cell-money">₹@ch.TotalRevenue.ToString("N0")</div></td>
                                            <td class="col-secondary" data-label="Share">
                                                <div class="share">
                                                    <div class="progress"><div class="progress-bar bar-green" style="width: @ch.RevenueSharePercentage%;"></div></div>
                                                    <span>@ch.RevenueSharePercentage%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-12 gap-b">
            <div class="card h-100">
                <div class="card-header"><h5>Payment Methods</h5></div>
                <div class="card-body">
                    @if (paymentBreakdown != null)
                    {
                        @foreach (var p in paymentBreakdown)
                        {
                            <div class="pay-row">
                                <div class="pay-top">
                                    <span>@p.Method</span>
                                    <span class="amt">₹@p.Amount.ToString("N0") <span class="cnt">(@p.Count)</span></span>
                                </div>
                                <div class="share">
                                    <div class="progress"><div class="progress-bar bar-indigo" style="width: @p.Share%;"></div></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="chart-empty">No transactions.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent sessions -->
    <div class="card gap-b">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Recent Sessions</h5>
            <a href="/owner/revenue/station/@Model.Station.Id/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))" class="btn btn-ghost">
                <i class="fas fa-download"></i> Export CSV
            </a>
        </div>
        <div class="card-body flush">
            <div class="table-responsive">
                <table class="table align-middle no-datatable table-responsive-cards">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Charger</th>
                            <th>Date & Time</th>
                            <th>Customer</th>
                            <th class="text-center">Energy</th>
                            <th class="text-right">Amount</th>
                            <th class="text-center">Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentSessions.Any())
                        {
                            <tr><td colspan="7" class="cell-empty">No transactions found in this period.</td></tr>
                        }
                        else
                        {
                            @foreach (var b in Model.RecentSessions)
                            {
                                var refCode = $"VN-{b.Id.ToString()[..8].ToUpper()}";
                                var cost = b.ActualCost ?? b.EstimatedCost;
                                <tr>
                                    <td class="col-primary" data-label="Ref">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="cell-ref">@refCode</span>
                                            <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                <i data-feather="chevron-down"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Charger">
                                        <div><span class="pill pill-plain">@(b.Charger?.Name ?? "Charger")</span></div>
                                    </td>
                                    <td data-label="Date & Time">
                                        <div>
                                            <div class="cell-strong">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                            <div class="cell-sub">@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</div>
                                        </div>
                                    </td>
                                    <td class="col-secondary" data-label="Customer & Vehicle">
                                        <div>
                                            <div class="cell-strong">@(b.CustomerName ?? b.Customer?.Fullname ?? "Walk-In")</div>
                                            <div class="cell-sub">@(b.VehicleModel ?? b.VehicleNumberPlate ?? "EV")</div>
                                        </div>
                                    </td>
                                    <td class="col-secondary text-center" data-label="Energy">
                                        <div class="cell-kwh">@(b.UnitsConsumedKwh?.ToString("N1") ?? "—") <span class="cell-sub">kWh</span></div>
                                    </td>
                                    <td class="text-right" data-label="Amount"><div class="cell-money">₹@cost.ToString("N0")</div></td>
                                    <td class="col-secondary text-center" data-label="Payment">
                                        <div><span class="pill pill-plain">@(b.PaymentMethod ?? "UPI")</span></div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function applyStationPreset(days, group) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - (days - 1));

            document.getElementById('stStartDate').value = start.toISOString().split('T')[0];
            document.getElementById('stEndDate').value = end.toISOString().split('T')[0];
            document.getElementById('stGroupBy').value = group;
            document.getElementById('stationFilterForm').submit();
        }

        const labels = @Html.Raw(Model.ChartLabelsJson);
        const dataRev = @Html.Raw(Model.ChartRevenueJson);
        const dataEnergy = @Html.Raw(Model.ChartEnergyJson);
        const dataCount = @Html.Raw(Model.ChartCountJson);
        const dataAov = @Html.Raw(Model.ChartAovJson);

        let stChart = null;

        const metricConfigs = {
            revenue: {
                label: 'Revenue (₹)',
                data: dataRev,
                borderColor: '#6777EF',
                backgroundColor: 'rgba(103, 119, 239, 0.12)',
                prefix: '₹',
                suffix: '',
                activeClass: 'active-revenue'
            },
            energy: {
                label: 'Energy (kWh)',
                data: dataEnergy,
                borderColor: '#3ABAF4',
                backgroundColor: 'rgba(58, 186, 244, 0.12)',
                prefix: '',
                suffix: ' kWh',
                activeClass: 'active-energy'
            },
            count: {
                label: 'Sessions',
                data: dataCount,
                borderColor: '#3DC9B3',
                backgroundColor: 'rgba(61, 201, 179, 0.12)',
                prefix: '',
                suffix: ' sessions',
                activeClass: 'active-sessions'
            },
            aov: {
                label: 'AOV (₹)',
                data: dataAov,
                borderColor: '#34395E',
                backgroundColor: 'rgba(52, 57, 94, 0.10)',
                prefix: '₹',
                suffix: '',
                activeClass: 'active-aov'
            }
        };

        function initStationChart(metric) {
            const ctx = document.getElementById('stationTelemetryChart');
            if (!ctx) return;

            const cfg = metricConfigs[metric];
            if (stChart) {
                stChart.destroy();
            }

            stChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.borderColor,
                        backgroundColor: cfg.backgroundColor,
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: labels.length > 40 ? 1 : 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: cfg.borderColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#34395E',
                            titleColor: '#FFFFFF',
                            bodyColor: '#FFFFFF',
                            borderColor: '#E3EAEF',
                            borderWidth: 1,
                            padding: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + cfg.label + ': ' + cfg.prefix + Number(ctx.raw).toLocaleString('en-IN') + cfg.suffix;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#E3EAEF' },
                            ticks: { color: '#34395E', font: { family: 'inherit', size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#E3EAEF' },
                            ticks: {
                                color: '#34395E',
                                font: { family: 'inherit', size: 11 },
                                callback: function (val) {
                                    return cfg.prefix + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val) + cfg.suffix;
                                }
                            }
                        }
                    }
                }
            });
        }

        function switchStationMetric(metric) {
            const switcher = document.getElementById('stationMetricSwitcher');
            if (switcher) {
                const buttons = switcher.querySelectorAll('.btn');
                buttons.forEach(btn => {
                    btn.classList.remove('active-revenue', 'active-energy', 'active-sessions', 'active-aov');
                });
                const activeBtn = document.getElementById('btn-metric-' + metric);
                if (activeBtn) {
                    activeBtn.classList.add(metricConfigs[metric].activeClass);
                }
            }
            initStationChart(metric);
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (labels.length > 0) {
                initStationChart('revenue');
            }
        });
    </script>
}