@model VoltNet.Controllers.stationowner.OwnerRevenueViewModel
@{
    ViewData["Title"] = "Owner Revenue Analytics";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}
<div class="ra-page">

    <div class="ra-head">
        <h4>Revenue Analytics</h4>
        @if (Model.HasStations)
        {
            <div class="ra-actions">
                <a href="/owner/revenue/export-pdf?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))&stationId=@(Model.SelectedStationId)" class="btn btn-ghost">
                    <i class="fas fa-file-pdf"></i> Download PDF
                </a>
                <a href="/owner/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))&stationId=@(Model.SelectedStationId)" class="btn btn-back">
                    <i class="fas fa-file-csv"></i> Export CSV
                </a>
            </div>
        }
    </div>

    @if (!Model.HasStations)
    {
        <div class="card">
            <div class="card-body empty-box">
                <h5>No Stations Registered</h5>
                <a href="/owner/stations/create" class="btn btn-main">
                    <i class="fas fa-plus"></i> Add Your First Station
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Summary cards -->
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
                <div class="card kpi kpi-indigo">
                    <div class="kpi-icon"><i class="fas fa-coins"></i></div>
                    <div class="kpi-text">
                        <div class="kpi-label">Today</div>
                        <div class="kpi-value">₹@Model.TodayRevenue.ToString("N0")</div>
                        <div class="kpi-note"><span class="pill pill-indigo">@Model.TodayBookings sessions</span></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
                <div class="card kpi kpi-teal">
                    <div class="kpi-icon"><i class="fas fa-calendar-week"></i></div>
                    <div class="kpi-text">
                        <div class="kpi-label">This Week</div>
                        <div class="kpi-value">₹@Model.WeekRevenue.ToString("N0")</div>
                        <div class="kpi-note"><span class="pill pill-teal">@Model.WeekBookings sessions</span></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
                <div class="card kpi kpi-info">
                    <div class="kpi-icon"><i class="fas fa-calendar-alt"></i></div>
                    <div class="kpi-text">
                        <div class="kpi-label">This Month</div>
                        <div class="kpi-value">₹@Model.MonthRevenue.ToString("N0")</div>
                        <div class="kpi-note"><span class="pill pill-info">@Model.MonthBookings sessions</span></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 col-12 gap-b">
                <div class="card kpi kpi-warn">
                    <div class="kpi-icon"><i class="fas fa-trophy"></i></div>
                    <div class="kpi-text">
                        <div class="kpi-label">All-Time</div>
                        <div class="kpi-value">₹@Model.AllTimeRevenue.ToString("N0")</div>
                        <div class="kpi-note"><span class="pill pill-warn">@Model.AllTimeBookings sessions</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card gap-b">
            <div class="card-body">
                <form method="get" action="/owner/revenue" class="row align-items-end">
                    <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0">
                        <label class="form-label">Station</label>
                        <select name="stationId" class="form-control">
                            <option value="">All Stations (@Model.OwnedStations.Count)</option>
                            @foreach (var s in Model.OwnedStations)
                            {
                                if (Model.SelectedStationId.HasValue && Model.SelectedStationId.Value == s.Id)
                                {
                                    <option value="@s.Id" selected>@s.Name (@s.City)</option>
                                }
                                else
                                {
                                    <option value="@s.Id">@s.Name (@s.City)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2 mb-3 mb-lg-0">
                        <label class="form-label">From</label>
                        <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2 mb-3 mb-lg-0">
                        <label class="form-label">To</label>
                        <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12 col-md-4 col-lg-2 mb-3 mb-lg-0">
                        <label class="form-label">Interval</label>
                        <select name="groupBy" class="form-control">
                            <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                            <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                            <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                        </select>
                    </div>
                    <div class="col-12 col-md-8 col-lg-3">
                        <div class="filter-actions">
                            <button type="submit" class="btn btn-main">
                                <i class="fas fa-filter"></i> Apply
                            </button>
                            <a href="/owner/revenue" class="btn btn-back btn-icon" title="Reset Filters" aria-label="Reset Filters">
                                <i class="fas fa-redo"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Period highlights -->
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-3 gap-b">
                <div class="card tile tile-success">
                    <div class="tile-label">Period Revenue</div>
                    <div class="tile-value">₹@Model.PeriodRevenue.ToString("N0")</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 gap-b">
                <div class="card tile tile-indigo">
                    <div class="tile-label">Sessions</div>
                    <div class="tile-value">@Model.PeriodBookings</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 gap-b">
                <div class="card tile tile-teal">
                    <div class="tile-label">Energy</div>
                    <div class="tile-value">@Model.PeriodUnitsKWh.ToString("N1") <small>kWh</small></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 gap-b">
                <div class="card tile tile-warn">
                    <div class="tile-label">Avg Order Value</div>
                    <div class="tile-value">₹@Model.PeriodAvgTicket.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row">
            <div class="col-lg-6 col-12 gap-b">
                <div class="card h-100">
                    <div class="card-header"><h5>Revenue by Station</h5></div>
                    <div class="card-body">
                        @if (Model.PeriodRevenue == 0)
                        {
                            <div class="chart-empty">No revenue data recorded.</div>
                        }
                        else
                        {
                            <div class="chart-box">
                                <canvas id="stationBreakdownChart"></canvas>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-12 gap-b">
                <div class="card h-100">
                    <div class="card-header"><h5>Daily Trend</h5></div>
                    <div class="card-body">
                        @if (Model.PeriodRevenue == 0)
                        {
                            <div class="chart-empty">No revenue data recorded.</div>
                        }
                        else
                        {
                            <div class="chart-box">
                                <canvas id="dailyTrendChart"></canvas>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Station comparison -->
        <div class="card gap-b">
            <div class="card-header">
                <h5>Station Comparison</h5>
            </div>
            <div class="card-body flush">
                <div class="table-responsive">
                    <table class="table align-middle no-datatable table-responsive-cards">
                        <thead>
                            <tr>
                                <th>Station</th>
                                <th>Location</th>
                                <th class="text-center">Bookings</th>
                                <th class="text-center">kWh</th>
                                <th class="text-right">Revenue</th>
                                <th>Share</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.StationComparisons.Any() || Model.StationComparisons.All(s => s.TotalRevenue == 0))
                            {
                                <tr>
                                    <td colspan="7" class="cell-empty">No completed bookings in this date range.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var station in Model.StationComparisons)
                                {
                                    <tr>
                                        <td class="col-primary" data-label="Station">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="cell-strong">@station.StationName</span>
                                                <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                    <i data-feather="chevron-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="col-secondary" data-label="Location">
                                            <div>
                                                <span class="pill pill-plain">@station.City</span>
                                                <div class="cell-sub mt-1">@station.Address</div>
                                            </div>
                                        </td>
                                        <td class="col-secondary text-center" data-label="Bookings"><div class="cell-strong">@station.TotalBookings</div></td>
                                        <td class="col-secondary text-center" data-label="Energy (kWh)"><div class="cell-kwh">@station.TotalUnitsKWh.ToString("N1")</div></td>
                                        <td class="text-right" data-label="Revenue"><div class="cell-money">₹@station.TotalRevenue.ToString("N2")</div></td>
                                        <td class="col-secondary" data-label="Revenue Share">
                                            <div class="share">
                                                <div class="progress">
                                                    <div class="progress-bar bar" role="progressbar"
                                                         style="width: @(station.RevenueSharePercentage)%;"
                                                         aria-valuenow="@(station.RevenueSharePercentage)" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span>@(station.RevenueSharePercentage)%</span>
                                            </div>
                                        </td>
                                        <td class="text-center col-action" data-label="Actions">
                                            <div class="table-actions">
                                                <a href="/owner/revenue/station/@station.StationId" class="btn btn-main" title="View Station Revenue Intelligence">
                                                    <i class="fas fa-chart-line"></i> Analytics
                                                </a>
                                                <a href="/owner/stations/details/@station.StationId" class="btn btn-back btn-icon" title="Station Settings & Profile" aria-label="Station Settings">
                                                    <i class="fas fa-cog"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @if (Model.HasStations && Model.PeriodRevenue > 0)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // 1. Station Breakdown Bar Chart
                const stationLabels = @Html.Raw(Model.StationChartLabelsJson);
                const stationData = @Html.Raw(Model.StationChartDataJson);

                const ctxBreakdown = document.getElementById('stationBreakdownChart');
                if (ctxBreakdown) {
                    new Chart(ctxBreakdown.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: stationLabels,
                            datasets: [{
                                label: 'Revenue (₹)',
                                data: stationData,
                                backgroundColor: 'rgba(103, 119, 239, 0.85)',
                                borderColor: '#6777EF',
                                hoverBackgroundColor: '#34395E',
                                borderWidth: 1,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#353C48',
                                    titleColor: '#FFFFFF',
                                    bodyColor: '#FFFFFF',
                                    padding: 10,
                                    cornerRadius: 6,
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#34395E', font: { weight: '500' } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: '#E3EAEF' },
                                    ticks: {
                                        color: '#34395E',
                                        font: { weight: '500' },
                                        callback: function (val) {
                                            return '₹' + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // 2. Daily Trend Line Chart
                const trendLabels = @Html.Raw(Model.TrendChartLabelsJson);
                const trendData = @Html.Raw(Model.TrendChartDataJson);

                const ctxTrend = document.getElementById('dailyTrendChart');
                if (ctxTrend) {
                    new Chart(ctxTrend.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: trendLabels,
                            datasets: [{
                                label: 'Daily Revenue (₹)',
                                data: trendData,
                                borderColor: '#3DC9B3',
                                backgroundColor: 'rgba(61, 201, 179, 0.15)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointRadius: trendLabels.length > 30 ? 2 : 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#3DC9B3',
                                pointBorderColor: '#FFFFFF',
                                pointBorderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#353C48',
                                    titleColor: '#FFFFFF',
                                    bodyColor: '#FFFFFF',
                                    padding: 10,
                                    cornerRadius: 6,
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Daily Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#34395E', font: { weight: '500' } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: '#E3EAEF' },
                                    ticks: {
                                        color: '#34395E',
                                        font: { weight: '500' },
                                        callback: function (val) {
                                            return '₹' + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}