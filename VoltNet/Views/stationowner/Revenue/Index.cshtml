@model VoltNet.Controllers.stationowner.OwnerRevenueViewModel
@{
    ViewData["Title"] = "Owner Revenue Analytics";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-1 text-primary"><i class="fas fa-chart-line mr-2"></i>Multi-Station Revenue Analytics</h4>
                <p class="text-muted mb-0">Consolidated financial performance, bay earnings, and energy monetization across your charging network.</p>
            </div>
            <div>
                @if (Model.HasStations)
                {
                    <a href="/owner/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))&stationId=@(Model.SelectedStationId)" class="btn btn-outline-success btn-lg shadow-sm">
                        <i class="fas fa-file-csv mr-2"></i>Export to CSV
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.HasStations)
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <div class="mb-3">
                <i class="fas fa-charging-station fa-4x text-muted opacity-50"></i>
            </div>
            <h5 class="text-secondary">No Stations Registered</h5>
            <p class="text-muted">You haven't registered any charging stations under this account yet. Once stations are created and bookings complete, revenue reports will automatically appear here.</p>
            <a href="/owner/stations/create" class="btn btn-primary"><i class="fas fa-plus mr-1"></i> Add Your First Station</a>
        </div>
    </div>
}
else
{
    <!-- Macro Summary Cards -->
    <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
            <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color:#fff;">
                <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                    <i class="fas fa-coins fa-2x text-white"></i>
                </div>
                <div class="card-wrap p-3">
                    <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">Today's Revenue</div>
                    <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.TodayRevenue.ToString("N0")</div>
                    <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.TodayBookings completed sessions</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
            <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color:#fff;">
                <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                    <i class="fas fa-calendar-week fa-2x text-white"></i>
                </div>
                <div class="card-wrap p-3">
                    <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">This Week</div>
                    <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.WeekRevenue.ToString("N0")</div>
                    <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
            <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%); color:#fff;">
                <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                    <i class="fas fa-calendar-alt fa-2x text-white"></i>
                </div>
                <div class="card-wrap p-3">
                    <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">This Month</div>
                    <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.MonthRevenue.ToString("N0")</div>
                    <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12 mb-4">
            <div class="card card-statistic-1 border-0 shadow-sm" style="border-radius:12px; background:linear-gradient(135deg, #f857a6 0%, #ff5858 100%); color:#fff;">
                <div class="card-icon" style="background:rgba(255,255,255,0.15); border-radius:12px; margin:15px;">
                    <i class="fas fa-trophy fa-2x text-white"></i>
                </div>
                <div class="card-wrap p-3">
                    <div class="card-header p-0" style="color:rgba(255,255,255,0.85); font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">All-Time Earnings</div>
                    <div class="card-body p-0 mt-1 font-weight-bold" style="font-size:26px; color:#fff;">₹@Model.AllTimeRevenue.ToString("N0")</div>
                    <small style="color:rgba(255,255,255,0.75);"><i class="fas fa-bolt mr-1"></i>@Model.AllTimeBookings total sessions</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
        <div class="card-body p-3">
            <form method="get" action="/owner/revenue" class="row align-items-end">
                <div class="col-lg-3 col-md-3 col-sm-12 mb-2 mb-md-0">
                    <label class="font-weight-bold text-muted small mb-1"><i class="fas fa-charging-station mr-1"></i>Filter by Station</label>
                    <select name="stationId" class="form-control selectric">
                        <option value="">All Stations (@Model.OwnedStations.Count Stations)</option>
                        @foreach (var s in Model.OwnedStations)
                        {
                            if (Model.SelectedStationId.HasValue && Model.SelectedStationId.Value == s.Id)
                            {
                                <option value="@s.Id" selected>@s.Name (@s.City)</option>
                            }
                            else
                            {
                                <option value="@s.Id">@s.Name (@s.City)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label class="font-weight-bold text-muted small mb-1"><i class="fas fa-calendar mr-1"></i>From Date</label>
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label class="font-weight-bold text-muted small mb-1"><i class="fas fa-calendar mr-1"></i>To Date</label>
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label class="font-weight-bold text-muted small mb-1"><i class="fas fa-layer-group mr-1"></i>Interval</label>
                    <select name="groupBy" class="form-control">
                        <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                        <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                        <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-12 col-sm-12 d-flex mt-2 mt-lg-0">
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-filter mr-1"></i>Apply Filter</button>
                    <a href="/owner/revenue" class="btn btn-light ml-2" title="Reset Filters"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Filtered Range Highlights -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-2">
            <div class="card bg-light border-0 p-3 text-center" style="border-radius:10px;">
                <span class="text-muted small text-uppercase font-weight-bold">Selected Window Revenue</span>
                <h4 class="text-success font-weight-bold mb-0 mt-1">₹@Model.PeriodRevenue.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="card bg-light border-0 p-3 text-center" style="border-radius:10px;">
                <span class="text-muted small text-uppercase font-weight-bold">Charging Bookings</span>
                <h4 class="text-primary font-weight-bold mb-0 mt-1">@Model.PeriodBookings</h4>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="card bg-light border-0 p-3 text-center" style="border-radius:10px;">
                <span class="text-muted small text-uppercase font-weight-bold">Total Energy Dispensed</span>
                <h4 class="text-info font-weight-bold mb-0 mt-1">@Model.PeriodUnitsKWh.ToString("N1") kWh</h4>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="card bg-light border-0 p-3 text-center" style="border-radius:10px;">
                <span class="text-muted small text-uppercase font-weight-bold">Avg Order Value (AOV)</span>
                <h4 class="text-warning font-weight-bold mb-0 mt-1">₹@Model.PeriodAvgTicket.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <!-- Visual Charts Row -->
    <div class="row">
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius:12px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-chart-bar text-primary mr-2"></i>Revenue Breakdown by Station</h5>
                    <small class="text-muted">Earnings distribution across your active stations in the selected date range</small>
                </div>
                <div class="card-body">
                    @if (Model.PeriodRevenue == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-chart-pie fa-3x mb-2 text-black-50"></i>
                            <p>No revenue data recorded for this date range.</p>
                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 320px;">
                            <canvas id="stationBreakdownChart"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius:12px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-chart-area text-success mr-2"></i>Daily Revenue Trend</h5>
                    <small class="text-muted">Daily earnings progression across selected stations</small>
                </div>
                <div class="card-body">
                    @if (Model.PeriodRevenue == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-chart-line fa-3x mb-2 text-black-50"></i>
                            <p>No revenue data recorded for this date range.</p>
                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 320px;">
                            <canvas id="dailyTrendChart"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Station Comparison Table -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-0 text-dark font-weight-bold"><i class="fas fa-table text-info mr-2"></i>Station Comparison Matrix</h5>
                <small class="text-muted">Comparative operational & monetization breakdown across all your stations</small>
            </div>
            <span class="badge badge-primary px-3 py-2">@Model.StationComparisons.Count Station(s) Listed</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Station Name</th>
                            <th>City & Location</th>
                            <th class="text-center">Bookings</th>
                            <th class="text-center">Energy (kWh)</th>
                            <th class="text-right">Total Revenue</th>
                            <th style="width: 220px;">Revenue Share</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.StationComparisons.Any() || Model.StationComparisons.All(s => s.TotalRevenue == 0))
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fas fa-info-circle mr-1"></i> No completed booking revenue recorded for your stations yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var station in Model.StationComparisons)
                            {
                                <tr>
                                    <td class="font-weight-bold text-dark">
                                        <i class="fas fa-charging-station text-primary mr-2"></i>@station.StationName
                                    </td>
                                    <td>
                                        <span class="badge badge-light border"><i class="fas fa-map-marker-alt text-danger mr-1"></i>@station.City</span>
                                        <div class="small text-muted text-truncate" style="max-width: 200px;">@station.Address</div>
                                    </td>
                                    <td class="text-center font-weight-bold">@station.TotalBookings</td>
                                    <td class="text-center font-weight-bold text-info">@station.TotalUnitsKWh.ToString("N1")</td>
                                    <td class="text-right font-weight-bold text-success font-size-16">₹@station.TotalRevenue.ToString("N2")</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 mr-2" style="height: 8px; border-radius: 4px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @(station.RevenueSharePercentage)%;" aria-valuenow="@(station.RevenueSharePercentage)" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="font-weight-bold small">@(station.RevenueSharePercentage)%</span>
                                        </div>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a href="/owner/revenue/station/@station.StationId" class="btn btn-sm btn-success font-weight-bold mr-1" title="View Station Revenue Intelligence">
                                            <i class="fas fa-chart-line mr-1"></i>Station Analytics
                                        </a>
                                        <a href="/owner/stations/details/@station.StationId" class="btn btn-sm btn-outline-primary" title="Station Settings & Profile">
                                            <i class="fas fa-cog"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @if (Model.HasStations && Model.PeriodRevenue > 0)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // 1. Station Breakdown Bar Chart
                const stationLabels = @Html.Raw(Model.StationChartLabelsJson);
                const stationData = @Html.Raw(Model.StationChartDataJson);

                const ctxBreakdown = document.getElementById('stationBreakdownChart');
                if (ctxBreakdown) {
                    new Chart(ctxBreakdown.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: stationLabels,
                            datasets: [{
                                label: 'Revenue (₹)',
                                data: stationData,
                                backgroundColor: 'rgba(54, 162, 235, 0.75)',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                borderWidth: 1.5,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function (val) {
                                            return '₹' + val.toLocaleString('en-IN');
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // 2. Daily Trend Line Chart
                const trendLabels = @Html.Raw(Model.TrendChartLabelsJson);
                const trendData = @Html.Raw(Model.TrendChartDataJson);

                const ctxTrend = document.getElementById('dailyTrendChart');
                if (ctxTrend) {
                    const gradient = ctxTrend.getContext('2d').createLinearGradient(0, 0, 0, 300);
                    gradient.addColorStop(0, 'rgba(46, 204, 113, 0.45)');
                    gradient.addColorStop(1, 'rgba(46, 204, 113, 0.0)');

                    new Chart(ctxTrend.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: trendLabels,
                            datasets: [{
                                label: 'Daily Revenue (₹)',
                                data: trendData,
                                borderColor: '#2ecc71',
                                backgroundColor: gradient,
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointRadius: 3,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#2ecc71'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Daily Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function (val) {
                                            return '₹' + val.toLocaleString('en-IN');
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}
