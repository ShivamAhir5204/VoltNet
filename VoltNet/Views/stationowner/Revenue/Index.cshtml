@model VoltNet.Controllers.stationowner.OwnerRevenueViewModel
@{
    ViewData["Title"] = "Owner Revenue Analytics";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between mb-4">
            <div>
                <h4 class="mb-1 font-weight-bold" style="color: #353C48; font-size: 22px;">
                    <i class="fas fa-chart-line mr-2" style="color: #6777EF;"></i>Revenue Analytics
                </h4>
                <div class="font-weight-500" style="color: #96A2B4; font-size: 13px;">
                    Consolidated financial and operational overview across all stations.
                </div>
            </div>
            @if (Model.HasStations)
            {
                <div class="action-btns mt-3 mt-sm-0">
                    <a href="/owner/revenue/export?startDate=@(Model.StartDate.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate.ToString("yyyy-MM-dd"))&stationId=@(Model.SelectedStationId)" 
                       class="btn font-weight-bold px-3 py-2 shadow-sm" 
                       style="background: #FFFFFF; border: 1.5px solid #28C76F; color: #28C76F; border-radius: 6px; font-size: 13px;">
                        <i class="fas fa-download mr-1"></i>Export CSV
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.HasStations)
{
    <div class="card shadow-sm border-0" style="border: 1px solid #E3EAEF !important; border-radius: 10px;">
        <div class="card-body text-center py-5">
            <div class="mb-3">
                <i class="fas fa-charging-station fa-4x" style="color: #96A2B4; opacity: 0.6;"></i>
            </div>
            <h5 class="font-weight-bold" style="color: #353C48;">No Stations Registered</h5>
            <p class="font-weight-500 max-w-500 mx-auto" style="color: #96A2B4; max-width: 500px;">
                You haven't registered any charging stations under this account yet. Once stations are created and bookings complete, revenue reports will automatically appear here.
            </p>
            <a href="/owner/stations/create" class="btn font-weight-bold px-4 py-2" style="background: #6777EF; color: #FFFFFF; border-radius: 6px;">
                <i class="fas fa-plus mr-1"></i> Add Your First Station
            </a>
        </div>
    </div>
}
else
{
    <!-- Macro Summary Cards (Otika Theme Palette) -->
    <div class="row">
        <!-- Today's Revenue -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
            <div class="revenue-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-label">Today</div>
                    <div class="stat-icon-box" style="background: rgba(103, 119, 239, 0.12); color: #6777EF;">
                        <i class="fas fa-coins"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value">₹@Model.TodayRevenue.ToString("N0")</div>
                    <div class="mt-2">
                        <span class="stat-badge" style="background: rgba(40, 199, 111, 0.12); color: #28C76F;">
                            <i class="fas fa-bolt mr-1"></i>@Model.TodayBookings sessions
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Week -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
            <div class="revenue-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-label">This Week</div>
                    <div class="stat-icon-box" style="background: rgba(61, 201, 179, 0.12); color: #3DC9B3;">
                        <i class="fas fa-calendar-week"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value">₹@Model.WeekRevenue.ToString("N0")</div>
                    <div class="mt-2">
                        <span class="stat-badge" style="background: rgba(61, 201, 179, 0.12); color: #3DC9B3;">
                            <i class="fas fa-bolt mr-1"></i>@Model.WeekBookings sessions
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Month -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
            <div class="revenue-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-label">This Month</div>
                    <div class="stat-icon-box" style="background: rgba(58, 186, 244, 0.12); color: #3ABAF4;">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value">₹@Model.MonthRevenue.ToString("N0")</div>
                    <div class="mt-2">
                        <span class="stat-badge" style="background: rgba(58, 186, 244, 0.12); color: #3ABAF4;">
                            <i class="fas fa-bolt mr-1"></i>@Model.MonthBookings sessions
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- All-Time Earnings -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-12 mb-4">
            <div class="revenue-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-label">All-Time</div>
                    <div class="stat-icon-box" style="background: rgba(255, 161, 23, 0.12); color: #FFA117;">
                        <i class="fas fa-trophy"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value">₹@Model.AllTimeRevenue.ToString("N0")</div>
                    <div class="mt-2">
                        <span class="stat-badge" style="background: rgba(255, 161, 23, 0.12); color: #FFA117;">
                            <i class="fas fa-bolt mr-1"></i>@Model.AllTimeBookings sessions
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar (Clean Otika Palette & Responsive Layout) -->
    <div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="/owner/revenue" class="row align-items-end">
                <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0">
                    <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 13px;">
                        <i class="fas fa-charging-station mr-1" style="color: #6777EF;"></i>Filter by Station
                    </label>
                    <select name="stationId" class="form-control" style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #353C48; border-radius: 6px; font-weight: 600;">
                        <option value="">All Stations (@Model.OwnedStations.Count Stations)</option>
                        @foreach (var s in Model.OwnedStations)
                        {
                            if (Model.SelectedStationId.HasValue && Model.SelectedStationId.Value == s.Id)
                            {
                                <option value="@s.Id" selected>@s.Name (@s.City)</option>
                            }
                            else
                            {
                                <option value="@s.Id">@s.Name (@s.City)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2 mb-3 mb-lg-0">
                    <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 13px;">
                        <i class="fas fa-calendar mr-1" style="color: #6777EF;"></i>From Date
                    </label>
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" 
                           style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #353C48; border-radius: 6px; font-weight: 600;" />
                </div>
                <div class="col-6 col-md-3 col-lg-2 mb-3 mb-lg-0">
                    <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 13px;">
                        <i class="fas fa-calendar mr-1" style="color: #6777EF;"></i>To Date
                    </label>
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" 
                           style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #353C48; border-radius: 6px; font-weight: 600;" />
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3 mb-lg-0">
                    <label class="font-weight-bold mb-1" style="color: #34395E; font-size: 13px;">
                        <i class="fas fa-layer-group mr-1" style="color: #6777EF;"></i>Interval
                    </label>
                    <select name="groupBy" class="form-control" style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #353C48; border-radius: 6px; font-weight: 600;">
                        <!option value="day" @(Model.GroupBy == "day" ? "selected" : "")>Daily</!option>
                        <!option value="week" @(Model.GroupBy == "week" ? "selected" : "")>Weekly</!option>
                        <!option value="month" @(Model.GroupBy == "month" ? "selected" : "")>Monthly</!option>
                    </select>
                </div>
                <div class="col-6 col-md-8 col-lg-3 d-flex align-items-center">
                    <button type="submit" class="btn font-weight-bold flex-grow-1" 
                            style="background: #6777EF; border-color: #6777EF; color: #FFFFFF; border-radius: 6px; height: 42px;">
                        <i class="fas fa-filter mr-1"></i>Apply Filter
                    </button>
                    <a href="/owner/revenue" class="btn ml-2 d-flex align-items-center justify-content-center" 
                       style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; width: 42px; height: 42px;" 
                       title="Reset Filters">
                        <i class="fas fa-redo"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Filtered Range Highlights (Otika Accent Borders) -->
    <div class="row mb-4">
        <div class="col-12 col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="revenue-highlight-card" style="border-top: 3px solid #28C76F !important;">
                <div class="highlight-label">Period Revenue</div>
                <div class="highlight-value" style="color: #28C76F;">₹@Model.PeriodRevenue.ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="revenue-highlight-card" style="border-top: 3px solid #6777EF !important;">
                <div class="highlight-label">Sessions</div>
                <div class="highlight-value" style="color: #6777EF;">@Model.PeriodBookings</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="revenue-highlight-card" style="border-top: 3px solid #3DC9B3 !important;">
                <div class="highlight-label">Energy</div>
                <div class="highlight-value" style="color: #3DC9B3;">@Model.PeriodUnitsKWh.ToString("N1") <span style="font-size: 13px; font-weight: 600;">kWh</span></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="revenue-highlight-card" style="border-top: 3px solid #FFA117 !important;">
                <div class="highlight-label">Avg Order Value</div>
                <div class="highlight-value" style="color: #FFA117;">₹@Model.PeriodAvgTicket.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- Visual Charts Row -->
    <div class="row">
        <!-- Revenue Breakdown Bar Chart -->
        <div class="col-lg-6 col-12 mb-4">
            <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
                <div class="card-header bg-white py-3" style="border-bottom: 1px solid #E3EAEF;">
                    <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
                        <i class="fas fa-chart-bar mr-2" style="color: #6777EF;"></i>Revenue by Station
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.PeriodRevenue == 0)
                    {
                        <div class="text-center py-5" style="color: #96A2B4;">
                            <i class="fas fa-chart-pie fa-3x mb-2 opacity-50"></i>
                            <div class="font-weight-600" style="font-size: 13px;">No revenue data recorded.</div>
                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 320px;">
                            <canvas id="stationBreakdownChart"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Daily Revenue Trend Line Chart -->
        <div class="col-lg-6 col-12 mb-4">
            <div class="card shadow-sm h-100" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
                <div class="card-header bg-white py-3" style="border-bottom: 1px solid #E3EAEF;">
                    <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
                        <i class="fas fa-chart-area mr-2" style="color: #28C76F;"></i>Daily Trend
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.PeriodRevenue == 0)
                    {
                        <div class="text-center py-5" style="color: #96A2B4;">
                            <i class="fas fa-chart-line fa-3x mb-2 opacity-50"></i>
                            <div class="font-weight-600" style="font-size: 13px;">No revenue data recorded.</div>
                        </div>
                    }
                    else
                    {
                        <div style="position: relative; height: 320px;">
                            <canvas id="dailyTrendChart"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Station Comparison Matrix Table -->
    <div class="card shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E3EAEF; border-radius: 10px;">
        <div class="card-header bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="border-bottom: 1px solid #E3EAEF;">
            <div class="mb-2 mb-sm-0">
                <h6 class="card-title mb-0 font-weight-bold" style="color: #353C48; font-size: 15px;">
                    <i class="fas fa-table mr-2" style="color: #3ABAF4;"></i>Station Comparison
                </h6>
            </div>
            <span class="badge font-weight-bold px-2 py-1" style="background: #F9F9F9; border: 1px solid #E3EAEF; color: #34395E; border-radius: 6px; font-size: 11px;">
                @Model.StationComparisons.Count Stations
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color: #353C48;">
                    <thead style="background: #F9F9F9; border-bottom: 2px solid #E3EAEF;">
                        <tr>
                            <th style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Station Name</th>
                            <th style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">City & Location</th>
                            <th class="text-center" style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Bookings</th>
                            <th class="text-center" style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Energy (kWh)</th>
                            <th class="text-right" style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Total Revenue</th>
                            <th style="width: 220px; color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Revenue Share</th>
                            <th class="text-center" style="color: #34395E; font-weight: 700; border: none; padding: 14px 18px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.StationComparisons.Any() || Model.StationComparisons.All(s => s.TotalRevenue == 0))
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5" style="color: #96A2B4;">
                                    <i class="fas fa-info-circle mr-1"></i> No completed booking revenue recorded for your stations in this date range.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var station in Model.StationComparisons)
                            {
                                <tr style="border-bottom: 1px solid #E3EAEF;">
                                    <td class="font-weight-bold" style="padding: 14px 18px; color: #353C48;">
                                        <i class="fas fa-charging-station mr-2" style="color: #6777EF;"></i>@station.StationName
                                    </td>
                                    <td style="padding: 14px 18px;">
                                        <span class="badge" style="background: #F2F2F2; color: #34395E; border: 1px solid #E3EAEF; font-weight: 600;">
                                            <i class="fas fa-map-marker-alt mr-1" style="color: #EA5455;"></i>@station.City
                                        </span>
                                        <div class="small text-truncate" style="max-width: 220px; color: #96A2B4;">@station.Address</div>
                                    </td>
                                    <td class="text-center font-weight-bold" style="padding: 14px 18px; color: #353C48;">@station.TotalBookings</td>
                                    <td class="text-center font-weight-bold" style="padding: 14px 18px; color: #3DC9B3;">@station.TotalUnitsKWh.ToString("N1")</td>
                                    <td class="text-right font-weight-bold" style="padding: 14px 18px; color: #28C76F; font-size: 16px;">₹@station.TotalRevenue.ToString("N2")</td>
                                    <td style="padding: 14px 18px;">
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 mr-2" style="height: 8px; border-radius: 4px; background: #E3EAEF;">
                                                <div class="progress-bar" role="progressbar" 
                                                     style="width: @(station.RevenueSharePercentage)%; background-color: #28C76F; border-radius: 4px;" 
                                                     aria-valuenow="@(station.RevenueSharePercentage)" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="font-weight-bold small" style="color: #353C48;">@(station.RevenueSharePercentage)%</span>
                                        </div>
                                    </td>
                                    <td class="text-center text-nowrap" style="padding: 14px 18px;">
                                        <a href="/owner/revenue/station/@station.StationId" 
                                           class="btn btn-sm font-weight-bold mr-1" 
                                           style="background: #6777EF; color: #FFFFFF; border-radius: 5px; padding: 6px 12px;" 
                                           title="View Station Revenue Intelligence">
                                            <i class="fas fa-chart-line mr-1"></i>Station Analytics
                                        </a>
                                        <a href="/owner/stations/details/@station.StationId" 
                                           class="btn btn-sm" 
                                           style="background: #FFFFFF; border: 1px solid #E3EAEF; color: #34395E; border-radius: 5px; padding: 6px 10px;" 
                                           title="Station Settings & Profile">
                                            <i class="fas fa-cog"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @if (Model.HasStations && Model.PeriodRevenue > 0)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // 1. Station Breakdown Bar Chart (Otika Indigo #6777EF)
                const stationLabels = @Html.Raw(Model.StationChartLabelsJson);
                const stationData = @Html.Raw(Model.StationChartDataJson);

                const ctxBreakdown = document.getElementById('stationBreakdownChart');
                if (ctxBreakdown) {
                    new Chart(ctxBreakdown.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: stationLabels,
                            datasets: [{
                                label: 'Revenue (₹)',
                                data: stationData,
                                backgroundColor: 'rgba(103, 119, 239, 0.85)',
                                borderColor: '#6777EF',
                                hoverBackgroundColor: '#5a67d8',
                                borderWidth: 1.5,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#353C48',
                                    titleColor: '#FFFFFF',
                                    bodyColor: '#FFFFFF',
                                    padding: 10,
                                    cornerRadius: 6,
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#96A2B4', font: { weight: '600' } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: '#F2F2F2' },
                                    ticks: {
                                        color: '#96A2B4',
                                        font: { weight: '600' },
                                        callback: function (val) {
                                            return '₹' + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // 2. Daily Trend Line Chart (Otika Success Green #28C76F)
                const trendLabels = @Html.Raw(Model.TrendChartLabelsJson);
                const trendData = @Html.Raw(Model.TrendChartDataJson);

                const ctxTrend = document.getElementById('dailyTrendChart');
                if (ctxTrend) {
                    const gradient = ctxTrend.getContext('2d').createLinearGradient(0, 0, 0, 300);
                    gradient.addColorStop(0, 'rgba(40, 199, 111, 0.35)');
                    gradient.addColorStop(1, 'rgba(40, 199, 111, 0.0)');

                    new Chart(ctxTrend.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: trendLabels,
                            datasets: [{
                                label: 'Daily Revenue (₹)',
                                data: trendData,
                                borderColor: '#28C76F',
                                backgroundColor: gradient,
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointRadius: trendLabels.length > 30 ? 2 : 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#28C76F',
                                pointBorderColor: '#FFFFFF',
                                pointBorderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: '#353C48',
                                    titleColor: '#FFFFFF',
                                    bodyColor: '#FFFFFF',
                                    padding: 10,
                                    cornerRadius: 6,
                                    callbacks: {
                                        label: function (ctx) {
                                            return ' Daily Revenue: ₹' + Number(ctx.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#96A2B4', font: { weight: '600' } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: '#F2F2F2' },
                                    ticks: {
                                        color: '#96A2B4',
                                        font: { weight: '600' },
                                        callback: function (val) {
                                            return '₹' + (val >= 1000 ? (val / 1000).toLocaleString('en-IN') + 'k' : val);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}
