@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>VoltNet - Verify OTP</title>
  <!-- General CSS Files -->
  <link rel="stylesheet" href="~/otika/assets/css/app.min.css">
  <link rel="stylesheet" href="~/otika/assets/bundles/bootstrap-social/bootstrap-social.css">
  <!-- Template CSS -->
  <link rel="stylesheet" href="~/otika/assets/css/style.css">
  <link rel="stylesheet" href="~/otika/assets/css/components.css">
  <!-- Custom style CSS -->
  <link rel="stylesheet" href="~/otika/assets/css/custom.css">
  <link rel='shortcut icon' type='image/x-icon' href='~/otika/assets/img/voltnet.ico' />
  <style>
    /* Remove the green borders and checkmarks for valid fields */
    .was-validated .form-control:valid, .form-control.is-valid {
      border-color: #e4e6fc;
      background-image: none;
    }
    .was-validated .form-control:valid:focus, .form-control.is-valid:focus {
      border-color: #2E9D54;
      box-shadow: 0 0 0 0.2rem rgba(46, 157, 84, 0.25);
    }
    
    /* VoltNet Brand Colors */
    .card-primary {
      border-top-color: #2E9D54 !important;
    }
    .btn-primary {
      background-color: #2E9D54 !important;
      border-color: #2E9D54 !important;
    }
    .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
      background-color: #248245 !important;
      border-color: #248245 !important;
    }
    .text-primary {
      color: #2E9D54 !important;
    }
    .custom-control-input:checked ~ .custom-control-label::before {
      background-color: #2E9D54 !important;
      border-color: #2E9D54 !important;
    }
    a {
      color: #2E9D54;
    }
    a:hover {
      color: #248245;
    }
  </style>
</head>

<body>
  <div class="loader"></div>
  <div id="app">
    <section class="section">
      <div class="container mt-5">
        <div class="row">
          <div class="col-12 col-sm-8 offset-sm-2 col-md-6 offset-md-3 col-lg-6 offset-lg-3 col-xl-4 offset-xl-4">
            <div class="card card-primary">
              <div class="card-header d-flex flex-column align-items-center pb-0">
                <div class="w-100 text-center mb-3">
                  <span class="logo-name" style="font-size: 28px; font-weight: 700; color: #2E9D54; vertical-align: middle; margin-left: 10px;">Verify Your Email</span>
                </div>
              </div>
              <div class="card-body">
                <p class="text-muted text-center">We sent a 6-digit verification code to <strong>@ViewBag.Email</strong></p>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }
                <form method="POST" asp-controller="Account" asp-action="VerifyOtp" class="needs-validation" novalidate="">
                  <input type="hidden" name="email" value="@ViewBag.Email" />
                  
                  <div class="form-group">
                    <label for="otp">Verification Code</label>
                    <input id="otp" type="text" class="form-control" name="otp" tabindex="1" required autofocus maxlength="6">
                    <div class="invalid-feedback">
                      Please enter the OTP
                    </div>
                  </div>

                  <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-lg btn-block" tabindex="2">
                      Verify & Complete Registration
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <!-- General JS Scripts -->
  <script src="~/otika/assets/js/app.min.js"></script>
  <!-- JS Libraies -->
  <!-- Page Specific JS File -->
  <!-- Template JS File -->
  <script src="~/otika/assets/js/scripts.js"></script>
  <!-- Custom JS File -->
  <script src="~/otika/assets/js/custom.js"></script>
</body>
</html>
