@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>@ViewData["Title"] - Customer Portal</title>
  <!-- General CSS Files -->
  <link rel="stylesheet" href="~/otika/assets/css/app.min.css">
  <link rel="stylesheet" href="~/otika/assets/bundles/datatables/datatables.min.css">
  <link rel="stylesheet" href="~/otika/assets/bundles/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css">
  <!-- Template CSS -->
  <link rel="stylesheet" href="~/otika/assets/bundles/select2/dist/css/select2.min.css">
  <link rel="stylesheet" href="~/otika/assets/css/style.css">
  <link rel="stylesheet" href="~/otika/assets/css/components.css">
  <!-- Custom style CSS -->
  <link rel="stylesheet" href="~/otika/assets/css/custom.css">
  <link rel='shortcut icon' type='image/x-icon' href='~/otika/assets/img/voltnet.ico' />
</head>

<body>
  <div class="loader"></div>
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <nav class="navbar navbar-expand-lg main-navbar sticky">
        <div class="form-inline mr-auto">
          <ul class="navbar-nav mr-3">
            <li><a href="#" data-toggle="sidebar" class="nav-link nav-link-lg
								collapse-btn"> <i data-feather="align-justify"></i></a></li>
            <li><a href="#" class="nav-link nav-link-lg fullscreen-btn">
                <i data-feather="maximize"></i>
              </a></li>
          </ul>
        </div>
        <ul class="navbar-nav navbar-right">
          <li class="dropdown"><a href="#" data-toggle="dropdown"
              class="nav-link dropdown-toggle nav-link-lg nav-link-user"> <img alt="image" src="~/otika/assets/img/admin.png"
                class="user-img-radious-style"> <span class="d-sm-none d-lg-inline-block"></span></a>
            <div class="dropdown-menu dropdown-menu-right pullDown">
              <div class="dropdown-title">Hello, @(User.Identity?.Name ?? "Customer")</div>
              <div class="dropdown-divider"></div>
              <a href="/logout" class="dropdown-item has-icon text-danger">
                <i class="fas fa-sign-out-alt"></i> Logout
              </a>
            </div>
          </li>
        </ul>
      </nav>
      <div class="main-sidebar sidebar-style-2">
        <aside id="sidebar-wrapper">
          <div class="sidebar-brand">
            <a href="/"> <img alt="image" src="~/otika/assets/img/voltnet.png" class="header-logo" /> <span
                class="logo-name">VoltNet</span>
            </a>
          </div>
          <ul class="sidebar-menu">
            <li class="menu-header">Customer Portal</li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/customer/dashboard") ? "active" : "")">
              <a href="/customer/dashboard" class="nav-link"><i data-feather="monitor"></i><span>Dashboard</span></a>
            </li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/customer/bookings") ? "active" : "")">
              <a href="/customer/bookings" class="nav-link"><i data-feather="calendar"></i><span>My Bookings</span></a>
            </li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/customer/spending") || Context.Request.Path.StartsWithSegments("/customer/analytics") ? "active" : "")">
              <a href="/customer/spending" class="nav-link"><i data-feather="pie-chart"></i><span>My Spending & Energy</span></a>
            </li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/Home/Stations") ? "active" : "")">
              <a href="/Home/Stations" class="nav-link"><i data-feather="map-pin"></i><span>Find Charging Stations</span></a>
            </li>
            <li class="menu-header">Account</li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/customer/profile") ? "active" : "")">
              <a href="/customer/profile" class="nav-link"><i data-feather="user"></i><span>My Profile</span></a>
            </li>
            <li class="dropdown @(Context.Request.Path.StartsWithSegments("/customer/change-password") ? "active" : "")">
              <a href="/customer/change-password" class="nav-link"><i data-feather="lock"></i><span>Change Password</span></a>
            </li>
          </ul>
        </aside>
      </div>
      <!-- Main Content -->
      <div class="main-content">
        <section class="section">
          <div class="section-body">
            @RenderBody()
          </div>
        </section>
      </div>
      <footer class="main-footer">
        <div class="footer-left">
          VoltNet &copy; @DateTime.Now.Year — Customer Portal
        </div>
        <div class="footer-right">
        </div>
      </footer>
    </div>
  </div>
  <!-- General JS Scripts -->
  <script src="~/otika/assets/js/app.min.js"></script>
  <!-- JS Libraies -->
  <script src="~/otika/assets/bundles/datatables/datatables.min.js"></script>
  <script src="~/otika/assets/bundles/datatables/DataTables-1.10.16/js/dataTables.bootstrap4.min.js"></script>
  <!-- Template JS File -->
  <script src="~/otika/assets/bundles/select2/dist/js/select2.full.min.js"></script>
  <script src="~/js/indian-states.js"></script>
  <script src="~/otika/assets/js/scripts.js"></script>
  <!-- Custom JS File -->
  <script src="~/otika/assets/js/custom.js"></script>
  <style>
    .modal-backdrop {
      z-index: 1040 !important;
    }
    .modal {
      z-index: 1060 !important;
    }
    .modal-dialog {
      z-index: 1070 !important;
    }
    .modal-content {
      z-index: 1075 !important;
    }
  </style>

  <script>
    $(document).ready(function () {
      $('#app .modal, .main-wrapper .modal, .main-content .modal').each(function () {
        $(this).appendTo("body");
      });
      $(document).on('show.bs.modal', '.modal', function () {
        if (!$(this).parent().is('body')) {
          $(this).appendTo('body');
        }
      });
    });
  </script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
