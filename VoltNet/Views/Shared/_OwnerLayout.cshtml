<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport">
    <meta name="description" content="VoltNet Station Owner Portal - Manage your EV charging stations, chargers, rates, managers, and bookings.">
    <title>@ViewData["Title"] - Station Owner Portal</title>

    <!-- General CSS Files -->
    <link rel="stylesheet" href="~/otika/assets/css/app.min.css">
    <link rel="stylesheet" href="~/otika/assets/bundles/datatables/datatables.min.css">
    <link rel="stylesheet" href="~/otika/assets/bundles/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/otika/assets/bundles/select2/dist/css/select2.min.css">

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/otika/assets/css/style.css">
    <link rel="stylesheet" href="~/otika/assets/css/components.css">
    <!-- Custom style CSS -->
    <link rel="stylesheet" href="~/otika/assets/css/custom.css">
    <!-- Mobile / responsive fixes (load last so it can override) -->
    <link rel="stylesheet" href="~/otika/assets/css/responsive-extra.css">

    @await RenderSectionAsync("Styles", required: false)

    <link rel="shortcut icon" type="image/x-icon" href="~/otika/assets/img/voltnet.ico" />
</head>

<body>
    <div class="loader"></div>
    <div id="app">
        <div class="main-wrapper main-wrapper-1">
            <div class="navbar-bg"></div>

            <!-- ================= TOP NAVBAR ================= -->
            <nav class="navbar navbar-expand-lg main-navbar sticky">
                <div class="form-inline mr-auto">
                    <ul class="navbar-nav mr-3">
                        <li>
                            <button type="button" data-toggle="sidebar" class="nav-link nav-link-lg collapse-btn nav-btn-plain" aria-label="Toggle navigation">
                                <i data-feather="align-justify" aria-hidden="true"></i>
                            </button>
                        </li>
                        <li class="d-none d-md-block">
                            <button type="button" class="nav-link nav-link-lg fullscreen-btn nav-btn-plain" aria-label="Toggle fullscreen">
                                <i data-feather="maximize" aria-hidden="true"></i>
                            </button>
                        </li>
                    </ul>
                </div>
                <ul class="navbar-nav navbar-right">
                    <li class="dropdown">
                        <a href="#" data-toggle="dropdown" class="nav-link dropdown-toggle nav-link-lg nav-link-user" aria-label="Open account menu">
                            <img alt="Owner profile" src="~/otika/assets/img/admin.png" class="user-img-radious-style">
                            <span class="d-none d-lg-inline-block">@(User.Identity?.Name ?? "Owner")</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right pullDown">
                            <div class="dropdown-title">Hello, @(User.Identity?.Name ?? "Owner")</div>
                            <a href="/owner/profile" class="dropdown-item has-icon"><i class="fas fa-user mr-2"></i> Profile</a>
                            <a href="/owner/change-password" class="dropdown-item has-icon"><i class="fas fa-key mr-2"></i> Change Password</a>
                            <div class="dropdown-divider"></div>
                            <form action="/logout" method="post" id="logoutForm" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item has-icon text-danger btn-logout">
                                    <i class="fas fa-sign-out-alt mr-2" aria-hidden="true"></i> Logout
                                </button>
                            </form>
                        </div>
                    </li>
                </ul>
            </nav>

            <!-- ================= SIDEBAR ================= -->
            <div class="main-sidebar sidebar-style-2">
                <aside id="sidebar-wrapper">
                    <div class="sidebar-brand">
                        <a href="/owner/dashboard" aria-label="VoltNet owner dashboard">
                            <img alt="VoltNet" src="~/otika/assets/img/voltnet.png" class="header-logo" />
                            <span class="logo-name">VoltNet</span>
                        </a>
                    </div>
                    <ul class="sidebar-menu">
                        <li class="menu-header">Station Owner</li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/dashboard") ? "active" : "")">
                            <a href="/owner/dashboard" class="nav-link"><i data-feather="monitor"></i><span>Dashboard</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/stations") ? "active" : "")">
                            <a href="/owner/stations" class="nav-link"><i data-feather="map-pin"></i><span>My Stations</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/rates") ? "active" : "")">
                            <a href="/owner/rates" class="nav-link"><i data-feather="dollar-sign"></i><span>Charging Rates</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/subscription") ? "active" : "")">
                            <a href="/owner/subscription" class="nav-link"><i data-feather="credit-card"></i><span>Subscriptions</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/station-managers") ? "active" : "")">
                            <a href="/owner/station-managers" class="nav-link"><i data-feather="users"></i><span>Station Managers</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/bookings") ? "active" : "")">
                            <a href="/owner/bookings" class="nav-link"><i data-feather="calendar"></i><span>Station Bookings</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/maintenance") ? "active" : "")">
                            <a href="/owner/maintenance" class="nav-link"><i data-feather="tool"></i><span>Maintenance</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/reports") ? "active" : "")">
                            <a href="/owner/reports" class="nav-link"><i data-feather="bar-chart-2"></i><span>Reports &amp; Analytics</span></a>
                        </li>

                        <li class="menu-header">Account</li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/profile") ? "active" : "")">
                            <a href="/owner/profile" class="nav-link"><i data-feather="user"></i><span>My Profile</span></a>
                        </li>
                        <li class="dropdown @(Context.Request.Path.StartsWithSegments("/owner/change-password") ? "active" : "")">
                            <a href="/owner/change-password" class="nav-link"><i data-feather="lock"></i><span>Change Password</span></a>
                        </li>
                    </ul>
                </aside>
            </div>

            <!-- ================= MAIN CONTENT ================= -->
            <div class="main-content">
                <section class="section">
                    @if (ViewData["PageTitle"] != null)
                    {
                        <div class="section-header">
                            <h1>@ViewData["PageTitle"]</h1>
                        </div>
                    }
                    <div class="section-body">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-has-icon alert-dismissible show fade mb-4 auto-dismiss">
                                <div class="alert-icon"><i class="fas fa-check-circle"></i></div>
                                <div class="alert-body">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss success message"><span aria-hidden="true">&times;</span></button>
                                    <div class="alert-title">Success</div>
                                    @TempData["SuccessMessage"]
                                </div>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-has-icon alert-dismissible show fade mb-4">
                                <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
                                <div class="alert-body">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss error message"><span aria-hidden="true">&times;</span></button>
                                    <div class="alert-title">Error</div>
                                    @TempData["ErrorMessage"]
                                </div>
                            </div>
                        }
                        @RenderBody()
                    </div>
                </section>
            </div>

            <footer class="main-footer">
                <div class="footer-left">
                    VoltNet &copy; @DateTime.Now.Year &mdash; Station Owner Portal
                </div>
                <div class="footer-right"></div>
            </footer>
        </div>
    </div>

    <!-- General JS Scripts -->
    <script src="~/otika/assets/js/app.min.js"></script>
    <!-- JS Libraries -->
    <script src="~/otika/assets/bundles/datatables/datatables.min.js"></script>
    <script src="~/otika/assets/bundles/datatables/DataTables-1.10.16/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/otika/assets/bundles/select2/dist/js/select2.full.min.js"></script>
    <!-- Template JS File -->
    <script src="~/otika/assets/js/scripts.js"></script>
    <!-- Custom JS File -->
    <script src="~/otika/assets/js/custom.js"></script>
    <script src="~/js/indian-states.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            $(document).ready(function () {

              // Icons
              if (typeof feather !== 'undefined') { feather.replace(); }

              // Select2 on any <select class="select2">
              if ($.fn.select2) {
                $('select.select2').each(function () {
                  if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({ width: '100%' });
                  }
                });
              }

              // DataTables on every .table (add class "no-datatable" to skip a table,
              // add class "no-sort" on a <th> to stop sorting that column)
              if ($.fn.DataTable) {
                $('.table:not(.no-datatable)').each(function () {
                  var $t = $(this);
                  if ($.fn.DataTable.isDataTable(this)) { return; }

                  // Skip tables with only a "No records" colspan row (DataTables breaks on it)
                  var $rows = $t.find('tbody tr');
                  if ($rows.length === 0 || $rows.find('td[colspan]').length > 0) { return; }

                  $t.DataTable({
                    autoWidth: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    columnDefs: [{ targets: 'no-sort', orderable: false }],
                    language: {
                      search: '',
                      searchPlaceholder: 'Search...',
                      lengthMenu: 'Show _MENU_'
                    },
                    dom:
                      '<"row align-items-center mb-3"' +
                        '<"col-12 col-md-6 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start"l>' +
                        '<"col-12 col-md-6 d-flex justify-content-center justify-content-md-end"f>' +
                      '>' +
                      '<"table-responsive"t>' +
                      '<"row align-items-center mt-3"' +
                        '<"col-12 col-md-5 text-center text-md-left mb-2 mb-md-0"i>' +
                        '<"col-12 col-md-7 d-flex justify-content-center justify-content-md-end"p>' +
                      '>'
                  });
                });
              }

              // Success alert fades out automatically
              setTimeout(function () { $('.alert.auto-dismiss').alert('close'); }, 6000);
            });
    </script>
</body>
</html>