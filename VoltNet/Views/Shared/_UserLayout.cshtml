<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="@(ViewData["MetaDescription"] ?? "VoltNet - India's Premium EV Charging Network. Find, book, and charge your electric vehicle at thousands of stations nationwide.")">
  <title>@ViewData["Title"] - VoltNet</title>

  <!-- Bootstrap 5.3.8 -->
  <link rel="stylesheet" href="~/bootstrap-5.3.8-dist/bootstrap-5.3.8-dist/css/bootstrap.min.css">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- VoltNet User-Site CSS -->
  <link rel="stylesheet" href="~/usersite/css/style.css">
  <link rel="shortcut icon" type="image/x-icon" href="~/mainicon.ico">
</head>
<body>
  <!-- ═══════════════ SCROLL PROGRESS ═══════════════ -->
  <div class="vn-scroll-progress"></div>

  <!-- ═══════════════ NAVBAR (Desktop & Mobile with Offcanvas) ═══════════════ -->
  <nav class="navbar navbar-expand-lg vn-navbar fixed-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
        <img src="~/logo.png" alt="VoltNet Logo" style="height: 40px; width: auto;" />
      </a>
      
      <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#vnNavbar" aria-controls="vnNavbar" aria-expanded="false">
        <i class="bi bi-list fs-2 text-dark"></i>
      </button>
      
      <div class="collapse navbar-collapse" id="vnNavbar">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Services" ? "active" : "")" asp-controller="Home" asp-action="Services">Services</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Stations" ? "active" : "")" asp-controller="Home" asp-action="Stations">Stations</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "NearbyMap" ? "active" : "")" href="/nearby-map"><i class="bi bi-geo-alt-fill me-1"></i>Map</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Pricing" ? "active" : "")" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a></li>
            <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "BecomePartner" ? "active" : "")" asp-controller="Home" asp-action="BecomePartner">Become Partner</a></li>
          </ul>
          
          <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center mt-3 mt-lg-0 ms-lg-3">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn dropdown-toggle d-flex align-items-center gap-2 btn-profile" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="profile-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <span class="d-none d-xl-block fw-semibold" style="font-size: 0.9rem;">@("Profile"?.Split('@')[0] ?? "My Account")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: var(--vn-radius-md); padding: 0.5rem;">
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li><a class="dropdown-item rounded" href="/admin/Dashboard"><i class="bi bi-speedometer2 me-2 text-muted"></i>Admin Dashboard</a></li>
                        }
                        else if (User.IsInRole("StationOwner"))
                        {
                            <li><a class="dropdown-item rounded" href="/owner/dashboard"><i class="bi bi-speedometer2 me-2 text-muted"></i>Owner Dashboard</a></li>
                        }
                        else if (User.IsInRole("StationManager"))
                        {
                            <li><a class="dropdown-item rounded" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2 text-muted"></i>Manager Dashboard</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item rounded" href="/customer/dashboard"><i class="bi bi-speedometer2 me-2 text-muted"></i>My Dashboard</a></li>
                        }
                        <li><hr class="dropdown-divider my-2"></li>
                        <li>
                            <form action="/logout" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item rounded text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/login" class="nav-link btn-nav-login">Log In</a>
                <a href="/register" class="btn-vn-primary btn-nav-register" style="padding: 8px 20px !important;">Sign Up</a>
            }
      </div>
    </div>
  </nav>

  <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
  @RenderBody()

  <!-- ═══════════════ FOOTER ═══════════════ -->
  <footer class="vn-footer">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4 col-md-6">
          <div class="footer-brand">
            <img src="~/logo.png" alt="VoltNet Logo" style="height: 40px; width: auto;" />
          </div>
          <p class="footer-desc mt-3">India's fastest-growing EV charging network. Powering the future of sustainable mobility with smart, reliable charging solutions.</p>
          <div class="footer-social mt-4">
            <a href="#"><i class="bi bi-twitter-x"></i></a>
            <a href="#"><i class="bi bi-instagram"></i></a>
            <a href="#"><i class="bi bi-linkedin"></i></a>
            <a href="#"><i class="bi bi-youtube"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-title">Company</h6>
          <ul class="footer-links">
            <li><a asp-controller="Home" asp-action="About">About Us</a></li>
            <li><a asp-controller="Home" asp-action="Services">Services</a></li>
            <li><a asp-controller="Home" asp-action="Stations">Stations</a></li>
            <li><a asp-controller="Home" asp-action="Pricing">Pricing</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-title">Support</h6>
          <ul class="footer-links">
            <li><a asp-controller="Home" asp-action="Faq">FAQs</a></li>
            <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
            <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
            <li><a href="#">Terms of Service</a></li>
          </ul>
        </div>
        <div class="col-lg-4 col-md-6">
          <h6 class="footer-title">Get In Touch</h6>
          <ul class="footer-links">
            <li><i class="bi bi-geo-alt me-2" style="color: var(--vn-green);"></i>VoltNet HQ, Innovation Hub, Pune, India</li>
            <li><i class="bi bi-envelope me-2" style="color: var(--vn-green);"></i>support@voltnet.com</li>
            <li><i class="bi bi-telephone me-2" style="color: var(--vn-green);"></i>+91 98765 43210</li>
            <li><i class="bi bi-clock me-2" style="color: var(--vn-green);"></i>24/7 Customer Support</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom text-center">
        <p class="mb-0">&copy; @DateTime.Now.Year VoltNet. All rights reserved. Powering a greener tomorrow.</p>
      </div>
    </div>
  </footer>

  <!-- ═══════════════ SCROLL TO TOP ═══════════════ -->
  <a href="#" class="vn-scroll-top shadow-sm" aria-label="Scroll to top">
    <i class="bi bi-arrow-up"></i>
  </a>

  <!-- Bootstrap 5.3.8 JS -->
  <script src="~/bootstrap-5.3.8-dist/bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js"></script>
  <!-- VoltNet User-Site JS -->
  <script src="~/usersite/js/main.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
