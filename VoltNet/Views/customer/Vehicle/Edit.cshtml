@model VoltNet.Models.Vehicle
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Edit Vehicle";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="fas fa-edit text-primary mr-2"></i>Edit Vehicle — @Model.VehicleNumberPlate</h4>
                <a href="/customer/vehicles" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Vehicles
                </a>
            </div>
            <div class="card-body">
                <form action="/customer/vehicles/edit/@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label class="font-weight-bold">Brand / Manufacturer <span class="text-danger">*</span></label>
                            <input type="text" name="Brand" class="form-control" required value="@Model.Brand" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6 form-group">
                            <label class="font-weight-bold">Model <span class="text-danger">*</span></label>
                            <input type="text" name="Model" class="form-control" required value="@Model.Model" />
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label class="font-weight-bold">Vehicle Registration Number <span class="text-danger">*</span></label>
                            <input type="text" name="VehicleNumberPlate" class="form-control text-uppercase" required value="@Model.VehicleNumberPlate" style="letter-spacing: 1px;" />
                            <span asp-validation-for="VehicleNumberPlate" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6 form-group">
                            <label class="font-weight-bold">Connector Type <span class="text-danger">*</span></label>
                            <select name="ConnectorType" class="form-control" required>
                                <option value="CCS2" selected="@(Model.ConnectorType == "CCS2")">CCS2 (Combined Charging System 2) — Most Common</option>
                                <option value="Type 2" selected="@(Model.ConnectorType == "Type 2")">Type 2 (Mennekes / AC Fast)</option>
                                <option value="GB/T" selected="@(Model.ConnectorType == "GB/T")">GB/T (Tata Xpres-T, Tigor EV fleet)</option>
                                <option value="CHAdeMO" selected="@(Model.ConnectorType == "CHAdeMO")">CHAdeMO (DC Quick)</option>
                            </select>
                            <span asp-validation-for="ConnectorType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 form-group">
                            <label class="font-weight-bold">Battery Capacity (kWh) <span class="text-muted small">(Optional)</span></label>
                            <input type="number" step="0.1" name="BatteryCapacityKwh" class="form-control" value="@Model.BatteryCapacityKwh" />
                        </div>

                        <div class="col-12 col-md-6 form-group d-flex align-items-center mt-3 mt-md-4">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" name="IsDefault" value="true" class="custom-control-input" id="isDefault" @(Model.IsDefault ? "checked" : "") />
                                <label class="custom-control-label font-weight-bold" for="isDefault">Default Vehicle for Bookings</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/customer/vehicles" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save mr-1"></i> Update Vehicle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
