@model IEnumerable<VoltNet.Models.Vehicle>
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "My Vehicles";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="fas fa-car text-primary mr-2"></i>My Registered Vehicles</h4>
                <a href="/customer/vehicles/create" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> Add New Vehicle
                </a>
            </div>
            <div class="card-body">
                <p class="text-muted">Manage your electric vehicles here. Save your EV models and connector types for instant, 1-click charging slot reservations.</p>

                @if (!Model.Any())
                {
                    <div class="empty-state text-center py-5">
                        <div class="empty-state-icon bg-primary text-white mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                            <i class="fas fa-car"></i>
                        </div>
                        <h4 class="font-weight-bold">No Vehicles Registered Yet</h4>
                        <p class="text-muted max-width-500 mx-auto">Add your EV's details (number plate, brand, battery capacity, connector type) to speed up future bookings.</p>
                        <a href="/customer/vehicles/create" class="btn btn-primary mt-3">
                            <i class="fas fa-plus mr-1"></i> Add Your First EV
                        </a>
                    </div>
                }
                else
                {
                    <div class="row">
                        @foreach (var vehicle in Model)
                        {
                            <div class="col-12 col-md-6 col-lg-4 mb-4">
                                <div class="card border shadow-sm h-100 position-relative @(vehicle.IsDefault ? "border-primary" : "")" style="border-radius: 12px; overflow: hidden;">
                                    @if (vehicle.IsDefault)
                                    {
                                        <div class="bg-primary text-white text-center py-1 font-weight-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                            <i class="fas fa-star mr-1"></i> DEFAULT VEHICLE
                                        </div>
                                    }
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div>
                                                <h5 class="font-weight-bold text-dark mb-0">@vehicle.Brand @vehicle.Model</h5>
                                                <span class="badge badge-light border text-muted mt-1 font-weight-semibold">@vehicle.ConnectorType</span>
                                            </div>
                                            <div class="vehicle-icon p-2 bg-light rounded text-primary">
                                                <i class="fas fa-charging-station fa-lg"></i>
                                            </div>
                                        </div>

                                        <div class="bg-light p-3 rounded mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="text-muted small">Plate Number</span>
                                                <strong class="text-dark font-monospace" style="letter-spacing: 1px;">@vehicle.VehicleNumberPlate</strong>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-muted small">Battery Capacity</span>
                                                <strong class="text-dark">@(vehicle.BatteryCapacityKwh.HasValue ? $"{vehicle.BatteryCapacityKwh.Value} kWh" : "Standard")</strong>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                            <div>
                                                @if (!vehicle.IsDefault)
                                                {
                                                    <form action="/customer/vehicles/set-default/@vehicle.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-primary btn-sm" title="Set as default vehicle">
                                                            <i class="far fa-star"></i> Set Default
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a href="/customer/vehicles/edit/@vehicle.Id" class="btn btn-outline-secondary btn-sm mr-1" title="Edit Vehicle">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <form action="/customer/vehicles/delete/@vehicle.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete vehicle @vehicle.VehicleNumberPlate?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Vehicle">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
