@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4>Welcome to your Dashboard!</h4>
            </div>
            <div class="card-body">
                <p>Welcome, @(User.Identity?.Name ?? "Customer"). Your EV charging journey starts here.</p>
                <div class="alert alert-info">
                    <strong>Note:</strong> We are constantly adding new features to improve your experience. Stay tuned!
                </div>
            </div>
        </div>
    </div>
</div>
