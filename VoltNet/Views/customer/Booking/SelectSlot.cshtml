@model IEnumerable<VoltNet.Controllers.customer.SlotViewModel>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var charger = ViewBag.Charger as VoltNet.Models.Charger;
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var estimatedCost = (decimal)ViewBag.EstimatedCost;
    var rate = ViewBag.Rate as VoltNet.Models.ChargingRate;
    ViewData["Title"] = $"Choose Time Slot - {charger?.Name}";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="sl">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
    </div>
}

<div class="card gap-b">
    <div class="card-body">
        <div class="head">
            <div>
                <span class="step">Step 2 of 3</span>
                <h4>@(charger?.Name) — @(station?.Name)</h4>
                <div class="pills">
                    <span class="status s-info">@(charger?.ConnectorType)</span>
                    <span class="status s-warn">@(charger?.CapacityKw) kW</span>
                    <span class="sub">@(station?.OpeningTime.ToString(@"hh\:mm")) - @(station?.ClosingTime.ToString(@"hh\:mm"))</span>
                </div>
            </div>
            <a href="/customer/book/@(station?.Id)" class="btn btn-back"><i class="fas fa-arrow-left"></i> Change Charger</a>
        </div>
    </div>
</div>

<div class="row">
    <!-- Date and rate -->
    <div class="col-12 col-lg-4 gap-b">
        <div class="card">
            <div class="card-header"><h5>Date</h5></div>
            <div class="card-body">
                <form method="get" action="/customer/book/@(station?.Id)/slots" id="dateForm">
                    <input type="hidden" name="chargerId" value="@(charger?.Id)" />
                    <div class="form-group mb-0">
                        <label for="dateInput">Booking date (next 7 days)</label>
                        <input type="date" class="form-control"
                               id="dateInput" name="date"
                               value="@(selectedDate.ToString("yyyy-MM-dd"))"
                               min="@(ViewBag.MinDate)"
                               max="@(ViewBag.MaxDate)"
                               onchange="document.getElementById('dateForm').submit();" />
                    </div>
                </form>

                <div class="mt-4">
                    <div class="line"><span class="k">Power</span><span class="v">@(charger?.CapacityKw) kW</span></div>
                    <div class="line"><span class="k">Energy rate</span><span class="v money">@(rate != null ? $"₹{rate.RatePerKwh:F2} / kWh" : "₹15.00 / kWh")</span></div>
                    @if (rate?.RatePerHour.HasValue == true && rate.RatePerHour.Value > 0)
                    {
                        <div class="line"><span class="k">Base station fee</span><span class="v">₹@rate.RatePerHour.Value.ToString("F2")</span></div>
                    }
                </div>

                <div class="legend">
                    <div><span class="status s-ok">Available</span></div>
                    <div><span class="status s-warn">Booked (waitlist)</span></div>
                    <div><span class="status s-err">Maintenance</span></div>
                    <div><span class="status s-plain">Past / closed</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slots -->
    <div class="col-12 col-lg-8 gap-b">
        <div class="card">
            <div class="card-header">
                <div>
                    <h5>Time Slots</h5>
                    <div class="sub">@(selectedDate.ToString("dddd, dd MMMM yyyy"))</div>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="empty-box">No slots in operating hours.</div>
                }
                else
                {
                    <div class="row">
                        @foreach (var slot in Model)
                        {
                            <div class="col-12 col-sm-6 col-md-4 mb-3">
                                @if (slot.IsAvailable)
                                {
                                    <a href="/customer/book/confirm?stationId=@(station?.Id)&chargerId=@(charger?.Id)&date=@(selectedDate.ToString("yyyy-MM-dd"))&startTime=@(slot.StartTime.ToString(@"hh\:mm"))&endTime=@(slot.EndTime.ToString(@"hh\:mm"))"
                                       class="slot available slot-card">
                                        <span class="time">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                        <span class="status s-ok">Available</span>
                                    </a>
                                }
                                else if (slot.IsBlocked)
                                {
                                    <div class="slot blocked slot-card">
                                        <span class="time">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                        <span class="status s-err">@(slot.BlockReason ?? "Maintenance")</span>
                                    </div>
                                }
                                else if (slot.IsBooked)
                                {
                                    <div class="slot booked slot-card">
                                        <span class="time">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                        <span class="status s-warn">Booked</span>

                                        @if (slot.IsUserInWaitlist)
                                        {
                                            <span class="status s-plan">You are in queue</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-warn"
                                                    onclick="openWaitlistModal('@(slot.StartTime.ToString(@"hh\:mm"))', '@(slot.EndTime.ToString(@"hh\:mm"))', '@(slot.WaitlistCount + 1)')">
                                                Join Waitlist (@(slot.WaitlistCount > 0 ? $"#{slot.WaitlistCount + 1}" : "#1"))
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="slot past slot-card">
                                        <span class="time">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                        <span class="status s-plain">Past</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

</div>

<!-- Modal: Join Waitlist Queue -->
<div class="modal fade sl-modal" id="waitlistModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Join Waitlist</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/customer/book/join-waitlist" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="stationId" value="@(station?.Id)" />
                <input type="hidden" name="chargerId" value="@(charger?.Id)" />
                <input type="hidden" name="bookingDate" value="@(selectedDate.ToString("yyyy-MM-dd"))" />
                <input type="hidden" id="modalStartTime" name="startTime" />
                <input type="hidden" id="modalEndTime" name="endTime" />

                <div class="modal-body">
                    <div class="impact">You will be added as <strong id="modalQueuePos"></strong>. If the current driver cancels, the slot is confirmed for you automatically.</div>
                    <div class="form-group mb-0">
                        <label>Vehicle number plate</label>
                        <input type="text" name="vehicleNumberPlate" class="form-control text-uppercase" autocapitalize="characters" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-main"><i class="fas fa-check"></i> Join Queue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openWaitlistModal(startTime, endTime, queueNum) {
            $('#modalStartTime').val(startTime);
            $('#modalEndTime').val(endTime);
            $('#modalQueuePos').text('Queue Position #' + queueNum);
            $('#waitlistModal').modal('show');
        }

        $(document).ready(function() {
            $('#waitlistModal').appendTo("body");
        });
    </script>
}