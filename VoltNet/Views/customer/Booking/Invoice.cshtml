@model VoltNet.Models.Booking

@{
    ViewData["Title"] = "Tax Invoice #" + Model.Id.ToString().Substring(0, 8).ToUpper();
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var totalAmount = Model.ActualCost ?? Model.EstimatedCost;
    if (totalAmount <= 0) totalAmount = 100.00m;
    
    // Transparent GST calculation (18% GST: 9% CGST + 9% SGST)
    var baseAmount = Math.Round(totalAmount / 1.18m, 2);
    var cgst = Math.Round(baseAmount * 0.09m, 2);
    var sgst = Math.Round(baseAmount * 0.09m, 2);
    var roundedDiff = totalAmount - (baseAmount + cgst + sgst);
    baseAmount += roundedDiff; // Adjust 1-paisa rounding

    var invoiceNo = $"VN-INV-{Model.BookingDate:yyyyMM}-{Model.Id.ToString().Substring(0, 8).ToUpper()}";
    var invoiceDate = Model.CompletedAt?.ToString("dd MMMM yyyy, hh:mm tt") ?? Model.BookingDate.ToString("dd MMMM yyyy");
}

@section Scripts {
    <style>
        @@media print {
            body {
                background: #fff !important;
                color: #000 !important;
            }
            .main-sidebar, .main-navbar, .settingSidebar, .main-footer, .invoice-actions, .breadcrumb, nav {
                display: none !important;
            }
            .main-content {
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
            }
            .invoice {
                padding: 0 !important;
                margin: 0 !important;
                box-shadow: none !important;
                border: none !important;
            }
            .card {
                border: none !important;
                box-shadow: none !important;
            }
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="invoice">
                    <div class="invoice-print">
                        <!-- Header -->
                        <div class="row align-items-center">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center mb-2">
                                    <img src="~/otika/assets/img/voltnet.png" alt="VoltNet" style="height: 48px;" class="mr-2" />
                                    <div>
                                        <h3 class="font-weight-bold text-primary mb-0">VoltNet</h3>
                                        <span class="text-muted small">EV Charging Infrastructure Network</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 text-sm-right mt-3 mt-sm-0">
                                <h4 class="font-weight-bold text-dark mb-0">TAX INVOICE</h4>
                                <div class="text-primary font-weight-bold">@invoiceNo</div>
                                <span class="badge badge-success px-3 py-1 mt-1 font-weight-bold">
                                    <i class="fas fa-check-circle mr-1"></i> PAID &amp; SETTLED
                                </span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Addresses & Details -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="font-weight-bold text-dark text-uppercase small tracking-wide mb-2">Billed To (Customer):</h6>
                                <address class="mb-0 text-muted">
                                    <strong class="text-dark font-weight-bold">@(Model.Customer?.Fullname ?? Model.CustomerName ?? "EV Driver")</strong><br />
                                    <i class="fas fa-phone-alt text-primary mr-1"></i> @(Model.Customer?.Mobile ?? Model.CustomerPhone ?? "—")<br />
                                    <i class="fas fa-envelope text-primary mr-1"></i> @(Model.Customer?.Email ?? "driver@voltnet.in")<br />
                                    <i class="fas fa-car text-primary mr-1"></i> <strong>Vehicle:</strong> @(string.IsNullOrEmpty(Model.VehicleNumberPlate) ? "—" : Model.VehicleNumberPlate) (@(Model.VehicleModel ?? "EV Vehicle"))
                                </address>
                            </div>
                            <div class="col-md-6 text-md-right mb-3">
                                <h6 class="font-weight-bold text-dark text-uppercase small tracking-wide mb-2">Station / Supplier Details:</h6>
                                <address class="mb-0 text-muted">
                                    <strong class="text-dark font-weight-bold">@Model.Station?.Name</strong><br />
                                    @Model.Station?.Address<br />
                                    @Model.Station?.City, @Model.Station?.State<br />
                                    <strong>Station Phone:</strong> @(Model.Station?.OwnerUser?.Mobile ?? "+91 98765 43210")<br />
                                    <strong>GSTIN:</strong> 24AAACV1234F1Z5
                                </address>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6 mb-2">
                                <div class="p-3 bg-light rounded">
                                    <div class="small text-muted">Charging Session Slot</div>
                                    <div class="font-weight-bold text-dark">
                                        @Model.BookingDate.ToString("dd MMMM yyyy") (@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm"))
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Charger: <strong class="text-dark">@Model.Charger?.Name</strong> (@Model.Charger?.ConnectorType, @(Model.Charger?.CapacityKw) kW)
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="p-3 bg-light rounded text-md-right">
                                    <div class="small text-muted">Invoice Date &amp; Time</div>
                                    <div class="font-weight-bold text-dark">@invoiceDate</div>
                                    <div class="small text-muted mt-1">
                                        Settlement Mode: <strong class="text-success">Direct Pump Billing (No Wallet)</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Meter Reading Section -->
                        @if (Model.StartMeterReading.HasValue || Model.EndMeterReading.HasValue || Model.UnitsConsumedKwh.HasValue)
                        {
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="card border mb-3 bg-white">
                                        <div class="card-body py-2 px-3">
                                            <div class="row text-center">
                                                <div class="col-4 border-right">
                                                    <span class="text-muted small">Initial Meter</span>
                                                    <h6 class="font-weight-bold text-dark mb-0">@(Model.StartMeterReading?.ToString("F2") ?? "0.00") kWh</h6>
                                                </div>
                                                <div class="col-4 border-right">
                                                    <span class="text-muted small">Final Meter</span>
                                                    <h6 class="font-weight-bold text-dark mb-0">@(Model.EndMeterReading?.ToString("F2") ?? (Model.UnitsConsumedKwh.HasValue ? Model.UnitsConsumedKwh.Value.ToString("F2") : "—")) kWh</h6>
                                                </div>
                                                <div class="col-4">
                                                    <span class="text-muted small">Energy Delivered</span>
                                                    <h6 class="font-weight-bold text-primary mb-0">@(Model.UnitsConsumedKwh?.ToString("F2") ?? "0.00") kWh</h6>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Itemized Summary Table -->
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-hover table-md mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Service Description</th>
                                        <th class="text-center">Rate / Unit</th>
                                        <th class="text-center">Energy Delivered</th>
                                        <th class="text-right">Taxable Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>
                                            <strong>EV Charging Service</strong><br />
                                            <small class="text-muted">High-speed EV dispensing on @Model.Charger?.Name (@Model.Charger?.ConnectorType) at @Model.Station?.Name</small>
                                        </td>
                                        <td class="text-center">
                                            ₹@(Model.AppliedRatePerKwh?.ToString("F2") ?? "15.00") / kWh
                                        </td>
                                        <td class="text-center">
                                            @(Model.UnitsConsumedKwh?.ToString("F2") ?? "—") kWh
                                        </td>
                                        <td class="text-right font-weight-bold">
                                            ₹@baseAmount.ToString("F2")
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Calculations and GST breakdown -->
                        <div class="row mt-4">
                            <div class="col-lg-7">
                                <div class="section-title font-weight-bold">Payment &amp; Tax Compliance</div>
                                <p class="section-lead small text-muted mb-2">
                                    This is a computer-generated tax invoice issued in accordance with Section 31 of the CGST Act, 2017. All electricity consumption values are calibrated according to CEA EV Charging Infrastructure Regulations.
                                </p>
                                <div class="p-2 border rounded bg-light small mb-3">
                                    <div><strong>Transaction ID:</strong> VN-TXN-@Model.Id.ToString().Substring(0, 12).ToUpper()</div>
                                    <div><strong>SAC Code:</strong> 998714 (Maintenance, repair and charging services of electric vehicles)</div>
                                    <div><strong>Payment Status:</strong> 100% Paid directly to station partner</div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.MeterPhotoUrl))
                                {
                                    <div class="mb-2">
                                        <a href="@Model.MeterPhotoUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-camera mr-1"></i> View Station Energy Meter Photo Proof
                                        </a>
                                    </div>
                                }
                            </div>
                            <div class="col-lg-5 text-right">
                                <div class="invoice-detail-item d-flex justify-content-between py-1">
                                    <div class="invoice-detail-name text-muted">Taxable Value (Subtotal):</div>
                                    <div class="invoice-detail-value font-weight-bold">₹@baseAmount.ToString("F2")</div>
                                </div>
                                <div class="invoice-detail-item d-flex justify-content-between py-1">
                                    <div class="invoice-detail-name text-muted">CGST (9.0%):</div>
                                    <div class="invoice-detail-value">₹@cgst.ToString("F2")</div>
                                </div>
                                <div class="invoice-detail-item d-flex justify-content-between py-1">
                                    <div class="invoice-detail-name text-muted">SGST (9.0%):</div>
                                    <div class="invoice-detail-value">₹@sgst.ToString("F2")</div>
                                </div>
                                <hr class="my-2" />
                                <div class="invoice-detail-item d-flex justify-content-between py-2 bg-light px-2 rounded">
                                    <div class="invoice-detail-name font-weight-bold text-dark h5 mb-0">Total Amount Paid:</div>
                                    <div class="invoice-detail-value font-weight-bold text-success h4 mb-0">₹@totalAmount.ToString("F2")</div>
                                </div>
                            </div>
                        </div>

                    </div> <!-- /.invoice-print -->

                    <hr class="invoice-actions mt-4" />

                    <!-- Action Buttons -->
                    <div class="invoice-actions d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <a href="/customer/invoices" class="btn btn-outline-secondary mr-2">
                                <i class="fas fa-arrow-left mr-1"></i> All Invoices
                            </a>
                            <a href="/customer/bookings" class="btn btn-outline-primary">
                                <i class="fas fa-calendar-check mr-1"></i> My Bookings
                            </a>
                        </div>
                        <div>
                            <button type="button" class="btn btn-warning btn-icon icon-left" onclick="window.print();">
                                <i class="fas fa-print mr-1"></i> Print / Save PDF
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
