@model IEnumerable<VoltNet.Models.Charger>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    ViewData["Title"] = $"Select Charger - {station?.Name}";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<div class="sc">

<div class="card gap-b">
    <div class="card-body">
        <div class="head">
            <div>
                <span class="step">Step 1 of 3</span>
                <h4>@(station?.Name)</h4>
                <div class="sub">@(station?.Address), @(station?.City), @(station?.State)</div>
            </div>
            <a href="/station/@(station?.Id)" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
    </div>
</div>

<h5 class="section">Chargers</h5>

<div class="row">
    @if (!Model.Any(c => c.Status == "Active"))
    {
        <div class="col-12">
            <div class="empty-box">
                No active chargers available.
                <div><a href="/Home/Stations" class="btn btn-main">Find Another Station</a></div>
            </div>
        </div>
    }
    else
    {
        @foreach (var charger in Model)
        {
            var isActive = charger.Status == "Active";
            var rate = station?.ChargingRates?.FirstOrDefault(r => r.ConnectorType == charger.ConnectorType && r.IsActive);

            <div class="col-12 col-md-6 col-lg-4 gap-b">
                <div class="card charger @(isActive ? "on" : "off")">
                    <div class="c-top">
                        <h5>@charger.Name</h5>
                        @if (isActive)
                        {
                            <span class="status s-ok">Available</span>
                        }
                        else
                        {
                            <span class="status s-plain">@charger.Status</span>
                        }
                    </div>

                    <div class="pills">
                        <span class="status s-info">@charger.ConnectorType</span>
                        <span class="status s-warn">@(charger.CapacityKw) kW</span>
                    </div>

                    <div class="rate">
                        <div class="line">
                            <span class="k">Energy rate</span>
                            <span class="v money">@(rate != null ? $"₹{rate.RatePerKwh:F2}/kWh" : "Standard Rates")</span>
                        </div>
                        @if (rate?.RatePerHour.HasValue == true && rate.RatePerHour.Value > 0)
                        {
                            <div class="line">
                                <span class="k">Hourly fee</span>
                                <span class="v">+ ₹@rate.RatePerHour.Value.ToString("F2")/hr</span>
                            </div>
                        }
                    </div>

                    @if (isActive)
                    {
                        <a href="/customer/book/@(station?.Id)/slots?chargerId=@(charger.Id)" class="btn btn-main btn-block">Choose Slot <i class="fas fa-arrow-right"></i></a>
                    }
                    else
                    {
                        <button class="btn btn-back btn-block" disabled>Unavailable</button>
                    }
                </div>
            </div>
        }
    }
</div>

</div>