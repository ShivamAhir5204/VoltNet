@model IEnumerable<VoltNet.Models.Charger>

@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    ViewData["Title"] = $"Select Charger - {station?.Name}";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-primary text-white border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <span class="badge badge-light text-primary font-weight-bold mb-2">Step 1 of 3: Choose Charger</span>
                        <h3 class="font-weight-bold mb-1"><i class="fas fa-charging-station mr-2"></i> @(station?.Name)</h3>
                        <p class="mb-0 text-white-50"><i class="fas fa-map-marker-alt mr-1"></i> @(station?.Address), @(station?.City), @(station?.State)</p>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <a href="/station/@(station?.Id)" class="btn btn-outline-light btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Station Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <h5 class="font-weight-bold text-dark mb-3"><i class="fas fa-bolt text-warning mr-2"></i> Available Chargers at this Station</h5>
    </div>

    @if (!Model.Any(c => c.Status == "Active"))
    {
        <div class="col-12">
            <div class="card text-center py-5">
                <div class="card-body">
                    <i class="fas fa-plug fa-4x text-muted mb-3"></i>
                    <h4>No Active Chargers Available</h4>
                    <p class="text-muted">All chargers at this station are currently undergoing maintenance or are offline.</p>
                    <a href="/Home/Stations" class="btn btn-primary mt-2">Find Another Station</a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var charger in Model)
        {
            var isActive = charger.Status == "Active";
            var rate = station?.ChargingRates?.FirstOrDefault(r => r.ConnectorType == charger.ConnectorType && r.IsActive);
            
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border @(isActive ? "border-primary" : "border-light opacity-75")">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="font-weight-bold mb-0 text-dark">@charger.Name</h5>
                                @if (isActive)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> Available</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary"><i class="fas fa-wrench mr-1"></i> @charger.Status</span>
                                }
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge badge-info px-3 py-2 mr-2">
                                        <i class="fas fa-plug mr-1"></i> @charger.ConnectorType
                                    </span>
                                    <span class="badge badge-warning px-3 py-2">
                                        <i class="fas fa-tachometer-alt mr-1"></i> @(charger.CapacityKw) kW
                                    </span>
                                </div>
                            </div>

                            <div class="p-3 bg-light rounded mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">Energy Rate:</span>
                                    <strong class="text-success h6 mb-0">
                                        @(rate != null ? $"₹{rate.RatePerKwh:F2}/kWh" : "Standard Rates")
                                    </strong>
                                </div>
                                @if (rate?.RatePerHour.HasValue == true && rate.RatePerHour.Value > 0)
                                {
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Parking/Hourly Fee:</span>
                                        <span class="text-primary font-weight-bold small">+ ₹@rate.RatePerHour.Value.ToString("F2")/hr</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div>
                            @if (isActive)
                            {
                                <a href="/customer/book/@(station?.Id)/slots?chargerId=@(charger.Id)" class="btn btn-primary btn-block py-2 font-weight-bold">
                                    Select & Choose Slot <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-block py-2" disabled>
                                    Currently Unavailable
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
