@{
    var station = ViewBag.Station as VoltNet.Models.Station;
    var charger = ViewBag.Charger as VoltNet.Models.Charger;
    var bookingDate = (DateTime)ViewBag.BookingDate;
    var startTime = (TimeSpan)ViewBag.StartTime;
    var endTime = (TimeSpan)ViewBag.EndTime;
    var estimatedCost = (decimal)ViewBag.EstimatedCost;
    var rate = ViewBag.Rate as VoltNet.Models.ChargingRate;
    ViewData["Title"] = "Review & Confirm Booking";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<div class="rb">
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <div>
                    <span class="step">Step 3 of 3</span>
                    <h4 class="mt-2">Review Booking</h4>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-12 col-md-6 mb-3 mb-md-0">
                        <div class="tile">
                            <span class="lbl">Station</span>
                            <div class="val">@station?.Name</div>
                            <div class="sub">@station?.Address, @station?.City, @station?.State</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="tile">
                            <span class="lbl">Charger</span>
                            <div class="val">@charger?.Name</div>
                            <div class="mt-2">
                                <span class="status s-info">@charger?.ConnectorType</span>
                                <span class="status s-warn">@charger?.CapacityKw kW</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <h5 class="section">Schedule</h5>
                    <div class="row">
                        <div class="col-6 col-md-4 mb-3 mb-md-0">
                            <span class="lbl">Date</span>
                            <div class="val">@bookingDate.ToString("dd MMM yyyy")</div>
                            <div class="sub">@bookingDate.ToString("dddd")</div>
                        </div>
                        <div class="col-6 col-md-4 mb-3 mb-md-0">
                            <span class="lbl">Time Slot</span>
                            <div class="val">@startTime.ToString(@"hh\:mm") - @endTime.ToString(@"hh\:mm")</div>
                            <div class="sub">1 hour</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <span class="lbl">Cancellation</span>
                            <div class="val money" style="font-size:15px">Free up to 30 mins before start</div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <h5 class="section">Billing</h5>
                    <div class="line"><span class="k">Energy rate</span><span class="v money">₹@(rate?.RatePerKwh.ToString("F2") ?? "15.00") / kWh</span></div>
                    @if (rate?.RatePerHour.HasValue == true && rate.RatePerHour.Value > 0)
                    {
                        <div class="line"><span class="k">Parking / base fee</span><span class="v">₹@rate.RatePerHour.Value.ToString("F2")</span></div>
                    }
                    <div class="total">
                        <span>Estimated cost (1 hr)</span>
                        <span class="amt">₹@estimatedCost.ToString("F2")</span>
                    </div>
                    <div class="note">You are billed only for the actual energy used.</div>
                </div>

                <div class="panel">
                    <h5 class="section">Advance Booking Deposit</h5>
                    <div class="line"><span class="k">Deposit</span><span class="v">₹50.00</span></div>
                    <div class="note warn">Fully deducted from your final bill. You pay the final energy bill minus ₹50.00.</div>
                </div>

                <form asp-action="Create" method="post" id="confirmBookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="stationId" value="@station?.Id" />
                    <input type="hidden" name="chargerId" value="@charger?.Id" />
                    <input type="hidden" name="bookingDate" value="@bookingDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="startTime" value="@startTime" />
                    <input type="hidden" name="endTime" value="@endTime" />

                    <div class="panel">
                        <h5 class="section">Vehicle</h5>
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3 mb-md-0">
                                <label>Number Plate</label>
                                <input type="text" name="vehicleNumberPlate" class="form-control text-uppercase" autocapitalize="characters" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label>Model</label>
                                <input type="text" name="vehicleModel" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/customer/book/@(station?.Id)/slots?chargerId=@(charger?.Id)&date=@(bookingDate.ToString("yyyy-MM-dd"))" class="btn btn-back"><i class="fas fa-arrow-left"></i> Back to Slots</a>
                        <button type="submit" class="btn btn-main" id="btnConfirmBooking"><i class="fas fa-check"></i> Confirm Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

<script>
    document.getElementById('confirmBookingForm').addEventListener('submit', function() {
        var btn = document.getElementById('btnConfirmBooking');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-2"></span> Confirming Slot...';
    });
</script>