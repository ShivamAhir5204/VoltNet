@model IEnumerable<VoltNet.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var ist = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
    var nowIst = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);

    var upcomingBookings = Model.Where(b => (b.Status == "Confirmed" || b.Status == "Charging") && (b.BookingDate.Date + b.EndTime) >= nowIst).ToList();
    var pastBookings = Model.Where(b => !upcomingBookings.Contains(b)).ToList();
    var waitlist = ViewBag.Waitlist as List<VoltNet.Models.WaitlistEntry> ?? new List<VoltNet.Models.WaitlistEntry>();
}

<div class="mb">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>My Bookings</h4>
                    <a href="/Home/Stations" class="btn btn-main"><i class="fas fa-plus"></i> Book New Slot</a>
                </div>
                <div class="card-body">

                    @if (waitlist.Any())
                    {
                        <div class="wait">
                            <h5>Waitlist (@waitlist.Count)</h5>
                            <div class="hint">If a driver cancels, your slot is confirmed automatically.</div>
                            <div class="row">
                                @foreach (var w in waitlist)
                                {
                                    <div class="col-12 col-md-6 mb-2">
                                        <div class="wait-item">
                                            <div>
                                                <div class="val">@w.Station?.Name</div>
                                                <div class="sub">@w.BookingDate.ToString("dd MMM yyyy") (@w.StartTime.ToString(@"hh\:mm") - @w.EndTime.ToString(@"hh\:mm"))</div>
                                                <span class="status s-warn mt-1">Queue Position #@w.QueuePosition</span>
                                            </div>
                                            <form asp-action="CancelWaitlist" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@w.Id" />
                                                <button type="submit" class="btn btn-reject" onclick="return confirm('Leave waitlist queue?');">Leave Queue</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <h5 class="section">Upcoming (@upcomingBookings.Count)</h5>

                    @if (!upcomingBookings.Any())
                    {
                        <div class="empty-box">
                            No upcoming bookings.
                            <div><a href="/Home/Stations" class="btn btn-ghost">Find Stations</a></div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var booking in upcomingBookings)
                            {
                                var slotStart = booking.BookingDate.Date + booking.StartTime;
                                var isCharging = booking.Status == "Charging";
                                var canCancel = !isCharging && (slotStart - nowIst).TotalMinutes >= 30;

                                <div class="col-12 col-md-6 gap-b">
                                    <div class="bk @(isCharging ? "live" : "")">
                                        <div class="bk-head">
                                            <div>
                                                <h5>@booking.Station?.Name</h5>
                                                <div class="sub">@booking.Station?.Address, @booking.Station?.City</div>
                                            </div>
                                            @if (isCharging)
                                            {
                                                <span class="status s-ok">Charging</span>
                                            }
                                            else
                                            {
                                                <span class="status s-plan">Confirmed</span>
                                            }
                                        </div>

                                        <div class="tile">
                                            <div class="row">
                                                <div class="col-6 mb-2">
                                                    <span class="lbl">Charger</span>
                                                    <div class="val">@booking.Charger?.Name</div>
                                                    <div class="sub">@booking.Charger?.ConnectorType (@(booking.Charger?.CapacityKw)kW)</div>
                                                </div>
                                                <div class="col-6 mb-2">
                                                    <span class="lbl">Vehicle</span>
                                                    <div class="val">@(string.IsNullOrEmpty(booking.VehicleNumberPlate) ? "—" : booking.VehicleNumberPlate)</div>
                                                    <div class="sub">@(booking.VehicleModel ?? "EV Car")</div>
                                                </div>
                                                <div class="col-6">
                                                    <span class="lbl">Date</span>
                                                    <div class="val">@booking.BookingDate.ToString("dd MMM yyyy")</div>
                                                </div>
                                                <div class="col-6">
                                                    <span class="lbl">Time Slot</span>
                                                    <div class="val">@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</div>
                                                </div>
                                            </div>

                                            @if (booking.BookingFee > 0 && !booking.IsWalkIn)
                                            {
                                                <div class="fee">
                                                    <span class="sub">Advance deposit (deducted from final bill)</span>
                                                    <span class="status s-warn">₹@booking.BookingFee.ToString("N0") Paid</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="bk-foot">
                                            <span class="ref">#@booking.Id.ToString().Substring(0, 8).ToUpper()</span>
                                            @if (isCharging)
                                            {
                                                <span class="note-live">Connected & charging</span>
                                            }
                                            else if (canCancel)
                                            {
                                                <button type="button" class="btn btn-reject" onclick="openCancelModal('@booking.Id', '@booking.Station?.Name', '@booking.BookingDate.ToString("dd MMM yyyy")', '@booking.StartTime.ToString(@"hh\:mm")')">
                                                    <i class="fas fa-times"></i> Cancel Booking
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="note-lock" title="Cancellation locked within 30 mins of slot start">Cancellation closed (&lt;30m)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <h5 class="section mt">History</h5>

                    @if (!pastBookings.Any())
                    {
                        <div class="empty-box">No past bookings.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle table-responsive-cards" id="table-1">
                                <thead>
                                    <tr>
                                        <th>Booking ID</th>
                                        <th>Station & Charger</th>
                                        <th>Vehicle</th>
                                        <th>Units (kWh)</th>
                                        <th>Final Cost</th>
                                        <th>Status</th>
                                        <th>Meter Proof</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in pastBookings)
                                    {
                                        <tr>
                                            <td class="col-primary" data-label="Booking ID">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span class="cell-strong">#@b.Id.ToString().Substring(0, 8).ToUpper()</span>
                                                    <button type="button" class="mobile-expand-btn ml-2" title="Show details">
                                                        <i data-feather="chevron-down"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Station & Charger">
                                                <div>
                                                    <div class="cell-strong">@b.Station?.Name</div>
                                                    <div class="cell-sub">@b.Charger?.Name (@b.Charger?.ConnectorType)</div>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Vehicle">
                                                <div>
                                                    <div class="cell-strong">@(b.VehicleNumberPlate ?? "—")</div>
                                                    <div class="cell-sub">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Units (kWh)">
                                                <div>
                                                    @if (b.UnitsConsumedKwh.HasValue)
                                                    {
                                                        <span class="status s-plain">@b.UnitsConsumedKwh.Value.ToString("F2") kWh</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="cell-sub">—</span>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="Final Cost">
                                                <div>
                                                    <div class="cell-money">₹@(b.ActualCost?.ToString("F2") ?? b.EstimatedCost.ToString("F2"))</div>
                                                    @if (b.BookingFee > 0)
                                                    {
                                                        <div class="cell-sub" title="₹@b.BookingFee.ToString("F2") advance booking fee deducted from total bill">Adv. ₹@b.BookingFee.ToString("F2") adjusted</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(b.PaymentMethod))
                                                    {
                                                        <div class="cell-sub">@b.PaymentMethod</div>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="Status">
                                                <div>
                                                    @if (b.Status == "Completed")
                                                    {
                                                        <span class="status s-ok">Completed</span>
                                                    }
                                                    else if (b.Status == "Cancelled")
                                                    {
                                                        <span class="status s-err" title="@b.CancellationReason">Cancelled</span>
                                                    }
                                                    else if (b.Status == "NoShow")
                                                    {
                                                        <span class="status s-warn">No Show</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status s-info">@b.Status</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="col-secondary" data-label="Meter Proof">
                                                <div>
                                                    @if (!string.IsNullOrEmpty(b.MeterPhotoUrl))
                                                    {
                                                        <a href="@b.MeterPhotoUrl" target="_blank" class="btn btn-ghost"><i class="fas fa-external-link-alt"></i> View Photo</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="cell-sub">—</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal: Cancel Booking -->
<div class="modal fade mb-modal" id="cancelBookingModal" tabindex="-1" role="dialog" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelBookingModalLabel">Cancel Booking</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cancelBookingId" name="id" />
                <div class="modal-body">
                    <div class="impact">Cancel your reservation for <strong id="cancelStationName"></strong> on <strong id="cancelDateTime"></strong>? The slot is released to the waitlist.</div>

                    <div class="form-group mb-0">
                        <label for="cancellationReason">Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="cancellationReason" name="cancellationReason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-dismiss="modal">Keep Booking</button>
                    <button type="submit" class="btn btn-reject"><i class="fas fa-times"></i> Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCancelModal(id, station, date, time) {
            $('#cancelBookingId').val(id);
            $('#cancelStationName').text(station);
            $('#cancelDateTime').text(date + ' at ' + time);
            $('#cancelBookingModal').modal('show');
        }

        $(document).ready(function() {
            $('#cancelBookingModal').appendTo("body");
        });
    </script>
}