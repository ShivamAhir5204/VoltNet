@model IEnumerable<VoltNet.Models.Booking>

@{
    ViewData["Title"] = "My Invoices";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var totalSpent = ViewBag.TotalSpent != null ? (decimal)ViewBag.TotalSpent : 0m;
    var totalKwh = ViewBag.TotalKwh != null ? (decimal)ViewBag.TotalKwh : 0m;
    var invoiceCount = ViewBag.InvoiceCount != null ? (int)ViewBag.InvoiceCount : Model.Count();
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-1"><i class="fas fa-file-invoice-dollar text-primary mr-2"></i> My Tax Invoices &amp; Receipts</h4>
                    <p class="text-muted mb-0 small">Download, view, and print GST-compliant tax invoices for all completed EV charging sessions.</p>
                </div>
                <div class="mt-2 mt-sm-0">
                    <a href="/customer/bookings" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-calendar-check mr-1"></i> Active Reservations
                    </a>
                </div>
            </div>
            <div class="card-body">

                <!-- Summary KPI Cards -->
                <div class="row mb-4">
                    <div class="col-12 col-md-4 mb-3 mb-md-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-primary text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-receipt fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0">
                                    <h4 class="text-muted">Total Invoices</h4>
                                </div>
                                <div class="card-body font-weight-bold">
                                    @invoiceCount
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-3 mb-md-0">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-success text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-bolt fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0">
                                    <h4 class="text-muted">Total Energy Dispensed</h4>
                                </div>
                                <div class="card-body font-weight-bold text-success">
                                    @totalKwh.ToString("F2") kWh
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card card-statistic-1 border mb-0">
                            <div class="card-icon bg-info text-white d-flex align-items-center justify-content-center">
                                <i class="fas fa-rupee-sign fa-2x"></i>
                            </div>
                            <div class="card-wrap">
                                <div class="card-header py-0">
                                    <h4 class="text-muted">Total Amount Settled</h4>
                                </div>
                                <div class="card-body font-weight-bold text-primary">
                                    ₹@totalSpent.ToString("F2")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-light rounded">
                        <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                        <h5 class="text-dark">No Invoices Generated Yet</h5>
                        <p class="text-muted small mb-3">Once you complete an EV charging session at any VoltNet station, your official tax invoice will appear here automatically.</p>
                        <a href="/Home/Stations" class="btn btn-primary">Find Charging Station</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle" id="table-1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Date</th>
                                    <th>Station &amp; City</th>
                                    <th>Vehicle</th>
                                    <th>Energy (kWh)</th>
                                    <th>Total Paid</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var invNo = $"VN-INV-{item.BookingDate:yyyyMM}-{item.Id.ToString().Substring(0, 8).ToUpper()}";
                                    var cost = item.ActualCost ?? item.EstimatedCost;
                                    <tr>
                                        <td>
                                            <a href="/customer/bookings/invoice/@item.Id" class="font-weight-bold text-primary">
                                                @invNo
                                            </a>
                                        </td>
                                        <td>
                                            @(item.CompletedAt?.ToString("dd MMM yyyy") ?? item.BookingDate.ToString("dd MMM yyyy"))
                                            <div class="small text-muted">@item.StartTime.ToString(@"hh\:mm") – @item.EndTime.ToString(@"hh\:mm")</div>
                                        </td>
                                        <td>
                                            <strong>@item.Station?.Name</strong>
                                            <div class="small text-muted">@item.Station?.City, @item.Station?.State</div>
                                        </td>
                                        <td>
                                            <strong>@(string.IsNullOrEmpty(item.VehicleNumberPlate) ? "—" : item.VehicleNumberPlate)</strong>
                                            <div class="small text-muted">@(item.VehicleModel ?? "EV Car")</div>
                                        </td>
                                        <td>
                                            @if (item.UnitsConsumedKwh.HasValue)
                                            {
                                                <span class="badge badge-light border font-weight-bold text-dark">@item.UnitsConsumedKwh.Value.ToString("F2") kWh</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <strong class="text-success">₹@cost.ToString("F2")</strong>
                                            <div class="small text-muted">Incl. 18% GST</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-success px-2 py-1">Paid</span>
                                        </td>
                                        <td class="text-center">
                                            <a href="/customer/bookings/invoice/@item.Id" class="btn btn-sm btn-outline-primary" title="View Tax Invoice">
                                                <i class="fas fa-eye mr-1"></i> View Invoice
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
