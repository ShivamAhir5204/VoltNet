@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    /* ── Change Password Responsive Styles ────────────────── */
    .pw-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .pw-card .card-header {
        background: #fff;
        border-bottom: 1px solid #eef0f4;
        border-radius: 12px 12px 0 0 !important;
        padding: 1.25rem 1.5rem;
    }
    .pw-card .card-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #34395e;
        margin: 0;
    }
    .pw-card .card-body {
        padding: 1.5rem;
    }
    .pw-card .form-group label {
        font-weight: 600;
        color: #34395e;
        font-size: 0.875rem;
        margin-bottom: 0.4rem;
    }
    .pw-card .form-control {
        border-radius: 8px;
        border: 1px solid #e4e6ef;
        padding: 0.6rem 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pw-card .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
    }
    .pw-input-wrapper {
        position: relative;
    }
    .pw-input-wrapper .toggle-pw {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #98a6ad;
        font-size: 0.95rem;
        z-index: 2;
    }
    .pw-input-wrapper .toggle-pw:hover {
        color: #667eea;
    }
    .btn-change-pw-submit {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 0.6rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        color: #fff;
        transition: opacity 0.2s, transform 0.15s;
    }
    .btn-change-pw-submit:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: #fff;
    }
    .btn-back-profile {
        background: transparent;
        border: 2px solid #98a6ad;
        color: #6c757d;
        padding: 0.6rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-back-profile:hover {
        background: #6c757d;
        color: #fff;
        border-color: #6c757d;
    }
    .pw-tips-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .pw-tips-card .card-header {
        background: #fff;
        border-bottom: 1px solid #eef0f4;
        border-radius: 12px 12px 0 0 !important;
        padding: 1.25rem 1.5rem;
    }
    .pw-tips-card .card-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #34395e;
        margin: 0;
    }
    .pw-tips-card .card-body {
        padding: 1.5rem;
    }
    .pw-tip {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.6rem 0;
    }
    .pw-tip i {
        color: #667eea;
        margin-top: 2px;
        flex-shrink: 0;
    }
    .pw-tip span {
        color: #6c757d;
        font-size: 0.875rem;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @@media (max-width: 767.98px) {
        .pw-card .card-body {
            padding: 1rem;
        }
        .pw-tips-card .card-body {
            padding: 1rem;
        }
        .btn-change-pw-submit,
        .btn-back-profile {
            width: 100%;
            text-align: center;
        }
        .pw-actions {
            flex-direction: column;
            gap: 0.5rem !important;
        }
    }
</style>

<!-- Page Header -->
<div class="section-header">
    <h1>Change Password</h1>
    <div class="section-header-breadcrumb">
        <div class="breadcrumb-item active"><a href="/customer/dashboard">Dashboard</a></div>
        <div class="breadcrumb-item active"><a href="/customer/profile">My Profile</a></div>
        <div class="breadcrumb-item">Change Password</div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Error
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="row">
    <!-- Change Password Form -->
    <div class="col-12 col-lg-7">
        <div class="card pw-card">
            <div class="card-header">
                <h4><i class="fas fa-key mr-2"></i>Change Password</h4>
            </div>
            <div class="card-body">
                <form method="post" action="/customer/change-password" id="changePasswordForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="currentPassword">Current Password <span class="text-danger">*</span></label>
                        <div class="pw-input-wrapper">
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                                   required placeholder="Enter your current password" />
                            <span class="toggle-pw" onclick="togglePassword('currentPassword', this)">
                                <i class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="newPassword">New Password <span class="text-danger">*</span></label>
                        <div class="pw-input-wrapper">
                            <input type="password" class="form-control" id="newPassword" name="newPassword"
                                   required minlength="6" placeholder="Enter new password (min 6 characters)" />
                            <span class="toggle-pw" onclick="togglePassword('newPassword', this)">
                                <i class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password <span class="text-danger">*</span></label>
                        <div class="pw-input-wrapper">
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                                   required minlength="6" placeholder="Re-enter new password" />
                            <span class="toggle-pw" onclick="togglePassword('confirmPassword', this)">
                                <i class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-group mt-4 d-flex flex-wrap pw-actions" style="gap:0.75rem;">
                        <button type="submit" class="btn btn-change-pw-submit">
                            <i class="fas fa-lock mr-1"></i> Update Password
                        </button>
                        <a href="/customer/profile" class="btn btn-back-profile">
                            <i class="fas fa-arrow-left mr-1"></i> Back to Profile
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tips -->
    <div class="col-12 col-lg-5">
        <div class="card pw-tips-card">
            <div class="card-header">
                <h4><i class="fas fa-lightbulb mr-2"></i>Password Tips</h4>
            </div>
            <div class="card-body">
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Use at least <strong>6 characters</strong></span>
                </div>
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Mix <strong>uppercase and lowercase</strong> letters</span>
                </div>
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Include at least one <strong>number</strong></span>
                </div>
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Add a <strong>special character</strong> (@@, #, $, etc.)</span>
                </div>
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Avoid using <strong>common words</strong> or personal info</span>
                </div>
                <div class="pw-tip">
                    <i class="fas fa-check-circle"></i>
                    <span>Don't reuse passwords from other websites</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePassword(inputId, toggleEl) {
        var input = document.getElementById(inputId);
        var icon = toggleEl.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>
}
